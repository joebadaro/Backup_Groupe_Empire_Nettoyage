---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AfterHoursPhonePopup from "../components/AfterHoursPhonePopup.astro";
import HeaderChoiceModal from "../components/HeaderChoiceModal.astro";
import UiIcon from "../components/icons/UiIcon.astro";
import { MOBILE_STICKY_CTA_BUTTON } from "../config/headerChoiceModal";

import SEO from "../components/SEO.astro";

/** Same-origin hashed URLs as @font-face in global CSS — early preload shortens font discovery vs CSS-parse-only */
import interLatinWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import outfitLatinWoff2 from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
/** Placeholders remplacés post-build par les URLs /_astro/boot-deferred-*.js */
const bootDeferredSiteScriptsUrl = "__EMPIRE_BOOT_PUBLIC_URL__";
const bootDeferredPrivateScriptsUrl = "__EMPIRE_BOOT_PRIVATE_URL__";
/** estimation-bootstrap-lazy.ts est bundlé par Vite en ESM — définit window.openEstimationWidget au chargement */

interface Props {
  title: string;
  description?: string;
  image?: string;
  robots?: string;
  /** Calculatrice interne : uniquement pour /estimation-privee/ */
  includePrivateCalculator?: boolean;
}

const { title, image, robots, includePrivateCalculator = false } = Astro.props;

const isEn = Astro.url.pathname.startsWith("/en");
const defaultDescription = isEn
  ? "Professional on-site carpet, upholstery, and mattress cleaning in Greater Montreal, Laval, and the South Shore. Eco-friendly products and truck-mount equipment. We do not pick up rugs for off-site cleaning."
  : "Groupe Nettoyage Empire — nettoyage sur place de tapis, meubles et matelas à Montréal, Laval et sur la Rive-Sud. Pas de ramassage des tapis pour nettoyage en atelier.";

const description = Astro.props.description ?? defaultDescription;

---

<!doctype html>
<html lang={Astro.url.pathname.startsWith("/en") ? "en" : "fr"}>
  <head>
    <meta charset="UTF-8" />
    <!-- Preloads LCP (pages d’accueil) avant polices -->
    <slot name="head" />
    <!-- Google origins: warm DNS/TCP/TLS before GTM/gtag (GTM reste inchangé ci-dessous) -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <!-- Google Tag Manager — dataLayer immédiat ; gtm.js différé sur mobile seulement -->
    <script is:inline>
      (function (w, d) {
        w.dataLayer = w.dataLayer || [];
        /* File d’attente compatible gtag → dataLayer avant le chargement réseau GTM */
        w.gtag =
          w.gtag ||
          function () {
            w.dataLayer.push(arguments);
          };

        var GTM_ID = "GTM-TPKDH7S2";
        var started = false;

        function startGTM() {
          if (started) return;
          started = true;
          w.dataLayer.push({
            "gtm.start": new Date().getTime(),
            event: "gtm.js",
          });
          var f = d.getElementsByTagName("script")[0];
          var j = d.createElement("script");
          j.async = true;
          j.src =
            "https://www.googletagmanager.com/gtm.js?id=" + GTM_ID;
          f.parentNode.insertBefore(j, f);
        }

        w.startGTM = startGTM;

        var isMobile = false;
        try {
          var mqMobile =
            typeof w.matchMedia === "function" &&
            w.matchMedia("(max-width: 768px)").matches;
          var narrow =
            typeof w.innerWidth === "number" &&
            w.innerWidth > 0 &&
            w.innerWidth <= 768;
          var uaMobile = /Android|iPhone|iPod|Mobile/i.test(
            (w.navigator && w.navigator.userAgent) || "",
          );
          isMobile = !!(mqMobile || narrow || uaMobile);
        } catch (e) {}

        /* Desktop : comportement inchangé — injecte immédiatement */
        if (!isMobile) {
          startGTM();
          return;
        }

        /* Mobile : différer gtm.js jusqu’à interaction OU ~4s depuis navigation */
        var DELAY_MS = 4000;
        var cleaned = false;

        function cleanupInteract() {
          if (cleaned) return;
          cleaned = true;
          d.removeEventListener("pointerdown", onInteract, true);
          d.removeEventListener("touchstart", onInteract, true);
          d.removeEventListener("keydown", onInteract, true);
        }

        function onInteract() {
          startGTM();
          cleanupInteract();
        }

        d.addEventListener("pointerdown", onInteract, {
          capture: true,
          once: true,
          passive: true,
        });
        d.addEventListener("touchstart", onInteract, {
          capture: true,
          once: true,
          passive: true,
        });
        d.addEventListener("keydown", onInteract, {
          capture: true,
          once: true,
        });

        var elapsed =
          w.performance && typeof w.performance.now === "function"
            ? w.performance.now()
            : 0;
        var wait = Math.max(0, DELAY_MS - elapsed);
        setTimeout(function () {
          startGTM();
          cleanupInteract();
        }, wait);
      })(window, document);
    </script>
    <!-- End Google Tag Manager -->
    <meta name="version" content="2.0.0-perf-optimized" />
    <link
      rel="preload"
      href={interLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      fetchpriority="low"
    />
    <link
      rel="preload"
      href={outfitLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      fetchpriority="low"
    />
    <SEO
      title={title}
      description={description}
      image={image}
      robots={robots}
    />
    {
      !includePrivateCalculator && (
        <script
          is:inline
          define:vars={{
            estimateUrlFr: "/demande-estimation/",
            estimateUrlEn: "/en/estimate-request/",
          }}
        >
          (function () {
            window.openEstimationWidget = function () {
              var path = window.location.pathname || "/";
              window.location.href =
                path.indexOf("/en") === 0 ? estimateUrlEn : estimateUrlFr;
            };
            /* Bouton Contact EN (#btn-trigger-estimate-page) sans onclick inline */
            document.addEventListener("DOMContentLoaded", function () {
              var btn = document.getElementById("btn-trigger-estimate-page");
              if (!btn) return;
              btn.addEventListener(
                "click",
                function (e) {
                  e.preventDefault();
                  e.stopImmediatePropagation();
                  window.openEstimationWidget();
                },
                true,
              );
            });
            /* Bloque tout ancien handler (onclick / script Header mis en cache) sur le CTA rouge. */
            document.addEventListener(
              "click",
              function (e) {
                var target = e.target;
                if (!target || !target.closest) return;
                var headerBtn = target.closest("#btn-open-estimation");
                if (headerBtn) {
                  e.preventDefault();
                  e.stopPropagation();
                  if (typeof window.__openHeaderChoiceModal === "function") {
                    window.__openHeaderChoiceModal();
                  } else {
                    window.__headerChoiceModalPending = true;
                  }
                  return;
                }
                var mobileBtn = target.closest("#btn-mobile-representative");
                if (!mobileBtn) return;
                e.preventDefault();
                e.stopPropagation();
                if (
                  typeof window.__openMobileRepresentativeModal === "function"
                ) {
                  window.__openMobileRepresentativeModal();
                } else {
                  window.__mobileRepresentativeModalPending = true;
                }
              },
              true,
            );
          })();
        </script>
      )
    }
    {image && <link rel="preload" as="image" href={image} />}
    <!-- Bundled as inline: fade-in reste hors du bundle Layout (LCP) ; SMS visiteur est dans visitor-sms.ts -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        function registerFadeInObserver() {
          var observerOptions = {
            root: null,
            rootMargin: "0px",
            threshold: 0.1,
          };
          var observer = new IntersectionObserver(function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            });
          }, observerOptions);
          document.querySelectorAll(".fade-in-section").forEach(function (section) {
            observer.observe(section);
          });
        }
        if ("requestIdleCallback" in window) {
          requestIdleCallback(registerFadeInObserver, { timeout: 2000 });
        } else {
          setTimeout(registerFadeInObserver, 1);
        }
      });
    </script>
  </head>
  <body data-empire-site-mode={includePrivateCalculator ? "private" : "public"}>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TPKDH7S2"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    {!includePrivateCalculator && <AfterHoursPhonePopup />}
    {!includePrivateCalculator && <HeaderChoiceModal />}

    <!-- Calculatrice : uniquement via slot sur /estimation-privee/ (évite d’importer EstimationModule dans ce layout pour tout le site). -->
    <slot name="private-calculator" />
    <!--
      Scripts non critiques : AUCUN module Astro/Vite dans le HTML initial.
      Mini scheduler inline → après window.load + idle (ou 1er pointerdown) charge boot via <script type=module>.
      GTM mobile : gtm.js différé (interaction ou ~4s) — dataLayer immédiat.
    -->
    <script
      is:inline
      define:vars={{
        bootModuleUrl: includePrivateCalculator
          ? bootDeferredPrivateScriptsUrl
          : bootDeferredSiteScriptsUrl,
      }}
    >
      (function () {
        var injected = false;
        function injectBootModule() {
          if (injected) return;
          injected = true;
          var s = document.createElement("script");
          s.type = "module";
          s.src = bootModuleUrl;
          s.async = true;
          document.body.appendChild(s);
        }

        function scheduleIdleInject() {
          if ("requestIdleCallback" in window) {
            requestIdleCallback(injectBootModule, { timeout: 3500 });
          } else {
            setTimeout(injectBootModule, 1);
          }
        }

        function afterWindowLoadThenIdle() {
          if (document.readyState === "complete") {
            scheduleIdleInject();
            return;
          }
          window.addEventListener(
            "load",
            function () {
              scheduleIdleInject();
            },
            { once: true },
          );
        }

        afterWindowLoadThenIdle();

        window.addEventListener(
          "pointerdown",
          function () {
            injectBootModule();
          },
          { passive: true, capture: true, once: true },
        );
      })();
    </script>

    {
      !includePrivateCalculator && (
        <div class="mobile-sticky-bar">
          <button
            type="button"
            id="btn-mobile-representative"
            class="mobile-sticky-bar__cta"
            data-header-choice-trigger="mobile"
          >
            <span class="mobile-sticky-bar__icon" aria-hidden="true">
              <UiIcon name="phone" size={17} />
            </span>
            <span class="mobile-sticky-bar__label">
              {
                isEn
                  ? MOBILE_STICKY_CTA_BUTTON.en
                  : MOBILE_STICKY_CTA_BUTTON.fr
              }
            </span>
          </button>
        </div>
      )
    }

    <style>
      /* GLOBAL GRADIENT BACKGROUND (Distinct) */
      body {
        /* Clearly visible Blue-Grey to White */
        background: linear-gradient(135deg, #cbdceb 0%, #ffffff 100%);
        background-attachment: fixed;
        min-height: 100vh;
      }

      /* fixed + scroll on iOS/Android often causes parallax/jank; desktop keeps fixed */
      @media (max-width: 768px) {
        body {
          background-attachment: scroll;
        }
      }

      /* MOBILE STICKY BAR — single representative CTA, opens HeaderChoiceModal */
      .mobile-sticky-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0.45rem 0.75rem calc(0.45rem + env(safe-area-inset-bottom, 0px));
        pointer-events: none;
        background: transparent;
        border: none;
        box-shadow: none;
        transform: translateY(100%);
        animation: slideUp 0.5s 1s forwards;
        box-sizing: border-box;
      }

      .mobile-sticky-bar__cta {
        pointer-events: auto;
        position: relative;
        isolation: isolate;
        overflow: hidden;
        width: min(90%, 22rem);
        max-width: 92%;
        min-height: 2.75rem;
        padding: 0.62rem 1.15rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 999px;
        background: linear-gradient(
          135deg,
          rgba(4, 45, 91, 0.98) 0%,
          rgba(0, 96, 190, 0.94) 100%
        );
        color: #ffffff;
        font-weight: 700;
        font-size: 0.9rem;
        line-height: 1.2;
        letter-spacing: 0.01em;
        text-align: center;
        white-space: nowrap;
        text-shadow: 0 1px 1px rgba(0, 20, 45, 0.22);
        box-shadow:
          0 10px 28px rgba(0, 34, 76, 0.34),
          inset 0 1px 0 rgba(255, 255, 255, 0.16);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition:
          transform 0.22s ease,
          box-shadow 0.22s ease,
          background 0.22s ease,
          border-color 0.22s ease;
        font-family: inherit;
        cursor: pointer;
        -webkit-appearance: none;
        appearance: none;
        margin: 0;
      }

      /* Reflet satiné discret — ne couvre pas le texte (z-index sur label/icon) */
      .mobile-sticky-bar__cta::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.11) 0%,
          rgba(255, 255, 255, 0.03) 42%,
          transparent 68%
        );
        pointer-events: none;
        z-index: 0;
      }

      .mobile-sticky-bar__cta::after {
        content: "";
        position: absolute;
        top: 1px;
        left: 14%;
        right: 14%;
        height: 40%;
        border-radius: 999px;
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.1) 0%,
          transparent 100%
        );
        pointer-events: none;
        z-index: 0;
      }

      .mobile-sticky-bar__icon {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 1.35rem;
        height: 1.35rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
        filter: drop-shadow(0 1px 1px rgba(0, 20, 45, 0.18));
      }

      .mobile-sticky-bar__label {
        position: relative;
        z-index: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      @media (hover: hover) and (pointer: fine) {
        .mobile-sticky-bar__cta:hover {
          transform: translateY(-1px);
          background: linear-gradient(
            135deg,
            rgba(6, 52, 102, 0.98) 0%,
            rgba(0, 108, 210, 0.94) 100%
          );
          border-color: rgba(255, 255, 255, 0.28);
          box-shadow:
            0 12px 32px rgba(0, 34, 76, 0.38),
            inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }
      }

      .mobile-sticky-bar__cta:active {
        transform: translateY(0);
        box-shadow:
          0 8px 22px rgba(0, 34, 76, 0.3),
          inset 0 1px 0 rgba(255, 255, 255, 0.14);
      }

      .mobile-sticky-bar__cta:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.92);
        outline-offset: 3px;
        box-shadow:
          0 10px 28px rgba(0, 34, 76, 0.34),
          inset 0 1px 0 rgba(255, 255, 255, 0.16),
          0 0 0 1px rgba(255, 255, 255, 0.35);
      }

      @media (prefers-reduced-motion: reduce) {
        .mobile-sticky-bar {
          animation: none;
          transform: translateY(0);
        }

        .mobile-sticky-bar__cta {
          transition: none;
        }

        .mobile-sticky-bar__cta:active {
          transform: none;
        }
      }

      @media (max-width: 360px) {
        .mobile-sticky-bar__cta {
          width: min(92%, 22rem);
          font-size: 0.82rem;
          padding-left: 0.9rem;
          padding-right: 0.9rem;
        }
      }

      @keyframes slideUp {
        to {
          transform: translateY(0);
        }
      }

      /* HIDE MOBILE BAR ON TABLET / DESKTOP */
      @media (min-width: 769px) {
        .mobile-sticky-bar {
          display: none !important;
        }
      }

      /* Footer clearance for compact sticky CTA + iOS safe area */
      @media (max-width: 768px) {
        footer {
          padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
        }
      }
    </style>
  </body>
</html>
