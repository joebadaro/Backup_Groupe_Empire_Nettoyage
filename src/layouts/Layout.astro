---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EstimationModule from "../components/EstimationModule.astro";
import UiIcon from "../components/icons/UiIcon.astro";
import { PHONES } from "../config/phones";

import SEO from "../components/SEO.astro";

/** Same-origin hashed URLs as @font-face in global CSS — early preload shortens font discovery vs CSS-parse-only */
import interLatinWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import outfitLatinWoff2 from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
/** estimation-bootstrap-lazy.ts est bundlé par Vite en ESM — définit window.openEstimationWidget au chargement */

interface Props {
  title: string;
  description?: string;
  image?: string;
  robots?: string;
}

const { title, image, robots } = Astro.props;

const isEn = Astro.url.pathname.startsWith("/en");
const defaultDescription = isEn
  ? "Professional on-site carpet, upholstery, and mattress cleaning in Greater Montreal, Laval, and the South Shore. Eco-friendly products and truck-mount equipment. We do not pick up rugs for off-site cleaning."
  : "Groupe Nettoyage Empire — nettoyage sur place de tapis, meubles et matelas à Montréal, Laval et sur la Rive-Sud. Pas de ramassage des tapis pour nettoyage en atelier.";

const description = Astro.props.description ?? defaultDescription;

---

<!doctype html>
<html lang={Astro.url.pathname.startsWith("/en") ? "en" : "fr"}>
  <head>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.addEventListener("load", function () {
        if (window.__gtmBootstrapDone) return;
        window.__gtmBootstrapDone = true;
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", "GTM-WWCZZPZ6");
      });
    </script>
    <meta name="version" content="2.0.0-perf-optimized" />
    <!-- Slot tôt : preloads LCP (ex. hero home) avant polices et GTM -->
    <slot name="head" />
    <link
      rel="preload"
      href={interLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      fetchpriority="high"
    />
    <link
      rel="preload"
      href={outfitLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      fetchpriority="low"
    />
    <SEO
      title={title}
      description={description}
      image={image}
      robots={robots}
    />
    {image && <link rel="preload" as="image" href={image} />}
    <!-- Bundled as inline: keeps fade-in + track-visit out of /_astro/Layout*.js (smaller critical bundle) -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        function registerFadeInObserver() {
          var observerOptions = {
            root: null,
            rootMargin: "0px",
            threshold: 0.1,
          };
          var observer = new IntersectionObserver(function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            });
          }, observerOptions);
          document.querySelectorAll(".fade-in-section").forEach(function (section) {
            observer.observe(section);
          });
        }
        if ("requestIdleCallback" in window) {
          requestIdleCallback(registerFadeInObserver, { timeout: 2000 });
        } else {
          setTimeout(registerFadeInObserver, 1);
        }
      });
      window.addEventListener("load", function () {
        var sessionKey = "visit_tracked_sms";
        function run() {
          if (sessionStorage.getItem(sessionKey)) return;
          fetch("/.netlify/functions/track-visit", { method: "POST" })
            .then(function (res) {
              if (!res.ok) console.error("TRACKING FAILED:", res.status);
            })
            .then(function () {
              sessionStorage.setItem(sessionKey, "true");
            })
            .catch(function (err) {
              console.error("Tracking error:", err);
            });
        }
        function schedule() {
          if (sessionStorage.getItem(sessionKey)) return;
          if ("requestIdleCallback" in window) {
            requestIdleCallback(run, { timeout: 20000 });
          } else {
            setTimeout(run, 10000);
          }
        }
        setTimeout(schedule, 4500);
      });
    </script>
  </head>
  <body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WWCZZPZ6"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Global Estimation Module -->
    <EstimationModule />
    <!-- Bootstrap: Astro <script> → bundlé par Vite avec MIME type JS correct (évite data:video/mp2t) -->
    <script>
      import '../scripts/estimation-bootstrap-lazy.ts';
    </script>

    <!-- MOBILE STICKY CTA BAR (Phone Only) -->
    <div class="mobile-sticky-bar">
      <a href={`tel:${PHONES.main.tel}`} class="sticky-btn btn-call">
        <span class="sticky-btn-icon" aria-hidden="true"
          ><UiIcon name="phone" size={18} /></span
        >
        <span class="sticky-btn-label">
          {
            Astro.url.pathname.startsWith("/en")
              ? "Call for Estimate"
              : "Appeler pour une estimation"
          }
        </span>
      </a>
      <button
        type="button"
        onclick="window.openEstimationWidget()"
        class="sticky-btn btn-quote"
      >
        <span class="sticky-btn-icon" aria-hidden="true"
          ><UiIcon name="clipboard" size={18} /></span
        >
        <span class="sticky-btn-label">
          {
            Astro.url.pathname.startsWith("/en")
              ? "Instant Estimate"
              : "Estimation Instantanée"
          }
        </span>
      </button>
    </div>

    <style>
      /* GLOBAL GRADIENT BACKGROUND (Distinct) */
      body {
        /* Clearly visible Blue-Grey to White */
        background: linear-gradient(135deg, #cbdceb 0%, #ffffff 100%);
        background-attachment: fixed;
        min-height: 100vh;
      }

      /* fixed + scroll on iOS/Android often causes parallax/jank; desktop keeps fixed */
      @media (max-width: 768px) {
        body {
          background-attachment: scroll;
        }
      }

      /* MOBILE STICKY BAR — shared FR/EN; dimensions locked so EN matches FR (FR copy often wraps) */
      .mobile-sticky-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: rgba(255, 255, 255, 0.15); /* Modified for transparent effect */
        backdrop-filter: blur(12px);
        box-shadow: none; /* Removed shadow */
        z-index: 9999;
        display: flex;
        align-items: stretch;
        padding: 8px 12px;
        gap: 10px;
        border-top: none; /* Removed white border */
        transform: translateY(100%);
        animation: slideUp 0.5s 1s forwards;
        box-sizing: border-box;
      }

      .mobile-sticky-bar .sticky-btn {
        flex: 1;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 3.5rem; /* matches ~2 lines FR labels + padding */
        padding: 10px 12px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.85rem;
        line-height: 1.2;
        text-decoration: none;
        text-align: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-sizing: border-box;
        font-family: inherit;
        cursor: pointer;
        -webkit-appearance: none;
        appearance: none;
        margin: 0;
      }

      .mobile-sticky-bar .sticky-btn-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        opacity: 0.95;
      }

      .mobile-sticky-bar .sticky-btn-label {
        flex: 1;
        min-width: 0;
        display: block;
        text-align: center;
        line-height: 1.2;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      .mobile-sticky-bar .sticky-btn:active {
        transform: scale(0.96);
      }

      /* BLUE BUTTON (Call) */
      .btn-call {
        background: linear-gradient(
          135deg,
          #001f3f 0%,
          #004a9f 100%
        ); /* Empire Blue Gradient */
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(0, 31, 63, 0.4);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
      }

      /* RED BUTTON (Quote) */
      .btn-quote {
        background: linear-gradient(
          135deg,
          #8b0000 0%,
          #ff5252 100%
        ); /* Rich Red Gradient */
        color: #ffffff !important; /* White Text */
        box-shadow: 0 4px 12px rgba(183, 28, 28, 0.4);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
      }

      @keyframes slideUp {
        to {
          transform: translateY(0);
        }
      }

      /* HIDE MOBILE BAR ON DESKTOP */
      @media (min-width: 768px) {
        .mobile-sticky-bar {
          display: none !important;
        }
      }

      /* Adjust footer so it doesn't get covered (sticky bar min-height aligned FR/EN) */
      @media (max-width: 767px) {
        footer {
          padding-bottom: 80px;
        }
      }
    </style>
  </body>
</html>
