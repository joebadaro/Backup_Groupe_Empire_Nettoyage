---
/**
 * Maillage interne léger pour les pages tapis locales : autres services assurés par la même entreprise.
 */
interface Props {
  locale?: "fr" | "en";
  /** Sur la page « tapis commercial » : dernier lien pointe vers le tapis résidentiel (évite l’auto-lien). */
  commercialPage?: boolean;
}

const { locale = "fr", commercialPage = false } = Astro.props;
const p = locale === "en" ? "/en" : "";

const copy =
  locale === "en"
    ? {
        title: "Other services in this area",
        lead:
          "We also offer the following services, with the same booking process:",
        fabric: "Fabric upholstery cleaning (sofas, chairs, etc.)",
        leather: "Leather upholstery cleaning",
        mattress: "Mattress cleaning & disinfection",
        fourthDefault: "Commercial carpet cleaning",
        fourthAlt: "Residential carpet cleaning",
      }
    : {
        title: "Autres services dans ce secteur",
        lead: "Sur la même prise de rendez-vous, nous proposons aussi :",
        fabric: "Nettoyage de meubles en tissu (divans, fauteuils, etc.)",
        leather: "Nettoyage de meubles en cuir",
        mattress: "Nettoyage et désinfection de matelas",
        fourthDefault: "Nettoyage de tapis commercial",
        fourthAlt: "Nettoyage de tapis résidentiel",
      };
---

<div class="local-cross-links fade-in-section">
  <h3 class="local-cross-links__title">{copy.title}</h3>
  <p class="local-cross-links__lead">{copy.lead}</p>
  <ul class="local-cross-links__list">
    <li>
      <a href={`${p}/services/meubles-tissu`}>{copy.fabric}</a>
    </li>
    <li>
      <a href={`${p}/services/meubles-cuir`}>{copy.leather}</a>
    </li>
    <li>
      <a href={`${p}/services/nettoyage-desinfection-matelas`}>{copy.mattress}</a>
    </li>
    <li>
      {
        commercialPage ? (
          <a href={`${p}/services/nettoyage-tapis-residentiel`}>
            {copy.fourthAlt}
          </a>
        ) : (
          <a href={`${p}/services/nettoyage-tapis-commercial`}>
            {copy.fourthDefault}
          </a>
        )
      }
    </li>
  </ul>
</div>

<style>
  .local-cross-links {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    padding: 1.25rem 1.5rem;
    background: #f8f9fa;
    border-left: 4px solid var(--color-accent, #c5a065);
    border-radius: 8px;
  }
  .local-cross-links__title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: var(--color-primary);
  }
  .local-cross-links__lead {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #555;
  }
  .local-cross-links__list {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.65;
    color: var(--color-text-light, #555);
  }
  .local-cross-links__list a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
