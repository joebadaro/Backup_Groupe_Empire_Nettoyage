---
// src/components/EstimationModule.astro
import UiIcon from "./icons/UiIcon.astro";
---

<!-- Main Container (Overlay) -->

<div id="estimation-widget" class="modal-overlay" style="display:none;">
    <div class="empire-modal">
        <!-- === LEFT: MAIN PROCESS === -->
        <div class="modal-main">
            <!-- Header -->
            <header class="modal-header">
                <h2 id="modal-title">Estimation Gratuite</h2>
                <div class="header-actions">
                    <button id="lang-toggle" class="lang-btn">EN</button>
                    <button
                        id="close-modal-btn"
                        class="close-btn"
                        aria-label="Fermer"
                        title="Fermer">&times;</button
                    >
                </div>
            </header>

            <!-- Progress -->
            <div class="progress-bar">
                <div
                    id="progress-fill"
                    class="progress-fill"
                    style="width: 25%"
                >
                </div>
            </div>

            <!-- Content Area -->
            <div class="modal-content">
                <!-- STEP 1: SERVICES -->
                <div id="step-services" class="step active">
                    <h3 id="txt-choose-services" class="text-center mb-2">Choisissez vos services</h3>
                    <div class="welcome-banner">
                        <div class="welcome-banner-icon">&#x1F3F7;&#xFE0F;</div>
                        <div class="welcome-banner-text">
                            <h3 id="txt-get-immediate">Obtenez votre estimation immédiate</h3>
                            <p id="txt-select-below">
                                Sélectionnez les services ci-dessous pour voir
                                les tarifs et obtenir un prix approximatif pour
                                vos besoins.
                            </p>
                        </div>
                    </div>
                    <div id="services-container" class="service-grid"></div>
                </div>

                <!-- STEP 2: DETAILS -->
                <div id="step-details" class="step">
                    <button
                        class="btn-text"
                        id="btn-back-to-services"
                        style="margin-bottom:10px; cursor:pointer;"
                        title="Retour">← Retour aux services</button
                    >
                    <h3 class="text-center">Détails de sélection</h3>
                    <div id="details-container"></div>
                </div>

                <!-- STEP 3: REVIEW SUMMARY (NEW) -->
                <div id="step-summary" class="step">
                    <h3 class="text-center">Vérifiez votre commande</h3>
                    <p class="text-center text-muted">
                        Veuillez revoir les articles sélectionnés avant de
                        finaliser.
                    </p>
                    <div
                        id="summary-container"
                        style="max-height: 400px; overflow-y: auto; margin: 20px 0; border: 1px solid #eee; border-radius: 8px; padding: 15px;"
                    >
                        <!-- Comprehensive List Injected Here via renderSummaryPage() -->
                    </div>
                </div>

                <!-- STEP 4: CONTACT FORM (Previously Step 3) -->
                <div id="step-contact" class="step">
                    <div id="desktop-contact-intro">
                        <h3 class="text-center" style="margin-bottom:10px;">
                            Recevoir votre estimation
                        </h3>
                        <p
                            class="text-center"
                            style="color:#666; font-size:0.95rem; margin-bottom:25px;"
                        >
                            Choisissez comment recevoir votre <strong
                                >estimation gratuite</strong
                            >
                        </p>
                    </div>

                    <div id="quote-message-container" style="display:none; background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); padding:15px; border-radius:8px; margin-bottom:20px; color:#1b5e20; font-size:0.95rem; line-height:1.5; border-left:5px solid #43a047;"></div>

                    <form
                        id="contact-form"
                        style="max-width:500px; margin:0 auto;"
                    >
                        <!-- Delivery Method Toggle -->
                        <div style="margin-bottom:25px;">
                            <label
                                style="display:block; font-weight:600; margin-bottom:12px; color:#333;"
                                id="lbl-delivery-method"
                                >Recevoir mon estimation par</label
                            >
                            <div
                                style="display:flex; gap:12px; background:#f5f5f5; padding:6px; border-radius:12px;"
                            >
                                <label
                                    style="flex:1; text-align:center; padding:12px; border-radius:8px; cursor:pointer; transition:all 0.3s; background:white; font-weight:600; color:#1a237e; box-shadow:0 2px 8px rgba(0,0,0,0.1);"
                                    id="label-sms"
                                >
                                    <input
                                        type="radio"
                                        name="delivery"
                                        value="sms"
                                        checked
                                        style="display:none;"
                                    />
                                    <i class="fas fa-sms" style="margin-right:6px;"></i> Texto
                                </label>
                                <label
                                    style="flex:1; text-align:center; padding:12px; border-radius:8px; cursor:pointer; transition:all 0.3s; background:transparent; font-weight:500; color:#666;"
                                    id="label-email"
                                >
                                    <input
                                        type="radio"
                                        name="delivery"
                                        value="email"
                                        style="display:none;"
                                    />
                                    <i class="fas fa-envelope" style="margin-right:6px;"></i> Courriel
                                </label>
                                <!-- Phone Option Removed -->
                            </div>
                            <p id="quote-delivery-info" style="display:none; margin-top:8px; font-size:0.85rem; color:#666; font-style:italic;">
                                Un membre de notre équipe vous contactera s'il a besoin de plus d'information.
                            </p>
                        </div>

                        <!-- Form Fields -->
                        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px 16px;">
                            <div style="grid-column: 1 / -1;">
                                <label
                                    style="display:none; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    id="label-company"
                                    >Nom de l'entreprise *</label
                                >
                                <input
                                    type="text"
                                    id="input-company"
                                    placeholder="Nom de votre entreprise"
                                    style="display:none; width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s; margin-bottom:15px;"
                                    onfocus="this.style.borderColor='#3949ab'; this.style.boxShadow='0 0 0 3px rgba(57,73,171,0.1)'"
                                    onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none'"
                                />

                                <label
                                    style="display:block; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    id="label-name-text"
                                    >Nom complet / Compagnie *</label
                                >
                                <input
                                    type="text"
                                    id="input-name"
                                    required
                                    placeholder="Votre nom ou entreprise"
                                    style="width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s;"
                                    onfocus="this.style.borderColor='#3949ab'; this.style.boxShadow='0 0 0 3px rgba(57,73,171,0.1)'"
                                    onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none'"
                                />
                            </div>

                            <div id="field-phone">
                                <label
                                    id="label-phone-text"
                                    style="display:block; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    >Téléphone (mobile pour SMS) *</label
                                >
                                <input
                                    type="tel"
                                    id="input-phone"
                                    required
                                    placeholder="514-555-1234"
                                    style="width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s;"
                                    onfocus="this.style.borderColor='#3949ab'; this.style.boxShadow='0 0 0 3px rgba(57,73,171,0.1)'"
                                    onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none'"
                                />
                            </div>

                            <div id="field-email" style="display:none;">
                                <label
                                    style="display:block; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    >Adresse courriel *</label
                                >
                                <input
                                    type="email"
                                    id="input-email"
                                    placeholder="exemple@email.com"
                                    style="width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s;"
                                    onfocus="this.style.borderColor='#3949ab'; this.style.boxShadow='0 0 0 3px rgba(57,73,171,0.1)'"
                                    onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none'"
                                />
                            </div>

                            <div>
                                <label
                                    style="display:block; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    >Adresse (Rue & Numéro)</label
                                >
                                <input
                                    type="text"
                                    id="input-street"
                                    placeholder="Ex: 1234 Rue Principale"
                                    style="width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s;"
                                />
                            </div>
                            <div>
                                <label
                                    style="display:block; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    >Apt / Unité</label
                                >
                                <input
                                    type="text"
                                    id="input-apt"
                                    placeholder="101"
                                    style="width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s;"
                                />
                            </div>
                            <div>
                                <label
                                    style="display:block; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    >Ville *</label
                                >
                                <input
                                    type="text"
                                    id="input-city"
                                    required
                                    placeholder="Montréal"
                                    style="width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s;"
                                    onfocus="this.style.borderColor='#3949ab'; this.style.boxShadow='0 0 0 3px rgba(57,73,171,0.1)'"
                                    onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none'"
                                />
                            </div>
                            <div>
                                <label
                                    style="display:block; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    >Code Postal</label
                                >
                                <input
                                    type="text"
                                    id="input-postal"
                                    placeholder="H1A 1A1"
                                    style="width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s;"
                                />
                            </div>

                            <div style="grid-column: 1 / -1;">
                                <label
                                    style="display:block; font-weight:600; margin-bottom:6px; color:#333; font-size:0.9rem;"
                                    >Notes (Code de porte, accès, demande spéciale, horaire...)</label
                                >
                                <textarea
                                    id="input-notes"
                                    rows="2"
                                    placeholder="Précisez ici si vous avez un code de porte, une demande spéciale ou des contraintes d'horaire."
                                    style="width:100%; padding:10px; border:2px solid #e0e0e0; border-radius:8px; font-size:0.95rem; transition:all 0.3s; resize:vertical; font-family:inherit;"
                                    onfocus="this.style.borderColor='#3949ab'; this.style.boxShadow='0 0 0 3px rgba(57,73,171,0.1)'"
                                    onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none'"
                                ></textarea>
                                <p id="quote-notes-instruction" style="display:none; font-size:0.85rem; color:#555; margin-top:5px; line-height:1.4; background:#f9f9f9; padding:8px; border-radius:6px; border-left:3px solid #1a237e;"></p>
                            </div>
                            
                            <div id="desktop-callback-request" style="grid-column: 1 / -1; margin-top:5px;">
                                <label style="display:block; font-weight:600; margin-bottom:8px; color:#333; font-size:0.9rem;">
                                    Souhaitez-vous que nous vous rappelions pour planifier un rendez-vous ? *
                                </label>
                                <div style="display:flex; gap:20px; align-items:center;">
                                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                        <input type="radio" name="callback-request" value="yes" required style="width:18px; height:18px; cursor:pointer;">
                                        <span style="font-size:0.95rem;">Oui</span>
                                    </label>
                                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                        <input type="radio" name="callback-request" value="no" required style="width:18px; height:18px; cursor:pointer;">
                                        <span style="font-size:0.95rem;">Non</span>
                                    </label>
                                </div>
                        </div>
                        </div>
                    </form>
                </div>

                <p
                    style="text-align:center; font-size:0.85rem; color:#999; margin-top:15px;"
                >
                    Vos informations sont confidentielles et sécurisées
                </p>
            </div>

            <!-- Footer for Nav -->
            <footer class="modal-footer">
                <button
                    id="btn-back"
                    class="btn btn-secondary hidden"
                    style="border:none; color:#777;">Retour en arrière</button
                >
                <button
                    id="btn-add-more"
                    class="btn hidden"
                    style="background: linear-gradient(90deg, #1a1a1a 0%, #0d47a1 100%); color: white; border: none; box-shadow: 0 4px 15px rgba(13, 71, 161, 0.3);"
                    >← Retour</button
                >
                <button
                    id="btn-next"
                    class="btn btn-primary"
                    style="width:auto;">Continuer</button
                >
            </footer>
        </div>

        <!-- === RIGHT: STICKY SIDEBAR === -->
        <div class="modal-sidebar">
            <div class="cart-title">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span id="txt-my-selection">Ma Sélection</span>
                    <button
                        onclick="resetEstimation()"
                        id="btn-app-reset"
                        style="background:none; border:1px solid #ddd; border-radius:4px; font-size:0.7rem; cursor:pointer; padding:2px 6px; color:#666;"
                        title="Tout effacer / Reset all"
                    >
                        Recommencer ↺
                    </button>
                </div>
                <span
                    style="font-size:0.8rem; background:#EEE; padding:2px 6px; border-radius:10px;"
                    id="cart-count">0 items</span
                >
            </div>

            <div id="cart-list" class="cart-list">
                <!-- Items appear here -->
                <div style="text-align:center; color:#999; margin-top:50px;">
                    Votre panier est vide.
                </div>
            </div>

            <!-- Promo Messages Space -->
            <div id="promo-message-area" style="margin-bottom:10px;"></div>

            <!-- Total Block -->
            <div class="cart-total-block">
                <!-- Subtotal Restored for Logic Visibility -->
                <div style="display:flex; justify-content:center; gap:10px; margin-bottom:5px; font-size:0.9rem; opacity:0.8; display:none;" id="subtotal-row">
                    <span>Articles:</span>
                    <span id="live-subtotal">0.00$</span>
                </div>

                <div class="cart-total-label">Total Estimé</div>
                <div id="live-total" class="cart-live-total">$0.00</div>
                <button
                    id="btn-toggle-details"
                    type="button"
                    style="display:none; margin-left:10px; font-size:0.9rem; background:none; border:none; text-decoration:underline; cursor:pointer; color:#007bff; font-weight:600;"
                >
                    Voir détails &#9650;
                </button>
                <!-- Warning Message (Min Order) inserted here -->
                <div
                    id="min-msg-sidebar"
                    style="font-size:0.8rem; margin-top:5px; display:none;"
                >
                </div>
            </div>

            <div
                style="text-align:center; font-size:0.7rem; color:#999; margin-top:10px;"
            >
                Taxes en sus.
            </div>
        </div>

        <button
            id="close-modal-btn-overlay"
            class="close-btn"
            aria-label="Fermer"
            style="position: absolute; top: -15px; right: -15px; background: white; border-radius: 50%; width: 30px; height: 30px; border: 1px solid #ccc; cursor:pointer;"
            >&times;</button
        >

        <!-- === MOBILE OPTIMIZED VIEW (New) === -->
        <div
            id="mobile-estimation-view"
            class="mobile-app-view"
            style="display:none;"
        >
            <header class="mobile-app-header">
                <div class="mobile-header-left">
                    <h2 id="mobile-title">Estimation</h2>
                </div>
                <button id="mobile-close-btn" class="mobile-close-btn" aria-label="Fermer"
                    >&times;</button
                >
            </header>

            <div id="mobile-scroll-container" class="mobile-app-content">
                <!-- Persistent Commercial Message (Mobile) -->
                <div id="mobile-persistent-commercial-msg" style="display:none; background: linear-gradient(180deg, #dcedc8 0%, #ffffff 100%); padding:20px; border-radius:12px; margin: 15px 15px 25px 15px; border:1px solid #c5e1a5; box-shadow:0 4px 10px rgba(0,0,0,0.05); text-align:center;">
                    <div style="color:#2e7d32; font-weight:700; font-size:1rem; margin-bottom:10px;">
                        <span style="display:block; margin-bottom:8px; color:#2e7d32;" aria-hidden="true"
                            ><UiIcon name="check" size={24} /></span
                        >
                        <span class="msg-title"></span>
                    </div>
                    <div class="msg-desc" style="font-size:0.9rem; color:#558b2f; line-height:1.5;"></div>
                    <div style="margin-top:15px; font-weight:800; color:#1b5e20; font-family:var(--font-heading); text-transform:uppercase;">
                        Groupe Nettoyage Empire
                    </div>
                </div>
                <!-- Step 1: Mobile Services List -->
                <div id="mobile-step-services" class="mobile-step active">
                    <div class="mobile-welcome">
                        <h3 id="mobile-txt-choose">Sélectionnez vos services</h3>
                        <p id="mobile-txt-touch">Touchez pour ajouter à l'estimation.</p>
                    </div>
                    <div id="mobile-services-list" class="mobile-list"></div>
                </div>

                <!-- Step 2: Mobile Details -->
                <div id="mobile-step-details" class="mobile-step">
                    <div class="mobile-step-header">
                        <button id="mobile-back-btn" class="mobile-back-link"
                            >← Retour</button
                        >
                        <h3 id="mobile-header-details">Détails</h3>
                    </div>
                    <div id="mobile-details-container"></div>
                </div>

                <!-- Step 3: Mobile Review Summary (NEW) -->
                <div id="mobile-step-summary-view" class="mobile-step">
                    <div class="mobile-step-header">
                        <button
                            id="mobile-back-btn-review"
                            class="mobile-back-link">← Retour</button
                        >
                        <h3 id="mobile-header-summary">Sommaire</h3>
                    </div>
                    <div id="mobile-summary-container" style="padding: 10px;">
                    </div>
                </div>

                <!-- Step 4: Mobile Form (Previously Step 3) -->
                <div id="mobile-step-contact" class="mobile-step">
                    <div class="mobile-step-header">
                        <button
                            id="mobile-back-btn-contact"
                            class="mobile-back-link">← Retour</button
                        >
                        <h3 id="mobile-header-finalize">Finaliser</h3>
                    </div>
                    <div style="padding-top:10px;">
                        <p id="mobile-txt-enter-info" style="margin-bottom:20px; color:#666;">
                            Entrez vos infos pour recevoir la soumission.
                        </p>
                        
                        <!-- Mobile Quote Message -->
                        <div id="mobile-quote-message-container" style="display:none; background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); padding:12px; border-radius:10px; margin-bottom:20px; color:#1b5e20; font-size:0.9rem; line-height:1.4; border-left:4px solid #43a047;"></div>

                        <!-- Mobile Form Container -->
                        <div id="mobile-contact-form-container">
                            <div class="mobile-form-wrapper">
                                <!-- Mobile Delivery Toggle -->
                                <div style="margin-bottom:20px;">
                                    <label
                                        id="mobile-lbl-delivery-method"
                                        style="display:block; font-weight:600; margin-bottom:10px; color:#333; font-size:0.95rem;"
                                        >Recevoir mon estimation par</label
                                    >
                                    <div
                                        style="display:flex; gap:10px; background:#f5f5f5; padding:5px; border-radius:12px;"
                                    >
                                        <label
                                            style="flex:1; text-align:center; padding:12px; border-radius:10px; transition:all 0.3s; background:white; font-weight:600; color:#1a237e; box-shadow:0 2px 5px rgba(0,0,0,0.05);"
                                            id="mobile-label-sms"
                                        >
                                            <input
                                                type="radio"
                                                name="mobile-delivery"
                                                value="sms"
                                                checked
                                                style="display:none;"
                                            />
                                            <span>SMS</span>
                                        </label>
                                        <label
                                            style="flex:1; text-align:center; padding:12px; border-radius:10px; transition:all 0.3s; background:transparent; font-weight:500; color:#666;"
                                            id="mobile-label-email"
                                        >
                                            <input
                                                type="radio"
                                                name="mobile-delivery"
                                                value="email"
                                                style="display:none;"
                                            />
                                            <span>Courriel</span>
                                        </label>
                                        <!-- Phone Option Removed -->
                                    </div>
                                    <p id="mobile-quote-delivery-info" style="display:none; margin-top:8px; font-size:0.85rem; color:#666; font-style:italic;">
                                        Un membre de notre équipe vous contactera s'il a besoin de plus d'information.
                                    </p>
                                </div>

                                <div style="display:grid; gap:12px;">
                                    <input
                                        type="text"
                                        id="mobile-input-company"
                                        placeholder="Nom de l'entreprise *"
                                        aria-label="Nom de l'entreprise *"
                                        class="mobile-input"
                                        style="display:none; width:100%; padding:14px; border:1px solid #ddd; border-radius:10px; font-size:1rem;"
                                    />

                                    <input
                                        type="text"
                                        id="mobile-input-name"
                                        placeholder="Nom complet *"
                                        aria-label="Nom complet *"
                                        class="mobile-input"
                                        style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px; font-size:1rem;"
                                    />

                                    <div id="mobile-field-phone">
                                        <input
                                            type="tel"
                                            id="mobile-input-phone"
                                            placeholder="Téléphone (mobile pour SMS) *"
                                            aria-label="Téléphone (mobile pour SMS) *"
                                            class="mobile-input"
                                            style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px; font-size:1rem;"
                                        />
                                    </div>

                                    <div
                                        id="mobile-field-email"
                                        style="display:none;"
                                    >
                                        <input
                                            type="email"
                                            id="mobile-input-email"
                                            placeholder="Adresse courriel *"
                                            aria-label="Adresse courriel *"
                                            class="mobile-input"
                                            style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px; font-size:1rem;"
                                        />
                                    </div>

                                    <div
                                        style="display:grid; grid-template-columns: 2fr 1fr; gap:12px; margin-bottom:12px;"
                                    >
                                        <input
                                            type="text"
                                            id="mobile-input-street"
                                            placeholder="Adresse (Rue/No)"
                                            aria-label="Adresse (Rue/No)"
                                            class="mobile-input"
                                            style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px; font-size:1rem;"
                                        />
                                        <input
                                            type="text"
                                            id="mobile-input-apt"
                                            placeholder="Apt"
                                            aria-label="Apt"
                                            class="mobile-input"
                                            style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px; font-size:1rem;"
                                        />
                                    </div>
                                    <input
                                        type="text"
                                        id="mobile-input-city"
                                        placeholder="Ville *"
                                        aria-label="Ville *"
                                        class="mobile-input"
                                        style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px; font-size:1rem; margin-bottom:12px;"
                                    />
                                    
                                    <input
