---
import {
  getPresentationVideo,
  PRESENTATION_POSTER_HEIGHT,
  PRESENTATION_POSTER_WIDTH,
  type PresentationLocale,
} from "../data/presentationVideos";

export interface Props {
  locale: PresentationLocale;
}

const { locale } = Astro.props;
const video = getPresentationVideo(locale);
const { homeTeaser } = video;
const thumbWidth = 200;
const thumbHeight = Math.round((thumbWidth * PRESENTATION_POSTER_HEIGHT) / PRESENTATION_POSTER_WIDTH);
---

<section
  class="presentation-home-teaser fade-in-section"
  aria-labelledby="presentation-home-teaser-title"
>
  <div class="container">
    <a
      href={video.presentationHref}
      class="presentation-home-teaser__card"
      aria-label={`${homeTeaser.button} — ${homeTeaser.duration}`}
    >
      <div class="presentation-home-teaser__media">
        <img
          src={video.posterUrl}
          alt={video.posterAlt}
          class="presentation-home-teaser__thumb"
          width={thumbWidth}
          height={thumbHeight}
          loading="lazy"
          decoding="async"
        />
        <span class="presentation-home-teaser__play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </span>
      </div>
      <div class="presentation-home-teaser__body">
        <h2 id="presentation-home-teaser-title" class="presentation-home-teaser__title">
          {homeTeaser.title}
        </h2>
        <p class="presentation-home-teaser__text">{homeTeaser.text}</p>
        <p class="presentation-home-teaser__duration">{homeTeaser.duration}</p>
        <span class="btn btn-primary presentation-home-teaser__btn">{homeTeaser.button}</span>
      </div>
    </a>
  </div>
</section>

<style>
  .presentation-home-teaser {
    padding: 1.15rem 0 1.35rem;
    background: linear-gradient(180deg, #f4f8fd 0%, #fafcfe 100%);
  }

  /*
   * Desktop : la bande trust du hero est position:absolute (top:100%, margin-top:-52px)
   * et déborde sous .hero-section sans réserver d'espace dans le flux.
   * Marge explicite pour éviter que la carte vidéo remonte sous « Excellence reconnue ».
   */
  @media (min-width: 769px) {
    .presentation-home-teaser {
      margin-top: 5rem;
      padding-top: 0.75rem;
    }
  }

  .presentation-home-teaser__card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: center;
    max-width: 920px;
    margin-inline: auto;
    padding: clamp(1rem, 2vw, 1.35rem) clamp(1rem, 2.5vw, 1.5rem);
    background: #ffffff;
    border: 1px solid rgba(0, 59, 122, 0.1);
    border-radius: 16px;
    box-shadow:
      0 10px 28px rgba(0, 31, 63, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.9) inset;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .presentation-home-teaser__card:hover {
      transform: translateY(-2px);
      border-color: rgba(0, 59, 122, 0.16);
      box-shadow:
        0 14px 34px rgba(0, 31, 63, 0.12),
        0 1px 0 rgba(255, 255, 255, 0.9) inset;
    }
  }

  .presentation-home-teaser__media {
    position: relative;
    width: min(200px, 34vw);
    aspect-ratio: 9 / 16;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 6px 18px rgba(0, 31, 63, 0.14);
  }

  .presentation-home-teaser__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .presentation-home-teaser__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(0, 20, 50, 0.04), rgba(0, 20, 50, 0.38));
    color: #fff;
    pointer-events: none;
  }

  .presentation-home-teaser__play svg {
    width: 44px;
    height: 44px;
    padding: 11px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    margin-left: 2px;
  }

  .presentation-home-teaser__body {
    min-width: 0;
  }

  .presentation-home-teaser__title {
    margin: 0 0 0.55rem;
    font-size: clamp(1.25rem, 2.1vw, 1.65rem);
    line-height: 1.25;
    color: var(--color-primary, #003b7a);
  }

  .presentation-home-teaser__text {
    margin: 0 0 0.5rem;
    max-width: 36rem;
    line-height: 1.55;
    color: #3d4f63;
    font-size: clamp(0.95rem, 1.05vw, 1.02rem);
  }

  .presentation-home-teaser__duration {
    margin: 0 0 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #64748b;
  }

  .presentation-home-teaser__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .presentation-home-teaser {
      padding: 0.85rem 0 1rem;
    }

    .presentation-home-teaser__card {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 1rem 1rem 1.1rem;
      gap: 0.85rem;
    }

    .presentation-home-teaser__media {
      width: min(132px, 38vw);
      margin-inline: auto;
    }

    .presentation-home-teaser__text {
      margin-inline: auto;
    }

    .presentation-home-teaser__btn {
      display: flex;
      width: 100%;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .presentation-home-teaser__card {
      transition: none;
    }
  }
</style>
