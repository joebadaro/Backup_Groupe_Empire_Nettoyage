---
import {
  getPresentationVideo,
  type PresentationLocale,
} from "../data/presentationVideos";

export interface Props {
  locale: PresentationLocale;
}

const { locale } = Astro.props;
const video = getPresentationVideo(locale);
const { homeTeaser } = video;
---

<section class="section presentation-home-teaser fade-in-section" aria-labelledby="presentation-home-teaser-title">
  <div class="container presentation-home-teaser__inner">
    <div class="presentation-home-teaser__copy">
      <h2 id="presentation-home-teaser-title" class="presentation-home-teaser__title">
        {homeTeaser.title}
      </h2>
      <p class="presentation-home-teaser__text">{homeTeaser.text}</p>
      <a href={video.presentationHref} class="btn btn-primary presentation-home-teaser__btn">
        {homeTeaser.button}
      </a>
    </div>
    <a
      href={video.presentationHref}
      class="presentation-home-teaser__thumb-link"
      aria-label={`${homeTeaser.button} : ${video.title}`}
    >
      <img
        src={video.posterUrl}
        alt={`Aperçu : ${video.title}`}
        class="presentation-home-teaser__thumb"
        width={180}
        height={320}
        loading="lazy"
        decoding="async"
      />
      <span class="presentation-home-teaser__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  .presentation-home-teaser {
    padding: 2.5rem 0 2.75rem;
    background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
    border-top: 1px solid rgba(0, 59, 122, 0.06);
    border-bottom: 1px solid rgba(0, 59, 122, 0.06);
  }

  .presentation-home-teaser__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.75rem;
    align-items: center;
    max-width: 980px;
  }

  .presentation-home-teaser__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    color: var(--color-primary, #003b7a);
  }

  .presentation-home-teaser__text {
    margin: 0 0 1.25rem;
    max-width: 42rem;
    line-height: 1.6;
    color: #3d4f63;
  }

  .presentation-home-teaser__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .presentation-home-teaser__thumb-link {
    position: relative;
    display: block;
    width: min(180px, 34vw);
    aspect-ratio: 9 / 16;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(0, 31, 63, 0.16);
    flex-shrink: 0;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .presentation-home-teaser__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .presentation-home-teaser__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(0, 20, 50, 0.05), rgba(0, 20, 50, 0.42));
    color: #fff;
  }

  .presentation-home-teaser__play svg {
    width: 48px;
    height: 48px;
    padding: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.22);
    margin-left: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .presentation-home-teaser__thumb-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 32px rgba(0, 31, 63, 0.2);
    }
  }

  @media (max-width: 768px) {
    .presentation-home-teaser__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .presentation-home-teaser__text {
      margin-inline: auto;
    }

    .presentation-home-teaser__thumb-link {
      width: min(160px, 46vw);
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .presentation-home-teaser__thumb-link {
      transition: none;
    }
  }
</style>
