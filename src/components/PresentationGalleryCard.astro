---
interface Props {
  href: string;
  title: string;
  posterUrl: string;
  aspectRatio?: string;
  linkLabel?: string;
  badgeText?: string;
}

const {
  href,
  title,
  posterUrl,
  aspectRatio = "9/16",
  linkLabel = "page de présentation",
  badgeText = "Voir la présentation",
} = Astro.props;
---

<a
  href={href}
  class="presentation-gallery-card"
  style={`--aspect: ${aspectRatio};`}
  aria-label={`${title} — ${linkLabel}`}
>
  <img
    src={posterUrl}
    alt={`Aperçu : ${title}`}
    loading="lazy"
    class="presentation-gallery-card__poster"
    width={360}
    height={640}
    decoding="async"
  />
  <span class="presentation-gallery-card__overlay" aria-hidden="true">
    <span class="presentation-gallery-card__badge">{badgeText}</span>
  </span>
</a>

<style>
  .presentation-gallery-card {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    max-height: 75vh;
    margin: 0 auto;
    aspect-ratio: var(--aspect);
    background-color: #080d14;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    touch-action: manipulation;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .presentation-gallery-card:hover,
    .presentation-gallery-card:focus-visible {
      transform: translateY(-4px);
      box-shadow: 0 16px 35px rgba(0, 31, 63, 0.25);
      outline: none;
    }
  }

  .presentation-gallery-card__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .presentation-gallery-card:hover .presentation-gallery-card__poster {
      opacity: 0.75;
      transform: scale(1.02);
    }
  }

  .presentation-gallery-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .presentation-gallery-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: calc(100% - 1.5rem);
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: rgba(0, 59, 122, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-align: center;
    line-height: 1.25;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .presentation-gallery-card:hover .presentation-gallery-card__badge {
      background: rgba(240, 193, 75, 0.95);
      color: #1a2a3a;
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .presentation-gallery-card,
    .presentation-gallery-card__poster,
    .presentation-gallery-card__badge {
      transition: none;
    }
  }
</style>
