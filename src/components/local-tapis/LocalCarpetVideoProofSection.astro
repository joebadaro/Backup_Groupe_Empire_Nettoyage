---
import ServiceVideoProof from "../ServiceVideoProof.astro";
import type { Props as ServiceVideoProofProps } from "../ServiceVideoProof.astro";

export interface Props extends ServiceVideoProofProps {}

const props = Astro.props;
---

<section class="section local-carpet-proof-section" aria-label="Vidéo de démonstration">
  <div class="local-carpet-proof-section__inner">
    <ServiceVideoProof {...props} />
  </div>
</section>

<style is:global>
  /* Pilote Brossard — section vidéo locale (n’affecte pas les autres pages) */

  .local-carpet-proof-section.section {
    padding: 1rem 1.25rem 1.35rem;
    overflow-x: clip;
    background: transparent;
  }

  .local-carpet-proof-section__inner {
    width: 100%;
    max-width: 980px;
    margin-inline: auto;
    padding-inline: clamp(0.75rem, 2vw, 1.25rem);
    box-sizing: border-box;
  }

  .local-carpet-proof-section .service-video-proof {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    width: 100% !important;
    max-width: 940px !important;
    margin-inline: auto !important;
  }

  .local-carpet-proof-section .service-video-proof--vertical .svp-card {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) clamp(220px, 24vw, 250px) !important;
    gap: 1.5rem !important;
    align-items: center !important;
    max-width: 940px !important;
    width: 100% !important;
    margin-inline: auto !important;
    padding: 1.25rem 1.4rem !important;
    min-height: 0 !important;
    height: auto !important;
    box-sizing: border-box !important;
  }

  .local-carpet-proof-section .svp-content {
    min-width: 0 !important;
    max-width: 560px !important;
    align-self: center !important;
    justify-self: start !important;
    padding: 0 !important;
  }

  .local-carpet-proof-section .svp-eyebrow {
    margin: 0 0 0.4rem !important;
    font-size: 0.8rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    line-height: 1.3 !important;
  }

  .local-carpet-proof-section .svp-title {
    margin: 0 0 0.65rem !important;
    font-size: clamp(1.6rem, 2.4vw, 1.85rem) !important;
    line-height: 1.22 !important;
    font-weight: 700 !important;
  }

  .local-carpet-proof-section .svp-desc {
    margin: 0 0 1rem !important;
    font-size: clamp(1rem, 1.1vw, 1.08rem) !important;
    line-height: 1.5 !important;
    max-width: 560px !important;
    color: #3d4f63 !important;
  }

  .local-carpet-proof-section .svp-actions {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.65rem !important;
    align-items: center !important;
    margin: 0 !important;
  }

  .local-carpet-proof-section .svp-actions .btn {
    padding: 0.65rem 1.1rem !important;
    font-size: 0.95rem !important;
    line-height: 1.25 !important;
  }

  .local-carpet-proof-section .service-video-proof--vertical .svp-thumb {
    width: clamp(220px, 24vw, 250px) !important;
    max-width: 250px !important;
    min-width: 220px !important;
    min-height: 0 !important;
    max-height: none !important;
    height: auto !important;
    aspect-ratio: 9 / 16 !important;
    justify-self: end !important;
    align-self: center !important;
    flex-shrink: 0 !important;
    margin: 0 !important;
    border-radius: 12px !important;
  }

  .local-carpet-proof-section .svp-thumb-img {
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    object-fit: cover !important;
    object-position: center center !important;
  }

  @media (max-width: 900px) {
    .local-carpet-proof-section.section {
      padding: 0.85rem 1rem 1.15rem;
    }

    .local-carpet-proof-section__inner {
      padding-inline: 0.85rem;
    }

    .local-carpet-proof-section .service-video-proof--vertical .svp-card {
      grid-template-columns: 1fr !important;
      gap: 1.15rem !important;
      padding: 1.1rem 1.15rem !important;
    }

    .local-carpet-proof-section .svp-content {
      order: 1 !important;
      max-width: none !important;
    }

    .local-carpet-proof-section .service-video-proof--vertical .svp-thumb {
      order: 2 !important;
      width: min(230px, 72vw) !important;
      max-width: 230px !important;
      min-width: 0 !important;
      margin-inline: auto !important;
      justify-self: center !important;
      align-self: center !important;
    }

    .local-carpet-proof-section .svp-title {
      font-size: clamp(1.45rem, 5vw, 1.65rem) !important;
    }

    .local-carpet-proof-section .svp-desc {
      font-size: 1rem !important;
    }
  }
</style>
