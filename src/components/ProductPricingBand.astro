---
/**
 * Bloc disponibilité / recommandation pour les fiches Odor Break / BioBreak (sans prix).
 */
import { productAdvisory } from "../data/productPricing";
import { PHONES } from "../config/phones";

interface Props {
  locale: "fr" | "en";
  /** Page courante : lien vers l’autre produit */
  current: "odor-break" | "biobreak";
}

const { locale, current } = Astro.props;
const otherHref =
  current === "odor-break"
    ? locale === "fr"
      ? "/produits/detachant-enzymatique-apres-nettoyage"
      : "/en/produits/detachant-enzymatique-apres-nettoyage"
    : locale === "fr"
      ? "/produits/neutralisant-odeurs-urine-oxygene"
      : "/en/produits/neutralisant-odeurs-urine-oxygene";
const copy =
  locale === "fr"
    ? {
        title: "Disponibilité et recommandations",
        advisory: productAdvisory.fr,
        duoLead:
          "Approche en deux temps, comme sur le terrain : souvent BioBreak d’abord pour travailler les taches organiques, puis Odor Break pour neutraliser les odeurs à la source et aider à assainir la zone — toujours selon le textile et le mode d’emploi.",
        foot: "Disponibilité et commande :",
        contact: "nous contacter",
      }
    : {
        title: "Availability and recommendations",
        advisory: productAdvisory.en,
        duoLead:
          "Two-step workflow, as we often use in the field: BioBreak first to work organic soils, then Odor Break to neutralize odors at the source and help sanitize the area — always per fabric and label directions.",
        foot: "Availability and orders:",
        contact: "contact us",
      };

const otherLabelResolved =
  current === "odor-break"
    ? locale === "fr"
      ? "BioBreak"
      : "BioBreak"
    : locale === "fr"
      ? "Odor Break"
      : "Odor Break";
---

<div class="price-band">
  <h2 class="price-band-title">{copy.title}</h2>
  <p class="price-band-advisory">{copy.advisory}</p>
  <p class="price-band-muted">{copy.duoLead}</p>
  <p class="price-band-foot">
    {copy.foot}
    <a href={`tel:${PHONES.main.tel}`}>{PHONES.main.display}</a>
    {locale === "fr" ? " ou " : " or "}
    <a href={locale === "fr" ? "/contact" : "/en/contact"}>{copy.contact}</a>.
  </p>
  <p class="price-band-link-other">
    <a href={otherHref}
      >{locale === "fr" ? "Voir la fiche" : "View"} {otherLabelResolved}</a
    >
    {locale === "fr" ? " · " : " · "}
    <a href={locale === "fr" ? "/produits" : "/en/produits"}
      >{locale === "fr" ? "Tous les produits" : "All products"}</a
    >
  </p>
</div>

<style>
  .price-band {
    margin: 2rem 0 0;
    padding: 1.25rem 1.35rem;
    background: linear-gradient(165deg, #f7fbff 0%, #ffffff 100%);
    border: 1px solid rgba(0, 74, 159, 0.12);
    border-radius: 10px;
    border-left: 3px solid var(--color-accent);
  }
  .price-band-title {
    margin: 0 0 0.65rem;
    font-size: 1.15rem;
    color: var(--color-primary);
  }
  .price-band-advisory {
    margin: 0 0 0.85rem;
    line-height: 1.65;
    color: #444;
    font-style: italic;
    font-size: 0.95rem;
  }
  .price-band-muted {
    margin: 0 0 0.85rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: #555;
  }
  .price-band-foot {
    margin: 0 0 0.35rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: #444;
  }
  .price-band-foot a {
    color: var(--color-primary);
    font-weight: 600;
  }
  .price-band-link-other {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
  }
  .price-band-link-other a {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
