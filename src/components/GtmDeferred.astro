---
/**
 * GTM après load + idle (évite concurrence CPU/réseau avec LCP).
 * touchstart/pointerdown : charge un peu plus tôt si l’utilisateur interagit (tags inchangés, même conteneur).
 * dataLayer doit exister dans le <head> (une ligne) avant tout push marketing.
 */
---
<script is:inline>
  (function () {
    function injectGtm() {
      if (window.__gtmBootstrapDone) return;
      window.__gtmBootstrapDone = true;
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-WWCZZPZ6");
    }
    function scheduleIdle() {
      if (window.__gtmBootstrapDone) return;
      if ("requestIdleCallback" in window) {
        requestIdleCallback(injectGtm, { timeout: 2600 });
      } else {
        setTimeout(injectGtm, 1800);
      }
    }
    window.addEventListener("load", scheduleIdle, { once: true });
    function scheduleOnEngagement() {
      if (window.__gtmBootstrapDone) return;
      if ("requestIdleCallback" in window) {
        requestIdleCallback(injectGtm, { timeout: 1200 });
      } else {
        setTimeout(injectGtm, 500);
      }
    }
    window.addEventListener(
      "pointerdown",
      function onPtr() {
        window.removeEventListener("pointerdown", onPtr, true);
        scheduleOnEngagement();
      },
      { passive: true, capture: true },
    );
  })();
</script>
