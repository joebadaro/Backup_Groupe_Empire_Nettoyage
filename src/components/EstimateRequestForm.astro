---
import { PHONES } from "../config/phones";
import { resolveServiceImageSrc, SERVICE_IMAGES } from "../data/serviceImagery";

interface Props {
  locale: "fr" | "en";
}

const { locale } = Astro.props;
const isEn = locale === "en";

const t = {
  title: isEn ? "Free Estimate Request" : "Demande d'estimation gratuite",
  subtitle: isEn
    ? "Fast response"
    : "Réponse rapide",
  callCta: isEn ? "Call for a Fast Estimate" : "Appelez pour un estimé rapide",
  fullName: isEn ? "Full name" : "Nom complet",
  phone: isEn ? "Phone number" : "Numéro de téléphone",
  email: isEn ? "Email (optional)" : "Courriel (optionnel)",
  servicesTitle: isEn ? "Type of service (Select one or more)" : "Type de service (Sélectionnez un ou plusieurs)",
  otherServiceLabel: isEn
    ? "Please specify the requested service"
    : "Précisez le service demandé",
  city: isEn ? "Address or City" : "Adresse ou Ville",
  cityPlaceholder: isEn ? "Ex: Montreal, Laval, or address" : "Ex: Montréal, Laval, ou adresse",
  dwelling: isEn ? "Property type" : "Type de logement",
  floor: isEn
    ? "Which floor are you located on?"
    : "À quel étage êtes-vous situé?",
  floorPlaceholder: isEn ? "Ex: 3rd floor" : "Ex: 3e étage",
  description: isEn ? "Details of the job / Message" : "Détails du travail / Message",
  descriptionPlaceholder: isEn 
    ? "Example: Living room carpet 3x4 m with wine stains, or very dirty 3-seater couch..."
    : "Exemple: Tapis salon 3x4 m avec taches de vin, ou divan 3 places très sale...",
  photos: isEn ? "Photos of the job (Optional)" : "Photos du travail (Optionnel)",
  photosHint: isEn
    ? "You can select multiple photos. Up to 5 photos max."
    : "Vous pouvez sélectionner plusieurs photos. Maximum 5 photos.",
  submit: isEn ? "Get my free estimate" : "Obtenir mon estimation gratuite",
  sending: isEn ? "Sending..." : "Envoi en cours...",
  errGeneric: isEn
    ? "An error occurred. Please try again or call us directly at 514-893-9939."
    : "Une erreur est survenue. Veuillez réessayer ou nous appeler directement au 514-893-9939.",
  dwMaison: isEn ? "House" : "Maison",
  dwCondo: "Condo",
  dwApp: isEn ? "Apartment" : "Appartement",
  dwCom: isEn ? "Commercial" : "Commercial",
  honeypotLabel: isEn ? "Company" : "Entreprise",
  step1Title: isEn ? "Contact Info" : "Coordonnées",
  step2Title: isEn ? "Your Needs" : "Votre besoin",
  step3Title: isEn ? "Details & Photos" : "Détails",
  next: isEn ? "Next →" : "Suivant →",
  back: isEn ? "← Back" : "← Retour",
  contactPrefTitle: isEn ? "How would you like to receive your estimate?" : "Comment souhaitez-vous recevoir votre estimation ?",
  contactPhoneTitle: isEn ? "By phone" : "Par téléphone",
  contactPhoneDesc: isEn ? "A representative will contact you by phone." : "Un représentant vous contactera par téléphone.",
  contactSmsTitle: isEn ? "By text" : "Par texto",
  contactSmsDesc: isEn ? "A representative will send your estimate by text message." : "Un représentant vous enverra votre estimation par message texte.",
  contactEmailTitle: isEn ? "By email" : "Par courriel",
  contactEmailDesc: isEn ? "A representative will send your estimate by email." : "Un représentant vous enverra votre estimation par courriel.",
  contactEmailWarning: isEn ? "Please enter your email to receive the estimate by email." : "Veuillez entrer votre courriel pour recevoir l'estimation par courriel.",
  contactEmailInlineLabel: isEn ? "Your email address *" : "Votre adresse courriel *",
};
---

<section class="erf">
  <div class="erf-inner">
    <h1 class="erf-title text-gradient-empire">{t.title}</h1>
    <p class="erf-sub">{t.subtitle}</p>

    <!-- Appels direct CTA -->
    <div class="erf-call-cta-wrapper">
      <a class="erf-call-cta-button" href={`tel:${PHONES.main.telIntl}`}>
        <span class="erf-call-icon" aria-hidden="true">📞</span>
        <span class="erf-call-text">
          <span class="erf-call-lbl">{t.callCta}</span>
          <span class="erf-call-num">{PHONES.main.display}</span>
        </span>
      </a>
    </div>

    <!-- Barre de progression des étapes -->
    <div class="erf-progress-container">
      <div class="erf-progress-line-bg"></div>
      <div class="erf-progress-line" id="erf-progress-line" style="width: 0%;"></div>
      <div class="erf-progress-step active" data-step="1">
        <div class="erf-step-num">1</div>
        <span class="erf-step-label">{t.step1Title}</span>
      </div>
      <div class="erf-progress-step" data-step="2">
        <div class="erf-step-num">2</div>
        <span class="erf-step-label">{t.step2Title}</span>
      </div>
      <div class="erf-progress-step" data-step="3">
        <div class="erf-step-num">3</div>
        <span class="erf-step-label">{t.step3Title}</span>
      </div>
    </div>

    <!-- Success / Error Panels -->
    <div
      class="erf-success-card"
      data-erf-success-full
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
    >
      {
        isEn ? (
          <>
            <p class="erf-success-p">
              Thank you, your estimate request has been sent successfully.
            </p>
            <p class="erf-success-p">
              A member of our team will contact you shortly.
            </p>
            <p class="erf-success-p">
              For a faster response, you can also call us directly at{" "}
              <a class="erf-success-link" href={`tel:${PHONES.main.telIntl}`}>
                {PHONES.main.display}
              </a>
              .
            </p>
          </>
        ) : (
          <>
            <p class="erf-success-p">Merci, votre demande d'estimation a bien été envoyée.</p>
            <p class="erf-success-p">
              Un membre de notre équipe vous contactera sous peu.
            </p>
            <p class="erf-success-p">
              Pour une réponse plus rapide, vous pouvez aussi nous appeler directement au{" "}
              <a class="erf-success-link" href={`tel:${PHONES.main.telIntl}`}>
                {PHONES.main.display}
              </a>
              .
            </p>
          </>
        )
      }
    </div>
    <div
      class="erf-success-card"
      data-erf-success-partial
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
    >
      {
        isEn ? (
          <>
            <p class="erf-success-p">Thank you, your estimate request has been sent successfully.</p>
            <p class="erf-success-p">
              Some photos could not be attached automatically. If needed, you can send them by text message at {PHONES.main.display}.
            </p>
          </>
        ) : (
          <>
            <p class="erf-success-p">Merci, votre demande d'estimation a bien été envoyée.</p>
            <p class="erf-success-p">
              Certaines photos n'ont pas pu être jointes automatiquement. Si nécessaire, vous pouvez nous les envoyer par texto au {PHONES.main.display}.
            </p>
          </>
        )
      }
    </div>
    <div class="erf-error" data-erf-error hidden role="alert"></div>

    <!-- Form Panel -->
    <div class="erf-form-panel" data-erf-form-panel>
      <form
        class="erf-form"
        id="estimate-request-form"
        data-sending-label={t.sending}
        data-erf-error-generic={t.errGeneric}
        enctype="multipart/form-data"
        novalidate
      >
        <input type="hidden" name="locale" value={locale} />

        <div class="erf-field hp" aria-hidden="true">
          <label for="erf-honeypot">{t.honeypotLabel}</label>
          <input type="text" id="erf-honeypot" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <!-- ==================== ÉTAPE 1 : COORDONNÉES ==================== -->
        <div class="erf-step-panel active" data-erf-step="1">
          <h2 class="erf-step-heading">{isEn ? "Your Contact Information" : "Vos coordonnées"}</h2>
          
          <div class="erf-field">
            <label for="erf-fullName">{t.fullName} *</label>
            <input id="erf-fullName" name="fullName" type="text" maxlength="200" autocomplete="name" placeholder={isEn ? "E.g., John Doe" : "Ex: Jean Tremblay"} />
          </div>

          <div class="erf-field">
            <label for="erf-phone">{t.phone} *</label>
            <input id="erf-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" placeholder="514-893-9939" />
          </div>

          <div class="erf-field">
            <label for="erf-email">{t.email}</label>
            <input id="erf-email" name="email" type="email" maxlength="120" autocomplete="email" placeholder={isEn ? "name@example.com" : "Ex: nom@courriel.com"} />
          </div>
          
          <div class="erf-nav-buttons">
            <button type="button" class="btn btn-primary erf-next-btn" data-next-step="2">
              {t.next}
            </button>
          </div>
        </div>

        <!-- ==================== ÉTAPE 2 : BESOINS & LOGEMENT ==================== -->
        <div class="erf-step-panel" data-erf-step="2" hidden style="display: none;">
          <h2 class="erf-step-heading">{isEn ? "Your Cleaning Needs" : "Votre besoin"}</h2>
          
          <fieldset class="erf-field erf-fieldset">
            <legend class="erf-legend-bold">{t.servicesTitle} *</legend>
            
            <div class="erf-services-grid">
              <!-- Divan & Meubles -->
              <label class="erf-service-card" data-service-value="sofa_meubles">
                <input type="checkbox" name="services" value="sofa_meubles" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper">
                  <img src={resolveServiceImageSrc(SERVICE_IMAGES.meubles_tissu.src)} alt={isEn ? "Upholstery Cleaning" : "Nettoyage meubles en tissu"} loading="lazy" />
                </div>
                <div class="erf-card-label">
                  {isEn ? "Couch & Furniture" : "Divan & Meubles"}
                </div>
              </label>

              <!-- Nettoyage Tapis -->
              <label class="erf-service-card" data-service-value="tapis">
                <input type="checkbox" name="services" value="tapis" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper">
                  <img src={resolveServiceImageSrc(SERVICE_IMAGES.tapis_residentiel.src)} alt={isEn ? "Carpet Cleaning" : "Nettoyage de tapis résidentiel"} loading="lazy" />
                </div>
                <div class="erf-card-label">
                  {isEn ? "Carpet Cleaning" : "Nettoyage Tapis"}
                </div>
              </label>

              <!-- Carpette -->
              <label class="erf-service-card" data-service-value="carpette">
                <input type="checkbox" name="services" value="carpette" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper">
                  <img src={resolveServiceImageSrc(SERVICE_IMAGES.tapis_oriental.src)} alt={isEn ? "Area Rug Cleaning" : "Nettoyage de carpette"} loading="lazy" />
                </div>
                <div class="erf-card-label">
                  {isEn ? "Area Rug" : "Carpette"}
                </div>
              </label>

              <!-- Nettoyage Matelas -->
              <label class="erf-service-card" data-service-value="matelas">
                <input type="checkbox" name="services" value="matelas" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper">
                  <img src={resolveServiceImageSrc(SERVICE_IMAGES.matelas.src)} alt={isEn ? "Mattress Cleaning" : "Nettoyage de matelas"} loading="lazy" />
                </div>
                <div class="erf-card-label">
                  {isEn ? "Mattress" : "Nettoyage Matelas"}
                </div>
              </label>

              <!-- Meubles en Cuir -->
              <label class="erf-service-card" data-service-value="cuir">
                <input type="checkbox" name="services" value="cuir" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper">
                  <img src={resolveServiceImageSrc(SERVICE_IMAGES.meubles_cuir.src)} alt={isEn ? "Leather Furniture" : "Nettoyage de cuir"} loading="lazy" />
                </div>
                <div class="erf-card-label">
                  {isEn ? "Leather Furniture" : "Meubles en Cuir"}
                </div>
              </label>

              <!-- Tuile & Céramique -->
              <label class="erf-service-card" data-service-value="tuiles">
                <input type="checkbox" name="services" value="tuiles" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper">
                  <img src={resolveServiceImageSrc(SERVICE_IMAGES.ceramique.src)} alt={isEn ? "Tile & Grout" : "Nettoyage de tuiles et céramique"} loading="lazy" />
                </div>
                <div class="erf-card-label">
                  {isEn ? "Tile & Grout" : "Tuile & Céramique"}
                </div>
              </label>

              <!-- Tapis Commercial -->
              <label class="erf-service-card" data-service-value="tapis_commercial">
                <input type="checkbox" name="services" value="tapis_commercial" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper">
                  <img src={resolveServiceImageSrc(SERVICE_IMAGES.tapis_commercial.src)} alt={isEn ? "Commercial Carpet Cleaning" : "Nettoyage de tapis commercial"} loading="lazy" />
                </div>
                <div class="erf-card-label">
                  {isEn ? "Commercial Carpet" : "Tapis Commercial"}
                </div>
              </label>

              <!-- Protecteur -->
              <label class="erf-service-card" data-service-value="protecteur">
                <input type="checkbox" name="services" value="protecteur" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper">
                  <img src={resolveServiceImageSrc(SERVICE_IMAGES.protecteur.src)} alt={isEn ? "Stain Protector" : "Application de protecteur anti tache"} loading="lazy" />
                </div>
                <div class="erf-card-label">
                  {isEn ? "Stain Protector" : "Protecteur"}
                </div>
              </label>

              <!-- Autre Service -->
              <label class="erf-service-card" data-service-value="autre">
                <input type="checkbox" name="services" value="autre" class="erf-service-checkbox" />
                <div class="erf-card-image-wrapper erf-card-icon-wrapper">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="erf-sparkle-icon" aria-hidden="true">
                    <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z"></path>
                  </svg>
                </div>
                <div class="erf-card-label">
                  {isEn ? "Other Service" : "Autre Service"}
                </div>
              </label>
            </div>
          </fieldset>

          <div class="erf-field" data-erf-other-service-row hidden style="display: none;">
            <label for="erf-otherServiceDetail">{t.otherServiceLabel} *</label>
            <input
              id="erf-otherServiceDetail"
              name="otherServiceDetail"
              type="text"
              maxlength="500"
              autocomplete="off"
            />
          </div>

          <div class="erf-field">
            <label for="erf-city">{t.city} *</label>
            <input id="erf-city" name="city" type="text" maxlength="120" autocomplete="address-level2" placeholder={t.cityPlaceholder} />
          </div>

          <fieldset class="erf-field erf-fieldset">
            <legend class="erf-legend-bold">{t.dwelling} *</legend>
            <div class="erf-dwelling-grid">
              <label class="erf-dwelling-option">
                <input type="radio" name="dwellingType" value="maison" /> 
                <span>{t.dwMaison}</span>
              </label>
              <label class="erf-dwelling-option">
                <input type="radio" name="dwellingType" value="condo" /> 
                <span>{t.dwCondo}</span>
              </label>
              <label class="erf-dwelling-option">
                <input type="radio" name="dwellingType" value="appartement" /> 
                <span>{t.dwApp}</span>
              </label>
              <label class="erf-dwelling-option">
                <input type="radio" name="dwellingType" value="commercial" /> 
                <span>{t.dwCom}</span>
              </label>
            </div>
          </fieldset>

          <div class="erf-field" data-erf-floor-row hidden style="display: none;">
            <label for="erf-floor">{t.floor} *</label>
            <input id="erf-floor" name="floor" type="text" maxlength="40" autocomplete="off" placeholder={t.floorPlaceholder} />
          </div>
          
          <div class="erf-nav-buttons">
            <button type="button" class="btn btn-secondary erf-back-btn" data-prev-step="1">
              {t.back}
            </button>
            <button type="button" class="btn btn-primary erf-next-btn" data-next-step="3">
              {t.next}
            </button>
          </div>
        </div>

        <!-- ==================== ÉTAPE 3 : DÉTAILS & PHOTOS ==================== -->
        <div class="erf-step-panel" data-erf-step="3" hidden style="display: none;">
          <h2 class="erf-step-heading">{isEn ? "Project Details" : "Détails du projet"}</h2>
          
          <div class="erf-field">
            <label for="erf-description">{t.description}</label>
            <textarea id="erf-description" name="description" rows="5" maxlength="8000" placeholder={t.descriptionPlaceholder}></textarea>
          </div>

          <div class="erf-field">
            <label for="erf-photos">{t.photos}</label>
            <input
              id="erf-photos"
              name="photos"
              type="file"
              accept="image/jpeg,image/jpg,image/png,image/webp,image/heic,image/heif,.heic,.heif"
              multiple
            />
            <span class="erf-hint">{t.photosHint}</span>
            <p id="erf-photo-client-msg" class="erf-hint" hidden aria-live="polite"></p>
          </div>
          
          <!-- Préférence de réception de l'estimation -->
          <fieldset class="erf-field erf-fieldset" style="margin-top: 1.5rem;">
            <legend class="erf-legend-bold">{t.contactPrefTitle} *</legend>
            <div class="erf-pref-grid">
              <!-- Par téléphone -->
              <label class="erf-pref-option selected">
                <input type="radio" name="contactPreference" value="telephone" checked />
                <div class="erf-pref-content">
                  <span class="erf-pref-label-title">{t.contactPhoneTitle}</span>
                  <span class="erf-pref-desc">{t.contactPhoneDesc}</span>
                </div>
              </label>

              <!-- Par texto -->
              <label class="erf-pref-option">
                <input type="radio" name="contactPreference" value="sms" />
                <div class="erf-pref-content">
                  <span class="erf-pref-label-title">{t.contactSmsTitle}</span>
                  <span class="erf-pref-desc">{t.contactSmsDesc}</span>
                </div>
              </label>

              <!-- Par courriel -->
              <label class="erf-pref-option">
                <input type="radio" name="contactPreference" value="courriel" />
                <div class="erf-pref-content">
                  <span class="erf-pref-label-title">{t.contactEmailTitle}</span>
                  <span class="erf-pref-desc">{t.contactEmailDesc}</span>
                </div>
              </label>
            </div>
          </fieldset>

          <!-- Saisie directe du courriel s'il est manquant et que "Par courriel" est choisi -->
          <div class="erf-field" id="erf-inline-email-container" style="display: none; margin-top: 1rem; animation: fadeIn 0.3s ease-out;">
            <label for="erf-inline-email">{t.contactEmailInlineLabel}</label>
            <input id="erf-inline-email" type="email" placeholder={isEn ? "name@example.com" : "Ex: nom@courriel.com"} />
            <span class="erf-hint" style="color: #b71c1c; font-weight: 600;">{t.contactEmailWarning}</span>
          </div>

          <div class="erf-nav-buttons">
            <button type="button" class="btn btn-secondary erf-back-btn" data-prev-step="2">
              {t.back}
            </button>
            <button type="submit" class="btn btn-primary pulse-btn erf-submit">
              {t.submit}
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { initEstimateRequestForm } from "../scripts/estimate-request-form.ts";

  const form = document.getElementById("estimate-request-form");
  if (form instanceof HTMLFormElement) {
    initEstimateRequestForm(form);
  }
</script>

<style>
  .erf {
    padding: 2rem 0 4rem;
  }
  .erf-inner {
    max-width: 720px; /* Plus large pour accueillir la grille de cartes */
    margin: 0 auto;
    padding: 2rem 1.5rem;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }
  .erf-title {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    margin-bottom: 0.5rem;
    text-align: center;
    font-weight: 800;
  }
  .erf-sub {
    text-align: center;
    color: #4b5563;
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  /* CALL CTA BUTTON */
  .erf-call-cta-wrapper {
    margin: 0 auto 2.5rem;
    max-width: 420px;
    display: flex;
    justify-content: center;
  }
  .erf-call-cta-button {
    display: flex;
    align-items: center;
    gap: 16px;
    background: linear-gradient(135deg, #001f3f 0%, #004a9f 100%);
    color: #ffffff !important;
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(0, 31, 63, 0.35);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .erf-call-cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 31, 63, 0.45);
  }
  .erf-call-icon {
    font-size: 1.5rem;
    animation: pulse 2s infinite;
  }
  .erf-call-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
  }
  .erf-call-lbl {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    opacity: 0.9;
  }
  .erf-call-num {
    font-size: 1.25rem;
    font-weight: 850;
  }

  /* PROGRESS BAR WIZARD */
  .erf-progress-container {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 500px;
    margin: 0 auto 3rem;
    padding: 0 15px;
  }
  .erf-progress-line-bg {
    position: absolute;
    top: 20px;
    left: 25px;
    right: 25px;
    height: 4px;
    background-color: #e5e7eb;
    z-index: 1;
    border-radius: 10px;
  }
  .erf-progress-line {
    position: absolute;
    top: 20px;
    left: 25px;
    height: 4px;
    background: linear-gradient(90deg, #b71c1c 0%, #ff5252 100%);
    z-index: 2;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 10px;
  }
  .erf-progress-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
    flex: 1;
  }
  .erf-step-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #ffffff;
