---
import { PHONES } from "../config/phones";

interface Props {
  locale: "fr" | "en";
}

const { locale } = Astro.props;
const isEn = locale === "en";

/** Valeurs `name="services"` — ordre FR / EN aligné avec la demande produit */
const SERVICE_OPTIONS: { value: string; labelFr: string; labelEn: string }[] = [
  {
    value: "sofa_meubles",
    labelFr: "Nettoyage de sofa, divan, chaises et fauteuils",
    labelEn: "Sofa, couch, chair and armchair cleaning",
  },
  { value: "tapis", labelFr: "Nettoyage de tapis", labelEn: "Carpet cleaning" },
  { value: "matelas", labelFr: "Nettoyage de matelas", labelEn: "Mattress cleaning" },
  { value: "cuir", labelFr: "Nettoyage de cuir", labelEn: "Leather cleaning" },
  {
    value: "tuiles",
    labelFr: "Nettoyage de tuiles et céramique",
    labelEn: "Tile and ceramic cleaning",
  },
  {
    value: "tapis_commercial",
    labelFr: "Nettoyage de tapis commercial",
    labelEn: "Commercial carpet cleaning",
  },
  {
    value: "protecteur",
    labelFr: "Application de protecteur anti tache",
    labelEn: "Stain protector application",
  },
  { value: "autre", labelFr: "Autre service", labelEn: "Other service" },
];

const t = {
  title: isEn ? "Free estimate request" : "Demande d'estimation gratuite",
  subtitle: isEn
    ? "Send your request in less than a minute. For a faster response, call us directly at 514-893-9939."
    : "Envoyez votre demande en moins d’une minute. Pour une réponse plus rapide, appelez-nous directement au 514-893-9939.",
  callCta: isEn ? `Call ${PHONES.main.display}` : `Appeler le ${PHONES.main.display}`,
  fullName: isEn ? "Full name" : "Nom complet",
  phone: isEn ? "Phone number" : "Numéro de téléphone",
  email: isEn ? "Email (optional)" : "Courriel (optionnel)",
  servicesTitle: isEn ? "Requested services" : "Services demandés",
  otherServiceLabel: isEn
    ? "Please specify the requested service"
    : "Précisez le service demandé",
  city: isEn ? "City" : "Ville",
  dwelling: isEn ? "Property type" : "Type de logement",
  floor: isEn
    ? "Which floor are you located on?"
    : "À quel étage êtes vous situé?",
  description: isEn ? "Describe your needs" : "Description du besoin",
  photos: isEn ? "Photos (optional)" : "Photos (optionnelles)",
  photosHint: isEn
    ? "Photos are optional. You can add up to 5 photos. The form may automatically reduce image size to make sending easier."
    : "Photos optionnelles. Vous pouvez ajouter jusqu'à 5 photos. Le formulaire peut réduire automatiquement la taille des images pour faciliter l'envoi.",
  contactPref: isEn ? "Preferred contact method" : "Méthode de contact préférée",
  contactHint: isEn
    ? "For a faster response, we recommend a phone call or text message."
    : "Pour une réponse plus rapide, nous recommandons un appel ou un texto.",
  submit: isEn ? "Send my estimate request" : "Envoyer ma demande d’estimation",
  sending: isEn ? "Sending..." : "Envoi en cours...",
  errGeneric: isEn
    ? "An error occurred. Please try again or call us directly at 514-893-9939."
    : "Une erreur est survenue. Veuillez réessayer ou nous appeler directement au 514-893-9939.",
  dwMaison: isEn ? "House" : "Maison",
  dwCondo: "Condo",
  dwApp: isEn ? "Apartment" : "Appartement",
  dwCom: isEn ? "Commercial" : "Commercial",
  cpPhone: isEn ? "Phone" : "Téléphone",
  cpSms: isEn ? "Text message" : "Texto",
  cpEmail: isEn ? "Email" : "Courriel",
  honeypotLabel: isEn ? "Company" : "Entreprise",
};
---

<section class="erf">
  <div class="erf-inner">
    <h1 class="erf-title text-gradient-empire">{t.title}</h1>
    <p class="erf-sub">{t.subtitle}</p>
    <p class="erf-call">
      <a class="erf-call-link" href={`tel:${PHONES.main.telIntl}`}>{t.callCta}</a>
    </p>

    <div
      class="erf-success-card"
      data-erf-success-full
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
    >
      {
        isEn ? (
          <>
            <p class="erf-success-p">
              Thank you, your estimate request has been sent successfully.
            </p>
            <p class="erf-success-p">
              A member of our team will contact you shortly using your preferred contact method.
            </p>
            <p class="erf-success-p">You do not need to submit the form again.</p>
            <p class="erf-success-p">
              For a faster response, you can also call us directly at{" "}
              <a class="erf-success-link" href={`tel:${PHONES.main.telIntl}`}>
                {PHONES.main.display}
              </a>
              .
            </p>
          </>
        ) : (
          <>
            <p class="erf-success-p">Merci, votre demande d'estimation a bien été envoyée.</p>
            <p class="erf-success-p">
              Un membre de notre équipe vous contactera sous peu selon la méthode de contact choisie.
            </p>
            <p class="erf-success-p">Vous n'avez pas besoin de renvoyer le formulaire.</p>
            <p class="erf-success-p">
              Pour une réponse plus rapide, vous pouvez aussi nous appeler directement au{" "}
              <a class="erf-success-link" href={`tel:${PHONES.main.telIntl}`}>
                {PHONES.main.display}
              </a>
              .
            </p>
          </>
        )
      }
    </div>
    <div
      class="erf-success-card"
      data-erf-success-partial
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
    >
      {
        isEn ? (
          <>
            <p class="erf-success-p">Thank you, your estimate request has been sent successfully.</p>
            <p class="erf-success-p">
              Some photos could not be attached automatically. If needed, you can send them by text message at
              514-893-9939.
            </p>
            <p class="erf-success-p">You do not need to submit the form again.</p>
          </>
        ) : (
          <>
            <p class="erf-success-p">Merci, votre demande d'estimation a bien été envoyée.</p>
            <p class="erf-success-p">
              Certaines photos n'ont pas pu être jointes automatiquement. Si nécessaire, vous pouvez nous les envoyer
              par texto au 514-893-9939.
            </p>
            <p class="erf-success-p">Vous n'avez pas besoin de renvoyer le formulaire.</p>
          </>
        )
      }
    </div>
    <div class="erf-error" data-erf-error hidden role="alert"></div>

    <div class="erf-form-panel" data-erf-form-panel>
    <form
      class="erf-form"
      id="estimate-request-form"
      data-sending-label={t.sending}
      data-erf-error-generic={t.errGeneric}
      enctype="multipart/form-data"
      novalidate
    >
      <input type="hidden" name="locale" value={locale} />

      <div class="erf-field hp" aria-hidden="true">
        <label for="erf-honeypot">{t.honeypotLabel}</label>
        <input type="text" id="erf-honeypot" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="erf-field">
        <label for="erf-fullName">{t.fullName} *</label>
        <input id="erf-fullName" name="fullName" type="text" required maxlength="200" autocomplete="name" />
      </div>

      <div class="erf-field">
        <label for="erf-phone">{t.phone} *</label>
        <input id="erf-phone" name="phone" type="tel" required maxlength="40" autocomplete="tel" />
      </div>

      <div class="erf-field">
        <label for="erf-email">{t.email}</label>
        <input id="erf-email" name="email" type="email" maxlength="120" autocomplete="email" />
      </div>

      <fieldset class="erf-field erf-fieldset">
        <legend>{t.servicesTitle} *</legend>
        {
          SERVICE_OPTIONS.map((opt) => (
            <label class="erf-radio">
              <input type="checkbox" name="services" value={opt.value} />
              {isEn ? opt.labelEn : opt.labelFr}
            </label>
          ))
        }
      </fieldset>

      <div class="erf-field" data-erf-other-service-row hidden style="display: none;">
        <label for="erf-otherServiceDetail">{t.otherServiceLabel} *</label>
        <input
          id="erf-otherServiceDetail"
          name="otherServiceDetail"
          type="text"
          maxlength="500"
          autocomplete="off"
        />
      </div>

      <div class="erf-field">
        <label for="erf-city">{t.city} *</label>
        <input id="erf-city" name="city" type="text" required maxlength="120" autocomplete="address-level2" />
      </div>

      <fieldset class="erf-field erf-fieldset">
        <legend>{t.dwelling} *</legend>
        <label class="erf-radio"
          ><input type="radio" name="dwellingType" value="maison" required /> {t.dwMaison}</label
        >
        <label class="erf-radio"
          ><input type="radio" name="dwellingType" value="condo" /> {t.dwCondo}</label
        >
        <label class="erf-radio"
          ><input type="radio" name="dwellingType" value="appartement" /> {t.dwApp}</label
        >
        <label class="erf-radio"
          ><input type="radio" name="dwellingType" value="commercial" /> {t.dwCom}</label
        >
      </fieldset>

      <div class="erf-field" data-erf-floor-row hidden style="display: none;">
        <label for="erf-floor">{t.floor} *</label>
        <input id="erf-floor" name="floor" type="text" maxlength="40" autocomplete="off" />
      </div>

      <div class="erf-field">
        <label for="erf-description">{t.description} *</label>
        <textarea id="erf-description" name="description" rows="5" required maxlength="8000"></textarea>
      </div>

      <div class="erf-field">
        <label for="erf-photos">{t.photos}</label>
        <input
          id="erf-photos"
          name="photos"
          type="file"
          accept="image/jpeg,image/jpg,image/png,image/webp,image/heic,image/heif,.heic,.heif"
          multiple
        />
        <span class="erf-hint">{t.photosHint}</span>
        <p id="erf-photo-client-msg" class="erf-hint" hidden aria-live="polite"></p>
      </div>

      <fieldset class="erf-field erf-fieldset">
        <legend>{t.contactPref} *</legend>
        <p class="erf-hint erf-contact-hint">{t.contactHint}</p>
        <label class="erf-radio"
          ><input type="radio" name="contactPreference" value="telephone" required /> {t.cpPhone}</label
        >
        <label class="erf-radio"><input type="radio" name="contactPreference" value="sms" /> {t.cpSms}</label>
        <label class="erf-radio"
          ><input type="radio" name="contactPreference" value="courriel" /> {t.cpEmail}</label
        >
      </fieldset>

      <button type="submit" class="btn btn-primary pulse-btn erf-submit">{t.submit}</button>
    </form>
    </div>
  </div>
</section>

<script>
  import { initEstimateRequestForm } from "../scripts/estimate-request-form.ts";

  const form = document.getElementById("estimate-request-form");
  if (form instanceof HTMLFormElement) {
    initEstimateRequestForm(form);
  }
</script>

<style>
  .erf {
    padding: 2rem 0 4rem;
  }
  .erf-inner {
    max-width: 560px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .erf-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .erf-sub {
    text-align: center;
    color: #444;
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }
  .erf-call {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .erf-call-link {
    font-weight: 700;
    color: var(--color-primary, #001f3f);
  }
  .erf-success-card {
    background: #e8f5e9;
    border: 2px solid #81c784;
    color: #1b5e20;
    padding: 1.25rem 1.35rem;
    border-radius: 12px;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 18px rgba(27, 94, 32, 0.12);
    font-size: 1.02rem;
    line-height: 1.55;
  }
  .erf-success-card:not([hidden]) {
    outline: none;
  }
  .erf-success-p {
    margin: 0 0 0.85rem;
  }
  .erf-success-p:last-child {
    margin-bottom: 0;
  }
  .erf-success-link {
    font-weight: 700;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .erf-error {
    background: #ffebee;
    border: 1px solid #ffcdd2;
    color: #b71c1c;
    padding: 12px 14px;
    border-radius: 8px;
    margin-bottom: 1rem;
    white-space: pre-wrap;
  }
  .erf-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .erf-field label,
  .erf-fieldset legend {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
    font-size: 0.95rem;
  }
  .erf-field input[type="text"],
  .erf-field input[type="tel"],
  .erf-field input[type="email"],
  .erf-field input[type="file"],
  .erf-field select,
  .erf-field textarea {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #cfd8dc;
    font: inherit;
    box-sizing: border-box;
  }
  .erf-fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }
  .erf-radio {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: 1rem;
    margin-bottom: 0.35rem;
    font-weight: 500;
    cursor: pointer;
  }
  .erf-hint {
    display: block;
    font-size: 0.85rem;
    color: #666;
    margin-top: 4px;
  }
  .erf-contact-hint {
    margin-bottom: 0.5rem;
    margin-top: 0;
  }
  .erf-submit {
    margin-top: 0.5rem;
    align-self: flex-start;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
