---
/**
 * Minimal stroke icons (currentColor). Use aria-hidden on parent when decorative.
 */
type UiIconName =
  | "phone"
  | "envelope"
  | "map-pin"
  | "shield"
  | "award"
  | "check"
  | "leaf"
  | "gem"
  | "fleur"
  | "clipboard"
  | "bolt"
  | "building"
  | "baby"
  | "paw"
  | "close"
  | "badge-certified"
  | "open-book"
  | "handshake"
  | "shield-check"
  | "thermometer"
  | "airflow"
  | "crosshair"
  | "truck-mount";

interface Props {
  name: UiIconName;
  class?: string;
  size?: number;
}

const { name, class: className = "", size = 20 } = Astro.props;

const base = {
  xmlns: "http://www.w3.org/2000/svg",
  width: size,
  height: size,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.6",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
  class: `ui-icon ${className}`.trim(),
};
---

{name === "phone" && (
  <svg {...base}>
    <path
      d="M5.5 4.5h2.5l1.7 4.3-1.3 1a12 12 0 0 0 5.3 5.3l1-1.3 4.3 1.7v2.5a1 1 0 0 1-1.1 1 19 19 0 0 1-8.4-3.6 19 19 0 0 1-3.6-8.4 1 1 0 0 1 1-1.1Z"
    />
  </svg>
)}

{name === "envelope" && (
  <svg {...base}>
    <path d="M4 6h16v12H4V6Z" />
    <path d="m4 7 8 6 8-6" />
  </svg>
)}

{name === "map-pin" && (
  <svg {...base}>
    <path d="M12 11a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
    <path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11Z" />
  </svg>
)}

{name === "shield" && (
  <svg {...base}>
    <path d="M12 3 5 6v6c0 5 3.5 9 7 10 3.5-1 7-5 7-10V6l-7-3Z" />
  </svg>
)}

{name === "award" && (
  <svg {...base}>
    <path d="M8.5 9.5 12 3l3.5 6.5L12 12 8.5 9.5Z" />
    <path d="M8.5 9.5 6 21l6-3 6 3-2.5-11.5" />
  </svg>
)}

{name === "check" && (
  <svg {...base}>
    <path d="M5 12.5 9.5 17 19 7" />
  </svg>
)}

{name === "leaf" && (
  <svg {...base}>
    <path d="M11 20A7 7 0 0 1 9.8 6c2.8.5 5.2 2.5 6.2 5.2 1 2.7.3 5.6-1.8 7.7" />
    <path d="M18 10c-4 1-7 4-8 8" />
  </svg>
)}

{name === "gem" && (
  <svg {...base}>
    <path d="M6 3h12l4 6-10 13L2 9l4-6Z" />
    <path d="M2 9h20" />
  </svg>
)}

{name === "fleur" && (
  <svg {...base} stroke-width="1.4">
    <path d="M12 4v16M8.5 7.5c2-1.5 4.5-1 6 1s1 4.5-1 6-4.5 1-6-1-1-4.5 1-6Z" />
  </svg>
)}

{name === "clipboard" && (
  <svg {...base}>
    <path d="M9 4h6a1 1 0 0 1 1 1v14a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V5a1 1 0 0 1 1-1Z" />
    <path d="M9 4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2" />
    <path d="M9 12h6M9 16h4" />
  </svg>
)}

{name === "bolt" && (
  <svg {...base}>
    <path d="M13 2 3 14h8l-1 8 10-12h-8l1-8Z" />
  </svg>
)}

{name === "building" && (
  <svg {...base}>
    <path d="M4 20V8l8-4v16M4 12h8" />
    <path d="M15 9h2v3M15 14h2v6" />
    <path d="M12 20h10v-8h-5V9h-5" />
  </svg>
)}

{name === "baby" && (
  <svg {...base}>
    <path d="M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
    <path d="M6 20a6 6 0 0 1 12 0" />
    <path d="M9 9h-.5a2.5 2.5 0 0 0 0 5H10" />
    <path d="M15 9h.5a2.5 2.5 0 0 1 0 5H14" />
  </svg>
)}

{name === "paw" && (
  <svg {...base}>
    <ellipse cx="8.5" cy="10" rx="1.6" ry="2" />
    <ellipse cx="15.5" cy="10" rx="1.6" ry="2" />
    <ellipse cx="6" cy="7" rx="1.3" ry="1.7" />
    <ellipse cx="18" cy="7" rx="1.3" ry="1.7" />
    <ellipse cx="12" cy="5.5" rx="1.3" ry="1.7" />
    <path d="M10 14c0 2 1.5 4 2 4s2-2 2-4" />
  </svg>
)}

{name === "close" && (
  <svg {...base}>
    <path d="M6 6l12 12M18 6 6 18" />
  </svg>
)}

{/* --- Passe premium (équipe / équipements) : stroke 1.5, sans modifier les icônes ci-dessus --- */}
{name === "badge-certified" && (
  <svg {...base} stroke-width="1.5">
    <circle cx="12" cy="12" r="9" />
    <path d="M8.5 12.2 10.8 14.5 15.5 9.8" />
  </svg>
)}

{name === "open-book" && (
  <svg {...base} stroke-width="1.5">
    <path d="M12 5.5v13" />
    <path d="M4.5 7.5h6.5a1 1 0 0 1 1 1v9.5H5.5a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1Z" />
    <path d="M19.5 7.5H13a1 1 0 0 0-1 1v9.5h6.5a1 1 0 0 0 1-1V8.5a1 1 0 0 0-1-1Z" />
  </svg>
)}

{name === "handshake" && (
  <svg {...base} stroke-width="1.5">
    <path d="M7.5 11.5 6 10l1.8-2.2a1.5 1.5 0 0 1 2.1-.2l.8.6" />
    <path d="M16.5 11.5 18 10l-1.8-2.2a1.5 1.5 0 0 0-2.1-.2l-.8.6" />
    <path d="M9.2 12.8 8 14l2 2 2.2-1.2" />
    <path d="M14.8 12.8 16 14l-2 2-2.2-1.2" />
    <path d="M10.5 11.5h3" />
  </svg>
)}

{name === "shield-check" && (
  <svg {...base} stroke-width="1.5">
    <path d="M12 3 5 6v6c0 5 3.5 9 7 10 3.5-1 7-5 7-10V6l-7-3Z" />
    <path d="M9 12.2 11.2 14.5 15 10.5" />
  </svg>
)}

{name === "thermometer" && (
  <svg {...base} stroke-width="1.5">
    <path d="M10 18.5a2.5 2.5 0 0 0 4 0v-8.2a4 4 0 1 0-4 0v8.2Z" />
    <path d="M12 9v5.5" />
  </svg>
)}

{name === "airflow" && (
  <svg {...base} stroke-width="1.5">
    <path d="M4 8c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3" />
    <path d="M4 12c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3" />
    <path d="M4 16c2.5 0 2.5-3 5-3s2.5 3 5 3 2.5-3 5-3" />
  </svg>
)}

{name === "crosshair" && (
  <svg {...base} stroke-width="1.5">
    <circle cx="12" cy="12" r="7" />
    <path d="M12 5v3M12 16v3M5 12h3M16 12h3" />
    <circle cx="12" cy="12" r="1.2" />
  </svg>
)}

{name === "truck-mount" && (
  <svg {...base} stroke-width="1.5">
    <path d="M3 14h11v-5H8l-2 2v3" />
    <path d="M14 9h2l3 3v2h-5" />
    <circle cx="7.5" cy="16" r="1.8" />
    <circle cx="16" cy="16" r="1.8" />
    <path d="M19 12h2v2h-2" />
    <path d="M5 11h5" />
  </svg>
)}
