---
import type { ServiceImageKey } from "../../data/serviceImagery";

interface Props {
  imageKey: ServiceImageKey;
  class?: string;
}

const { imageKey, class: className = "" } = Astro.props;

const s = {
  xmlns: "http://www.w3.org/2000/svg",
  width: 34,
  height: 34,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.5",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
  class: `homepage-card-icon ${className}`.trim(),
  "aria-hidden": "true" as const,
};
