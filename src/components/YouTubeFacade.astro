---
interface Props {
  videoId: string;
  title: string;
  posterUrl?: string; // Opt-in custom high-res poster
  aspectRatio?: string;
  class?: string;
}

const {
  videoId,
  title,
  posterUrl,
  aspectRatio = "16/9",
  class: className = "",
} = Astro.props;

// For production, using a custom WebP poster is highly recommended for best quality,
// but for Shorts and default videos, hqdefault.jpg natively guarantees existence.
const fallbackPoster = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
const finalPoster = posterUrl || fallbackPoster;
---

<div 
  class:list={["yt-facade", className]} 
  data-yid={videoId} 
  style={`--aspect: ${aspectRatio};`}
  role="button"
  tabindex="0"
  aria-label={`Lancer la vidéo : ${title}`}
>
  <img 
    src={finalPoster} 
    alt={`Aperçu de la vidéo : ${title}`} 
    loading="lazy" 
    class="yt-facade-poster"
  />
  <div class="yt-play-overlay">
    <button class="yt-play-btn" aria-hidden="true" tabindex="-1">
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <path d="M8 5v14l11-7z" />
      </svg>
    </button>
  </div>
</div>

<style>
  .yt-facade {
    position: relative;
    width: auto;
    max-width: 100%;
    max-height: 75vh;
    margin: 0 auto; /* Ensure it stays centered if scaling down */
    aspect-ratio: var(--aspect);
    background-color: #080d14; /* Dark theme navy */
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .yt-facade:hover, .yt-facade:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgba(0, 31, 63, 0.25);
    outline: none;
  }

  .yt-facade-poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .yt-facade.is-loaded .yt-facade-poster,
  .yt-facade.is-loaded .yt-play-overlay {
    display: none;
  }

  /* Deepen the image when hovering for cinematic effect */
  .yt-facade:hover .yt-facade-poster {
    opacity: 0.75;
    transform: scale(1.02);
  }

  .yt-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  /* Glassmorphism premium play button */
  .yt-play-btn {
    position: relative;
    width: 72px;
    height: 72px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }

  .yt-play-btn svg {
    width: 34px;
    height: 34px;
    margin-left: 4px; /* Optically center the play triangle */
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    transition: color 0.3s ease;
  }

  /* Elegant pulsing aura */
  .yt-play-btn::before {
    content: '';
    position: absolute;
    inset: -15px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    animation: play-pulse 2.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    pointer-events: none;
  }

  @keyframes play-pulse {
    0% { transform: scale(0.85); opacity: 0; border-width: 2px; }
    50% { opacity: 0.6; }
    100% { transform: scale(1.3); opacity: 0; border-width: 0.5px; }
  }

  /* On hover, transition directly to the brand's premium Gold (#f0c14b) */
  .yt-facade:hover .yt-play-btn, .yt-facade:focus-visible .yt-play-btn {
    background: rgba(240, 193, 75, 0.95);
    border-color: #f0c14b;
    transform: scale(1.08);
    box-shadow: 0 8px 25px rgba(240, 193, 75, 0.4);
  }

  .yt-facade:hover .yt-play-btn svg, .yt-facade:focus-visible .yt-play-btn svg {
    color: #001f3f; /* Deep brand blue for contrast against gold */
    filter: none;
  }

  .yt-facade:hover .yt-play-btn::before {
    border-color: rgba(240, 193, 75, 0.6);
  }

  /* Support original inline desktop video layer natively */
  :global(.yt-facade iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: #000;
  }

  /* Note: Full-width structural expansion on Mobile is securely handled directly via JS ancestor manipulation */
</style>

<script>
  let ytGhostPlayer = null;
  let isYtApiReady = false;
  let isYtApiLoading = false;
  let ghostResizeObserver = null;

  const initGhostOverlay = () => {
    if (document.getElementById('yt-ghost-wrapper')) return;
    
    // Create the global invisible ghost wrapper
    const wrapper = document.createElement('div');
    wrapper.id = 'yt-ghost-wrapper';
    wrapper.title = 'YouTube video player'; // Best Practices fix
    wrapper.style.position = 'absolute';
    wrapper.style.zIndex = '999';
    wrapper.style.top = '-9999px';
    wrapper.style.left = '-9999px';
    wrapper.style.width = '100px';
    wrapper.style.height = '100px';
    wrapper.style.border = 'none';
    wrapper.style.backgroundColor = '#000';
    wrapper.style.pointerEvents = 'auto'; // Allows natural touch forwarding

    const iframeBox = document.createElement('div');
    iframeBox.id = 'yt-ghost-iframe';

    wrapper.appendChild(iframeBox);
    document.body.appendChild(wrapper);
  };

  const loadYTAPI = () => {
    isYtApiLoading = true;
    initGhostOverlay();

    if (!document.getElementById('youtube-api-script')) {
      if (typeof window !== 'undefined') {
        window.onYouTubeIframeAPIReady = () => {
          isYtApiReady = true;
          if (document.getElementById('yt-ghost-iframe')) {
            ytGhostPlayer = new window.YT.Player('yt-ghost-iframe', {
              height: '100%',
              width: '100%',
              playerVars: {
                playsinline: 1,
                rel: 0,
                showinfo: 0,
                modestbranding: 1,
                autoplay: 1,
                controls: 1
              }
            });
          }
        };
      }
      const tag = document.createElement('script');
      tag.id = 'youtube-api-script';
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
    } else if (typeof window !== 'undefined' && window.YT && window.YT.Player) {
      // Re-initialize safely for Astro View Transitions if DOM was wiped but script remains
      isYtApiReady = true;
      if (document.getElementById('yt-ghost-iframe')) {
        ytGhostPlayer = new window.YT.Player('yt-ghost-iframe', {
          height: '100%',
          width: '100%',
          playerVars: {
            playsinline: 1,
            rel: 0,
            showinfo: 0,
            modestbranding: 1,
            autoplay: 1,
            controls: 1
          }
        });
      }
    }
  };

  const syncGhostPosition = (facade) => {
    const wrapper = document.getElementById('yt-ghost-wrapper');
    if (!wrapper) return;
    const rect = facade.getBoundingClientRect();
    wrapper.style.top = `${rect.top + window.scrollY}px`;
    wrapper.style.left = `${rect.left + window.scrollX}px`;
    wrapper.style.width = `${rect.width}px`;
    wrapper.style.height = `${rect.height}px`;
  };

  const startGhostSync = (facade) => {
    if (ghostResizeObserver) {
      ghostResizeObserver.disconnect();
    }
    syncGhostPosition(facade);

    // CPU-friendly hardware-accelerated layout sync replaces heavy setInterval
    ghostResizeObserver = new ResizeObserver(() => {
      syncGhostPosition(facade);
    });
    ghostResizeObserver.observe(facade);
    ghostResizeObserver.observe(document.body);
  };

  const stopGhostSync = () => {
    if (ghostResizeObserver) {
      ghostResizeObserver.disconnect();
      ghostResizeObserver = null;
    }
    const wrapper = document.getElementById('yt-ghost-wrapper');
    if (wrapper) {
      wrapper.style.top = '-9999px';
      wrapper.style.left = '-9999px';
    }
  };

  const createIframe = (videoId) => {
    const iframe = document.createElement('iframe');
    iframe.setAttribute('src', `https://www.youtube.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0&showinfo=0&modestbranding=1`);
    iframe.setAttribute('title', 'YouTube video player'); // Best Practices
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
    iframe.setAttribute('allowfullscreen', '');
    return iframe;
  };

  const loadInlineVideo = (facade, videoId) => {
    if (facade.classList.contains('is-loaded')) return;

    // Reset previously playing Ghost Players cleanly
    if (ytGhostPlayer && typeof ytGhostPlayer.stopVideo === 'function') {
      try { ytGhostPlayer.stopVideo(); } catch (e) {}
    }
    stopGhostSync();

    // Structurally reset old UI facades
    const activeFacades = document.querySelectorAll('.yt-facade.is-loaded');
    activeFacades.forEach((activeNode) => {
      if (activeNode !== facade) {
        activeNode.classList.remove('is-loaded');
        const oldParentCard = activeNode.closest('.video-card');
        if (oldParentCard) oldParentCard.style.gridColumn = '';
        const iframeToRemove = activeNode.querySelector('iframe');
        if (iframeToRemove) iframeToRemove.remove();
      }
    });

    facade.classList.add('is-loaded');
    
    // Mobile cinematic structural grid expansion
    const parentCard = facade.closest('.video-card');
    if (parentCard && window.innerWidth <= 768) {
      parentCard.style.gridColumn = '1 / -1';
    }

    if (isYtApiReady && ytGhostPlayer && typeof ytGhostPlayer.loadVideoById === 'function') {
      // API is ready: Execute the Pre-warmed Ghost Overlay
      setTimeout(() => {
        const wrapper = document.getElementById('yt-ghost-wrapper');
        if (wrapper) {
          startGhostSync(facade);
          ytGhostPlayer.loadVideoById(videoId);
        }
        if (window.innerWidth <= 768 && parentCard) {
          parentCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, 40);
    } else {
      // Fallback: Synchronous DOM injection guarantees standard autoplay if API evaded Pre-warm
      const iframe = createIframe(videoId);
      facade.appendChild(iframe);
      if (window.innerWidth <= 768 && parentCard) {
        setTimeout(() => {
          parentCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 40);
      }
    }
  };

  const initFacades = () => {
    // 1. Astro View Transition persistence restoration
    if (isYtApiLoading && !document.getElementById('yt-ghost-wrapper')) {
      loadYTAPI(); 
    }

    const facades = document.querySelectorAll('.yt-facade');
    
    // 2. IntersectionObserver triggers lazy Pre-Warm exactly 800px beforehand
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (!isYtApiLoading) loadYTAPI();
          // Disconnect to guarantee zero subsequent CPU processing
          observer.disconnect();
        }
      });
    }, { rootMargin: '800px 0px' });

    facades.forEach(facade => {
      observer.observe(facade); // Register for lazy loading sensing

      // 3. Purge ghost event listeners across re-rendering boundaries safely
      const clone = facade.cloneNode(true);
      if (facade.parentNode) facade.parentNode.replaceChild(clone, facade);

      clone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const videoId = clone.getAttribute('data-yid');
          if (videoId) loadInlineVideo(clone, videoId);
        }
      });
      
      clone.addEventListener('click', () => {
        const videoId = clone.getAttribute('data-yid');
        if (videoId) loadInlineVideo(clone, videoId);
      });
    });
  };

  // Bind respectfully acknowledging Astro's architecture
  document.addEventListener('DOMContentLoaded', initFacades);
  document.addEventListener('astro:page-load', initFacades);
</script>
