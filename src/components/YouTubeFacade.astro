---
interface Props {
  videoId: string;
  title: string;
  posterUrl?: string; // Opt-in custom high-res poster
  aspectRatio?: string;
  class?: string;
}

const {
  videoId,
  title,
  posterUrl,
  aspectRatio = "16/9",
  class: className = "",
} = Astro.props;

// For production, using a custom WebP poster is highly recommended for best quality,
// but for Shorts and default videos, hqdefault.jpg natively guarantees existence.
const fallbackPoster = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
const finalPoster = posterUrl || fallbackPoster;
---

<div 
  class:list={["yt-facade", className]} 
  data-yid={videoId} 
  style={`--aspect: ${aspectRatio};`}
  role="button"
  tabindex="0"
  aria-label={`Lancer la vidéo : ${title}`}
>
  <img 
    src={finalPoster} 
    alt={`Aperçu de la vidéo : ${title}`} 
    loading="lazy" 
    class="yt-facade-poster"
  />
  <div class="yt-play-overlay">
    <button class="yt-play-btn" aria-hidden="true" tabindex="-1">
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <path d="M8 5v14l11-7z" />
      </svg>
    </button>
  </div>
</div>

<style>
  .yt-facade {
    position: relative;
    width: auto;
    max-width: 100%;
    max-height: 75vh;
    margin: 0 auto; /* Ensure it stays centered if scaling down */
    aspect-ratio: var(--aspect);
    background-color: #080d14; /* Dark theme navy */
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .yt-facade:hover, .yt-facade:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgba(0, 31, 63, 0.25);
    outline: none;
  }

  .yt-facade-poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .yt-facade.is-loaded .yt-facade-poster,
  .yt-facade.is-loaded .yt-play-overlay {
    display: none;
  }

  /* Deepen the image when hovering for cinematic effect */
  .yt-facade:hover .yt-facade-poster {
    opacity: 0.75;
    transform: scale(1.02);
  }

  .yt-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  /* Glassmorphism premium play button */
  .yt-play-btn {
    position: relative;
    width: 72px;
    height: 72px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }

  .yt-play-btn svg {
    width: 34px;
    height: 34px;
    margin-left: 4px; /* Optically center the play triangle */
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    transition: color 0.3s ease;
  }

  /* Elegant pulsing aura */
  .yt-play-btn::before {
    content: '';
    position: absolute;
    inset: -15px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    animation: play-pulse 2.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    pointer-events: none;
  }

  @keyframes play-pulse {
    0% { transform: scale(0.85); opacity: 0; border-width: 2px; }
    50% { opacity: 0.6; }
    100% { transform: scale(1.3); opacity: 0; border-width: 0.5px; }
  }

  /* On hover, transition directly to the brand's premium Gold (#f0c14b) */
  .yt-facade:hover .yt-play-btn, .yt-facade:focus-visible .yt-play-btn {
    background: rgba(240, 193, 75, 0.95);
    border-color: #f0c14b;
    transform: scale(1.08);
    box-shadow: 0 8px 25px rgba(240, 193, 75, 0.4);
  }

  .yt-facade:hover .yt-play-btn svg, .yt-facade:focus-visible .yt-play-btn svg {
    color: #001f3f; /* Deep brand blue for contrast against gold */
    filter: none;
  }

  .yt-facade:hover .yt-play-btn::before {
    border-color: rgba(240, 193, 75, 0.6);
  }

  /* ================================
     PREMIUM OVERLAY MODAL STYLES
  ================================ */
  :global(#yt-modal-overlay) {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(4, 8, 14, 0.95);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    z-index: 999999;
    display: flex;
    flex-direction: column; /* Force vertical stacking to separate header from video natively */
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    animation: modalFadeIn 0.3s forwards ease-out;
  }

  /* ================================
     PREMIUM HEADER & MODAL STYLES
  ================================ */
  :global(#yt-modal-header) {
    width: 100%;
    max-width: 450px; /* Constrict exactly to structural video width */
    padding: 0 0 1.25rem 0; /* Buffer explicit breathing room visually above the video limit */
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 1000000;
    box-sizing: border-box;
    pointer-events: none; /* Let clicks pass through empty areas */
  }

  :global(.yt-modal-brand) {
    display: flex;
    align-items: center;
    pointer-events: auto; /* Re-enable clicks for the logo pill */
    animation: modalFadeIn 0.5s forwards ease-out 0.1s;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.yt-modal-brand img) {
    height: 48px; /* Slightly larger, elegant presence */
    width: auto;
    display: block;
    /* Pure cinematic monochrome white logic */
    filter: brightness(0) invert(1) drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    opacity: 0.85;
    transition: all 0.3s ease;
  }

  :global(.yt-modal-brand:hover img) {
    opacity: 1;
    filter: brightness(0) invert(1) drop-shadow(0 0 15px rgba(255,255,255,0.4));
  }

  @media (max-width: 600px) {
    :global(.yt-modal-brand img) {
      height: 38px;
    }
  }

  :global(.yt-modal-close) {
    position: relative;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    width: 44px;
    height: 44px;
    font-size: 2.8rem;
    font-weight: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: auto;
  }

  :global(.yt-modal-close:hover) {
    background: #f0c14b;
    color: #001f3f;
    border-color: #f0c14b;
    transform: scale(1.1);
  }

  :global(.yt-modal-content) {
    position: relative;
    width: 100%;
    max-width: 450px;
    height: 100%; /* Adapt freely up to max limits alongside header */
    max-height: 78vh; /* Scaled securely to make perfect room for header element on mobile */
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.8);
    transform: scale(0.95) translateY(20px);
    animation: modalScaleUp 0.4s forwards cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  :global(.yt-modal-content iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: #000;
  }

  /* Lock body scrolling when modal is active */
  :global(body.yt-modal-locked) {
    overflow: hidden !important;
  }

  @keyframes modalFadeIn {
    to { opacity: 1; }
  }

  @keyframes modalScaleUp {
    to { transform: scale(1) translateY(0); }
  }

  /* Outgoing animations mapped via JS delay */
  :global(#yt-modal-overlay.is-closing) {
    animation: modalFadeOut 0.3s forwards ease-in;
  }
  
  :global(#yt-modal-overlay.is-closing .yt-modal-content) {
    animation: modalScaleDown 0.3s forwards cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes modalFadeOut {
    to { opacity: 0; }
  }

  @keyframes modalScaleDown {
    to { transform: scale(0.95) translateY(10px); }
  }
</style>

<script>
  let activeModal: HTMLElement | null = null;

  const closeYoutubeModal = () => {
    if (!activeModal) return;
    
    // Trigger outbound animation
    activeModal.classList.add('is-closing');
    
    // Unlock body scrolling instantly to feel responsive
    document.body.classList.remove('yt-modal-locked');

    // Wait for cinematic animation to finish (300ms) before destroying DOM
    setTimeout(() => {
      if (activeModal && activeModal.parentNode) {
        activeModal.parentNode.removeChild(activeModal);
      }
      activeModal = null;
    }, 300);
  };

  const spawnYoutubeModal = (videoId: string) => {
    // SINGLETON: If one is already open, instantly kill it.
    if (activeModal) closeYoutubeModal();

    // Lock page background
    document.body.classList.add('yt-modal-locked');

    // Build the overlay wrapper
    const overlay = document.createElement('div');
    overlay.id = 'yt-modal-overlay';
    
    // Close on background click
    overlay.addEventListener('click', (e) => {
      // Allow clicking the overlay itself to close it
      if (e.target === overlay) closeYoutubeModal();
    });

    // Build header layout container
    const header = document.createElement('header');
    header.id = 'yt-modal-header';

    // Build glowing glass brand pill
    const brandPill = document.createElement('div');
    brandPill.className = 'yt-modal-brand';
    
    const brandLogo = document.createElement('img');
    brandLogo.src = '/images/logo-last-update-1.webp?v=finalv4';
    brandLogo.alt = 'Groupe Nettoyage Empire Logo';
    
    brandPill.appendChild(brandLogo);

    // Build close button
    const closeBtn = document.createElement('button');
    closeBtn.className = 'yt-modal-close';
    closeBtn.innerHTML = '×';
    closeBtn.setAttribute('aria-label', 'Fermer la vidéo');
    closeBtn.addEventListener('click', closeYoutubeModal);

    // Assemble header
    header.appendChild(brandPill);
    header.appendChild(closeBtn);

    // Build content bounding box for video
    const contentBox = document.createElement('div');
    contentBox.className = 'yt-modal-content';

    // Build the actual iframe
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&showinfo=0&modestbranding=1`;
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;

    // Assemble DOM
    contentBox.appendChild(iframe);
    overlay.appendChild(header);
    overlay.appendChild(contentBox);
    document.body.appendChild(overlay);
    
    activeModal = overlay;
  };

  const initFacades = () => {
    const facades = document.querySelectorAll('.yt-facade');
    facades.forEach(facade => {
      const clone = facade.cloneNode(true) as HTMLElement;
      if (facade.parentNode) facade.parentNode.replaceChild(clone, facade);

      clone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const videoId = clone.getAttribute('data-yid');
          if (videoId) spawnYoutubeModal(videoId);
        }
      });
      
      clone.addEventListener('click', () => {
        const videoId = clone.getAttribute('data-yid');
        if (videoId) spawnYoutubeModal(videoId);
      });
    });

    // Global ESC key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeModal) {
        closeYoutubeModal();
      }
    });
  };

  // Run on first load and also after Astro page transitions if enabled
  document.addEventListener('DOMContentLoaded', initFacades);
  document.addEventListener('astro:page-load', initFacades);
</script>
