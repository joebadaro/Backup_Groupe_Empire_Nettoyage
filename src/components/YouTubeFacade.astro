---
interface Props {
  videoId: string;
  title: string;
  posterUrl?: string; // Opt-in custom high-res poster
  aspectRatio?: string;
  class?: string;
}

const {
  videoId,
  title,
  posterUrl,
  aspectRatio = "16/9",
  class: className = "",
} = Astro.props;

// For production, using a custom WebP poster is highly recommended for best quality,
// but for Shorts and default videos, hqdefault.jpg natively guarantees existence.
const fallbackPoster = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
const finalPoster = posterUrl || fallbackPoster;
---

<div 
  class:list={["yt-facade", className]} 
  data-yid={videoId} 
  style={`--aspect: ${aspectRatio};`}
  role="button"
  tabindex="0"
  aria-label={`Lancer la vidéo : ${title}`}
>
  <img 
    src={finalPoster} 
    alt={`Aperçu de la vidéo : ${title}`} 
    loading="lazy" 
    class="yt-facade-poster"
  />
  <div class="yt-play-overlay">
    <button class="yt-play-btn" aria-hidden="true" tabindex="-1">
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <path d="M8 5v14l11-7z" />
      </svg>
    </button>
  </div>
</div>

<style>
  .yt-facade {
    position: relative;
    width: auto;
    max-width: 100%;
    max-height: 75vh;
    margin: 0 auto; /* Ensure it stays centered if scaling down */
    aspect-ratio: var(--aspect);
    background-color: #080d14; /* Dark theme navy */
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .yt-facade:hover, .yt-facade:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgba(0, 31, 63, 0.25);
    outline: none;
  }

  .yt-facade-poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .yt-facade.is-loaded .yt-facade-poster,
  .yt-facade.is-loaded .yt-play-overlay {
    display: none;
  }

  /* Deepen the image when hovering for cinematic effect */
  .yt-facade:hover .yt-facade-poster {
    opacity: 0.75;
    transform: scale(1.02);
  }

  .yt-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  /* Glassmorphism premium play button */
  .yt-play-btn {
    position: relative;
    width: 72px;
    height: 72px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }

  .yt-play-btn svg {
    width: 34px;
    height: 34px;
    margin-left: 4px; /* Optically center the play triangle */
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    transition: color 0.3s ease;
  }

  /* Elegant pulsing aura */
  .yt-play-btn::before {
    content: '';
    position: absolute;
    inset: -15px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    animation: play-pulse 2.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    pointer-events: none;
  }

  @keyframes play-pulse {
    0% { transform: scale(0.85); opacity: 0; border-width: 2px; }
    50% { opacity: 0.6; }
    100% { transform: scale(1.3); opacity: 0; border-width: 0.5px; }
  }

  /* On hover, transition directly to the brand's premium Gold (#f0c14b) */
  .yt-facade:hover .yt-play-btn, .yt-facade:focus-visible .yt-play-btn {
    background: rgba(240, 193, 75, 0.95);
    border-color: #f0c14b;
    transform: scale(1.08);
    box-shadow: 0 8px 25px rgba(240, 193, 75, 0.4);
  }

  .yt-facade:hover .yt-play-btn svg, .yt-facade:focus-visible .yt-play-btn svg {
    color: #001f3f; /* Deep brand blue for contrast against gold */
    filter: none;
  }

  .yt-facade:hover .yt-play-btn::before {
    border-color: rgba(240, 193, 75, 0.6);
  }

  /* Support original inline desktop video layer natively */
  :global(.yt-facade iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: #000;
  }

  /* Note: Full-width structural expansion on Mobile is securely handled directly via JS ancestor manipulation */
</style>

<script>
  // ─── Preconnect helper ───────────────────────────────────────────────────────
  // Adds DNS-preconnect + preconnect link tags for YouTube origins ONE time only.
  // This is pure network warmup — no script, no player, no DOM weight at all.
  const addYouTubePreconnect = () => {
    if (document.querySelector('link[data-yt-preconnect]')) return;
    const origins = [
      'https://www.youtube.com',
      'https://www.youtube-nocookie.com',
      'https://i.ytimg.com',
    ];
    origins.forEach(origin => {
      const dns = document.createElement('link');
      dns.rel = 'dns-prefetch';
      dns.href = origin;
      dns.setAttribute('data-yt-preconnect', '');
      document.head.appendChild(dns);

      const pre = document.createElement('link');
      pre.rel = 'preconnect';
      pre.href = origin;
      pre.crossOrigin = 'anonymous';
      document.head.appendChild(pre);
    });
  };

  // ─── Iframe factory ──────────────────────────────────────────────────────────
  // Creates a fully-compliant YouTube iframe with autoplay + playsinline.
  // Injected SYNCHRONOUSLY inside the click handler → mobile OS trusts the gesture.
  const createIframe = (videoId) => {
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0&modestbranding=1`;
    iframe.title = 'YouTube video player';
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
    iframe.setAttribute('allowfullscreen', '');
    return iframe;
  };

  // ─── Video activation ────────────────────────────────────────────────────────
  const activateVideo = (facade, videoId) => {
    if (facade.classList.contains('is-loaded')) return;

    // Reset any previously active card
    document.querySelectorAll('.yt-facade.is-loaded').forEach(node => {
      if (node === facade) return;
      node.classList.remove('is-loaded');
      const oldCard = node.closest('.video-card');
      if (oldCard) oldCard.style.gridColumn = '';
      const oldIframe = node.querySelector('iframe');
      if (oldIframe) oldIframe.remove();
    });

    facade.classList.add('is-loaded');

    // Mobile grid expansion
    const parentCard = facade.closest('.video-card');
    if (parentCard && window.innerWidth <= 768) {
      parentCard.style.gridColumn = '1 / -1';
    }

    // ── SYNCHRONOUS injection ─────────────────────────────────────────────────
    // The iframe is appended within the SAME call-stack as the user's click/tap.
    // iOS Safari and Android Chrome both require this to honour autoplay.
    // Any async gap (setTimeout, await, etc.) breaks the gesture-trust chain.
    facade.appendChild(createIframe(videoId));

    // Smooth-scroll the card into view on mobile (deferred is fine after injection)
    if (window.innerWidth <= 768 && parentCard) {
      setTimeout(() => {
        parentCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 40);
    }
  };

  // ─── IntersectionObserver — preconnect only ──────────────────────────────────
  // Fires when the user scrolls within 600 px of any facade.
  // Only adds <link rel="preconnect"> tags — no script download, no player init.
  const observeFacadesForPreconnect = (facades) => {
    if (!('IntersectionObserver' in window)) return;

    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          addYouTubePreconnect();
          obs.disconnect(); // One-shot, zero ongoing CPU cost
        }
      });
    }, { rootMargin: '600px 0px' });

    facades.forEach(f => io.observe(f));
  };

  // ─── Bootstrap ───────────────────────────────────────────────────────────────
  const initFacades = () => {
    const facades = Array.from(document.querySelectorAll('.yt-facade'));
    if (!facades.length) return;

    observeFacadesForPreconnect(facades);

    facades.forEach(facade => {
      // Clone node to purge any stale listeners from previous Astro page loads
      const clone = facade.cloneNode(true);
      facade.parentNode?.replaceChild(clone, facade);

      clone.addEventListener('click', () => {
        const vid = clone.getAttribute('data-yid');
        if (vid) activateVideo(clone, vid);
      });

      clone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const vid = clone.getAttribute('data-yid');
          if (vid) activateVideo(clone, vid);
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initFacades);
  document.addEventListener('astro:page-load', initFacades);
</script>

