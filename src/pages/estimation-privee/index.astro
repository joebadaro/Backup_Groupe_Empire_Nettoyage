---
/**
 * Outil interne uniquement — calculateur d’estimation.
 * Non référencé publiquement ; noindex ; hors sitemap.
 */
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Estimation (interne)"
  description="Outil réservé à l’équipe."
  robots="noindex, nofollow"
  includePrivateCalculator={true}
>
  <div class="container" style="padding: 2rem 1rem 4rem; max-width: 720px;">
    <p style="color: #555; font-size: 0.95rem; margin: 0;">
      Outil interne — utilisez le bouton « Estimation gratuite » ou la barre mobile pour ouvrir la
      calculatrice.
    </p>
  </div>
</Layout>

<script>
  /** Chargé seulement sur cette route — évite d’écraser window.openEstimationWidget sur le reste du site (dev + prod). */
  import "../../scripts/estimation-bootstrap-lazy.ts";
</script>
