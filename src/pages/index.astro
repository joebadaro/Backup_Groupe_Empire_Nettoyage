        .split-layout {
          grid-template-columns: 1fr;
          text-align: center;
          gap: 4rem;
        }
        .eco-list {
          text-align: left;
        }
        .eco-circle-bg {
          width: 300px;
          height: 300px;
        }
        .reverse-mobile {
          display: flex;
          flex-direction: column-reverse;
        }
        .tech-image-wrapper {
          margin-bottom: 4rem;
        }
        .hero-title {
          font-size: 2.8rem; /* Slightly smaller for better fit */
          margin-bottom: 1.5rem;
        }
        .hero-subtitle-group .hero-subtitle {
          font-size: 1.1rem;
        }

        .hero-subtitle-group {
          margin-bottom: 2rem;
        }
        .hero-badge {
          margin-bottom: 1.5rem;
          padding: 8px 20px; /* Smaller padding */
          background: rgba(255, 255, 255, 0.05); /* Very subtle */
          border: 1px solid rgba(255, 255, 255, 0.1); /* Very thin border */
          backdrop-filter: none; /* Remove heavy blur on mobile for clarity */
        }

        .watermark-trust,
        .watermark-eco {
          width: 200px;
          height: 200px;
          opacity: 0.1;
        }
      }

      @media (max-width: 1024px) and (min-width: 769px) {
        .hero-section {
          padding: 8rem 0 6rem 0;
          min-height: 65vh;
          display: flex;
          align-items: center;
        }
      }

      /*
       * Mobile (≤768): hauteur du hero = global.css (clamp + vw uniquement, pas de vh/svh/dvh) — stable WebView Google iPhone.
       * 1 image, pas de slideshow JS, pas de fade (voir global.css + script is:inline).
       */
      @media (max-width: 768px) {
        .hero-section {
          display: flex;
          flex-direction: row;
          align-items: flex-start;
          justify-content: center;
          /* Bas : prolonge la photo à la place de l’ancienne vague (mobile homepage uniquement) */
          padding: 4.75rem 1rem 5rem;
          box-sizing: border-box;
          /* Homepage seulement (scoped) : hero un peu plus bas / compact que global.css */
          min-height: clamp(340px, 168vw, 600px) !important;
        }

        .hero-section .hero-content {
          width: 100%;
          max-width: 100%;
          padding-left: 0.5rem;
          padding-right: 0.5rem;
          /* Hero mobile : CTA masqués — marge légère pour le contenu texte */
          padding-bottom: 1.25rem;
        }

        /* Badge « Choix du consommateur » : ~40 % plus compact (surface), mobile seulement */
        .hero-section .hero-badge {
          margin-bottom: 0.75rem;
          padding: 5px 14px !important;
          border-radius: 12px;
          max-width: min(100%, 20rem);
          /* Moins coûteux que blur(10px) du style de base — même effet « verre » */
          backdrop-filter: blur(6px);
        }

        /* Isole le paint du slideshow — mobile seulement */
        .hero-section .hero-slideshow {
          contain: paint;
        }

        .hero-section .badge-main {
          font-size: 0.95rem !important;
          letter-spacing: 0.06em !important;
          gap: 6px !important;
          margin-bottom: 2px !important;
          line-height: 1.15 !important;
        }

        .hero-section .badge-icon-img {
          width: 30px !important;
          height: auto !important;
        }

        .hero-section .badge-sub {
          font-size: 0.62rem !important;
          letter-spacing: 0.14em !important;
        }

        .hero-section .hero-title {
          margin-bottom: 1.1rem;
          font-size: 2.65rem;
          line-height: 1.05;
        }

        .hero-subtitle-group {
          margin-bottom: 1.15rem;
        }

        .hero-subtitle--desktop {
          display: none !important;
        }

        .hero-subtitle--mobile {
          color: #e8edf4;
          font-weight: 500;
          line-height: 1.45;
          text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
        }

        /* Portrait + crossfade plus court que desktop (5.2s) — activé seulement après data-hero-ready */
        .hero-slide {
          object-position: center 50%;
        }

        .hero-slideshow[data-hero-ready] .hero-slide {
          transition: opacity 1.2s ease-in-out;
        }

        .hero-slogan-layer {
          transition: opacity 1.2s ease-in-out;
        }

        /* Entrée hero plus courte — moins d’animations longues sur le 1er écran (mobile seulement) */
        .hero-section .animate-on-load {
          animation-duration: 0.45s;
        }
        .hero-section .delay-1 {
          animation-delay: 0.08s;
        }
        .hero-section .delay-2 {
          animation-delay: 0.16s;
        }
        .hero-section .delay-3 {
          animation-delay: 0.24s;
        }

        .section-services {
          margin-top: 0 !important;
          padding: 3.65rem 0 8rem !important;
        }
      }

      /* --- Mobile trust (≤768px): overlay dans le hero (position:absolute) — pas de marge négative / pas de chevauchement services --- */
      @media (max-width: 768px) {
        .hero-section .trust-container {
          position: absolute;
          left: 0;
          right: 0;
          top: auto;
          bottom: 72px;
          margin-top: 0 !important;
          margin-bottom: 0 !important;
          padding: 0 !important;
          z-index: 12;
          border-bottom: none;
          background: none !important;
          background-color: transparent !important;
          background-image: none !important;
          pointer-events: none;
          overflow: visible;
        }

        .hero-section .trust-container::before {
          display: none;
        }

        .hero-section .trust-kicker {
          font-size: 0.42rem;
          letter-spacing: 0.14em;
          margin: 0 0 0.18rem;
          color: rgba(255, 255, 255, 0.72);
          font-weight: 500;
          text-transform: uppercase;
          text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
        }

        .hero-section .trust-unified-wrap {
          max-width: 100%;
          margin-left: auto;
          margin-right: auto;
          border: none;
          background: transparent;
          box-shadow: none;
          padding: 0 0.65rem 0;
          overflow: visible;
          backdrop-filter: none;
        }

        .hero-section .trust-grid--desktop {
          display: none !important;
        }

        .hero-section .trust-grid--mobile {
          display: grid !important;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          column-gap: 0.35rem;
          row-gap: 0.35rem;
          align-items: stretch;
          padding: 0;
          margin: 0;
        }

        .hero-section .trust-grid--mobile .trust-pill {
          min-height: 0;
          margin: 0;
          padding: 0.25rem 0.28rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          justify-content: center;
          gap: 0.25rem;
          text-align: center;
          font-size: 0.575rem;
          line-height: 1.18;
          font-weight: 500;
          letter-spacing: 0.02em;
          color: rgba(255, 255, 255, 0.88);
          overflow-wrap: break-word;
          hyphens: auto;
          -webkit-font-smoothing: antialiased;
          border-radius: 999px;
          background: rgba(255, 255, 255, 0.06);
          border: 1px solid rgba(255, 255, 255, 0.1);
          box-shadow: none;
        }

        .hero-section .trust-grid--mobile .trust-pill--long {
          font-size: 0.55rem;
          line-height: 1.2;
          padding: 0.25rem 0.23rem;
        }

        .hero-section .trust-grid--mobile .trust-pill .icon {
          font-size: 0.625rem;
          line-height: 1;
          opacity: 0.78;
          flex-shrink: 0;
          margin-top: 0;
          filter: none;
        }
      }

      @media (max-width: 360px) {
        .hero-section .trust-container .trust-grid--mobile {
          grid-template-columns: 1fr 1fr;
        }
      }
      /* ================================
         PROMO HERO PILL (REFINED LUXURY)
      ================================ */
      .hero-promo-pill-wrapper {
        margin-top: 1.75rem;
        display: flex;
        justify-content: center;
        width: 100%;
        position: relative;
        z-index: 10;
        pointer-events: auto;
      }

      .hero-promo-pill {
        display: inline-flex;
        align-items: center;
        background: transparent;
