      }
      .big-num {
        font-size: 3rem;
        font-weight: 800;
        display: block;
        line-height: 1;
      }
      .tech-label {
        font-size: 1rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 1px;
      }

      /* --- CTA FINAL --- */
      .cta-final {
        background: linear-gradient(135deg, #f0f4f8, #ffffff);
        padding: 8rem 0;
      }
      .cta-title {
        color: var(--color-primary);
        font-size: 3rem;
        margin-bottom: 1.5rem;
        font-weight: 800;
        letter-spacing: -1px;
      }
      .cta-buttons {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        margin-top: 3rem;
        flex-wrap: wrap;
      }
      .btn-white-red {
        background: var(--color-brand-red);
        color: white;
        padding: 18px 40px;
        border-radius: 50px;
        font-weight: 700;
        transition: 0.3s;
        font-size: 1.1rem;
        box-shadow: 0 10px 25px rgba(211, 47, 47, 0.3);
      }
      .btn-white-red:hover {
        transform: scale(1.05);
        box-shadow: 0 15px 35px rgba(211, 47, 47, 0.5);
      }

      /* --- WATERMARK LOGO BRANDING --- */
      .brand-watermark {
        position: absolute;
        z-index: 0;
        opacity: 0.12; /* Increased to 12% to be definitely visible */
        pointer-events: none;
        background-image: url("/images/water-logo-home.webp");
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        mix-blend-mode: multiply;
      }

      .watermark-trust {
        top: -50px;
        left: -100px;
        width: 500px;
        height: 500px;
        transform: rotate(-15deg);
      }

      .watermark-eco {
        bottom: -100px;
        right: -100px;
        width: 600px;
        height: 600px;
        opacity: 0.15;
        transform: rotate(10deg);
      }

      /* Ensure sections are relative to contain watermark */
      .trust-container,
      .section-eco {
        position: relative;
        overflow: hidden;
      }

      /* --- QUALITY STRIP (REFINED) --- */
      .section-quality-strip-refined {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
        background: #f8fbff; /* Very subtle Ice Blue tint for premium separation */
        border-top: 1px solid rgba(0, 0, 0, 0.03);
        border-bottom: 1px solid rgba(0, 0, 0, 0.03);
      }

      .quality-image-wrapper {
        width: 100%;
        height: 100%;
        padding: 2rem; /* Give images some breathing room */
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .quality-img-full {
        width: 100%;
        height: auto;
        max-height: 450px;
        object-fit: cover; /* Changed from contain to cover to fill shape better */
        display: block;
        border-radius: 24px; /* Slightly more rounded */
        box-shadow: 0 25px 50px rgba(0, 50, 100, 0.15); /* Stronger, more elegant shadow */
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* 2e visuel « Une équipe dévouée » : même largeur utile que la photo du dessus, ratio 800×644, plus de hauteur si besoin */
      .quality-image-wrapper--van-frame .quality-img-full.quality-img-full--fullframe {
        width: 100%;
        max-width: 100%;
        max-height: none;
        height: auto;
        aspect-ratio: 800 / 644;
        object-fit: contain;
        object-position: center bottom;
        background: transparent;
        display: block;
        margin-inline: auto;
      }

      /* Photo entière — 3e vignette « La Puissance de nos Camions-Usines » uniquement */
      .tech-gallery .tech-img.tech-img--fullframe {
        object-fit: contain;
        object-position: center;
        width: 100%;
        height: 400px;
        min-height: unset;
        background: rgba(10, 35, 66, 0.35);
        box-sizing: border-box;
      }

      /* Elegant lift on hover */
      .quality-image-wrapper:hover .quality-img-full {
        transform: translateY(-10px);
        box-shadow: 0 30px 60px rgba(0, 50, 100, 0.12);
      }

      .quality-content-refined {
        padding: 3rem 2rem;
        color: var(--color-primary);
      }

      .quality-content-refined h3 {
        font-size: 2.2rem; /* Slightly larger */
        color: var(--color-primary);
        margin-bottom: 1rem;
        font-weight: 800;
      }
      .quality-content-refined p {
        font-size: 1.2rem;
        color: var(--color-text-light);
        line-height: 1.6;
      }

      /* RESPONSIVE — hero dans un media séparé (769–1024) pour ne pas appliquer 65vh aux phones (WebView Google iPhone) */
      @media (max-width: 1024px) {
        .section-quality-strip-refined {
          grid-template-columns: 1fr;
        }
        .quality-img-full {
          max-height: 300px;
        }
        .quality-image-wrapper--van-frame .quality-img-full.quality-img-full--fullframe {
          max-height: none;
        }
        .tech-gallery {
          grid-template-columns: 1fr;
        }
