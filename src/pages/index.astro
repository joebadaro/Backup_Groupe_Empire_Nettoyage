        >
      </div>
    </div>

    <script is:inline>
      // is:inline = exécuté tel quel sur le client (pas bundlé)
      // Démarrer le carrousel après l’enregistrement LCP (réduit render delay / reflows sur mobile).
      (function () {
        var __heroInited = false;
        function initHomeHeroSlideshow() {
          if (__heroInited) return;
          __heroInited = true;
          // Simple Cross-Fade Slideshow (Standardized)
          const slides = document.querySelectorAll(".slide");

          if (slides.length > 0) {
            let currentSlide = 0;
            const intervalTime = 4000; // 4 seconds

            setInterval(() => {
              slides[currentSlide].classList.remove("active");
              currentSlide = (currentSlide + 1) % slides.length;
              slides[currentSlide].classList.add("active");
            }, intervalTime);
          }

          // Hero slideshow (5 images) — desktop : swap direct. Mobile : crossfade court (CSS) + pause si touch récent (pas d’écouteur scroll : iOS le spamme pendant l’inertie et bloquait tous les swaps).
          const heroSlides = document.querySelectorAll(".hero-slide");
          if (heroSlides.length > 0) {
            let currentHeroSlide = 0;
            const isMobileHero =
              typeof window.matchMedia === "function" &&
              window.matchMedia("(max-width: 768px)").matches;
            const firstSwapDelayMs = isMobileHero ? 6000 : 4500;
            const swapIntervalMs = isMobileHero ? 5500 : 4500;

            const sloganA = document.querySelector(".hero-slogan--a");
            const sloganB = document.querySelector(".hero-slogan--b");

            const syncHeroSloganToSlide = (slideIndex) => {
              if (!sloganA || !sloganB) return;
              /* Photos 1–3: À la Vapeur; 4–5: Haut de Gamme */
              const showVapeur = slideIndex < 3;
              sloganA.classList.toggle("active", showVapeur);
              sloganB.classList.toggle("active", !showVapeur);
            };

            const subtitleGroup = document.querySelector(".hero-subtitle-group");
            const syncHeroSubtitleGroup = (slideIndex) => {
              if (!subtitleGroup) return;
              const hide = slideIndex >= 2;
              subtitleGroup.classList.toggle(
                "hero-subtitle-group--hidden-on-slides-34",
                hide,
              );
              subtitleGroup.setAttribute("aria-hidden", hide ? "true" : "false");
            };

            function prefetchHeroSlideCandidate(imgEl) {
              if (!imgEl || imgEl.tagName !== "IMG") return;
              var picture = imgEl.closest && imgEl.closest("picture");
              var pre = new Image();
              var chosenSrcset = null;
              var sizesAttr = imgEl.getAttribute("sizes") || "";
              if (picture) {
                var sources = picture.querySelectorAll("source[srcset]");
                for (var si = 0; si < sources.length; si++) {
                  var srcEl = sources[si];
                  var mediaQ = srcEl.getAttribute("media");
                  if (
                    mediaQ &&
                    typeof window.matchMedia === "function" &&
                    !window.matchMedia(mediaQ).matches
                  ) {
                    continue;
                  }
                  chosenSrcset = srcEl.getAttribute("srcset");
                  break;
                }
              }
              if (chosenSrcset) {
                pre.srcset = chosenSrcset;
                pre.sizes = sizesAttr;
              }
              var fallbackSrc = imgEl.getAttribute("src");
              if (fallbackSrc) pre.src = fallbackSrc;
              if (!chosenSrcset && imgEl.getAttribute("srcset")) {
                pre.srcset = imgEl.getAttribute("srcset");
                pre.sizes = sizesAttr;
              }
            }

            const swapHeroSlide = () => {
              heroSlides[currentHeroSlide].classList.remove("active");
              currentHeroSlide = (currentHeroSlide + 1) % heroSlides.length;
              heroSlides[currentHeroSlide].classList.add("active");
              syncHeroSloganToSlide(currentHeroSlide);
              syncHeroSubtitleGroup(currentHeroSlide);
              /* Mobile : ne pas précharger la slide suivante trop tôt (concurrence LCP / bande passante). */
              if (isMobileHero && currentHeroSlide < 1) return;
              const nextIdx = (currentHeroSlide + 1) % heroSlides.length;
              const nextImg = heroSlides[nextIdx];
              if (nextImg && !nextImg.dataset.heroPrefetched) {
                nextImg.dataset.heroPrefetched = "1";
                prefetchHeroSlideCandidate(nextImg);
              }
            };

            syncHeroSubtitleGroup(0);

            setTimeout(() => {
              const slideshow = document.querySelector(".hero-slideshow");
              if (slideshow) slideshow.setAttribute("data-hero-ready", "");
              swapHeroSlide();
              setInterval(swapHeroSlide, swapIntervalMs);
            }, firstSwapDelayMs);
          }
        }

        function runHeroInitInIdle() {
          requestAnimationFrame(function () {
            if ("requestIdleCallback" in window) {
              requestIdleCallback(
                function () {
                  initHomeHeroSlideshow();
                },
                { timeout: 2000 }
              );
            } else {
              setTimeout(initHomeHeroSlideshow, 0);
            }
          });
        }

        // Après l’enregistrement LCP (meilleur pour render delay) ; repli load / timeout.
        (function scheduleHeroInitAfterLCP() {
          var done = false;
          function go() {
            if (done) return;
            done = true;
            runHeroInitInIdle();
          }
          if (typeof PerformanceObserver !== "undefined") {
            try {
              var po = new PerformanceObserver(function (list) {
                var ents = list.getEntries();
                if (!ents.length) return;
                try {
                  po.disconnect();
                } catch (e) {}
                go();
              });
              po.observe({ type: "largest-contentful-paint", buffered: true });
            } catch (e) {}
          }
          window.addEventListener("load", go, { once: true });
          setTimeout(go, 6500);
        })();
      })();
    </script>

