        line-height: 1.6;
        margin-bottom: 1.5rem;
        color: rgba(255, 255, 255, 0.85);
      }

      /* --- ANIMATIONS V3 (Staggered & Smooth) — match EN: hero + sections animate on all viewports */
      .fade-in-section {
        opacity: 0;
        transform: translateY(30px);
        transition:
          opacity 0.8s ease-out,
          transform 0.8s ease-out;
        will-change: opacity, visibility;
      }
      .fade-in-section.is-visible {
        opacity: 1;
        transform: none;
      }

      /* CSS-Only Animation for Hero LCP (badge, title, subtitle, CTAs) */
      .animate-on-load {
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
      }
      .delay-1 {
        animation-delay: 0.2s;
      }
      .delay-2 {
        animation-delay: 0.4s;
      }
      .delay-3 {
        animation-delay: 0.6s;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .delay-100 {
        transition-delay: 100ms;
      }
      .delay-200 {
        transition-delay: 200ms;
      }
      .delay-300 {
        transition-delay: 300ms;
      }

      .text-gradient-tricolor {
        background: linear-gradient(
          90deg,
          #a2c2e1 0%,
          #ffffff 50%,
          #d32f2f 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
      }

      /* First line inside each full-slogan layer — solid white (no gradient) */
      .hero-slogan-white {
        color: #ffffff !important;
        -webkit-text-fill-color: #ffffff !important;
        background: none;
        -webkit-background-clip: border-box;
        background-clip: border-box;
      }

      /*
       * Slogan : même instant que le swap d’image — classe .active basculée dans swapHeroSlide() avec les .hero-slide.
       * transition: opacity = même durée que .hero-slide (5.2s desktop, 1.2s ≤768px).
       */
      .hero-slogan-wrap {
        display: inline-block;
        max-width: 100%;
        text-align: center;
        vertical-align: bottom;
      }

      .hero-slogan-rotate-stack {
        display: inline-grid;
        vertical-align: bottom;
        max-width: 100%;
        text-align: center;
      }

      .hero-slogan-sizer {
        grid-area: 1 / 1;
        visibility: hidden;
      }

      .hero-slogan-layer {
        grid-area: 1 / 1;
        transform: translateZ(0);
        opacity: 0;
        transition: opacity 5.2s ease-in-out;
        z-index: 1;
      }

      .hero-slogan-layer.active {
        opacity: 1;
        z-index: 2;
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-slogan-layer {
          transition: none !important;
        }

        .hero-slogan--a {
          opacity: 1 !important;
        }

        .hero-slogan--b {
          opacity: 0 !important;
          visibility: hidden;
        }

        .hero-slogan-sizer {
          display: none;
        }
      }

      /* --- NEW HERO --- */
      .hero-section {
        position: relative;
        /* Rich "Living Room" Background with Overlay */
        /* Rich "Living Room" Background with Overlay -> REPLACED BY SLIDESHOW */
        background: linear-gradient(
          rgba(10, 35, 66, 0.5),
          rgba(10, 35, 66, 0.5)
        );
        /* Fallback color if images fail */
        background-color: #0a2342;
        color: white;
        padding: 12rem 0 14rem 0; /* More expansive padding */
        overflow: hidden;
      }

      /* Mobile hero: padding défini dans @media ≤768 ; hauteur via global.css (vw + px, pas vh/svh) */

      /* --- SLIDESHOW CONTAINER --- */
      .hero-slideshow {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0; /* Behind content (which is z-index 10) */
      }

      .hero-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        opacity: 0;
        /* Pas de transition tant que le slideshow n’est pas prêt — LCP mobile sans fade initial */
        transition: none;
        z-index: 1;
      }

      .hero-slide.active {
        opacity: 1;
        z-index: 2;
      }

      .hero-slideshow[data-hero-ready] .hero-slide {
        transition: opacity 5.2s ease-in-out; /* 5.2s — même durée que .hero-slogan-layer */
      }

      .hero-overlay {
        /* Ensure overlay is ABOVE slides but BELOW content */
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* Gradient: Transparent top to Dark Blue bottom for text readability */
        background: linear-gradient(
          to bottom,
          rgba(10, 35, 66, 0.1) 0%,
          rgba(10, 35, 66, 0.4) 50%,
          rgba(10, 35, 66, 0.9) 100%
        );
        z-index: 3;
        pointer-events: none;
      }

      .hero-badge {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        /* Much lighter, glass-like interaction */
        background: rgba(255, 255, 255, 0.08); /* Slightly more transparent */
        border: 1px solid rgba(255, 255, 255, 0.15); /* More subtle border */
        padding: 12px 30px;
        border-radius: 16px;
        margin-bottom: 2.5rem;
        backdrop-filter: blur(10px); /* Increased blur */
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
      }

      .hero-badge:hover {
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.3);
      }

      .badge-main {
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #ffffff;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        line-height: 1.1;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .badge-icon-img {
        width: 50px; /* Slightly larger for visibility */
        height: auto;
        filter: drop-shadow(
          0 2px 5px rgba(0, 0, 0, 0.3)
        ); /* Good shadow for depth */
      }

      .badge-sub {
        font-family: var(--font-body);
        font-size: 0.95rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: rgba(255, 255, 255, 0.9);
      }

      .hero-title {
        color: #ffffff !important; /* Force white for legibility */
        font-size: clamp(3.5rem, 7vw, 6rem); /* Bigger, Bolder */
        margin-bottom: 2rem;
        line-height: 1; /* Tigher line height for punchier look */
        text-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); /* Deep Shadow */
      }

      .hero-subtitle-group {
        max-width: 700px;
        margin: 0 auto 3rem auto;
        transition:
          opacity 3.5s ease,
          transform 3.5s ease;
        transform: translateY(0.5rem);
      }

      .hero-subtitle-group.hero-subtitle-group--hidden-on-slides-34 {
        opacity: 0;
        pointer-events: none;
      }

      .hero-subtitle {
        font-size: 1.3rem;
        color: #cbd5e1;
        margin: 0;
      }

      @media (min-width: 769px) {
        .hero-subtitle--mobile {
          display: none !important;
        }
      }

      .cta-btn-stack {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1.25;
        gap: 0.1rem;
        text-align: left;
      }
      .cta-btn-phone-num {
        font-size: 0.92em;
        font-weight: 800;
      }

      @media (max-width: 768px) {
        .hero-actions {
          display: none !important;
        }
      }

      /* --- TRUST INSIGNIA (unified premium band — hero → services) --- */
      .trust-container {
