---
import Layout from "../layouts/Layout.astro";
import GoogleReviewsSection from "../components/GoogleReviewsSection.astro";
import {
  HOMEPAGE_SERVICE_CARDS,
  getServiceImage,
  SERVICE_IMAGES_ASSET_VERSION,
} from "../data/serviceImagery";
import UiIcon from "../components/icons/UiIcon.astro";
import HomepageServiceCardIcon from "../components/icons/HomepageServiceCardIcon.astro";
import YouTubeFacade from "../components/YouTubeFacade.astro";
import PresentationHomeTeaser from "../components/PresentationHomeTeaser.astro";
import ConversionCtaPriorityGroup from "../components/ConversionCtaPriorityGroup.astro";
import {
  SALON_SECTIONNEL_POSTER_SIZES_HOME,
  SALON_SECTIONNEL_POSTER_SRCSET,
} from "../data/salonSectionnelPoster";
import { SALON_SECTIONNEL_UPLOAD_DATE } from "../lib/videoSchema";

const _v = SERVICE_IMAGES_ASSET_VERSION;
/** 3e vignette « La Puissance… » uniquement — bump si bytes de photo-56 changent (évite cache navigateur sur ?v= global). */
const PHOTO_56_TRUCK_TILE_V = "13";
const _teamFb = "/images/catalog/team-facebook-optimized";
const TEAM_FACEBOOK_SRCSET = `${_teamFb}-400.webp?v=${_v} 400w, ${_teamFb}-560.webp?v=${_v} 560w, ${_teamFb}-640.webp?v=${_v} 640w, ${_teamFb}.webp?v=${_v} 800w`;
const TEAM_FACEBOOK_SIZES =
  "(max-width: 768px) min(calc(100vw - 3rem), 560px), min(800px, 34vw)";

const _van = "/images/catalog/team-van-back-home";
const TEAM_VAN_SRCSET = `${_van}-400.webp?v=${_v} 400w, ${_van}-480.webp?v=${_v} 480w, ${_van}-640.webp?v=${_v} 640w, ${_van}.webp?v=${_v} 800w`;
const TEAM_VAN_SIZES =
  "(max-width: 768px) min(calc(100vw - 3rem), 520px), min(800px, 34vw)";

const _p8 = "/images/catalog/photo-8-home";
const PHOTO_8_SRCSET = `${_p8}-320.webp?v=${_v} 320w, ${_p8}-400.webp?v=${_v} 400w, ${_p8}-533.webp?v=${_v} 533w`;
const PHOTO_8_SIZES =
  "(max-width: 768px) min(calc(100vw - 2rem), 380px), min(50vw, 520px)";

const _p76 = "/images/catalog/photo-76";
const PHOTO_76_SRCSET = `${_p76}-400.webp?v=${_v} 400w, ${_p76}-640.webp?v=${_v} 640w, ${_p76}-800.webp?v=${_v} 800w, ${_p76}.webp?v=${_v} 1200w`;
const PHOTO_76_SIZES =
  "(max-width: 768px) min(calc(100vw - 3rem), 600px), min(50vw, 600px)";

const _choix = "/images/choix-quebec-optimized";
const CHOIX_SRCSET = `${_choix}-96.webp?v=${_v} 96w, ${_choix}-128.webp?v=${_v} 128w, ${_choix}.webp?v=${_v} 200w`;
const CHOIX_SIZES = "(max-width: 768px) 30px, 40px";
---

<Layout
  title="Groupe Nettoyage Empire - L'Excellence du Nettoyage au Québec"
  description="Services de nettoyage de premier plan pour tapis, meubles et matelas à Montréal et Québec. Techniciens certifiés, produits écologiques haut de gamme et technologie de camion-usine."
>
  <!-- LCP mobile : img portrait directe (pas via source) — srcset plafonné à 800w pour limiter la variance DPR 3× -->
  <link
    slot="head"
    rel="preload"
    as="image"
    fetchpriority="high"
    imagesrcset="/images/catalog/hero-salon-nettoyage-vapeur-montreal-portrait-480.webp 480w, /images/catalog/hero-salon-nettoyage-vapeur-montreal-portrait-640.webp 640w, /images/catalog/hero-salon-nettoyage-vapeur-montreal-portrait-800.webp 800w"
    imagesizes="100vw"
    media="(max-width: 768px)"
  />
  <!-- LCP desktop slide 1 : même srcset que le <source min-width:769px> -->
  <link
    slot="head"
    rel="preload"
    as="image"
    fetchpriority="high"
    imagesrcset="/images/catalog/hero-slide-2-mobile.webp 800w, /images/catalog/hero-slide-2-1280.webp 1280w, /images/catalog/hero-slide-2-1600.webp 1600w, /images/catalog/hero-slide-2.webp 1920w"
    imagesizes="100vw"
    media="(min-width: 769px)"
  />
  <!-- 1. HERO SECTION: IMPACT VISUEL FORT (Bleu Foncé & Or) -->
  <section class="hero-section">
    <!-- SLIDESHOW BACKGROUND -->
    <div class="hero-slideshow">
      <!-- Slide 1: Salon lumineux — mobile LCP = <img> portrait ; desktop = <source min-width> -->
      <picture class="hero-bg-picture hero-bg-picture--secondary">
        <source
          media="(min-width: 769px)"
          type="image/webp"
          srcset="/images/catalog/hero-slide-2-mobile.webp 800w, /images/catalog/hero-slide-2-1280.webp 1280w, /images/catalog/hero-slide-2-1600.webp 1600w, /images/catalog/hero-slide-2.webp 1920w"
          sizes="100vw"
        />
        <img
          src="/images/catalog/hero-salon-nettoyage-vapeur-montreal-portrait-800.webp"
          srcset="/images/catalog/hero-salon-nettoyage-vapeur-montreal-portrait-480.webp 480w, /images/catalog/hero-salon-nettoyage-vapeur-montreal-portrait-640.webp 640w, /images/catalog/hero-salon-nettoyage-vapeur-montreal-portrait-800.webp 800w"
          sizes="100vw"
          alt="Nettoyage professionnel de tapis et divans à Montréal - Groupe Empire"
          class="hero-slide active"
          width={800}
          height={1000}
          decoding="async"
          fetchpriority="high"
          loading="eager"
        />
      </picture>

      <!-- Slide 2: Salon résidentiel luxe — tapis (portrait source) -->
      <picture class="hero-bg-picture">
        <source
          media="(max-width: 768px)"
          type="image/webp"
          srcset="/images/catalog/hero-salon-prestige-tapis-residentiel-quebec-portrait-800.webp 800w, /images/catalog/hero-salon-prestige-tapis-residentiel-quebec-portrait.webp 1600w"
          sizes="100vw"
        />
        <img
          src="/images/catalog/hero-salon-prestige-tapis-residentiel-quebec.webp"
          srcset="/images/catalog/hero-salon-prestige-tapis-residentiel-quebec-mobile.webp 800w, /images/catalog/hero-salon-prestige-tapis-residentiel-quebec.webp 1600w"
          sizes="100vw"
          alt="Salon résidentiel luxueux avec tapis impeccablement nettoyé - Groupe Nettoyage Empire, Québec"
          class="hero-slide"
          loading="lazy"
          width={1600}
          height={2000}
          decoding="async"
        />
      </picture>

      <!-- Slide 3: Tapis laine — tall ≤768px / wide desktop -->
      <picture class="hero-bg-picture hero-bg-picture--wool-tall">
        <source
          media="(max-width: 768px)"
          type="image/webp"
          srcset="/images/catalog/hero-tapis-laine-wool-quebec-tall-portrait-800.webp 800w, /images/catalog/hero-tapis-laine-wool-quebec-tall-portrait-1600.webp 1600w"
          sizes="100vw"
        />
        <img
          src="/images/catalog/hero-tapis-laine-wool-quebec-wide.webp"
          srcset="/images/catalog/hero-tapis-laine-wool-quebec-wide-800.webp 800w, /images/catalog/hero-tapis-laine-wool-quebec-wide.webp 1536w"
          sizes="100vw"
          alt="Tapis en laine professionnellement nettoyé, texture soignée - Groupe Nettoyage Empire, Québec"
          class="hero-slide"
          loading="lazy"
          width={1536}
          height={1024}
          decoding="async"
        />
      </picture>

      <!-- Slide 4: Commercial — espace 2 -->
      <picture class="hero-bg-picture">
        <source
          media="(max-width: 768px)"
          type="image/webp"
          srcset="/images/catalog/hero-commercial-bureau-espace2-quebec-portrait-800.webp 800w, /images/catalog/hero-commercial-bureau-espace2-quebec-portrait.webp 1600w"
          sizes="100vw"
        />
        <img
          src="/images/catalog/hero-commercial-bureau-espace2-quebec.webp"
          srcset="/images/catalog/hero-commercial-bureau-espace2-quebec-mobile.webp 800w, /images/catalog/hero-commercial-bureau-espace2-quebec.webp 1600w"
          sizes="100vw"
          alt="Espace commercial lumineux avec tapis professionnels - Groupe Nettoyage Empire, Québec"
          class="hero-slide"
          loading="lazy"
          width={1600}
          height={2000}
          decoding="async"
        />
      </picture>

      <!-- Slide 5: Matelas — même pattern portrait / desktop que slide 4 -->
      <picture class="hero-bg-picture">
        <source
          media="(max-width: 768px)"
          type="image/webp"
          srcset="/images/catalog/hero-matelas-professionnel-quebec-portrait-800.webp 800w, /images/catalog/hero-matelas-professionnel-quebec-portrait.webp 1600w"
          sizes="100vw"
        />
        <img
          src="/images/catalog/hero-matelas-professionnel-quebec.webp"
          srcset="/images/catalog/hero-matelas-professionnel-quebec-mobile.webp 800w, /images/catalog/hero-matelas-professionnel-quebec.webp 1600w"
          sizes="100vw"
          alt="Matelas impeccablement nettoyé et désinfecté - Groupe Nettoyage Empire, Québec"
          class="hero-slide"
          loading="lazy"
          width={1600}
          height={2000}
          decoding="async"
        />
      </picture>
    </div>

    <div class="hero-overlay"></div>
    <div
      class="container hero-content text-center"
      style="position: relative; z-index: 10;"
    >
      <div class="hero-badge animate-on-load">
        <span class="badge-main">
          <img
            src={`/images/choix-quebec-optimized.webp?v=${_v}`}
            srcset={CHOIX_SRCSET}
            sizes={CHOIX_SIZES}
            alt="Choix du Consommateur"
            class="badge-icon-img"
            width="40"
            height="40"
            fetchpriority="low"
            loading="lazy"
          />
          Le Choix Numéro 1
        </span>
        <span class="badge-sub">des consommateurs au Québec</span>
      </div>

      <h1 class="hero-title animate-on-load delay-1">
        <span class="hero-slogan-wrap">
          <span class="hero-slogan-rotate-stack">
            <span class="hero-slogan-sizer" aria-hidden="true">
              L'Art du Nettoyage<br />À la Vapeur
            </span>
            <span class="hero-slogan-layer hero-slogan--a active">
              <span class="hero-slogan-white">L'Art du Nettoyage</span><br />
              <span class="text-gradient-tricolor">À la Vapeur</span>
            </span>
            <span class="hero-slogan-layer hero-slogan--b">
              <span class="hero-slogan-white">L'Art du Nettoyage</span><br />
              <span class="text-gradient-tricolor">Haut de Gamme</span>
            </span>
          </span>
        </span>
      </h1>
      <div class="hero-subtitle-group">
        <p class="hero-subtitle hero-subtitle--desktop animate-on-load delay-2">
          Nettoyage sur place de tapis, meubles et matelas<br />
          Extraction à la vapeur avec camion-usine · Montréal, Laval et Rive-Sud
        </p>
        <p class="hero-subtitle hero-subtitle--mobile animate-on-load delay-2">
          Nettoyage à domicile — tapis, meubles et matelas<br />
          Extraction à la vapeur · Montréal et Rive-Sud
        </p>
      </div>
      <ConversionCtaPriorityGroup
        locale="fr"
        layout="hero"
        buttonStyle="glass"
        phoneIcon
        estimateIcon
        estimateIconName="clipboard"
      />
    </div>

    <!-- 2. TRUST (mobile: overlay bas du hero — desktop: inchangé visuellement via CSS) -->
    <section class="trust-container">
      <div class="container trust-band-inner">
        <p class="trust-kicker">Excellence reconnue</p>
        <div class="trust-unified-wrap">
          <div class="trust-grid trust-grid--desktop">
            <div class="trust-pill badge-google">
              <img
                src="/images/google-reviews-badge.png"
                alt="Avis clients Google — Groupe Nettoyage Empire"
                class="google-badge"
                width="302"
                height="167"
                loading="lazy"
                fetchpriority="low"
              />
            </div>
            <div class="trust-pill badge-exp">
              <span class="icon" aria-hidden="true"
                ><UiIcon name="gem" size={16} /></span
              >
              30+ ans d'expérience
            </div>
            <div class="trust-pill badge-eco">
              <span class="icon" aria-hidden="true"
                ><UiIcon name="leaf" size={16} /></span
              >
              100% Écologique
            </div>
            <div class="trust-pill badge-local">
              <span class="icon" aria-hidden="true"
                ><UiIcon name="fleur" size={16} /></span
              >
              Entreprise Québécoise
            </div>
          </div>
          <div
            class="trust-grid trust-grid--mobile"
            aria-label="Points forts — Groupe Nettoyage Empire"
          >
            <div class="trust-pill">
              <span class="icon" aria-hidden="true"
                ><UiIcon name="check" size={15} /></span
              >
              <span>Techniciens certifiés</span>
            </div>
            <div class="trust-pill">
              <span class="icon" aria-hidden="true"
                ><UiIcon name="gem" size={15} /></span
              >
              <span>30+ ans d'expérience</span>
            </div>
            <div class="trust-pill trust-pill--long">
              <span class="icon" aria-hidden="true"
                ><UiIcon name="leaf" size={15} /></span
              >
              <span>Produits écologiques premium</span>
            </div>
            <div class="trust-pill">
              <span class="icon" aria-hidden="true"
                ><UiIcon name="fleur" size={15} /></span
              >
              <span>Entreprise québécoise</span>
            </div>
          </div>
        </div>
      </div>
    </section>

  </section>

  <PresentationHomeTeaser locale="fr" />

  <!-- 3. SERVICES (Fond Bleu Pâle - Contraste Doux) -->
  <section class="section section-services">
    <div class="container">
      <div class="section-header text-center">
        <span class="tag-blue">Expertise Complète</span>
        <h2 class="title-dark-blue text-gradient-empire">
          Nos Solutions de Nettoyage
        </h2>
        <p class="lead-text">
          Une intervention ciblée pour chaque surface de votre intérieur.
        </p>
      </div>

      <div class="services-grid-modern">
        {
          HOMEPAGE_SERVICE_CARDS.map((card) => {
            const img = getServiceImage(card.imageKey, {
              forHomepageCard: true,
            });
            return (
              <a
                href={card.href}
                class={`service-card-modern fade-in-section ${card.delayClass}`}
              >
                <img
                  src={img.src}
                  {...(img.srcset ? { srcset: img.srcset } : {})}
                  {...(img.sizes ? { sizes: img.sizes } : {})}
                  alt={img.altFr}
                  class="card-img"
                  width={img.width}
                  height={img.height}
                  loading="lazy"
                  style={
                    img.objectPosition
                      ? `object-position: ${img.objectPosition}`
                      : undefined
                  }
                />
                <div class="card-content">
                  <div class={`card-icon ${card.iconTone}`} aria-hidden="true">
                    <HomepageServiceCardIcon imageKey={card.imageKey} />
                  </div>
                  <h3>{card.titleFr}</h3>
                  <p>{card.descriptionFr}</p>
                  <span class="link-text">Voir détails &rarr;</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 3.8 FEATURED VIDEO SECTION (Conversion Hook) -->
  <section class="section-featured-video fade-in-section">
    <div class="container text-center">
      <div class="section-header-video">
        <span class="tag-gold-outline">Résultats Époustouflants</span>
        <h2 class="title-light">La différence Empire : Des résultats qui parlent d'eux-mêmes</h2>
      </div>
      
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "VideoObject",
        "name": "Nettoyage de salon sectionnel 6 places | Résultat avant-après",
        "description": "Démonstration de nettoyage de salon sectionnel par Groupe Nettoyage Empire. Vidéo avant/après et démonstration de nettoyage professionnel.",
        "thumbnailUrl": "https://groupenettoyageempire.com/images/videos/video-thumb-salon-sectionnel.webp",
        "uploadDate": SALON_SECTIONNEL_UPLOAD_DATE,
        "embedUrl": "https://www.youtube.com/embed/em1yhDedcOQ"
      })} />

      <div class="premium-announcement-pill fade-in-section delay-100">
        <span class="pill-text">
          <span class="pill-highlight">Nouveau</span>
          <span class="pill-separator">•</span> 
          Découvrez notre plus récent nettoyage filmé
        </span>
      </div>


      <div class="video-facade-standalone video-facade-shorts">
        <YouTubeFacade 
          videoId="em1yhDedcOQ" 
          title="Nettoyage de salon sectionnel 6 places | Résultat avant-après"
          posterUrl="/images/videos/video-thumb-salon-sectionnel.webp" 
          posterSrcSet={SALON_SECTIONNEL_POSTER_SRCSET}
          posterSizes={SALON_SECTIONNEL_POSTER_SIZES_HOME}
          aspectRatio="9/16"
        />
      </div>

      <div class="video-cta-standalone">
        <a href="/realisations-video" class="btn btn-gold-solid">
          <span class="icon" aria-hidden="true"><UiIcon name="play" size={20} /></span>
          Voir notre galerie vidéo complète
        </a>
      </div>
    </div>
  </section>

  <style>
    .section-featured-video {
      background: linear-gradient(145deg, #2a6bb5 0%, #003b7a 60%, #07172c 100%);
      padding: 5rem 0;
      position: relative;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .section-header-video {
      max-width: 800px;
      margin: 0 auto 3rem;
    }

    .tag-gold-outline {
      display: inline-block;
      border: 1px solid rgba(240, 193, 75, 0.5);
      color: #f0c14b;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      padding: 6px 16px;
      border-radius: 50px;
      margin-bottom: 1.2rem;
      background: rgba(240, 193, 75, 0.05);
    }

    .title-light {
      color: #ffffff;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 800;
      margin: 0 0 1rem;
      line-height: 1.2;
    }

    .lead-text-light {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1.1rem;
      line-height: 1.6;
      margin: 0;
    }

    .video-facade-standalone {
      margin: 0 auto 2.5rem;
    }
    
    .video-facade-shorts {
      max-width: 360px; /* Constrain vertical video width */
      width: 100%;
    }

    .video-facade-shorts :global(.yt-facade) {
      border-radius: 20px; /* Phone-like rounding */
    }
    
    .video-facade-standalone :global(.yt-facade) {
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .video-cta-standalone {
      display: flex;
      justify-content: center;
    }

    .btn-gold-solid {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      /* Stacked: refined top gloss + rich centered cobalt blue */
      background: 
        linear-gradient(180deg, rgba(255, 255, 255, 0.025) 0%, transparent 32%),
        radial-gradient(ellipse at 50% 30%, #3a7eff 0%, #1a3fd4 45%, #080f6e 100%) !important;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1.5px solid rgba(100, 180, 255, 0.55) !important;
      color: #ffffff !important;
      font-weight: 600;
      letter-spacing: 0.4px;
      padding: 15px 36px;
      border-radius: 50px;
      text-decoration: none;
      transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
      /* Grounding shadow + very soft halo + subtle inset depth */
      box-shadow:
        0 4px 14px rgba(0, 0, 0, 0.35),
        0 0 22px rgba(0, 70, 200, 0.28),
        inset 0 1px 2px rgba(255, 255, 255, 0.08),
        inset 0 -3px 8px rgba(0, 0, 50, 0.65) !important;
    }

    .btn-gold-solid:hover {
      background: 
        linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, transparent 55%),
        radial-gradient(ellipse at 50% 30%, #5090ff 0%, #2a52e0 45%, #0c1890 100%) !important;
      transform: translateY(-2px);
      border: 1.5px solid rgba(130, 200, 255, 0.7) !important;
      box-shadow:
        0 6px 18px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(0, 70, 200, 0.38),
        inset 0 1px 5px rgba(255, 255, 255, 0.45),
        inset 0 -3px 8px rgba(0, 0, 50, 0.55) !important;
    }

    /* --- PREMIUM VIDEO ANNOUNCEMENT PILL --- */
    .premium-announcement-pill {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 28px;
      border-radius: 50px;
      background: linear-gradient(135deg, rgba(8, 20, 45, 0.85) 0%, rgba(0, 45, 100, 0.85) 100%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        0 0 15px rgba(0, 90, 255, 0.15),
        inset 0 1px 2px rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      margin-bottom: 2rem;
      overflow: hidden;
      max-width: 90vw;
    }

    .premium-announcement-pill::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
      animation: shimmerSweep 8s infinite cubic-bezier(0.2, 0, 0.2, 1);
      z-index: 0;
      pointer-events: none;
      will-change: transform;
    }

    @keyframes shimmerSweep {
      0% { transform: translateX(-100%); }
      35%, 100% { transform: translateX(300%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .premium-announcement-pill::before {
        animation: none;
        display: none;
      }
    }

    .pill-text {
      color: rgba(255, 255, 255, 0.95);
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.3px;
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .pill-highlight {
      color: #f0c14b;
      font-weight: 800;
      text-transform: uppercase;
      font-size: 0.82rem;
      letter-spacing: 1.5px;
      text-shadow: 0 0 12px rgba(240, 193, 75, 0.4);
    }

    .pill-separator {
      color: rgba(255, 255, 255, 0.25);
    }

    @media (max-width: 600px) {
      .premium-announcement-pill { padding: 12px 20px; }
