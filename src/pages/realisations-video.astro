---
import Layout from "../layouts/Layout.astro";
import YouTubeFacade from "../components/YouTubeFacade.astro";
import UiIcon from "../components/icons/UiIcon.astro";

const title = "Réalisations en Vidéo | Groupe Nettoyage Empire";
const description = "Visionnez nos vidéos de nettoyage avant et après. Constatez l'efficacité de nos camions-usines sur les tapis, meubles, et matelas.";
const canonicalPath = "/realisations-video";

// Placeholder videos for the gallery. 
// When the real YouTube IDs are available, update these objects.
const videos = [
  {
    id: "IRxgswcnjpI",
    title: "Nettoyage de carpettes perses à domicile à Westmount | Traitement urine de chat et lumière UV",
    category: "Carpettes Perses",
    posterUrl: "/images/videos/video-thumb-tapis-perse.webp"
  },
  {
    id: "rmdaHcA2mcc",
    title: "Nettoyage de sofa et causeuse capitonnés",
    category: "Sofas & Causeuses",
    posterUrl: "/images/videos/video-thumb-causeuse.webp"
  },
  {
    id: "a6ESbeUbols",
    title: "Nettoyage de printemps | Nettoyage à la vapeur et camion usine",
    category: "Nettoyage Profond",
    posterUrl: "/images/videos/video-thumb-produits.webp"
  },
  {
    id: "iZqbmcUTjJA",
    title: "Nettoyage de sofa et causeuse à Brossard | Vapeur et traitement enzymatique",
    category: "Sofas & Causeuses",
    posterUrl: "/images/videos/video-thumb-sofa-brossard.webp"
  },
  {
    id: "l2L2E-s1y2s",
    title: "Nettoyage de meuble en velours | Nettoyage à la vapeur avec camion usine",
    category: "Meubles en Velours",
    posterUrl: "/images/videos/video-thumb-banquette.webp"
  },
  {
    id: "em1yhDedcOQ",
    title: "Nettoyage de salon sectionnel 6 places | Résultat avant-après",
    category: "Nettoyage de Meubles",
    posterUrl: "/images/videos/video-thumb-salon-sectionnel.webp"
  },
  {
    id: "BtCGbCaIq9M",
    title: "Nettoyage d'un set de salon en microfibre",
    category: "Microfibre",
    posterUrl: "/images/videos/video-thumb-velour.webp"
  },
  {
    id: "6GDp9ff_6EY",
    title: "Nettoyage de carpette orientale à domicile à Westmount | Nettoyage à la vapeur",
    category: "Carpettes Orientales",
    posterUrl: "/images/videos/video-thumb-tapis-oriental-new-v2.webp"
  },
  {
    id: "Ew7zbheK83U",
    title: "Nettoyage d’un tapis très sale | Avant après, traitement enzymatique et vapeur",
    category: "Tapis Très Sale",
    posterUrl: "/images/videos/video-thumb-tapis-berbere.webp"
  },
  {
    id: "gUCvR2RsdHQ",
    title: "Nettoyage à la vapeur de tuiles et coulis",
    category: "Tuiles & Coulis",
    posterUrl: "/images/videos/video-thumb-tuile-v2.webp"
  },
  {
    id: "QS7mPeE122A",
    title: "Nettoyage de divan avec tache de café | Résultat avant après",
    category: "Détachage Extrême",
    posterUrl: "/images/videos/video-thumb-cafe.webp"
  }
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": videos.map((video, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "VideoObject",
      "name": video.title,
      "description": `Démonstration de ${video.category.toLowerCase()} par Groupe Nettoyage Empire. Vidéo avant/après et démonstration de nettoyage professionnel.`,
      "thumbnailUrl": `https://groupenettoyageempire.com${video.posterUrl}`,
      "uploadDate": "2024-01-01T08:00:00+00:00",
      "embedUrl": `https://www.youtube.com/embed/${video.id}`
    }
  }))
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

  <!-- PAGE HERO -->
  <section class="video-hero">
    <div class="container video-hero-inner">
      <span class="video-tag">Portfolio</span>
      <h1 class="video-hero-title">Nos Réalisations en Vidéo</h1>
      <p class="video-hero-subtitle">
        Des résultats qui parlent d'eux-mêmes. Découvrez l'efficacité de notre technologie de camion-usine en action.
      </p>
    </div>
  </section>

  <!-- VIDEO GALLERY CONTENUT -->
  <section class="video-main">
    <div class="container">
      
      <div class="video-grid">
        {videos.map((video, index) => (
          <article class={`video-card fade-in-section ${index > 1 ? 'delay-100' : ''}`} aria-labelledby={`video-title-${index}`}>
            <div class="video-facade-container">
               <YouTubeFacade 
                  videoId={video.id} 
                  title={video.title} 
                  posterUrl={video.posterUrl}
                  aspectRatio="9/16"
               />
            </div>
            <div class="video-card-body">
              <span class="video-category-badge">{video.category}</span>
              <h2 id={`video-title-${index}`} class="video-card-title">{video.title}</h2>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="video-cta-section fade-in-section">
    <div class="container video-cta-inner text-center">
      <div class="video-cta-icon" aria-hidden="true" style="color: #003b7a;"><UiIcon name="check" size={48} /></div>
      <h2 class="video-cta-title">Convaincu par nos résultats ?</h2>
      <p class="video-cta-text">
        Redonnez l'éclat du neuf à vos intérieurs. Obtenez une estimation précise et de nos offres promotionnelles en quelques secondes.
      </p>
      <div class="video-cta-actions">
        <button
          type="button"
          onclick="window.openEstimationWidget()"
          class="btn btn-primary-promo pulse-btn"
          aria-label="Ouvrir le calculateur d'estimation gratuite"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
          Obtenir mon estimation gratuite
        </button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ================================
     PAGE HERO
  ================================ */
  .video-hero {
    background: linear-gradient(145deg, #2a6bb5 0%, #003b7a 60%, #07172c 100%);
    color: white;
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .video-hero-inner {
    max-width: 750px;
    margin: 0 auto;
  }

  .video-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #f0c14b;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 5px 16px;
    border-radius: 50px;
    margin-bottom: 1.2rem;
  }

  .video-hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin: 0 0 1rem;
    line-height: 1.15;
    color: #ffffff;
  }

  .video-hero-subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0;
  }

  /* ================================
     MAIN SECTION & GRID
  ================================ */
  .video-main {
    padding: 5rem 0;
    background: #f8fbff;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 columns for vertical videos on desktop */
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr); /* 2 columns on tablet */
    }
  }

  @media (max-width: 600px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  /* ================================
     VIDEO CARD
  ================================ */
  .video-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid #e8edf3;
    box-shadow: 0 5px 25px rgba(0, 30, 80, 0.05);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .video-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 30, 80, 0.12);
  }

  .video-facade-container {
    width: 100%;
    /* Override facade border-radius since parent wraps it */
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  /* Ensure facade fits tightly into card top */
  :global(.video-facade-container .yt-facade) {
    border-bottom-left-radius: 0 !important;
    border-bottom-right-radius: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  .video-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    background: #fff;
  }

  .video-category-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #003b7a;
    background: #eef4fc;
    padding: 4px 10px;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .video-category-badge {
      font-size: 0.65rem;
      padding: 3px 6px;
      letter-spacing: 0.5px;
    }
  }

  .video-card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #001f3f;
    margin: 0;
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    .video-card-title {
      font-size: 0.95rem;
      line-height: 1.3;
    }
    .video-card-body {
      padding: 1rem 0.75rem;
    }
  }

  /* ================================
     CTA SECTION
  ================================ */
  .video-cta-section {
    background: #fff;
    border-top: 1px solid #e8edf3;
    padding: 5rem 0;
  }

  .video-cta-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .video-cta-icon {
    margin-bottom: 1rem;
  }

  .video-cta-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #001f3f;
    margin: 0 0 1rem;
    line-height: 1.25;
  }

  .video-cta-text {
    font-size: 1.05rem;
    color: #4b5563;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .video-cta-actions {
    display: flex;
    justify-content: center;
  }

  .btn-primary-promo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #003b7a 0%, #080d14 100%);
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    padding: 16px 32px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 8px 25px rgba(0, 59, 122, 0.35);
  }

  .btn-primary-promo:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0, 59, 122, 0.45);
  }

  /* ================================
     ANIMATIONS
  ================================ */
  .fade-in-section {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }
  .fade-in-section.is-visible {
    opacity: 1;
    transform: none;
  }
  .delay-100 {
    transition-delay: 0.15s;
  }
  .pulse-btn {
    animation: pulseShadow 2.5s ease-in-out infinite;
  }
  @keyframes pulseShadow {
    0%, 100% { box-shadow: 0 6px 20px rgba(0, 59, 122, 0.35); }
    50% { box-shadow: 0 8px 30px rgba(0, 59, 122, 0.6); }
  }
</style>
