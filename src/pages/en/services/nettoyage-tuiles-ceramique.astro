---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../../layouts/Layout.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import ServiceVideoProofDuo from "../../../components/ServiceVideoProofDuo.astro";
import UiIcon from "../../../components/icons/UiIcon.astro";
import ConversionCtaPriorityGroup from "../../../components/ConversionCtaPriorityGroup.astro";
import CeramiqueSlideshowSlides from "../../../components/CeramiqueSlideshowSlides.astro";

/** Technician section photos: rendered only when the file exists (no empty frames). */
function publicImageIfExists(relPath: string): string | null {
  const abs = path.join(process.cwd(), "public", relPath.replace(/^\//, ""));
  return fs.existsSync(abs) ? relPath : null;
}

const servicePhotos = {
  floor: publicImageIfExists("/images/catalog/tuile-plancher-technicien.webp"),
  shower: publicImageIfExists("/images/catalog/tuile-douche-technicien.webp"),
  backsplash: publicImageIfExists("/images/catalog/tuile-backsplash-technicien.webp"),
};
---

<Layout
  title="Ceramic Tile & Grout Cleaning | Montreal & South Shore"
  description="Steam cleaning of ceramic tile, flooring and grout in Montreal and on the South Shore. Floors, shower walls, kitchen backsplashes."
  image="/images/services/tuiles-ceramique.webp"
  preloadImage={false}
>
  <!-- SPLIT SCREEN HERO: BLOCK 1 -->
  <div class="split-hero-container mobile-hero-stack ceramique-slideshow-fit">
    <div class="container full-width-split">
      <div class="split-layout">
        <!-- LEFT COLUMN: CONTENT -->
        <div class="split-content fade-in-section">
          <div class="service-hero-intro">
          <span class="service-cat-badge">FLOORS & SURFACES</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Ceramic, Tile & Grout Cleaning
          </h1>

          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
              <CeramiqueSlideshowSlides locale="en" />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100">
            <h2 class="problem-title">The Problem:</h2>
            <p class="problem-text">
              Have your grout lines turned black or gray? Mopping only moves dirt 
              into the pores of the grout. Without high-pressure cleaning, bacteria, 
              limescale and grease accumulate, making your floors look dull and unsanitary.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            Restore the original look of your floors with
            <strong>professional steam cleaning under controlled high pressure</strong>,
            combined with a <strong>powerful extraction system</strong>.
            The alliance of <strong>30&nbsp;years of experience</strong>,
            <strong>advanced cleaning technologies</strong> and
            <strong>premium eco-friendly products</strong> restores shine to your ceramic
            tile and grout — without splashing, with almost immediate drying.
          </p>

          <ul class="empire-trust-list fade-in-up delay-200" aria-label="Our advantages">
            <li>Over 30&nbsp;years of experience in Quebec</li>
            <li>Controlled high-pressure steam + powerful extraction</li>
            <li>Premium eco-friendly products, family- and pet-friendly</li>
          </ul>

          </div>

          <div class="service-hero-action-band">

          <ConversionCtaPriorityGroup locale="en" buttonStyle="primary" />
          <ServiceVideoProofDuo
            title="See Our Tile Cleaning in Action"
            subtitle="Two real tile and grout cleaning projects"
            description="Watch our real service videos and see our professional method for deep cleaning ceramic tiles and grout lines."
            allVideosHref="/en/video-gallery/"
            playLabel="Watch the Video"
            allVideosLabel="See All Our Work"
            closeLabel="Close video"
            videos={[
              {
                title: "Commercial Ceramic Tile Cleaning",
                youtubeId: "t4ZxSeA6uFA",
                youtubeTitle: "Commercial Ceramic Tile Cleaning",
                posterUrl: "/images/videos/video-thumb-nettoyage-tuile-ceramique-commercial.webp",
                videoAspectRatio: "9 / 16",
              },
              {
                title: "Tile and Grout Steam Cleaning",
                youtubeId: "gUCvR2RsdHQ",
                youtubeTitle: "Tile and Grout Steam Cleaning",
                posterUrl: "/images/videos/video-thumb-tuile-v2.webp",
                videoAspectRatio: "9 / 16",
              },
            ]}
          />

          </div>
        </div>

        <!-- RIGHT COLUMN: IMAGE -->
        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
            <CeramiqueSlideshowSlides locale="en" priority />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="service-layout">
        <!-- MAIN CONTENT -->
        <div class="service-main">

          <nav class="ceramique-service-nav fade-in-section" aria-label="Ceramic cleaning service types">
            <p class="ceramique-service-nav__label">Our ceramic cleaning services</p>
            <ul class="ceramique-service-nav__list">
              <li><a href="#tile-floor-cleaning">Tile &amp; ceramic floors</a></li>
              <li><a href="#shower-wall-cleaning">Shower walls &amp; bathrooms</a></li>
              <li><a href="#kitchen-backsplash-cleaning">Kitchen backsplash</a></li>
            </ul>
          </nav>

          <div id="tile-floor-cleaning" class="ceramique-service-block fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Ceramic tile and flooring cleaning
            </h2>
            {servicePhotos.floor && (
              <figure class="ceramique-service-photo">
                <img
                  src={servicePhotos.floor}
                  alt="Empire technician cleaning a ceramic tile floor in Montreal"
                  width="1200"
                  height="800"
                  loading="lazy"
                />
              </figure>
            )}
            <p>
              On <strong>tile floors</strong> and <strong>ceramic flooring</strong>, grease,
              limescale, mop residue and soiled <strong>grout lines</strong> embed in the pores.
              Regular household cleaning moves the dirt without truly extracting it.
            </p>
            <p>
              We use <strong>pre-treatment</strong>, <strong>specialized grout brushing</strong>,
              then <strong>steam cleaning under controlled high pressure</strong> with
              <strong>simultaneous extraction</strong> — for a cleaner ceramic floor,
              deep-cleaned joints and fast drying, without splashing furniture or baseboards.
            </p>
          </div>

          <div id="shower-wall-cleaning" class="ceramique-service-block fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Shower wall and bathroom tile cleaning
            </h2>
            {servicePhotos.shower && (
              <figure class="ceramique-service-photo">
                <img
                  src={servicePhotos.shower}
                  alt="Empire technician cleaning shower walls and bathroom tile grout"
                  width="1200"
                  height="800"
                  loading="lazy"
                />
              </figure>
            )}
            <p>
              In bathrooms, humidity, soap and limescale darken <strong>wall tiling</strong>
              and <strong>shower grout</strong>. <strong>Shower wall cleaning</strong> treats
              these vertical surfaces differently from a floor: adapted tools, controlled water,
              protected finishes.
            </p>
            <p>
              We remove soap scum and visible deposits on ceramic tile, clean soiled shower
              joints and restore a fresh look to the stall and tiled walls — without soaking
              silicone, niches or shelves.
            </p>
          </div>

          <div id="kitchen-backsplash-cleaning" class="ceramique-service-block fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Kitchen backsplash cleaning
            </h2>
            {servicePhotos.backsplash && (
              <figure class="ceramique-service-photo">
                <img
                  src={servicePhotos.backsplash}
                  alt="Empire technician cleaning a kitchen backsplash and grout lines"
                  width="1200"
                  height="800"
                  loading="lazy"
                />
              </figure>
            )}
            <p>
              <strong>Kitchen backsplash cleaning</strong> targets cooking splashes and
              <strong>greasy residue</strong> that build up behind the countertop and cooktop —
              a different challenge than bathroom humidity.
            </p>
            <p>
              Precise hand tools clean ceramic backsplash tiles and grout without projecting
              water onto cabinets. Ideal alongside a kitchen floor cleaning, without redoing
              the full method on the walls.
            </p>
          </div>

          <div class="ceramique-mid-cta fade-in-section delay-100">
            <p class="ceramique-mid-cta__text">
              Ready to clean your ceramic tile, flooring or grout lines?
            </p>
            <ConversionCtaPriorityGroup locale="en" buttonStyle="primary" />
          </div>
          
          <div class="fade-in-section delay-100" style="margin-top: 0;">
            <h2 class="section-title text-gradient-empire">
              Our professional process (steam, high pressure and extraction)
            </h2>
            <p style="margin: 0 0 1.5rem; line-height: 1.65; max-width: 720px;">
              The alliance of <strong>30&nbsp;years of experience</strong>,
              <strong>advanced cleaning technologies</strong> and
              <strong>premium eco-friendly products</strong> guides every visit.
              We restore ceramic tile, flooring and grout — in homes, condos or apartments —
              with professional steam cleaning under controlled high pressure, combined with
              a powerful extraction system.
            </p>
            <div class="process-timeline" style="margin-bottom: 3rem;">
              <div class="process-step">
                <div class="step-marker">1</div>
                <div class="step-content">
                  <h3>Inspection and pre-treatment</h3>
                  <p>Identification of the tile type (ceramic, porcelain, natural stone) and application of an alkaline cleaning agent specifically designed to break down grease and soap residue.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="step-marker">2</div>
                <div class="step-content">
                  <h3>Specialized grout brushing</h3>
                  <p>We use specialized brushes to vigorously scrub each grout line. This mechanical action is essential to release embedded black dirt before extraction.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="step-marker">3</div>
                <div class="step-content">
                  <h3>Controlled high-pressure steam and extraction (200°F)</h3>
                  <p>Our machine projects pressurized hot water inside a closed rotating head. It cleans and vacuums simultaneously, guaranteeing zero splashing on your walls or cabinets.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="step-marker">4</div>
                <div class="step-content">
                  <h3>Neutralization and drying</h3>
                  <p>A final pH-balanced rinse removes any sticky residue. We then use high-power fans to ensure fast drying, ready for the final step.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="step-marker">5</div>
                <div class="step-content">
                  <h3>Protection (grout sealant)</h3>
                  <p>Optional grout protection available: we can apply a professional protective sealant that penetrates the grout pores to help resist dirt and make future cleaning easier.</p>
                </div>
              </div>
            </div>

            <div class="info-box fade-in-section delay-100">
              <h3 style="color: var(--color-primary); margin-bottom: 10px;">
                Why do your joints turn black so quickly?
              </h3>
              <p>
                Grout is like a sponge: it is extremely porous. When you mop your floor, dirty water ends up accumulating in the "hollows" of the joints. Once the water evaporates, only the dirt remains at the bottom.
                Only professional steam cleaning under controlled high pressure, combined with extraction, can “empty” these pores. Applying a <strong>protective sealant</strong> after cleaning is the best investment to keep your joints white for years.
              </p>
            </div>
          </div>

          <!-- BENEFITS SECTION -->
          <div class="fade-in-section delay-200" style="margin-top: 4rem;">
            <h2 class="section-title text-gradient-empire">
              Advantages of our professional cleaning
            </h2>
            <div class="benefits-grid">
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Total Hygiene:</strong> Eliminates bacteria, mold, limescale and allergens lodged in porous joints.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Floor Like New:</strong> Rediscover the original color of your grout without scrubbing it yourself for hours.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Zero Splashing:</strong> Our rotating equipment contains all water and suction inside the cleaning head — ideal for condos and apartments.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Premium Eco Products:</strong> Professional formulas that are effective and designed for family and pet households.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Durable Protection:</strong> Our high-quality sealants facilitate your future household cleanings.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Fast Service:</strong> A standard kitchen is typically cleaned in 2 to 3 hours.</span>
              </div>
            </div>
          </div>

          <!-- WHO / ROOMS -->
          <div class="fade-in-section delay-200" style="margin-top: 4rem;">
            <h2 class="section-title text-gradient-empire">
              Ceramic cleaning for homes, condos and apartments
            </h2>
            <p style="line-height: 1.65; max-width: 720px; margin-bottom: 1.25rem;">
              Whether you live in a family home, a high-rise condo or an apartment,
              we adapt our equipment and method to your access and surface condition.
              The closed turbo head limits splashing — a real advantage in tighter spaces
              and open kitchens.
            </p>
            <p style="line-height: 1.65; max-width: 720px; margin-bottom: 1.25rem;">
              We serve residential and commercial clients on the areas where ceramic
              and grout get dirty the fastest:
            </p>
            <ul class="ceramique-rooms-list">
              <li><a href="#kitchen-backsplash-cleaning">Kitchens and backsplashes</a> (grease, greasy residue, limescale)</li>
              <li><a href="#shower-wall-cleaning">Bathrooms and shower walls</a> (humidity, darkened shower grout)</li>
              <li><a href="#tile-floor-cleaning">Tile floors and ceramic flooring</a> (entries, hallways, heavy traffic)</li>
              <li>Basements and tiled living areas</li>
            </ul>
          </div>

          <!-- ZONES DESSERVIES -->
          <div class="zones-section" style="margin-top: 4rem; margin-bottom: 3rem;">
            <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Service Areas — Tile and Ceramic</h3>
            <p>We serve the entire Greater Montreal Area with our high-performance mobile units.</p>

            <div class="city-group">
                <p class="city-lead">Montreal (East and West)</p>
                <div class="badges-container">
                    <span class="badge badge-blue">Montreal</span>
                    <span class="badge badge-blue">Westmount</span>
                    <span class="badge badge-blue">Mount Royal</span>
                    <span class="badge badge-blue">Outremont</span>
                    <span class="badge badge-blue">LaSalle</span>
                    <span class="badge badge-blue">Ahuntsic</span>
                </div>
            </div>

            <div class="city-group">
                <p class="city-lead">Laval</p>
                <div class="badges-container">
                    <span class="badge badge-blue">Laval (all neighborhoods)</span>
                    <span class="badge badge-blue">Chomedey</span>
                    <span class="badge badge-blue">Duvernay</span>
                    <span class="badge badge-blue">Fabreville</span>
                </div>
            </div>

            <div class="city-group">
                <p class="city-lead">Montreal South Shore</p>
                <div class="badges-container">
                    <span class="badge badge-green">Longueuil</span>
                    <span class="badge badge-green">Brossard</span>
                    <span class="badge badge-green">Saint-Hubert</span>
                    <span class="badge badge-green">Boucherville</span>
                    <span class="badge badge-green">Saint-Lambert</span>
                </div>
            </div>
          </div>

                    <div
                        class="fade-in-section delay-200"
                        style="margin-top: 2rem; margin-bottom: 2rem; padding: 1.5rem 1.75rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); border-radius: 8px; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <h3 style="color: var(--color-primary); margin: 0 0 0.75rem; font-size: 1.2rem;">
                            Professional Tile and Grout Cleaning in Longueuil and on Montreal's South Shore
                        </h3>
                        <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                            We provide tile and grout cleaning in Longueuil, Brossard, Saint-Hubert, Boucherville, Saint-Lambert and across Montreal's South Shore — for floors, ceramic tile and grout lines in homes, condos and apartments. Kitchens, bathrooms, entries and high-traffic areas are treated with our premium eco-friendly products. The technician inspects the surface before starting so the cleaning can be adapted to the condition of the tiles, buildup in the joints and the level of soil.
                        </p>
                    </div>

          <!-- FAQ SECTION -->
          <div class="fade-in-section delay-300" style="margin-top: 3rem;">
              <h2 class="section-title text-gradient-empire">
