        </div>

        <!-- SIDEBAR -->
        <aside class="service-sidebar">
          <div class="sticky-card fade-in-section">
            <h3 class="card-title text-gradient-gold">Request a Free Estimate</h3>
            <p class="card-desc">Floors, shower walls or backsplash: get your ceramic cleaning estimate today.</p>
            <a href="tel:5148939939" class="btn btn-gradient-green full-width pop-effect pulse-phone">
              <span class="cta-btn-stack">
                <span>Call for a Fast Estimate</span>
                <span class="cta-btn-phone-num">(514) 893-9939</span>
