---
import Layout from "../../../layouts/Layout.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import LocalTapisCrossServiceLinks from "../../../components/LocalTapisCrossServiceLinks.astro";
import LocalCarpetVideoProofSection from "../../../components/local-tapis/LocalCarpetVideoProofSection.astro";
import UiIcon from "../../../components/icons/UiIcon.astro";
import ConversionCtaPriorityGroup from "../../../components/ConversionCtaPriorityGroup.astro";
---

<Layout
  title="Carpet Cleaning Westmount | At-home residential service"
  description="Residential carpet cleaning in Westmount for homes, condos, stairs, bedrooms and living rooms. At-home service with professional extraction and fabric-safe products."
>
  <div class="split-hero-container mobile-hero-stack">
    <div class="container full-width-split">
      <div class="split-layout">
        <div class="split-content fade-in-section">
          <span class="service-cat-badge">PREMIUM RESIDENTIAL • WESTMOUNT</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Carpet Cleaning in Westmount
          </h1>

          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
              <img
                src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
                alt="Professional residential carpet cleaning in Westmount"
                class="slide active"
                width="1200"
                height="800"
                loading="eager"
              />
              <img
                src="/images/catalog/photo-67.webp"
                alt="Living room carpet after cleaning — Westmount home"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/camion-usine-nettoyage-empire.webp"
                alt="Truck-mount extraction for Westmount residential carpet cleaning"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100" style="border-left-color: var(--color-accent);">
            <h2 class="problem-title" style="color: var(--color-primary);">Interiors where every room matters:</h2>
            <p class="problem-text">
              In Westmount, wall-to-wall carpet in bedrooms, main living areas, landings and stairs often sits in well-kept homes with little room for heavy-handed cleaning: fibers capture fine dust, foot traffic and winter carry-in while remaining center stage in formal and family spaces.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            Our <strong>carpet cleaning at home in Westmount</strong> follows your floor plan and fiber type: we favor controlled extraction and products suited to <strong>residential carpet cleaning</strong> in high-expectation settings, without unnecessary shuffling of large pieces in the rooms you use most.
          </p>

          <ConversionCtaPriorityGroup locale="en" buttonStyle="green" phoneIcon estimateIcon />
        </div>

        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
            <img
              src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
              alt="Professional residential carpet cleaning in Westmount"
              class="slide active"
              width="1200"
              height="800"
              fetchpriority="high"
              loading="eager"
            />
            <img
              src="/images/catalog/photo-67.webp"
              alt="Living room carpet after cleaning — Westmount home"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/camion-usine-nettoyage-empire.webp"
              alt="Truck-mount extraction for Westmount residential carpet cleaning"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>



  <LocalCarpetVideoProofSection
    title="See our carpet cleaning in action"
    subtitle="Real example of in-home residential carpet cleaning"
    description="Watch a real job and see our professional method for cleaning residential carpets right in the client's home."
    youtubeId="9TKQuGP6-GA"
    youtubeTitle="Nettoyage complet de tapis résidentiel à domicile"
    allVideosHref="/en/video-gallery/"
    posterUrl="/images/videos/video-thumb-nettoyage-tapis-maison-complet.webp"
    videoAspectRatio="9 / 16"
    playLabel="Watch the Video"
    allVideosLabel="See All Our Work"
    closeLabel="Close video"
  />
  <section class="section">
    <div class="container">
      <div class="service-layout">
        <div class="service-main">
          <div class="fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Carpet cleaning in Westmount: method and living spaces
            </h2>

            <p>
              <strong>Carpet cleaning in Westmount</strong> is about keeping main living levels consistent: primary bedrooms, formal and informal living rooms, finished basements, and stairs between floors. We set chemistry and agitation based on how each area is used, the pile type, and whether children or pets are part of the household, with careful control of remaining moisture.
            </p>

            <ul class="benefit-list" style="margin-bottom: 3rem;">
              <li>
                <strong>Fiber assessment:</strong> we map high-wear paths (foyer transitions, stair noses, hallways) before choosing pre-treatment strength.
              </li>
              <li>
                <strong>Measured extraction:</strong> professional hot-water rinse to lift residue without over-wetting wall-to-wall carpet.
              </li>
              <li>
                <strong>Respectful access:</strong> shoe covers, corner protection and neat hose runs suited to finished interiors.
              </li>
              <li>
                <strong>Realistic drying:</strong> we discuss ventilation and typical dry times for your season and carpet build.
              </li>
            </ul>

            <p style="margin-top: 0; margin-bottom: 0; line-height: 1.65; color: var(--color-text-main);">
              In Westmount, our at-home carpet cleaning service is designed for houses, condos, stairs and residential spaces where carpets collect dust, winter salt, traffic marks and everyday soil. To understand our full method, visit our <a href="/en/services/nettoyage-tapis-residentiel/" class="tapis-trio-links__a">residential carpet cleaning service</a>. For coverage across the island, see our <a href="/en/services/nettoyage-tapis-montreal/" class="tapis-trio-links__a">carpet cleaning in Montreal</a>.
            </p>

            <p style="margin-top: 2rem; margin-bottom: 0; line-height: 1.65; color: var(--color-text-main);">
              In Westmount, we also handle area rugs in residential interiors where delicate fibres, colours and living room placement require a careful cleaning approach. For specialized pieces, you can also review our <a href="/en/services/tapis-orientaux/" class="tapis-trio-links__a">oriental rug cleaning service</a> and <a href="/en/services/tapis-laine/" class="tapis-trio-links__a">wool rug cleaning service</a>.
            </p>

            <div style="margin-top: 3rem; background-color: #f8f9fa; border-left: 4px solid var(--color-accent); padding: 2rem; border-radius: 8px;">
              <h3 style="color: var(--color-primary); margin-bottom: 1rem;">
                Refined residential expectations
              </h3>
              <p>
                Premium homes call for disciplined execution: when fibers warrant gentler chemistry, we adjust accordingly, and we pre-treat stains without overstating outcomes on very old or deeply set discoloration.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-layout" style="display: block;">
        <div class="service-main" style="max-width: 800px; margin: 0 auto;">
          <div class="zones-section" style="margin-top: 3rem; margin-bottom: 3rem;">
            <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Service in Westmount</h3>
            <div class="city-group">
              <div class="badges-container">
                <span class="badge badge-blue">Single-family homes</span>
                <span class="badge badge-blue">Condominiums</span>
                <span class="badge badge-blue">Multi-level layouts</span>
                <span class="badge badge-blue">Primary bedrooms & living rooms</span>
              </div>
            </div>
            <p class="contact-footer">Book carpet cleaning in Westmount: <strong>(514) 893-9939</strong>.</p>
          </div>

          <LocalTapisCrossServiceLinks locale="en" />

          <div class="fade-in-section delay-300" style="margin-top: 3rem;">
            <h2 class="section-title text-gradient-empire">
              FAQ — carpet cleaning in Westmount
            </h2>
            <FAQSchema
              faqs={[
                {
                  question: "Do you provide at-home carpet cleaning throughout Westmount?",
                  answer:
                    "Yes. We serve houses, condos and residential buildings on scheduled routes on the island, adapting equipment to floor plans and access.",
                },
                {
                  question: "How do you handle carpets in bedrooms and main living rooms?",
                  answer:
                    "We tailor pre-treatment and moisture levels to fiber type and room use, then extract systematically to support reasonable dry times in occupied spaces.",
                },
                {
                  question: "Are carpeted stairs cleaned differently?",
                  answer:
                    "Yes. Treads and risers are treated with hand tools designed for stairs so extraction reaches step edges and landings without soaking the backing.",
                },
                {
                  question: "Typical drying time after a residential cleaning?",
                  answer:
                    "Often between 3 and 6 hours depending on airflow, carpet thickness and season; your technician outlines practical expectations after inspection.",
                },
              ]}
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".slideshow-container").forEach((container) => {
    const slides = container.querySelectorAll(".slide");
    if (slides.length <= 1) return;
    let currentSlide = 0;
    setInterval(() => {
      slides[currentSlide].classList.remove("active");
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add("active");
    }, 4000);
  });
</script>

<style>
  .split-hero-container { background-color: #fff; padding-top: 0; padding-bottom: 0; overflow: hidden; width: 100vw; }
  .full-width-split { width: 100%; max-width: none; padding: 0; margin: 0; }
  .split-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: stretch; min-height: 80vh; }
  .split-content { background-color: #ffffff; padding: 100px 4rem 4rem 10%; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 2; }
  .service-cat-badge { text-transform: uppercase; color: var(--color-accent); font-weight: 700; letter-spacing: 2px; font-size: 0.85rem; display: block; margin-bottom: 1rem; }
  .split-title { font-size: clamp(2.5rem, 3.5vw, 4rem); color: var(--color-primary); margin-bottom: 2rem; line-height: 1.1; }
  .city-group { margin-bottom: 1.5rem; }
  .badges-container { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .badge { padding: 0.4rem 0.9rem; border-radius: 20px; font-size: 0.9rem; border: 1px solid transparent; }
  .badge-blue { background: #e8f4fd; border-color: #c5dff0; }
  .problem-statement { background: #ffffff; border-left: 4px solid #ff4444; padding: 1.5rem; border-radius: 0; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(174, 206, 235, 0.3); }
  .problem-title { font-size: 1rem; color: #cc0000; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 700; }
  .problem-text { font-size: 1.05rem; color: var(--color-text-main); font-style: italic; }
  .lead-text { font-size: 1.15rem; line-height: 1.7; color: var(--color-text-main); margin-bottom: 2.5rem; max-width: 650px; }
  .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; }
  .cta-btn-stack {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
    gap: 0.1rem;
    text-align: left;
  }
  .cta-btn-phone-num {
    font-size: 0.92em;
    font-weight: 800;
  }
  @media (max-width: 900px) { .cta-group { display: none !important; } }
  .split-image-wrapper { position: relative; height: 100%; min-height: 500px; width: 100%; }
  .slideshow-container { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .slideshow-container img.slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }
  .slideshow-container img.slide.active { opacity: 1; }
  @media (max-width: 1024px) {
    .split-layout { grid-template-columns: 1fr; min-height: auto; }
    .lead-text { max-width: 100%; }
  }
  .service-layout { display: grid; grid-template-columns: 1fr; gap: 5rem; }
  .section-title { font-size: 1.8rem; color: var(--color-primary); margin-bottom: 1.5rem; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; display: inline-block; }
  .benefit-list { margin: 2rem 0; list-style: none; padding: 0; }
  .benefit-list li { margin-bottom: 1rem; padding-left: 0; position: relative; font-size: 1.05rem; }
  .contact-footer { margin-top: 1.5rem; font-style: italic; color: #666; }
  .tapis-trio-links__a { color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
</style>
