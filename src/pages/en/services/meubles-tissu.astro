                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-171.webp"
                alt="Fabric furniture cleaning expert - South Shore"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-172.webp"
                alt="Sofa cleaning before and after"
