                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100">
            <h2 class="problem-title">When Your Upholstery Needs a Deep Clean</h2>
            <p class="problem-text">
              Over time, sofas collect dust, everyday soil, signs of use and body residue. Contact areas—armrests, seats, backs and cushions—often darken first, and dirt can settle deeper into the padding.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            We clean fabric sofas, couches, sectionals and armchairs <strong>in your home</strong>. After a pre-service inspection, we adapt the method to the textile: suitable products, shampooing, steam cleaning and hot-water extraction when the fabric allows—without moving your furniture.
          </p>

          </div>

          <div class="service-hero-action-band">

          <ConversionCtaPriorityGroup locale="en" buttonStyle="primary" phoneIcon estimateIcon />

          <ServiceVideoProof
            title="See our work in action"
