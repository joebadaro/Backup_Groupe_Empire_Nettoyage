          />

          </div>
        </div>

        <!-- RIGHT COLUMN: IMAGE (Visual / Slideshow) -->
        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
            <img
              src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
              alt="Professional steam carpet cleaning at home"
              class="slide active"
              width="1200"
              height="800"
              fetchpriority="high"
              loading="eager"
            />
            <img
              src="/images/catalog/resultat-tapis-propre-longueuil.webp"
              alt="Residential carpet cleaning result - Groupe Empire"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-34.webp"
              alt="At-home carpet cleaning service - Groupe Empire"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-67.webp"
              alt="Residential carpet after professional cleaning in Montreal"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-142.webp"
              alt="Before and after carpet cleaning - Groupe Empire"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-143.webp"
              alt="Clean residential carpet after professional cleaning"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-144.webp"
              alt="More than 30 years of carpet cleaning expertise - Groupe Empire"
