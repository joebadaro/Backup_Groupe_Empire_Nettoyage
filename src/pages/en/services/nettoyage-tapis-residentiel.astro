                alt="Before and after carpet cleaning - Groupe Empire"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-143.webp"
                alt="Clean residential carpet after professional cleaning"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-144.webp"
                alt="More than 30 years of carpet cleaning expertise - Groupe Empire"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-133.webp"
                alt="At-home carpet cleaning without moving furniture"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
