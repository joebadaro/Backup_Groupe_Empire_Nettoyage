---
import Layout from "../../../layouts/Layout.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import LocalUpholsteryPremiumLayout from "../../../components/local-upholstery/LocalUpholsteryPremiumLayout.astro";
---

<Layout
  title="Upholstery Cleaning in Saint-Bruno | Sofa, Sectional, Fabric Furniture"
  description="Premium residential upholstery cleaning in Saint-Bruno for sofas, sectionals, modular seating, armchairs and banquettes. Meticulous care for quality furniture and light fabrics."
>
  <LocalUpholsteryPremiumLayout
    locale="en"
    cityBadge="UPHOLSTERED FURNITURE • SAINT-BRUNO"
    h1="Sofa, Sectional and Armchair Cleaning in Saint-Bruno"
    problemTitle="Demanding family interiors:"
    problemText="In Saint-Bruno, well-kept homes and family interiors call for precise care of upholstered furniture."
    leadText="Our service is designed to preserve quality seating, keep the look of light fabrics and maintain impeccable everyday comfort in the home."
    trustBadges={[
      "Over 30 years of experience",
      "Eco-friendly products",
      "Fast drying (often 2 to 6 h)",
      "Fabric inspection before treatment",
    ]}
    methodSectionTitle="Our professional method"
    methodSteps={[
      "Fabric inspection and method check before the visit.",
      "Targeted pre-treatment with professional shampoo matched to the fiber.",
      "Steam cleaning by hot-water extraction with a truck-mount unit.",
      "Protection of floors and walkways.",
      "Precise extraction for fast drying, usually within 2 to 6 hours.",
    ]}
    furnitureSectionTitle="Types of furniture we clean"
    furnitureTypesIntro="We clean sectional sofas, sectionals, modular sofas, upholstered armchairs, banquettes, ottomans and fabric chairs. Each visit is adjusted to the fabric, how much the furniture is used and the finish required."
  >
    <div slot="presentation">
      <h2 class="section-title text-gradient-empire">
        The service in Saint-Bruno
      </h2>
      <p>
        We work in the residential areas of Saint-Bruno with a structured approach: a detailed fabric inspection, a technical choice of products, deep cleaning and a careful finish. This method keeps a clean, even and lasting appearance.
      </p>
    </div>

    <div slot="extras">
      <div class="fade-in-section delay-350" style="margin-top: 2.5rem;">
        <h2 class="section-title text-gradient-empire">
          Why clean your upholstered furniture regularly
        </h2>
        <p>
          Even in a well-kept home, fabrics gradually collect fine dust, body oils and signs of use. Periodic professional cleaning helps preserve the furniture and extend the life of sofas, armchairs and banquettes.
        </p>
      </div>

      <div class="fade-in-section delay-400" style="margin-top: 2.5rem;">
        <h2 class="section-title text-gradient-empire">
          Specialized treatments available
        </h2>
        <p>
          Depending on the initial assessment, we can include targeted stain treatment, odor neutralization, an enzymatic treatment and optional fabric protection. Recommendations are made to preserve the look and quality of the furniture over the long term.
        </p>
      </div>

      <div class="fade-in-section delay-450" style="margin-top: 2.5rem;">
        <h2 class="section-title text-gradient-empire">
          Why choose Empire Cleaning Group in Saint-Bruno
        </h2>
        <p>
          With over 30 years of experience, our team focuses on precise work, eco-friendly products and a careful residential finish. Our goal is simple: lasting cleanliness and a result suited to the well-kept interiors of Saint-Bruno.
        </p>
      </div>

      <div class="fade-in-section delay-500" style="margin-top: 2.5rem;">
        <h2 class="section-title text-gradient-empire">Request an estimate</h2>
        <p>
          For a quick estimate on cleaning your sofa, couch, armchair, sectional, modular seating or banquette in Saint-Bruno, contact Empire Cleaning Group at
          (514) 893-9939.
        </p>
      </div>
    </div>

    <div slot="faq">
      <h2 class="section-title text-gradient-empire">Local Saint-Bruno FAQ</h2>
      <FAQSchema
        faqs={[
          {
            question: "Does the service suit light-colored fabrics in a family home?",
            answer:
              "Yes. We adapt each step to the fiber so we can clean deeply while protecting the look of light and delicate fabrics.",
          },
          {
            question: "Can you clean a large sectional sofa and matching armchairs on the same day?",
            answer:
              "Yes. We plan the visit to cover the main furniture in one appointment, with one consistent method across all the seating.",
          },
          {
            question: "How long until the furniture is dry after cleaning?",
            answer:
              "Most upholstered furniture dries within 2 to 6 hours, depending on the fabric, the home's ventilation and indoor humidity.",
          },
        ]}
      />
    </div>
  </LocalUpholsteryPremiumLayout>
</Layout>
