---
import Layout from "../../../layouts/Layout.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import ServiceVideoProof from "../../../components/ServiceVideoProof.astro";
import UiIcon from "../../../components/icons/UiIcon.astro";
import ConversionCtaPriorityGroup from "../../../components/ConversionCtaPriorityGroup.astro";
---

<Layout
    title="Mattress Cleaning & Disinfection | Montreal and South Shore"
    description="At-home mattress cleaning and disinfection with green and eco-friendly products. Treatments for urine, blood, odours and dust mites. Montreal and the South Shore."
>
    <!-- SPLIT SCREEN HERO: BLOCK 1 -->
    <div class="split-hero-container mobile-hero-stack">
        <div class="container full-width-split">
            <div class="split-layout">
                <!-- LEFT COLUMN: CONTENT -->
                <div class="split-content fade-in-section bg-gradient-premium">
          <div class="service-hero-intro">
                    <span class="service-cat-badge">MATTRESS</span>
                    <h1 class="split-title fade-in-up text-gradient-empire">
                        Mattress Cleaning &amp; Disinfection
                    </h1>

                    <div class="mobile-hero-slideshow fade-in-up delay-050">
                        <div class="slideshow-container">
                            <img
                                src="/images/catalog/teck-empire-matress-optimized.webp"
                                alt="Groupe Empire expert deep mattress cleaning - Montreal"
                                class="slide active"
                                width="1200"
                                height="800"
                                loading="eager"
                            />
                            <img
                                src="/images/catalog/photo-matelas-2.webp"
                                alt="At-home mattress cleaning and disinfection Montreal - dust mite care"
                                class="slide"
                                width="1200"
                                height="800"
                                loading="lazy"
                            />
                            <img
                                src="/images/catalog/kid-dog-matress-optimized.webp"
                                alt="Mattress disinfection suited to homes with children and pets - Montreal"
                                class="slide"
                                width="1200"
                                height="800"
                                loading="lazy"
                            />

                            <img
                                src="/images/catalog/woman-matress-optimized.webp"
                                alt="Restful sleep after professional mattress cleaning - Groupe Empire"
                                class="slide"
                                width="1200"
                                height="800"
                                loading="lazy"
                            />
                        </div>
                        <div class="image-overlay-gradient"></div>
                    </div>

                    <!-- BLOCK 1: INTRO (VISIBLE) -->
                    <div class="problem-statement fade-in-up delay-100">
                        <h2 class="problem-title">Professional Mattress Cleaning with Green and Eco-Friendly Products</h2>
                        <p class="problem-text">
                            Over time, your mattress collects dust, sweat, body residue and allergens. Human and pet urine stains, blood stains, rings, yellowing and persistent odours may also call for specialty treatments.
                        </p>
                        <p class="problem-text">
                            At Groupe Nettoyage Empire, we favour green and eco-friendly cleaning products, selected according to the textile type and the needs of each service.
                        </p>
                    </div>

                    <p class="lead-text fade-in-up delay-200">
                        We offer a professional <strong>at-home mattress cleaning and disinfection</strong> service using steam cleaning, shampooing and hot-water extraction when the textile allows. After inspection, our technicians may recommend specialty treatments for stains, odours, dust mites and other specific needs—with your authorization.
                    </p>

                    </div>

                    <div class="service-hero-action-band">

                    <ConversionCtaPriorityGroup locale="en" buttonStyle="green" estimateIcon />
                    <ServiceVideoProof
                        title="See Our Mattress Cleaning in Action"
                        subtitle="Steam mattress cleaning with specialized treatment"
                        description="Watch a real in-home service: mattress preparation, professional method and the result after cleaning."
                        youtubeId="0JmVo463OCA"
                        youtubeTitle="Mattress Steam Cleaning with Specialized Treatment"
                        allVideosHref="/en/video-gallery/"
                        posterUrl="/images/videos/video-thumb-nettoyage-matelas.webp"
                        videoAspectRatio="9 / 16"
                        playLabel="Watch the Video"
                        allVideosLabel="See All Our Work"
                        closeLabel="Close video"
                    />

                    </div>
                </div>

                <!-- RIGHT COLUMN: IMAGE -->
                <div class="split-image-wrapper fade-in-section delay-200">
                    <div class="slideshow-container">
                        <img
                            src="/images/catalog/teck-empire-matress-optimized.webp"
                            alt="Groupe Empire expert deep mattress cleaning - Montreal"
                            class="slide active"
                            width="1200"
                            height="800"
                            fetchpriority="high"
                            loading="eager"
                        />
                        <img
                            src="/images/catalog/photo-matelas-2.webp"
                            alt="At-home mattress cleaning and disinfection Montreal - dust mite care"
                            class="slide"
                            width="1200"
                            height="800"
                            loading="lazy"
                        />
                        <img
                            src="/images/catalog/kid-dog-matress-optimized.webp"
                            alt="Mattress disinfection suited to homes with children and pets - Montreal"
                            class="slide"
                            width="1200"
                            height="800"
                            loading="lazy"
                        />

                        <img
                            src="/images/catalog/woman-matress-optimized.webp"
                            alt="Restful sleep after professional mattress cleaning - Groupe Empire"
                            class="slide"
                            width="1200"
                            height="800"
                            loading="lazy"
                        />
                    </div>
                    <div class="image-overlay-gradient"></div>
                </div>
            </div>
        </div>
    </div>

    <section class="section">
        <div class="container">
            <div class="service-layout" style="display: block;">
                <!-- MAIN CONTENT (Centered, No Sidebar) -->
                <div
                    class="service-main"
                    style="max-width: 800px; margin: 0 auto;"
                >
                    <div class="fade-in-section delay-100" style="margin-top: 2rem;">
                        <div>
                            <hr class="separator" />

                            <h2 style="color: var(--color-primary);">
                                Why have a mattress professionally cleaned?
                            </h2>
                            <p>
                                A Twin, Full, Queen or King mattress easily holds sweat, dust and allergens. Human or pet urine stains, blood stains, rings, halos and yellowing often need more than a household product.
                            </p>
                            <p style="margin-top: 1rem;">
                                At <strong>Groupe Nettoyage Empire</strong>, <strong>cleaning</strong> removes soil and residue with steam, shampooing and hot-water extraction when the textile allows. <strong>Deodorizing</strong> targets persistent odours when relevant. <strong>Disinfection</strong> is an additional treatment, compatible with the textile and suited to the situation—it is not automatic on every mattress and does not replace cleaning.
                            </p>

                            <div style="margin-top: 2.5rem;">
                                <h2 style="color: var(--color-primary); margin-bottom: 1rem;">
                                    Stains, odours, dust mites and allergens
                                </h2>
                                <p style="margin-bottom: 1rem;">
                                    Depending on the inspection, our mattress cleaning and disinfection service can address several common situations:
                                </p>
                                <ul class="benefit-list" style="margin-bottom: 1.5rem;">
                                    <li>
                                        <strong>Human and pet urine:</strong> related stains and odours, often addressed with an enzymatic pre-treatment or another specialty treatment based on the assessment.
                                    </li>
                                    <li>
                                        <strong>Blood stains:</strong> careful treatment adapted to the textile and how old the stain is.
                                    </li>
                                    <li>
                                        <strong>Rings, halos and yellowing:</strong> linked to sweat and body residue; a recent stain often responds better than an old halo.
                                    </li>
                                    <li>
                                        <strong>Persistent odours:</strong> targeted deodorizing when the source can be treated on site.
                                    </li>
                                    <li>
                                        <strong>Dust mites, allergens and bacteria:</strong> our professional steam cleaning, shampooing and extraction help remove dust, dust-mite residue and allergen particles present in the mattress fibres. Depending on the inspection and textile compatibility, a specialized disinfectant treatment may also be recommended for bacteria and certain microorganisms.
                                    </li>
                                </ul>
                                <p>
                                    Enzyme treatments, oxygen-based treatments or disinfectant treatments are presented clearly (recommended, needed based on the assessment, or optional) and applied only with your authorization. Depending on the case, they serve as a <strong>pre-treatment</strong> or as a complement to cleaning.
                                </p>
                            </div>

                            <h2 style="color: var(--color-primary); margin-top: 2.5rem;">
                                Our five-step method
                            </h2>
                            <p>
                                Every service starts with the real condition of the mattress. Here is the typical flow of a professional in-home cleaning:
                            </p>

                            <ul class="benefit-list" style="margin-top: 1.5rem; margin-bottom: 2rem;">
                                <li>
                                    <strong>1. Pre-service inspection:</strong> the technician examines the textile, stains (urine, blood, rings), odours and mattress type, then explains the recommended method.
                                </li>
                                <li>
                                    <strong>2. Preparation and vacuuming:</strong> surface preparation and vacuuming to remove dust, dead skin and dry soil before wet cleaning.
                                </li>
                                <li>
                                    <strong>3. Specialty pre-treatments when needed:</strong> when warranted, application of an enzyme, oxygen-based or other suitable pre-treatment—always after explanation and with your approval.
                                </li>
                                <li>
                                    <strong>4. Steam, shampooing and hot-water extraction:</strong> coordinated professional process when the textile allows, to lift soil and remove excess moisture. Steam alone is not automatic disinfection of every mattress.
                                </li>
                                <li>
                                    <strong>5. Finishing, optional disinfection and drying:</strong> rinse/extraction as required by the process, complementary disinfectant treatment if appropriate and authorized, then drying guidance. Drying usually takes 2 to 6 hours, depending on the mattress, humidity and ventilation.
                                </li>
                            </ul>

                            <h2
                                class="section-title text-gradient-empire"
                                style="font-size: 1.5rem; margin-bottom: 1rem;"
                            >
                                What you gain with professional cleaning
                            </h2>
                            <ul class="benefit-list">
                                <li>
                                    A cleaner mattress, with removal of accessible soil, body residue and contaminants.
                                </li>
                                <li>
                                    Practical help with urine, sweat or other persistent odours when the right treatment is possible.
                                </li>
                                <li>
                                    Improvement of stains, rings, halos and yellowing depending on age and fibre condition.
                                </li>
                                <li>
                                    An approach suited to homes with children or pets, with products chosen for residential use.
                                </li>
                                <li>
                                    In-home service—no need to move the mattress—and typical drying of 2 to 6 hours depending on conditions.
                                </li>
                            </ul>

                            <div style="margin-top: 3rem;">
                                <h2 style="color: var(--color-primary); margin-bottom: 1rem;">
                                    Expertise and professional equipment
                                </h2>
                                <p>
                                    At Groupe Nettoyage Empire, we bring more than 30 years of experience and professional steam cleaning and hot-water extraction equipment. Our technicians adapt products, method and moisture control to each mattress’s composition and condition.
                                </p>
                                <h3 style="color: var(--color-primary); margin: 1.5rem 0 0.75rem; font-size: 1.15rem;">
                                    Our green and eco-friendly cleaning products
                                </h3>
                                <p>
                                    We favour professional green and eco-friendly cleaning solutions suited to different fabric types. Our technicians choose products according to the mattress characteristics and the needs of the service. Specialty treatments may also be offered when a situation calls for a particular approach.
                                </p>
                            </div>

                            <div style="margin-top: 2.5rem;">
                                <h2 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.35rem;">
                                    Mattress sizes and types
                                </h2>
                                <p>
                                    We clean common sizes at home—Twin, Full, Queen and King—as well as spring, hybrid and foam mattresses when the method is compatible. The inspection confirms the right approach before we begin.
                                </p>
                            </div>

                            <p style="margin-top: 2rem;">
                                For a cleaner sleep surface and a better-kept bedroom, trust professional mattress cleaning from <strong>Groupe Nettoyage Empire</strong>.
                            </p>
                            <p style="margin-top: 0.5rem;">
                                Contact us today for a <strong>quick quote</strong> and dependable service.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BENEFITS & FAQ -->
    <section class="section" style="padding-top: 0;">
        <div class="container">
            <div class="service-layout" style="display: block;">
                <div
                    class="service-main"
                    style="max-width: 800px; margin: 0 auto;"
                >
                    <!-- WHY CHOOSE US -->
                    <div
                        class="fade-in-section delay-200"
                        style="margin-top: 3rem;"
                    >
                        <h2 class="section-title text-gradient-empire">
                            Why choose us?
                        </h2>
                        <div class="benefits-grid">
                            <div class="benefit-item">
                                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                                <span>Professional inspection</span>
                            </div>
                            <div class="benefit-item">
                                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                                <span>Professional Steam Cleaning &amp; Extraction</span>
                            </div>
                            <div class="benefit-item">
                                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                                <span>Adapted specialty treatments</span>
                            </div>
                        </div>
                    </div>

                    <!-- SERVICE AREAS -->
                    <div class="zones-section" style="margin-top: 3rem; margin-bottom: 3rem;">
                        <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Service areas</h3>
                        <p>We provide in-home service across Greater Montreal, Laval and the South Shore with our mobile units.</p>

                        <div class="city-group">
                            <p class="city-lead">Montreal (East and West)</p>
                            <div class="badges-container">
                                <span class="badge badge-blue">Montreal (all boroughs)</span>
                                <span class="badge badge-blue">Westmount</span>
                                <span class="badge badge-blue">Mount Royal</span>
                                <span class="badge badge-blue">Outremont</span>
                                <span class="badge badge-blue">LaSalle</span>
                                <span class="badge badge-blue">And more...</span>
                            </div>
                        </div>

                        <div class="city-group">
                            <p class="city-lead">Laval</p>
                            <div class="badges-container">
                                <span class="badge badge-blue">Laval (entire city)</span>
                                <span class="badge badge-blue">Chomedey</span>
                                <span class="badge badge-blue">Sainte-Rose</span>
                                <span class="badge badge-blue">Vimont</span>
                            </div>
                        </div>

                        <div class="city-group">
                            <p class="city-lead">Montreal South Shore</p>
                            <div class="badges-container">
                                <span class="badge badge-green">Longueuil</span>
                                <span class="badge badge-green">Brossard</span>
                                <span class="badge badge-green">Saint-Lambert</span>
                                <span class="badge badge-green">Saint-Hubert</span>
                                <span class="badge badge-green">Greenfield Park</span>
                                <span class="badge badge-green">Saint-Bruno</span>
                                <span class="badge badge-green">Boucherville</span>
                                <span class="badge badge-green">Candiac</span>
                                <span class="badge badge-green">And more...</span>
                            </div>
                        </div>
                        
                        <p class="contact-footer">Need an appointment? Call us at <strong>(514) 893-9939</strong>.</p>
                    </div>

                    <div
                        class="fade-in-section delay-200"
                        style="margin-top: 2rem; margin-bottom: 1.5rem; padding: 1.5rem 1.75rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); border-radius: 8px; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <h3 style="color: var(--color-primary); margin: 0 0 0.75rem; font-size: 1.2rem;">
                            Mattress cleaning in Westmount
                        </h3>
                        <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                            We also offer mattress cleaning and disinfection in Westmount, in the home. The technician inspects the mattress to adapt the method to stains, odours, sweat and textile condition. Specialty treatments are offered when relevant and authorized by you.
                        </p>
                    </div>

                    <div
                        class="fade-in-section delay-200"
                        style="margin-top: 2rem; margin-bottom: 2rem; padding: 1.5rem 1.75rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); border-radius: 8px; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <h3 style="color: var(--color-primary); margin: 0 0 0.75rem; font-size: 1.2rem;">
                            Mattress cleaning in Longueuil, Boucherville and Candiac
                        </h3>
                        <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                            The same service in Longueuil, Boucherville and Candiac: inspection first, then cleaning adapted to the mattress. Deodorizing or disinfection when the situation warrants it and with your approval.
                        </p>
                    </div>

                    <!-- FAQ -->
                    <div class="fade-in-section delay-300" style="margin-top: 3rem;">
                        <h2 class="section-title text-gradient-empire">
                            Frequently asked questions — mattress cleaning and disinfection
                        </h2>
                        <FAQSchema
                            faqs={[
                                {
                                    question:
                                        "What is the difference between mattress cleaning and disinfection?",
                                    answer: "Cleaning removes soil, body residue and treatable stains with steam, shampooing and hot-water extraction when the textile allows. Deodorizing targets persistent odours when relevant. Disinfection is an additional treatment, compatible with the textile and suited to the situation, to help reduce bacteria and certain microorganisms on treated areas. It is not automatic on every mattress.",
                                },
                                {
                                    question:
                                        "Do you treat human or pet urine stains?",
                                    answer: "Yes, that is a common request. After inspection, the technician may recommend an enzymatic pre-treatment or another specialty treatment, then proceed with cleaning and extraction. Every additional treatment is explained and applied only with your authorization. Results depend on how old and how deep the stain is.",
                                },
                                {
                                    question:
                                        "Can you treat blood stains, rings and yellowing?",
                                    answer: "Often yes, with an approach adapted to the textile. Recent stains generally respond better. Rings, halos and yellowing linked to sweat can be improved; an old halo may leave a trace even after a thorough cleaning. We tell you what is realistic before we start.",
                                },
                                {
                                    question:
                                        "Does cleaning help with dust mites, allergens and bacteria?",
                                    answer: "Deep cleaning helps remove dust, dead skin, residue and contaminants associated with allergens. When appropriate, a disinfectant treatment compatible with the textile may be offered as a complement. Steam alone is not automatic disinfection of every mattress.",
                                },
                                {
                                    question:
                                        "Are enzyme, oxygen-based or disinfectant treatments included?",
                                    answer: "They are not automatic. Depending on the inspection, they may serve as a pre-treatment or a complementary step. The technician explains what is recommended, needed based on the assessment, or optional, then obtains your authorization before any application.",
                                },
                                {
                                    question:
                                        "How long before I can sleep on my mattress again?",
                                    answer: "Drying usually takes 2 to 6 hours, depending on mattress type, room humidity and ventilation. After extraction, the surface is typically slightly damp, not soaked. A morning or early-afternoon cleaning often lets you reuse the bed the same day; a fan speeds the process.",
                                },
                                {
                                    question:
                                        "Do you clean foam, hybrid and spring mattresses?",
                                    answer: "Yes, when the method is compatible. Spring, hybrid and foam mattresses do not all receive the same process: inspection confirms the approach, especially for foam, which needs good moisture control. Twin, Full, Queen and King sizes are handled in the home.",
                                },
                                {
                                    question:
                                        "Should I have a relatively new mattress cleaned?",
                                    answer: "Even a recent mattress collects sweat, body residue and dust. Periodic professional cleaning helps keep a cleaner sleep surface, especially with children, pets or allergen sensitivities. The ideal interval depends on use; the technician can advise based on what is observed.",
                                },
                            ]}
                        />
                    </div>

                    <p
                        class="fade-in-section"
                        style="margin-top: 2rem; margin-bottom: 1rem; line-height: 1.65; color: var(--color-text-main); font-size: 0.95rem;"
                    >
                        Also have a sofa or couch to refresh? See our
                        <a href="/en/services/meubles-tissu/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">fabric furniture cleaning</a>
                        or our
                        <a href="/en/video-gallery/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">video gallery</a>.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        // Force script to run immediately using is:inline
        (function () {
            // Slideshow Logic
            document.querySelectorAll(".slideshow-container").forEach((container) => {
                const slides = container.querySelectorAll(".slide");
                if (slides.length <= 1) return;
                let currentSlide = 0;
                setInterval(() => {
                    slides[currentSlide].classList.remove("active");
                    currentSlide = (currentSlide + 1) % slides.length;
                    slides[currentSlide].classList.add("active");
                }, 4000);
            });
        })();
    </script>

    <style>
        /* HERO */
        /* SPLIT SCREEN HERO (Sky Blue Theme) */
        .split-hero-container {
            background-color: #fff; /* Reset container to white */
            padding-top: 0; /* Remove container padding so image hits top */
            padding-bottom: 0;
            overflow: hidden;
            width: 100vw;
        }
        .full-width-split {
            width: 100%;
            max-width: none;
            padding: 0;
            margin: 0;
        }
        .split-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            align-items: stretch;
            min-height: 80vh; /* Consistent viewport height */
        }
        /* LEFT TEXT COLUMN */
        .split-content {
            background-color: #ffffff;
            padding: 100px 4rem 4rem 10%; /* Add header offset internal padding */
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            z-index: 2;
        }
        .service-cat-badge {
            text-transform: uppercase;
            color: var(--color-accent);
            font-weight: 700;
            letter-spacing: 2px;
            font-size: 0.85rem;
            display: block;
            margin-bottom: 1rem;
        }
        .split-title {
            font-size: clamp(2.5rem, 3.5vw, 4rem);
            color: var(--color-primary); /* Dark Blue text */
            margin-bottom: 2rem;
            line-height: 1.1;
        }
        .problem-statement {
            background: #ffffff; /* White box */
            border-left: 4px solid #ff4444; /* Red border returns for alertness */
            padding: 1.5rem;
            border-radius: 0;
            margin-bottom: 2rem;
            box-shadow: 0 4px 15px rgba(174, 206, 235, 0.3); /* Soft blue shadow */
        }
        .problem-title {
            font-size: clamp(0.82rem, 2.5vw, 1rem);
            color: #cc0000;
            margin-bottom: 0.65rem;
            text-transform: uppercase;
            font-weight: 700;
            line-height: 1.35;
            overflow-wrap: anywhere;
            hyphens: auto;
        }
        .problem-text {
            font-size: 1.05rem;
            color: var(--color-text-main);
            font-style: italic;
            line-height: 1.55;
        }
        .problem-text + .problem-text {
            margin-top: 0.75rem;
        }
        .lead-text {
            font-size: 1.15rem;
            line-height: 1.7;
            color: var(--color-text-main); /* Dark grey text */
            margin-bottom: 2.5rem;
            max-width: 650px;
        }
        .cta-group {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .cta-btn-stack {
            display: inline-flex;
            flex-direction: column;
            align-items: flex-start;
            line-height: 1.25;
            gap: 0.1rem;
            text-align: left;
        }
        .cta-btn-phone-num {
            font-size: 0.92em;
            font-weight: 800;
        }
        @media (max-width: 900px) {
            .cta-group {
                display: none !important;
            }
        }
        /* Reset Secondary Button for Light Mode */
        .split-content .btn-secondary-outline {
            border-color: #ddd;
            color: #666;
        }
        .split-content .btn-secondary-outline:hover {
            background: white;
            color: var(--color-primary);
            border-color: var(--color-primary);
        }
        /* RIGHT IMAGE COLUMN */
        .split-image-wrapper {
            position: relative;
            height: 100%;
            min-height: 500px;
            width: 100%;
            border-radius: 0;
            transform: none;
            box-shadow: none;
            margin: 0;
            background-color: #fff; /* Ensure white background if image loads late */
        }
        /* Slideshow Styles reused but adapted for full height */
        .slideshow-container {
            position: relative;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
        }
        .slide.active {
            opacity: 1;
        }
        /* RESPONSIVE */
        @media (max-width: 1024px) {
            .split-layout {
                grid-template-columns: 1fr;
                min-height: auto;
            }
            .lead-text {
                max-width: 100%;
            }
        }
        /* LAYOUT */
        .service-layout {
            display: grid;
            grid-template-columns: 1.8fr 1fr;
            gap: 5rem;
        }
        /* TYPOGRAPHY */
        .section-title {
            font-size: 1.8rem;
            color: var(--color-primary);
