---
import Layout from "../../../layouts/Layout.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import LocalTapisCrossServiceLinks from "../../../components/LocalTapisCrossServiceLinks.astro";
import UiIcon from "../../../components/icons/UiIcon.astro";
---

<Layout
  title="Carpet Cleaning La Prairie | Historic core, mixed zones, road access"
  description="Carpet and upholstery cleaning in La Prairie: historic Old La Prairie, mixed residential/commercial areas, and bridge corridor traffic. Truck-mount deep clean with fast drying."
>
  <div class="split-hero-container mobile-hero-stack">
    <div class="container full-width-split">
      <div class="split-layout">
        <div class="split-content fade-in-section">
          <span class="service-cat-badge">LOCAL SOLUTION • LA PRAIRIE</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Carpet & Sofa Cleaning in La Prairie
          </h1>

          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
            <img
              src="/images/catalog/camion-usine-nettoyage-empire.webp"
              alt="Our high-power extraction truck-mount unit parked in La Prairie"
              class="slide active"
              width="1200"
              height="800"
              loading="eager"
            />
            <img
              src="/images/catalog/resultat-nettoyage-escaliers-tapis.webp"
              alt="Carpet stair cleaning result in La Prairie"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/nettoyage-fauteuil-professionnel.webp"
              alt="Empire technician cleaning a fabric sofa in La Prairie"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100" style="border-left-color: var(--color-accent);">
            <h3 class="problem-title" style="color: var(--color-primary);">A City of Transition and Through-Traffic:</h3>
            <p class="problem-text">
              La Prairie combines a historic core, established residential streets, newer projects, and mixed commercial activity. With bridge corridors and major road access nearby, entry zones collect salt, fine dust, and traffic residue faster than in quieter purely residential suburbs.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            Our La Prairie approach reflects this mixed reality: older homes with basement and stair wear, newer condo stock, local offices, and retail spaces. Truck-mount extraction gives deep soil removal with quick drying, useful when surfaces must be operational again the same day.
          </p>

          <div class="cta-group fade-in-up delay-300">
            <a href="tel:5148939939" class="btn btn-gradient-green pulse-btn">
              <span class="icon" aria-hidden="true"><UiIcon name="phone" size={18} /></span>
              (514) 893-9939 (La Prairie Service)
            </a>
            <button onclick="window.openEstimationWidget()" class="btn btn-gradient-green">
              Free Quote
            </button>
          </div>
        </div>

        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
            <img
              src="/images/catalog/camion-usine-nettoyage-empire.webp"
              alt="Our high-power extraction truck-mount unit parked in La Prairie"
              class="slide active"
              width="1200"
              height="800"
              fetchpriority="high"
              loading="eager"
            />
            <img
              src="/images/catalog/resultat-nettoyage-escaliers-tapis.webp"
              alt="Carpet stair cleaning result in La Prairie"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/nettoyage-fauteuil-professionnel.webp"
              alt="Empire technician cleaning a fabric sofa in La Prairie"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="service-layout">
        <div class="service-main">
          <div class="fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Why Choose Us in La Prairie?
            </h2>
            <p>
              Our commitment is simple: consistent quality in a city where heritage housing, new districts, and business activity coexist. We adapt products, agitation, and rinse depth based on fiber age, cleaning history, and interior traffic intensity.
            </p>
            <ul class="benefit-list" style="margin-bottom: 3rem;">
              <li>
                <strong>State-of-the-Art Technology:</strong> The truck-mount outperforms all portable machines. Dirt is expelled out of your home and into our truck.
              </li>
              <li>
                <strong>Ultra-Fast Drying:</strong> Thanks to our industrial suction, your carpets are dry in 3 to 6 hours.
              </li>
              <li>
                <strong>Fabric Care:</strong> We clean all types of furniture (cotton, microfiber, velvet, leather) with tailored products.
              </li>
              <li>
                <strong>Disinfection Included:</strong> Hot steam naturally acts as a powerful disinfectant against mites and microbes.
              </li>
            </ul>

            <div style="margin-top: 3rem; background-color: #f8f9fa; border-left: 4px solid var(--color-accent); padding: 2rem; border-radius: 8px;">
              <h3 style="color: var(--color-primary); margin-bottom: 1rem;">
                Peace of Mind for the Entire Family
              </h3>
              <p>
                Our products are safe for children and pets. We use no heavy perfumes or sticky chemical residues.
              </p>
            </div>

            <div class="tapis-trio-links" style="margin-top: 2.25rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); padding: 1.5rem 1.75rem; border-radius: 8px;">
              <h3 style="color: var(--color-primary); margin: 0 0 0.6rem; font-size: 1.2rem">South Shore local linking</h3>
              <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                <a href="/en/services/nettoyage-tapis-rive-sud" class="tapis-trio-links__a">South Shore overview</a> ·
                <a href="/en/services/nettoyage-tapis-longueuil" class="tapis-trio-links__a">Longueuil</a> ·
                <a href="/en/services/nettoyage-tapis-brossard" class="tapis-trio-links__a">Brossard</a> ·
                <a href="/en/services/nettoyage-tapis-boucherville" class="tapis-trio-links__a">Boucherville</a> ·
                <a href="/en/services/nettoyage-tapis-saint-bruno" class="tapis-trio-links__a">Saint-Bruno</a> ·
                neighboring city: <a href="/en/services/nettoyage-tapis-candiac" class="tapis-trio-links__a">Candiac</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-main" style="max-width: 800px; margin: 0 auto;">
          <div class="zones-section" style="margin-top: 3rem; margin-bottom: 3rem;">
            <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Areas we serve in La Prairie:</h3>
            <div class="city-group">
              <div class="badges-container">
                <span class="badge badge-blue">Old La Prairie</span>
                <span class="badge badge-blue">Symbiocité</span>
                <span class="badge badge-blue">La Citière</span>
                <span class="badge badge-blue">Grand Boisé</span>
              </div>
            </div>
            <p class="contact-footer">La Prairie customer service: <strong>(514) 893-9939</strong>.</p>
          </div>

          <LocalTapisCrossServiceLinks locale="en" />

          <div class="fade-in-section delay-300" style="margin-top: 3rem;">
            <h2 class="section-title text-gradient-empire">
              Frequently Asked Questions — La Prairie
            </h2>
            <FAQSchema
              faqs={[
                {
                  question: "How long does an average visit take?",
                  answer: "For a living room and two bedrooms, plan for about 1.5 to 2 hours of work.",
                },
                {
                  question: "Do you remove embedded pet hair?",
                  answer: "Yes, our mechanical brushing combined with heavy steam dislodges hair that regular vacuums cannot reach.",
                },
                {
                  question: "What do you need on-site?",
                  answer: "We are self-sufficient. We only need exterior access to park our truck and a regular water faucet to fill our tank if necessary.",
                },
                {
                  question: "Why does La Prairie often need a different approach between the historic sector and newer neighborhoods?",
                  answer: "Historic zones often have older fibers, basements, and carpets with multiple cleaning cycles. Newer areas may have denser carpet but heavier entry traffic. We adjust chemistry, agitation, and rinse depth to the exact context.",
                }
              ]}
            />
          </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".slideshow-container").forEach((container) => {
    const slides = container.querySelectorAll(".slide");
    if (slides.length <= 1) return;
    let currentSlide = 0;
    setInterval(() => {
      slides[currentSlide].classList.remove("active");
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add("active");
    }, 4000);
  });
</script>

<style>
  .split-hero-container { background-color: #fff; padding-top: 0; padding-bottom: 0; overflow: hidden; width: 100vw; }
  .full-width-split { width: 100%; max-width: none; padding: 0; margin: 0; }
  .split-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: stretch; min-height: 80vh; }
  .split-content { background-color: #ffffff; padding: 100px 4rem 4rem 10%; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 2; }
  .service-cat-badge { text-transform: uppercase; color: var(--color-accent); font-weight: 700; letter-spacing: 2px; font-size: 0.85rem; display: block; margin-bottom: 1rem; }
  .split-title { font-size: clamp(2.5rem, 3.5vw, 4rem); color: var(--color-primary); margin-bottom: 2rem; line-height: 1.1; }
  .city-group { margin-bottom: 1.5rem; }
  .badges-container { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .badge { padding: 0.4rem 0.9rem; border-radius: 20px; font-size: 0.9rem; border: 1px solid transparent; }
  .badge-blue { background: #e8f4fd; border-color: #c5dff0; }
  .problem-statement { background: #ffffff; border-left: 4px solid #ff4444; padding: 1.5rem; border-radius: 0; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(174, 206, 235, 0.3); }
  .problem-title { font-size: 1rem; color: #cc0000; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 700; }
  .problem-text { font-size: 1.05rem; color: var(--color-text-main); font-style: italic; }
  .lead-text { font-size: 1.15rem; line-height: 1.7; color: var(--color-text-main); margin-bottom: 2.5rem; max-width: 650px; }
  .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; }
  @media (max-width: 900px) { .cta-group { display: none !important; } }
  .split-image-wrapper { position: relative; height: 100%; min-height: 500px; width: 100%; }
  .slideshow-container { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .slideshow-container img.slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }
  .slideshow-container img.slide.active { opacity: 1; }
  @media (max-width: 1024px) {
    .split-layout { grid-template-columns: 1fr; min-height: auto; }
    .split-content { padding: 3rem 1.5rem; order: 1; }
    .split-image-wrapper { order: 2; height: 400px; min-height: 0; }
  }
  .service-layout { display: grid; grid-template-columns: 1fr; gap: 5rem; }
  .section-title { font-size: 1.8rem; color: var(--color-primary); margin-bottom: 1.5rem; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; display: inline-block; }
  .benefit-list { margin: 2rem 0; list-style: none; padding: 0; }
  .benefit-list li { margin-bottom: 1rem; padding-left: 0; position: relative; font-size: 1.05rem; }
  .contact-footer { margin-top: 1.5rem; font-style: italic; color: #666; }
  .tapis-trio-links__a { color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
</style>
