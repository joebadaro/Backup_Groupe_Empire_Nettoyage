---
import Layout from "../../../layouts/Layout.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import LocalTapisCrossServiceLinks from "../../../components/LocalTapisCrossServiceLinks.astro";
import UiIcon from "../../../components/icons/UiIcon.astro";
---

<Layout
  title="Residential Carpet Cleaning in Boucherville | Homes, Condos, Stairs"
  description="Residential carpet cleaning in Boucherville for family homes and condos: basements, stairs, living areas, and high-traffic zones. Professional deep extraction with fast drying and reliable in-home service."
>
  <!-- SPLIT SCREEN HERO -->
  <div class="split-hero-container mobile-hero-stack">
    <div class="container full-width-split">
      <div class="split-layout">
        <!-- LEFT COLUMN: CONTENT (Hook) -->
        <div class="split-content fade-in-section">
          <span class="service-cat-badge">PRESTIGE LEVEL • BOUCHERVILLE</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Residential Carpet Cleaning in Boucherville
          </h1>

          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
             <img
              src="/images/catalog/nettoyage-fauteuil-professionnel.webp"
              alt="Professional furniture cleaning in a Boucherville home"
              class="slide active"
              width="1200"
              height="800"
              loading="eager"
            />
            <img
              src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
              alt="Empire Cleaning truck-mount deployed in Boucherville"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
             <img
              src="/images/catalog/photo-40.webp"
              alt="Upholstered living room furniture cleaned by steam extraction"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100" style="border-left-color: var(--color-accent);">
            <h2 class="problem-title" style="color: var(--color-primary);">Daily Family Use and High-Traffic Carpets:</h2>
            <p class="problem-text">
              In Boucherville homes and residential condos, carpets in living areas, basements and staircases are used heavily every day. With children, pets and frequent
              foot traffic, fibers quickly collect fine dust, tracked-in debris and everyday stains.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            In Boucherville, our approach is built for residential maintenance: protect home comfort, extend carpet life and keep daily spaces clean without adding complexity.
            We adapt products and agitation based on fiber type, usage intensity and whether children or pets are part of the household routine.
          </p>

          <div class="cta-group fade-in-up delay-300">
            <a href="tel:5148939939" class="btn btn-gradient-green pulse-btn">
              <span class="icon" aria-hidden="true"><UiIcon name="phone" size={18} /></span>
              <span class="cta-btn-stack">
                <span>Call for a Fast Estimate</span>
                <span class="cta-btn-phone-num">(514) 893-9939</span>
              </span>
            </a>
            <button
              onclick="window.openEstimationWidget()"
              class="btn btn-gradient-green"
            >
              <span class="icon" aria-hidden="true"><UiIcon name="bolt" size={18} /></span>
              Request a Free Estimate
            </button>
          </div>
        </div>

        <!-- RIGHT COLUMN: IMAGE (Visual / Slideshow) -->
        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
             <img
              src="/images/catalog/nettoyage-fauteuil-professionnel.webp"
              alt="Professional furniture cleaning in a Boucherville home"
              class="slide active"
              width="1200"
              height="800"
              fetchpriority="high"
              loading="eager"
            />
            <img
              src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
              alt="Empire Cleaning truck-mount deployed in Boucherville"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
             <img
              src="/images/catalog/photo-40.webp"
              alt="Upholstered living room furniture cleaned by steam extraction"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="service-layout">
        <!-- MAIN CONTENT -->
        <div class="service-main">
          <!-- BENEFIT LIST & SEO CONTENT -->
          <div class="fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Why Boucherville homeowners choose our service
            </h2>

            <p>
              Our method combines technical rigor and careful execution for family homes and residential condos in Boucherville. We focus on living room carpets, basements,
              stairs and hallways to improve everyday cleanliness and comfort.
            </p>

            <ul class="benefit-list" style="margin-bottom: 3rem;">
              <li>
                <strong>Truck-Mount Advantage:</strong> Our units use high-temperature water and deep extraction to clean thoroughly while avoiding over-wetting.
              </li>
              <li>
                <strong>Delicate Fabric Care:</strong> Designer furniture and genuine wool rugs require special skills. We use a low-pH conditioner to prevent color migration (bleeding) of your valuable area rugs.
              </li>
              <li>
                <strong>Home Hygiene Benefits:</strong> Thermal extraction helps reduce dust mites, mold spores and pet-related allergens in carpet fibers.
              </li>
              <li>
                <strong>High-Traffic Area Care:</strong> We target entryways, hallways, stairs and family zones to limit premature fiber wear.
              </li>
              <li>
                <strong>Fast Drying:</strong> Thanks to strong extraction, carpets are often dry within 3 to 5 hours depending on ventilation and textile type.
              </li>
            </ul>

            <p style="margin-top: 0; margin-bottom: 0; line-height: 1.65; color: var(--color-text-main);">
              In Boucherville, our at-home carpet cleaning service is designed for family homes, condos and residential spaces where carpets collect dust, traffic marks and everyday soil. To understand our full method, visit our <a href="/en/services/nettoyage-tapis-residentiel/" class="tapis-trio-links__a">residential carpet cleaning service</a>.
            </p>

            <div style="margin-top: 3rem; background-color: #f8f9fa; border-left: 4px solid var(--color-accent); padding: 2rem; border-radius: 8px;">
               <h3 style="color: var(--color-primary); margin-bottom: 1rem;">
                Home-safe product approach
              </h3>
              <p>
                We use professional non-toxic products with no heavy residues, suitable for homes with children and pets. The goal is deep cleaning that respects indoor
                living environments.
              </p>
            </div>

            <div style="margin-top: 3rem;">
              <hr class="separator" />
              <h3>Everyday Stain Care</h3>
              <p>
                Drink spills, food stains or pet marks? Avoid aggressive scrubbing. Read our <a href="/en/conseils/erreurs-taches-tapis" style="color: var(--color-accent); font-weight: bold;">practical stain guide</a> and contact us for a treatment adapted to your carpet.
              </p>
            </div>

            <div class="tapis-trio-links" style="margin-top: 2.25rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); padding: 1.5rem 1.75rem; border-radius: 8px;">
              <h3 style="color: var(--color-primary); margin: 0 0 0.6rem; font-size: 1.2rem">South Shore: more local pages</h3>
              <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                <a href="/en/services/nettoyage-tapis-rive-sud" class="tapis-trio-links__a">South Shore overview</a> · <a href="/en/services/nettoyage-tapis-longueuil" class="tapis-trio-links__a">Longueuil &amp; Saint-Hubert</a> · <a href="/en/services/nettoyage-tapis-brossard" class="tapis-trio-links__a">Brossard</a> · next-door neighbour: <a href="/en/services/nettoyage-tapis-saint-bruno" class="tapis-trio-links__a">Saint-Bruno-de-Montarville</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NEW SECTIONS: BENEFITS & FAQ -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-layout" style="display: block;">
        <div class="service-main" style="max-width: 800px; margin: 0 auto;">
           
           <!-- ZONES DESSERVIES -->
          <div class="zones-section" style="margin-top: 3rem; margin-bottom: 3rem;">
            <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Rapid Intervention Everywhere in Boucherville</h3>

             <div class="city-group">
              <div class="badges-container">
                <span class="badge badge-blue">Old Boucherville (Heritage Sector)</span>
                <span class="badge badge-blue">Boucherville Industrial Park</span>
                <span class="badge badge-blue">Harmonie Sector</span>
                <span class="badge badge-blue">Les Boisés</span>
                <span class="badge badge-blue">Riverside Estates (Fleuve)</span>
                <span class="badge badge-blue">Varennes (Nearby)</span>
              </div>
            </div>
            <p class="contact-footer">Secure your appointment slot today: <strong>(514) 893-9939</strong>.</p>
          </div>

          <LocalTapisCrossServiceLinks locale="en" />

          <!-- FAQ -->
          <div class="fade-in-section delay-300" style="margin-top: 3rem;">
            <h2 class="section-title text-gradient-empire">
              Frequently Asked Questions — Residential Boucherville
            </h2>
            <FAQSchema
              faqs={[
                {
                  question: "Do you clean basement and staircase carpets in family homes?",
                  answer:
                    "Yes. We regularly clean basements, stairs and hallways, with a method adjusted to wear level and carpet fiber type.",
                },
                {
                  question: "Is your service suitable for homes with children and pets?",
                  answer:
                    "Absolutely. We use professional non-toxic products and deep extraction to improve cleanliness in the most heavily used living areas.",
                },
                {
                  question: "How long does drying usually take after residential carpet cleaning?",
                  answer:
                    "In most cases, carpets dry within a few hours, often between 3 and 6 hours depending on airflow, humidity and carpet thickness.",
                },
                {
                  question: "Can you treat stubborn stains in family and dining areas?",
                  answer:
                    "Yes. We apply targeted pre-treatment and adapted extraction to significantly improve stained zones, based on the actual condition of the fibers.",
                },
                {
                  question: "Do you also provide service in residential condos in Boucherville?",
                  answer:
                    "Yes. We adapt logistics and cleaning method to the building so living spaces are cleaned effectively with minimal disruption.",
                }
              ]}
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".slideshow-container").forEach((container) => {
    const slides = container.querySelectorAll(".slide");
    if (slides.length <= 1) return;
    let currentSlide = 0;
    setInterval(() => {
      slides[currentSlide].classList.remove("active");
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add("active");
    }, 4000);
  });
</script>

<style>
  /* Base styles reused for consistency */
  .split-hero-container { background-color: #fff; padding-top: 0; padding-bottom: 0; overflow: hidden; width: 100vw; }
  .full-width-split { width: 100%; max-width: none; padding: 0; margin: 0; }
  .split-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: stretch; min-height: 80vh; }
  .split-content { background-color: #ffffff; padding: 100px 4rem 4rem 10%; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 2; }
  .service-cat-badge { text-transform: uppercase; color: var(--color-accent); font-weight: 700; letter-spacing: 2px; font-size: 0.85rem; display: block; margin-bottom: 1rem; }
  .split-title { font-size: clamp(2.5rem, 3.5vw, 4rem); color: var(--color-primary); margin-bottom: 2rem; line-height: 1.1; }
  .city-group { margin-bottom: 1.5rem; }
  .badges-container { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .badge { padding: 0.4rem 0.9rem; border-radius: 20px; font-size: 0.9rem; border: 1px solid transparent; }
  .badge-blue { background: #e8f4fd; border-color: #c5dff0; }
  .problem-statement { background: #ffffff; border-left: 4px solid #ff4444; padding: 1.5rem; border-radius: 0; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(174, 206, 235, 0.3); }
  .problem-title { font-size: 1rem; color: #cc0000; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 700; }
  .problem-text { font-size: 1.05rem; color: var(--color-text-main); font-style: italic; }
  .lead-text { font-size: 1.15rem; line-height: 1.7; color: var(--color-text-main); margin-bottom: 2.5rem; max-width: 650px; }
  .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; }
  .cta-btn-stack {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
    gap: 0.1rem;
    text-align: left;
  }
  .cta-btn-phone-num {
    font-size: 0.92em;
    font-weight: 800;
  }
  @media (max-width: 900px) { .cta-group { display: none !important; } }
  .split-image-wrapper { position: relative; height: 100%; min-height: 500px; width: 100%; }
  .slideshow-container { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .slideshow-container img.slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }
  .slideshow-container img.slide.active { opacity: 1; }
  @media (max-width: 1024px) {
    .split-layout { grid-template-columns: 1fr; min-height: auto; }
    .lead-text { max-width: 100%; }
  }
  .service-layout { display: grid; grid-template-columns: 1fr; gap: 5rem; }
  .section-title { font-size: 1.8rem; color: var(--color-primary); margin-bottom: 1.5rem; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; display: inline-block; }
  .separator { border: 0; height: 1px; background: rgba(0, 0, 0, 0.1); margin: 1.5rem 0; }
  .benefit-list { margin: 2rem 0; list-style: none; padding: 0; }
  .benefit-list li { margin-bottom: 1rem; padding-left: 0; position: relative; font-size: 1.05rem; }
  .contact-footer { margin-top: 1.5rem; font-style: italic; color: #666; }
  .tapis-trio-links__a { color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
</style>
