import FAQSchema from "../../../components/FAQSchema.astro";
import ServiceVideoProof from "../../../components/ServiceVideoProof.astro";
import ConversionCtaPriorityGroup from "../../../components/ConversionCtaPriorityGroup.astro";
import UiIcon from "../../../components/icons/UiIcon.astro";

const services = [
  {
    slug: "tapis-residentiel",
    title: "Residential Carpet Cleaning",
    seoTitle: "Expert In-Home Residential Carpet Cleaning",
    category: "Carpets",
    icon: "",
    image: "/images/catalog/photo-tapis-clean.webp",
    slides: [
      "/images/catalog/photo-tapis-clean.webp",
      "/images/catalog/hero-slide-1.webp",
    ],
    imagePosition: "center top",
    heroHeight: "70vh",
    heroFit: "contain",
    intro:
      "Your carpets are the air filter of your home. Over time, they accumulate dust, mites, and allergens. Our in-home cleaning protects your floors while sanitizing your air.",
    problem:
      "Stubborn stains, high traffic, or in need of a hygienic refresh? Consumer methods often leave soapy residues behind.",
    process: [
      {
        title: "Pre-inspection & Protection",
