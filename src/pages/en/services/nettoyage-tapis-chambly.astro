---
import Layout from "../../../layouts/Layout.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import LocalTapisCrossServiceLinks from "../../../components/LocalTapisCrossServiceLinks.astro";
import LocalCarpetVideoProofSection from "../../../components/local-tapis/LocalCarpetVideoProofSection.astro";
import UiIcon from "../../../components/icons/UiIcon.astro";
---

<Layout
  title="Carpet Cleaning Chambly | At-home service, condos, stairs"
  description="Residential carpet cleaning in Chambly for homes and condos: stairs, basements and family living spaces. At-home carpet cleaning with professional extraction on the South Shore."
>
  <div class="split-hero-container mobile-hero-stack">
    <div class="container full-width-split">
      <div class="split-layout">
        <div class="split-content fade-in-section">
          <span class="service-cat-badge">SOUTH SHORE RESIDENTIAL • CHAMBLY</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Carpet Cleaning in Chambly
          </h1>

          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
              <img
                src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
                alt="Residential carpet cleaning visit in Chambly"
                class="slide active"
                width="1200"
                height="800"
                loading="eager"
              />
              <img
                src="/images/catalog/nettoyage-tapis-laine-jaune.webp"
                alt="Fresh carpet after at-home cleaning on the South Shore"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/camion-usine-nettoyage-empire.webp"
                alt="Truck-mount extraction equipment for Chambly-area homes"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100" style="border-left-color: var(--color-accent);">
            <h2 class="problem-title" style="color: var(--color-primary);">Busy homes, condos and everyday traffic:</h2>
            <p class="problem-text">
              In Chambly, wall-to-wall carpets in living rooms, basements and on stairs collect fine dust and tracked-in grit. Family routines, pets and daily trips toward Montreal corridors all add wear that shows first in the spaces where people actually live—not just at the front door.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            We schedule <strong>carpet cleaning at home in Chambly</strong> around your property type—house, condo or multi-level home with stairs. The focus is <strong>residential carpet cleaning</strong> where it matters: hallways, stair treads, finished basements and shared family rooms, without unnecessary furniture shuffling.
          </p>

          <div class="cta-group fade-in-up delay-300">
            <a href="tel:5148939939" class="btn btn-gradient-green pulse-btn">
              <span class="icon" aria-hidden="true"><UiIcon name="phone" size={18} /></span>
              <span class="cta-btn-stack">
                <span>Call for a Fast Estimate</span>
                <span class="cta-btn-phone-num">(514) 893-9939</span>
              </span>
            </a>
            <button onclick="window.openEstimationWidget()" class="btn btn-gradient-green">
              <span class="icon" aria-hidden="true"><UiIcon name="bolt" size={18} /></span>
              Request a Free Estimate
            </button>
          </div>
        </div>

        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
            <img
              src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
              alt="Residential carpet cleaning visit in Chambly"
              class="slide active"
              width="1200"
              height="800"
              fetchpriority="high"
              loading="eager"
            />
            <img
              src="/images/catalog/nettoyage-tapis-laine-jaune.webp"
              alt="Fresh carpet after at-home cleaning on the South Shore"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/camion-usine-nettoyage-empire.webp"
              alt="Truck-mount extraction equipment for Chambly-area homes"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>



  <LocalCarpetVideoProofSection
    title="See our carpet cleaning in action"
    subtitle="Real example of in-home residential carpet cleaning"
    description="Watch a real job and see our professional method for cleaning residential carpets right in the client's home."
    youtubeId="9TKQuGP6-GA"
    youtubeTitle="Nettoyage complet de tapis résidentiel à domicile"
    allVideosHref="/en/video-gallery/"
    posterUrl="/images/videos/video-thumb-nettoyage-tapis-maison-complet.webp"
    videoAspectRatio="9 / 16"
    playLabel="Watch the Video"
    allVideosLabel="See All Our Work"
    closeLabel="Close video"
  />
  <section class="section">
    <div class="container">
      <div class="service-layout">
        <div class="service-main">
          <div class="fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Carpet cleaning in Chambly: where we focus first
            </h2>

            <p>
              Whether you need <strong>carpet cleaning in Chambly</strong> to refresh main living areas or follow up after a busy season, we prioritize high-friction zones: stair noses, basement recreation carpet, landings and corridors from the entryway inward.
            </p>

            <ul class="benefit-list" style="margin-bottom: 3rem;">
              <li>
                <strong>Deep extraction:</strong> truck-mount or professional portable units deliver hot-water rinse and strong vacuum recovery to lift embedded soil without leaving carpets soaked.
              </li>
              <li>
                <strong>Fiber-aware cleaning:</strong> synthetics, blends and wool receive adjusted chemistry and agitation based on actual use and room type.
              </li>
              <li>
                <strong>Stairs and basements:</strong> these areas often show the heaviest wear; we work them methodically to even out appearance and reduce obvious traffic shadowing.
              </li>
              <li>
                <strong>Respectful in-home work:</strong> shoe covers, corner guards and careful hose routing help protect your interior while we work.
              </li>
            </ul>

            <p style="margin-top: 0; margin-bottom: 0; line-height: 1.65; color: var(--color-text-main);">
              For our full step-by-step residential process across the South Shore, read the details on our <a href="/en/services/nettoyage-tapis-residentiel/" class="tapis-trio-links__a">residential carpet cleaning service</a>.
            </p>

            <div style="margin-top: 3rem; background-color: #f8f9fa; border-left: 4px solid var(--color-accent); padding: 2rem; border-radius: 8px;">
              <h3 style="color: var(--color-primary); margin-bottom: 1rem;">
                Households with kids and pets
              </h3>
              <p>
                We select professional products suited to active homes and rely on thorough extraction to reduce allergens and fine dust trapped in carpet pile.
              </p>
            </div>

            <div class="tapis-trio-links" style="margin-top: 2.25rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); padding: 1.5rem 1.75rem; border-radius: 8px;">
              <h3 style="color: var(--color-primary); margin: 0 0 0.6rem; font-size: 1.2rem">More South Shore carpet pages</h3>
              <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                <a href="/en/services/nettoyage-tapis-rive-sud/" class="tapis-trio-links__a">South Shore overview</a> ·
                <a href="/en/services/nettoyage-tapis-longueuil/" class="tapis-trio-links__a">Longueuil</a> ·
                <a href="/en/services/nettoyage-tapis-candiac/" class="tapis-trio-links__a">Candiac</a> ·
                nearby: <a href="/en/services/nettoyage-tapis-la-prairie/" class="tapis-trio-links__a">La Prairie</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-layout" style="display: block;">
        <div class="service-main" style="max-width: 800px; margin: 0 auto;">
          <div class="zones-section" style="margin-top: 3rem; margin-bottom: 3rem;">
            <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Service area around Chambly</h3>
            <div class="city-group">
              <div class="badges-container">
                <span class="badge badge-blue">Central neighborhoods</span>
                <span class="badge badge-blue">Family-oriented sectors</span>
                <span class="badge badge-blue">Townhouses and condos</span>
                <span class="badge badge-blue">South Shore commuter corridors</span>
              </div>
            </div>
            <p class="contact-footer">Book carpet cleaning in Chambly: <strong>(514) 893-9939</strong>.</p>
          </div>

          <LocalTapisCrossServiceLinks locale="en" />

          <div class="fade-in-section delay-300" style="margin-top: 3rem;">
            <h2 class="section-title text-gradient-empire">
              FAQ — carpet cleaning in Chambly
            </h2>
            <FAQSchema
              faqs={[
                {
                  question: "Do you offer at-home carpet cleaning throughout Chambly?",
                  answer:
                    "Yes. We serve houses, condos and residential duplexes on scheduled South Shore routes. Equipment choice depends on building access and layout.",
                },
                {
                  question: "How is maintenance cleaning different from a deeper restorative visit?",
                  answer:
                    "Maintenance visits focus on soil load and appearance refresh; deeper work adds targeted pre-treatment and extraction for compacted traffic lanes. Your technician recommends based on fiber condition and use patterns.",
                },
                {
                  question: "Are carpeted stairs handled differently?",
                  answer:
                    "Yes. We use specialized hand tools for treads and risers so extraction reaches step edges and landings without over-wetting.",
                },
                {
                  question: "Typical drying time after residential cleaning?",
                  answer:
                    "Often a few hours—commonly 3 to 6—depending on airflow, carpet thickness and indoor temperature.",
                },
              ]}
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".slideshow-container").forEach((container) => {
    const slides = container.querySelectorAll(".slide");
    if (slides.length <= 1) return;
    let currentSlide = 0;
    setInterval(() => {
      slides[currentSlide].classList.remove("active");
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add("active");
    }, 4000);
  });
</script>

<style>
  .split-hero-container { background-color: #fff; padding-top: 0; padding-bottom: 0; overflow: hidden; width: 100vw; }
  .full-width-split { width: 100%; max-width: none; padding: 0; margin: 0; }
  .split-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: stretch; min-height: 80vh; }
  .split-content { background-color: #ffffff; padding: 100px 4rem 4rem 10%; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 2; }
  .service-cat-badge { text-transform: uppercase; color: var(--color-accent); font-weight: 700; letter-spacing: 2px; font-size: 0.85rem; display: block; margin-bottom: 1rem; }
  .split-title { font-size: clamp(2.5rem, 3.5vw, 4rem); color: var(--color-primary); margin-bottom: 2rem; line-height: 1.1; }
  .city-group { margin-bottom: 1.5rem; }
  .badges-container { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .badge { padding: 0.4rem 0.9rem; border-radius: 20px; font-size: 0.9rem; border: 1px solid transparent; }
  .badge-blue { background: #e8f4fd; border-color: #c5dff0; }
  .problem-statement { background: #ffffff; border-left: 4px solid #ff4444; padding: 1.5rem; border-radius: 0; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(174, 206, 235, 0.3); }
  .problem-title { font-size: 1rem; color: #cc0000; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 700; }
  .problem-text { font-size: 1.05rem; color: var(--color-text-main); font-style: italic; }
  .lead-text { font-size: 1.15rem; line-height: 1.7; color: var(--color-text-main); margin-bottom: 2.5rem; max-width: 650px; }
  .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; }
  .cta-btn-stack {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
    gap: 0.1rem;
    text-align: left;
  }
  .cta-btn-phone-num {
    font-size: 0.92em;
    font-weight: 800;
  }
  @media (max-width: 900px) { .cta-group { display: none !important; } }
  .split-image-wrapper { position: relative; height: 100%; min-height: 500px; width: 100%; }
  .slideshow-container { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .slideshow-container img.slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }
  .slideshow-container img.slide.active { opacity: 1; }
  @media (max-width: 1024px) {
    .split-layout { grid-template-columns: 1fr; min-height: auto; }
    .lead-text { max-width: 100%; }
  }
  .service-layout { display: grid; grid-template-columns: 1fr; gap: 5rem; }
  .section-title { font-size: 1.8rem; color: var(--color-primary); margin-bottom: 1.5rem; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; display: inline-block; }
  .benefit-list { margin: 2rem 0; list-style: none; padding: 0; }
  .benefit-list li { margin-bottom: 1rem; padding-left: 0; position: relative; font-size: 1.05rem; }
  .contact-footer { margin-top: 1.5rem; font-style: italic; color: #666; }
  .tapis-trio-links__a { color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
</style>
