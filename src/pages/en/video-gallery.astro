---
import Layout from "../../layouts/Layout.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import PresentationGalleryCard from "../../components/PresentationGalleryCard.astro";
import UiIcon from "../../components/icons/UiIcon.astro";
import { getPresentationGalleryEntry } from "../../data/presentationVideos";
import {
  SALON_SECTIONNEL_POSTER_SIZES_GRID,
  SALON_SECTIONNEL_POSTER_SRCSET,
} from "../../data/salonSectionnelPoster";

const title = "Video Gallery | Groupe Nettoyage Empire";
const description = "Watch our before-and-after cleaning videos. See the power of our truck-mount technology on carpets, furniture, and mattresses.";
const canonicalPath = "/en/video-gallery";

// Placeholder videos for the gallery. 
const videos = [
  getPresentationGalleryEntry("en"),
  {
    id: "46rCcc5hGLk",
    title: "Premium wool carpet cleaning in Westmount, stairs, bedrooms and restored leather sofas",
    category: "Wool Carpets",
    posterUrl: "/images/videos/video-thumb-westmount-short.jpg",
    description:
      "Premium wool carpet cleaning in Westmount (stairs and bedrooms), with delicate-fiber treatment and full restoration of fabric and leather sofas.",
  },
  {
    id: "auWtvSvqucg",
    title: "Stained sofa cleaning in Saint-Bruno-de-Montarville",
    category: "Stained Sofas",
    posterUrl: "/images/videos/video-thumb-salon-st-bruno-short.jpg",
    description:
      "Deep sofa cleaning in Saint-Bruno-de-Montarville with enzyme treatment, disinfection, carbon stain protection, and truck-mount extraction.",
  },
  {
    id: "t4ZxSeA6uFA",
    title: "Commercial Ceramic Tile Cleaning",
    category: "Commercial Flooring",
    posterUrl: "/images/videos/video-thumb-nettoyage-tuile-ceramique-commercial.webp",
    description:
      "Professional commercial ceramic tile cleaning with specialized equipment, ideal for businesses, restaurants, offices and high-traffic areas.",
  },
  {
    id: "9TKQuGP6-GA",
    title: "Complete Residential Carpet Cleaning at Home",
    category: "Residential Carpet",
    posterUrl: "/images/videos/video-thumb-nettoyage-tapis-maison-complet.webp",
    description:
      "Professional residential carpet cleaning with specialized equipment, ideal for refreshing fibres and improving the overall cleanliness of the home.",
  },
  {
    id: "-ghWZBk6g3A",
    title: "Commercial Carpet Cleaning for Restaurants and Bars",
    category: "Commercial Carpet",
    posterUrl: "/images/videos/video-thumb-nettoyage-resto-bar.webp",
    description:
      "Commercial carpet cleaning service for restaurants, bars and professional spaces, using a method adapted to high-traffic areas.",
  },
  {
    id: "0JmVo463OCA",
    title: "Mattress Steam Cleaning with Specialized Treatment",
    category: "Mattress Cleaning",
    posterUrl: "/images/videos/video-thumb-nettoyage-matelas.webp",
    description:
      "Professional mattress steam cleaning with a specialized treatment designed to refresh, deodorize and deep clean the mattress.",
  },
  {
    id: "IRxgswcnjpI",
    title: "Persian Rug Cleaning at Home in Westmount | Cat Urine Treatment and UV Light",
    category: "Persian Rugs",
    posterUrl: "/images/videos/video-thumb-tapis-perse.webp"
  },
  {
    id: "rmdaHcA2mcc",
    title: "Tufted Sofa and Loveseat Cleaning",
    category: "Tufted Sofas",
    posterUrl: "/images/videos/video-thumb-causeuse.webp"
  },
  {
    id: "a6ESbeUbols",
    title: "Spring Cleaning | Steam Cleaning and Truck Mount",
    category: "Deep Cleaning",
    posterUrl: "/images/videos/video-thumb-produits.webp"
  },
  {
    id: "iZqbmcUTjJA",
    title: "Sofa and Loveseat Cleaning in Brossard | Steam and Enzymatic Treatment",
    category: "Tufted Sofas",
    posterUrl: "/images/videos/video-thumb-sofa-brossard.webp"
  },
  {
    id: "l2L2E-s1y2s",
    title: "Velvet Furniture Cleaning | Steam Cleaning with Truck Mount",
    category: "Velvet Furniture",
    posterUrl: "/images/videos/video-thumb-banquette.webp"
  },
  {
    id: "em1yhDedcOQ",
    title: "6-Seater Sectional Sofa Cleaning | Before & After Results",
    category: "Furniture Cleaning",
    posterUrl: "/images/videos/video-thumb-salon-sectionnel.webp",
    posterSrcSet: SALON_SECTIONNEL_POSTER_SRCSET,
    posterSizes: SALON_SECTIONNEL_POSTER_SIZES_GRID,
  },
  {
    id: "BtCGbCaIq9M",
    title: "Microfiber Living Room Set Cleaning",
    category: "Microfiber",
    posterUrl: "/images/videos/video-thumb-velour.webp"
  },
  {
    id: "6GDp9ff_6EY",
    title: "Oriental Rug Cleaning at Home in Westmount | Steam Cleaning",
    category: "Oriental Rugs",
    posterUrl: "/images/videos/video-thumb-tapis-oriental-new-v2.webp"
  },
  {
    id: "Ew7zbheK83U",
    title: "Extremely Dirty Rug Cleaning | Before and After, Enzyme and Steam Treatment",
    category: "Extremely Dirty Rugs",
    posterUrl: "/images/videos/video-thumb-tapis-berbere.webp"
  },
  {
    id: "gUCvR2RsdHQ",
    title: "Tile and Grout Steam Cleaning",
    category: "Tile & Grout",
    posterUrl: "/images/videos/video-thumb-tuile-v2.webp"
  },
  {
    id: "QS7mPeE122A",
    title: "Couch Cleaning with Coffee Stain | Before and After Results",
    category: "Extreme Stain Removal",
    posterUrl: "/images/videos/video-thumb-cafe.webp"
  }
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": videos.map((video, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "VideoObject",
      "name": video.title,
      "description":
        "description" in video && video.description
          ? video.description
          : `Demonstration of ${video.category.toLowerCase()} by Groupe Nettoyage Empire. Before and after results using professional cleaning equipment.`,
      "thumbnailUrl": `https://groupenettoyageempire.com${video.posterUrl}`,
      ...("presentationHref" in video && video.presentationHref
        ? {}
        : { uploadDate: "2024-01-01T08:00:00+00:00" }),
      "embedUrl": `https://www.youtube.com/embed/${video.id}`
    }
  }))
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

  <!-- PAGE HERO -->
  <section class="video-hero">
    <div class="container video-hero-inner">
      <span class="video-tag">Portfolio</span>
      <h1 class="video-hero-title">Our Video Gallery</h1>
      <p class="video-hero-subtitle">
        Results that speak for themselves. Discover the efficiency of our exclusive truck-mount technology in action.
      </p>
    </div>
  </section>

  <!-- VIDEO GALLERY CONTENT -->
  <section class="video-main">
    <div class="container">
      
      <div class="video-grid">
        {videos.map((video, index) => (
          <article class={`video-card fade-in-section ${index > 1 ? 'delay-100' : ''}`} aria-labelledby={`video-title-${index}`}>
            <div class="video-facade-container">
              {"presentationHref" in video && video.presentationHref ? (
                <PresentationGalleryCard
                  href={video.presentationHref}
                  title={video.title}
                  posterUrl={video.posterUrl}
                  linkLabel="presentation page"
                  badgeText="Watch presentation"
                />
              ) : (
                <YouTubeFacade
                  videoId={video.id}
                  title={video.title}
                  posterUrl={video.posterUrl}
                  posterSrcSet={video.posterSrcSet}
                  posterSizes={video.posterSizes}
                  aspectRatio="9/16"
                />
              )}
            </div>
            <div class="video-card-body">
              <span class="video-category-badge">{video.category}</span>
              <h2 id={`video-title-${index}`} class="video-card-title">{video.title}</h2>
              {"presentationHref" in video && video.presentationHref && (
                <p class="video-presentation-hint">Full video on our presentation page</p>
              )}
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="video-cta-section fade-in-section">
    <div class="container video-cta-inner text-center">
      <div class="video-cta-icon" aria-hidden="true" style="color: #003b7a;"><UiIcon name="check" size={48} /></div>
      <h2 class="video-cta-title">Convinced by our results?</h2>
      <p class="video-cta-text">
        Restore your interior's brand-new look. Get an accurate quote and see our current promotions in just a few seconds.
      </p>
      <div class="video-cta-actions">
        <button
          type="button"
          onclick="window.openEstimationWidget()"
          class="btn btn-primary-promo pulse-btn"
          aria-label="Open the free estimate calculator"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
          Get my free estimate
        </button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ================================
     PAGE HERO
  ================================ */
  .video-hero {
    background: linear-gradient(145deg, #2a6bb5 0%, #003b7a 60%, #07172c 100%);
    color: white;
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .video-hero-inner {
    max-width: 750px;
    margin: 0 auto;
  }

  .video-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #f0c14b;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 5px 16px;
    border-radius: 50px;
    margin-bottom: 1.2rem;
  }

  .video-hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin: 0 0 1rem;
    line-height: 1.15;
    color: #ffffff;
  }

  .video-hero-subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0;
  }

  /* ================================
     MAIN SECTION & GRID
  ================================ */
  .video-main {
    padding: 5rem 0;
    background: #f8fbff;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 columns for vertical videos on desktop */
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr); /* 2 columns on tablet */
    }
  }

  @media (max-width: 600px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  /* ================================
     VIDEO CARD
  ================================ */
  .video-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(0, 59, 122, 0.25);
    box-shadow: 
      0 8px 20px rgba(0, 30, 80, 0.35),
      0 24px 60px rgba(0, 30, 80, 0.50);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.4s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .video-card:hover {
      transform: translateY(-12px);
      border-color: rgba(240, 193, 75, 0.7);
      box-shadow: 
        0 24px 50px rgba(0, 30, 80, 0.45),
        0 50px 100px rgba(0, 30, 80, 0.60),
        0 8px 30px rgba(240, 193, 75, 0.35);
    }
  }

  .video-facade-container {
    width: 100%;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  :global(.video-facade-container .yt-facade),
  :global(.video-facade-container .presentation-gallery-card) {
    border-bottom-left-radius: 0 !important;
    border-bottom-right-radius: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  .video-card-body {
    padding: 1rem 1.15rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 0 0 auto;
    background: #fff;
  }

  .video-category-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #003b7a;
    background: #eef4fc;
    padding: 4px 10px;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .video-category-badge {
      font-size: 0.65rem;
      padding: 3px 6px;
      letter-spacing: 0.5px;
    }
  }

  .video-card-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #001f3f;
    margin: 0;
    line-height: 1.35;
  }

  .video-presentation-hint {
    margin: 0.2rem 0 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: #4b6075;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .video-card-title {
      font-size: 0.9rem;
      line-height: 1.28;
    }
    .video-card-body {
      padding: 0.75rem 0.65rem 0.85rem;
    }
  }

  /* ================================
     CTA SECTION
  ================================ */
  .video-cta-section {
    background: #fff;
    border-top: 1px solid #e8edf3;
    padding: 5rem 0;
  }

  .video-cta-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .video-cta-icon {
    margin-bottom: 1rem;
  }

  .video-cta-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #001f3f;
    margin: 0 0 1rem;
    line-height: 1.25;
  }

  .video-cta-text {
    font-size: 1.05rem;
    color: #4b5563;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .video-cta-actions {
    display: flex;
    justify-content: center;
  }

  .btn-primary-promo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #003b7a 0%, #080d14 100%);
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    padding: 16px 32px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 8px 25px rgba(0, 59, 122, 0.35);
  }

  .btn-primary-promo:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0, 59, 122, 0.45);
  }

  /* ================================
     ANIMATIONS
  ================================ */
  .fade-in-section {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }
  .fade-in-section.is-visible {
    opacity: 1;
    transform: none;
  }
  .delay-100 {
    transition-delay: 0.15s;
  }
  .pulse-btn {
    animation: pulseShadow 2.5s ease-in-out infinite;
  }
  @keyframes pulseShadow {
    0%, 100% { box-shadow: 0 6px 20px rgba(0, 59, 122, 0.35); }
    50% { box-shadow: 0 8px 30px rgba(0, 59, 122, 0.6); }
  }
</style>
