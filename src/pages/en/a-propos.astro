---
import Layout from "../../layouts/Layout.astro";
import { googleReviewsMapsUrl } from "../../data/googleReviews";
---

<Layout
  title="About Us — Empire Cleaning Group"
  description="Empire Cleaning Group: specialized on-site cleaning (carpets, upholstery, mattresses) in Greater Montreal — no rug pickup for off-site cleaning. Mission, team, and service area."
>
  <div class="about-container">
    <div class="container">
      <h1>About us</h1>
      <p class="intro">
        For over <strong>30 years</strong>, <strong>Empire Cleaning Group</strong> has
        provided specialized cleaning services to homes and businesses in the{" "}
        <strong>Greater Montreal area</strong>, including <strong>Laval</strong> and
        the <strong>South Shore</strong>. We work on carpets, upholstered furniture,
        mattresses, and other surfaces — with a professional approach and a focus on
        results.
      </p>

      <div class="mission-box">
        <h2>Our mission</h2>
        <p>
          Deliver the most thorough, hygienic cleaning possible by combining strong
          customer service with field-appropriate technology.
        </p>
      </div>

      <h2>Our team</h2>
      <p>
        Our technicians are certified, trained on an ongoing basis, and committed to
        your satisfaction. <strong>We do not subcontract</strong>: the specialist who
        comes to your home or business is part of our team.
      </p>

      <h2>Our approach</h2>
      <p>
        We use <strong>professional cleaning methods</strong>, including hot-water
        extraction when appropriate, with <strong>the right equipment</strong> for the
        job — including truck-mounted units when access allows. We choose solutions
        based on fibres and surfaces, favouring <strong>eco-friendly products</strong>
        consistent with how we describe our work across the site.
      </p>
      <p>
        All work is done <strong>on-site</strong> at your home or business.{" "}
        <strong>We do not pick up rugs</strong> for workshop or in-plant cleaning.
      </p>

      <h2>Service area</h2>
      <p>
        We serve the <strong>Greater Montreal area</strong>,{" "}
        <strong>Laval</strong>, and the <strong>South Shore</strong>. For a specific
        visit or quote, please <a href="/en/contact">contact us</a> or use the online
        estimate tool on our website.
      </p>

      <h2>Client feedback</h2>
      <p>
        Client comments are available on our{" "}
        <a href={googleReviewsMapsUrl} target="_blank" rel="noopener noreferrer"
          >Google Business Profile</a
        >. On our homepage we show <strong>excerpts</strong> from reviews; the
        profile lists the full, current set of feedback.
      </p>

      <div class="mission-box history-cta">
        <h2>Our history</h2>
        <p>
          For our background and our work with clients under the{" "}
          <strong>Sears Cleaning</strong> name in Montreal and the surrounding area,
          see <a href="/en/about">Our history</a>.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about-container {
    padding: 4rem 0;
  }
  h1 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }
  h2 {
    font-size: 1.35rem;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }
  .intro {
    font-size: 1.15rem;
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 44rem;
    color: var(--color-text);
  }
  .about-container p {
    line-height: 1.65;
    max-width: 44rem;
    color: var(--color-text-light);
  }
  .mission-box {
    background-color: var(--color-background);
    padding: 2rem;
    border-left: 5px solid var(--color-gold);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .history-cta {
    margin-top: 2.5rem;
  }
  .about-container a:not(.btn) {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
