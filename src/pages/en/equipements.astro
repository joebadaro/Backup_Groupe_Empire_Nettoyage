---
import Layout from "../../layouts/Layout.astro";
import UiIcon from "../../components/icons/UiIcon.astro";
---

<Layout
    title="Our Equipment - State-of-the-Art Technology | Empire Cleaning Group"
    description="Discover our high-performance truck-mount units for impeccable carpet and furniture cleaning. Thermal power and 100% ecological products."
>
    <div class="page-header">
        <div class="container text-center fade-in-section">
            <span class="sub-title text-accent">Performance & Innovation</span>
            <h1 class="text-white">Our State-of-the-Art Equipment</h1>
            <p class="lead-text">Superior technology for impeccable results.</p>
        </div>
    </div>

    <section class="section">
        <div class="container">
            <!-- Top Section: Text Left, Slideshow Right -->
            <div class="intro-text text-center fade-in-section page-intro-center">
                <div class="intro-h2-wrap">
                    <span class="intro-h2-icon" aria-hidden="true"
                        ><UiIcon name="truck-mount" size={30} /></span
                    >
                    <h2 class="gradient-text-red intro-h2-title">
                        The Power of the Truck-Mount Unit
                    </h2>
                </div>
                <p>
                    To guarantee unequal deep cleaning, we use
                    state-of-the-art truck-mount units. These mobile
                    units generate suction power and heat far superior
                    to standard portable equipment.
                </p>
                <p>
                    The result? Faster drying, maximum dirt extraction,
                    and a carpet that stays clean longer.
                </p>
            </div>

            <div class="equipment-grid-2x2 fade-in-section delay-100">
                <div class="equip-card">
                    <img
                        src="/images/catalog/equipment-slide-6.webp"
                        alt="Empire Cleaning Group Truck Mount Mobile Unit"
                        loading="eager"
                    />
                    <div class="equip-card-overlay">
                        <h3>Truck Mount Mobile Units</h3>
                        <p>Superior extraction power for ultra fast drying.</p>
                    </div>
                </div>
                <div class="equip-card">
                    <img
                        src="/images/catalog/equipment-slide-13.webp"
                        alt="Empire Cleaning Mobile Truck Mount"
                        loading="lazy"
                    />
                    <div class="equip-card-overlay">
                        <h3>Empire Cleaning Mobile Units</h3>
                        <p>State-of-the-art equipment and superior technology for flawless results.</p>
                    </div>
                </div>
                <div class="equip-card">
                    <img
                        src="/images/catalog/equipment-slide-7.webp?v=2"
                        alt="Our certified technical team"
                        loading="lazy"
                    />
                    <div class="equip-card-overlay">
                        <h3>Our Expert Team</h3>
                        <p>Passionate professionals dedicated to the absolute cleanliness of your home.</p>
                    </div>
                </div>
                <div class="equip-card">
                    <img
                        src="/images/catalog/equipment-slide-8.webp"
                        alt="Thermal truck mount side view"
                        loading="lazy"
                    />
                    <div class="equip-card-overlay">
                        <h3>Independent Mobile Units</h3>
                        <p>Total autonomy in hot water and integrated powerful thermal generators.</p>
                    </div>
                </div>
                <div class="equip-card">
                    <img
                        src="/images/catalog/equipment-slide-9.webp"
                        alt="Industrial vacuum and extraction machine"
                        loading="lazy"
                    />
                    <div class="equip-card-overlay">
                        <h3>Industrial Machinery</h3>
                        <p>Controlled pressure and constant heat to dissolve the worst stains.</p>
                    </div>
                </div>
                <div class="equip-card">
                    <img
                        src="/images/catalog/equipment-slide-10.webp"
                        alt="Empire Cleaning Group cleaning fleet"
                        loading="lazy"
                    />
                    <div class="equip-card-overlay">
                        <h3>Guaranteed Rapid Response</h3>
                        <p>Modern fleet committed to offering exceptional service everywhere.</p>
                    </div>
                </div>
                <div class="equip-card">
                    <img
                        src="/images/catalog/equipment-slide-5.webp?v=3"
                        alt="Certified technicians and professional cleaning"
                        loading="lazy"
                    />
                    <div class="equip-card-overlay">
                        <h3>Certified Technicians</h3>
                        <p>Truck mounts and high-level professional expertise.</p>
                    </div>
                </div>
            </div>

            <!-- Features Grid below the main visual -->
            <div class="features-grid fade-in-section">
                <div class="feature-card">
                    <div class="feature-card-icon" aria-hidden="true">
                        <UiIcon name="thermometer" size={26} />
                    </div>
                    <h3>Thermal Truck-Mount Unit</h3>
                    <p>
                        Our units generate constant heat over 200°F, allowing
                        grease to dissolve and bacteria to be eliminated without
                        harsh chemicals.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-card-icon" aria-hidden="true">
                        <UiIcon name="leaf" size={26} />
                    </div>
                    <h3>Ecological Products</h3>
                    <p>
                        We use 100% biodegradable cleaning solutions, safe for
                        your children and pets.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-card-icon" aria-hidden="true">
                        <UiIcon name="airflow" size={26} />
                    </div>
                    <h3>Powerful Suction</h3>
                    <p>
                        Our industrial suction system extracts up to 95% of
                        moisture, significantly reducing drying time.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-card-icon" aria-hidden="true">
                        <UiIcon name="crosshair" size={26} />
                    </div>
                    <h3>Precision Tools</h3>
                    <p>
                        From rotary brushes to delicate tools for fragile
                        fabrics, we have the right equipment for every
                        situation.
                    </p>
                </div>
            </div>

            <div class="call-action fade-in-section delay-100">
                <h3 class="gradient-text-green">See the difference yourself</h3>
                <p>Request a free quote today.</p>
                <a href="tel:5148939939" class="btn btn-primary pulse-btn"
                    ><span class="btn-inline-icon" aria-hidden="true"
                        ><UiIcon name="phone" size={18} /></span
                    >(514) 893-9939</a
                >
            </div>
        </div>
    </section>
</Layout>



<style>
    /* New Layout Structure */
    .page-intro-center {
        max-width: 800px;
        margin: 0 auto 3rem auto;
    }
    .intro-h2-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }
    .intro-h2-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        opacity: 0.88;
        flex-shrink: 0;
    }
    .intro-h2-title {
        font-size: 2.2rem;
        margin: 0;
        line-height: 1.2;
    }
    .page-intro-center p {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #444;
        margin-bottom: 1.5rem;
    }

    /* Elegant 2x2 Grid Layout */
    .equipment-grid-2x2 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin: 0 auto 4rem auto;
    }
    
    @media (min-width: 768px) {
        .equipment-grid-2x2 {
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
            max-width: 950px; /* Constrains width so images aren't massive */
        }
    }

    .equip-card {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0, 30, 60, 0.2); /* Stronger static shadow */
        background: #fff;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
    }

    .equip-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 55px rgba(0, 20, 40, 0.65); /* Much darker hover shadow as requested */
    }

    .equip-card img {
        width: 100%;
        height: 300px; /* Reduced from 380px to be more elegant and less imposing */
        object-fit: cover;
        display: block;
        transition: transform 0.6s ease;
    }

    .equip-card:hover img {
        transform: scale(1.05); /* Elegant zoom effect */
    }

    /* Dark gradient over the bottom of the image for text readability */
    .equip-card-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        background: linear-gradient(to top, rgba(10, 25, 40, 0.95) 0%, rgba(10, 25, 40, 0.5) 60%, transparent 100%);
        padding: 4rem 1.5rem 1.5rem 1.5rem; /* Generous top padding for gradient fade */
        text-align: center;
        color: white;
        pointer-events: none; /* Let hover events pass through to card */
    }

    .equip-card-overlay h3 {
        color: white; /* Ensure it stays white over image */
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5); /* extra crispness */
        line-height: 1.3;
    }

    .equip-card-overlay p {
        font-size: 0.95rem;
        line-height: 1.5;
        opacity: 0.95;
        margin: 0;
        text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    }

    /* Gradients for Text as requested */
    .gradient-text-red {
        background: -webkit-linear-gradient(45deg, #000 0%, #d80000 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
    }
    .gradient-text-green {
        background: -webkit-linear-gradient(45deg, #000 0%, #2ecc71 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
    }

    /* Existing Styles Refined */
    .page-header {
        background-color: var(--color-primary);
        background-image: linear-gradient(
            135deg,
            var(--color-primary) 0%,
            #0f243a 100%
        );
        color: white;
        padding: 6rem 0 4rem 0;
        margin-bottom: 4rem;
    }
    .text-white {
        color: white;
    }
    .text-accent {
        color: var(--color-accent);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
    }
    .lead-text {
        font-size: 1.2rem;
        opacity: 0.9;
        margin-top: 1rem;
    }

    .highlight-box {
        /* No left border to be cleaner next to image, or keep specific user wish? 
           User wants elegant. Let's keep it clean. */
        padding-right: 1rem;
    }
    .highlight-box h2 {
        font-size: 2.2rem;
        margin-bottom: 1.5rem;
        line-height: 1.2;
    }
    .highlight-box p {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #444;
        margin-bottom: 1.5rem;
    }

    .features-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-bottom: 4rem;
    }
    @media (min-width: 600px) {
        .features-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (min-width: 1000px) {
        .features-grid {
            grid-template-columns: 1fr 1fr 1fr 1fr; /* 4 in a row */
        }
    }

    .feature-card {
        background: white;
        padding: 2rem;
        border-radius: var(--border-radius-md);
        box-shadow: var(--shadow-subtle);
        border: 1px solid #f0f0f0;
        transition: 0.3s ease;
        text-align: center;
    }
    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-hover);
        border-color: var(--color-accent);
    }
    .feature-card-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 1rem auto;
        border-radius: 12px;
        background: rgba(10, 35, 66, 0.055);
        border: 1px solid rgba(10, 35, 66, 0.08);
        color: var(--color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease, border-color 0.2s ease;
    }
    .feature-card:hover .feature-card-icon {
        background: rgba(0, 74, 159, 0.08);
        border-color: rgba(0, 74, 159, 0.14);
    }
    .btn-inline-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.35rem;
    }
    .feature-card h3 {
        color: var(--color-primary);
        margin-bottom: 0.8rem;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .slideshow-container {
        width: 100%;
        height: 100%;
        position: relative;
    }
    .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .slide.active {
        opacity: 1;
    }

    .trust-badge {
        text-align: center;
        margin-top: 1.5rem;
    }
    .stars {
        color: #f1c40f;
        font-size: 1.2rem;
        letter-spacing: 3px;
        display: block;
        margin-bottom: 0.5rem;
    }
    .trust-badge p {
        font-style: italic;
        color: #666;
        font-size: 0.95rem;
        margin: 0;
    }

    .call-action {
        background: linear-gradient(135deg, #f9f9f9 0%, #fff 100%);
        padding: 3rem;
        border-radius: var(--border-radius-md);
        text-align: center;
        box-shadow: var(--shadow-subtle);
        border: 1px solid #eee;
    }
    .call-action h3 {
        font-size: 2rem;
        margin-bottom: 1rem;
    }
</style>
