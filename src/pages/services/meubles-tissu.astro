---
import Layout from "../../layouts/Layout.astro";
import FAQSchema from "../../components/FAQSchema.astro";
import UiIcon from "../../components/icons/UiIcon.astro";
import ServiceVideoProof from "../../components/ServiceVideoProof.astro";
import ConversionCtaPriorityGroup from "../../components/ConversionCtaPriorityGroup.astro";
---

<Layout
  title="Nettoyage de divans, sofas et fauteuils | Montréal et Rive-Sud"
  description="Nettoyage de divans, sectionnels, fauteuils, bergères, chaises rembourrées et têtes de lit. Service professionnel à domicile à Montréal et sur la Rive-Sud."
>
  <!-- SPLIT SCREEN HERO (Standardisé) -->
  <div class="split-hero-container mobile-hero-stack">
    <div class="container full-width-split">
      <div class="split-layout">
        <!-- LEFT COLUMN: CONTENT -->
        <div class="split-content fade-in-section">
          <div class="service-hero-intro">
          <span class="service-cat-badge">MEUBLES</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Nettoyage de sofas, divans, fauteuils et meubles en tissu
          </h1>

          <!-- Mobile-only slideshow: shown right after title -->
          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
              <img
                src="/images/catalog/sofa-slide-hero-1.webp"
                alt="Technicien Nettoyage Empire nettoyage chaise capitonnée - Montréal"
                class="slide active"
                width="1200"
                height="800"
                loading="eager"
              />
              <img
                src="/images/catalog/sofa-slide-hero-2.webp"
                alt="Daniel nettoyage sofa sectionnel gris - Professionnel Groupe Empire"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-16.webp"
                alt="Nettoyage divan tissu en profondeur"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-33.webp"
                alt="Détachage sofa microfibre"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-119.webp"
                alt="Nettoyage professionnel de fauteuils"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-129.webp"
                alt="Extraction vapeur sur meuble en tissu"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-170.webp"
                alt="Nettoyage divan Laval"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-171.webp"
                alt="Expert nettoyage meubles Rive-Sud"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-172.webp"
                alt="Nettoyage sofa avant-après"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/meuble-exterieur-optimized.webp"
                alt="Nettoyage de meubles de patio et mobilier extérieur professionnel - Montréal"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100">
            <h2 class="problem-title">Quand le tissu s’encrasse</h2>
            <p class="problem-text">
              Au fil du temps, vos sofas accumulent poussière, saletés, traces d’utilisation et résidus corporels. Les zones de contact — accoudoirs, assises, dossiers et coussins — s’assombrissent souvent en premier, et la saleté peut s’installer plus profondément dans le rembourrage.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            Nous nettoyons sofas, divans, sectionnels et fauteuils en tissu <strong>directement chez vous</strong>. Après une inspection préalable, nous adaptons la méthode au textile&nbsp;: produits adaptés, shampoing, nettoyage à la vapeur et injection-extraction lorsque le tissu le permet — sans déménager vos meubles.
          </p>

          </div>

          <div class="service-hero-action-band">

          <ConversionCtaPriorityGroup locale="fr" buttonStyle="primary" phoneIcon estimateIcon />

          <ServiceVideoProof
            title="Voyez notre travail en action"
            subtitle="Intervention réelle sur un sofa taché à Saint-Bruno-de-Montarville"
            description="Découvrez une intervention complète : préparation du meuble, méthode professionnelle et résultat obtenu après le nettoyage."
            youtubeId="auWtvSvqucg"
            youtubeTitle="Nettoyage de sofas tachés à Saint-Bruno-de-Montarville"
            allVideosHref="/realisations-video/"
            videoAspectRatio="9 / 16"
          />

          </div>
        </div>

        <!-- RIGHT COLUMN: IMAGE (Carousel) -->
        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
            <img
              src="/images/catalog/sofa-slide-hero-1.webp"
              alt="Technicien Nettoyage Empire nettoyage chaise capitonnée - Montréal"
              class="slide active"
              width="1200"
              height="800"
              fetchpriority="high"
              loading="eager"
            />
            <img
              src="/images/catalog/sofa-slide-hero-2.webp"
              alt="Daniel nettoyage sofa sectionnel gris - Professionnel Groupe Empire"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-16.webp"
              alt="Nettoyage divan tissu en profondeur"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-33.webp"
              alt="Détachage sofa microfibre"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-119.webp"
              alt="Nettoyage professionnel de fauteuils"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-129.webp"
              alt="Extraction vapeur sur meuble en tissu"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />

            <img
              src="/images/catalog/photo-170.webp"
              alt="Nettoyage divan Laval"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-171.webp"
              alt="Expert nettoyage meubles Rive-Sud"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-172.webp"
              alt="Nettoyage sofa avant-après"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/meuble-exterieur-optimized.webp"
              alt="Nettoyage de meubles de patio et mobilier extérieur professionnel - Montréal"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>

  <section class="content-section">
    <div class="container alternate-layout">
      <div class="service-main-content">
        
        <div class="info-block">
          <h2 class="text-gradient-empire">Pourquoi confier votre sofa à un nettoyage professionnel&nbsp;?</h2>
          <p>Un sofa ou un divan en tissu retient facilement la poussière, les poils d’animaux, les saletés et les traces d’utilisation du quotidien. Avec le temps, le tissu peut ternir, les odeurs s’installer et certaines taches devenir plus difficiles à traiter avec un produit ménager.</p>
          <p>Un nettoyage professionnel commence par une <strong>inspection préalable</strong> du textile. Selon le type de tissu et l’état du meuble, nous utilisons des produits adaptés, un shampoing, un nettoyage à la vapeur et une injection-extraction lorsque c’est compatible avec la fibre. L’objectif&nbsp;: déloger la saleté incrustée, limiter les résidus et respecter le meuble.</p>
          <p>Nous intervenons à domicile pour les sofas, divans, causeuses, sectionnels, fauteuils, bergères, chaises rembourrées et têtes de lit en tissu. La méthode est choisie selon le code d’entretien du fabricant, le type de tissu et le niveau d’encrassement observé sur place.</p>
        </div>

        <div class="info-block" style="margin-top: 2.5rem;">
          <h3 style="color: var(--color-primary); margin-bottom: 1rem;">Quels meubles en tissu nettoyons-nous&nbsp;?</h3>
          <p>Nous adaptons le nettoyage professionnel à domicile aux principaux meubles rembourrés résidentiels et commerciaux&nbsp;:</p>
          <ul class="check-list">
            <li><strong>Sofas, divans et causeuses :</strong> nettoyage professionnel des sofas, divans et causeuses, incluant les assises, dossiers, accoudoirs et coussins, selon les caractéristiques du tissu.</li>
            <li><strong>Sectionnels et divans avec méridienne :</strong> nettoyage professionnel de sectionnels de différentes dimensions, incluant les divans avec méridienne, les modèles modulaires et les grands ensembles de salon.</li>
            <li><strong>Fauteuils, bergères et chaises rembourrées :</strong> nettoyage professionnel de fauteuils, bergères, fauteuils inclinables de type Lazy Boy (La-Z-Boy), chaises de cuisine et chaises de salle à manger, incluant les assises, dossiers et accoudoirs rembourrés.</li>
            <li><strong>Têtes de lit en tissu :</strong> nettoyage professionnel de têtes de lit rembourrées, notamment les formats Queen et King. Traitement adapté à la poussière, aux résidus corporels, aux taches et aux zones de contact.</li>
            <li><strong>Tissus plus délicats :</strong> velours, chenille et certaines fibres naturelles qui demandent une approche prudente.</li>
            <li><strong>Mobilier commercial :</strong> chaises de bureau et fauteuils de salle d’attente, selon l’état du tissu.</li>
          </ul>
        </div>

        <div class="pro-tip">
          <p class="pro-tip-heading">Conseil du technicien : housses amovibles</p>
          <p>Si vos housses de coussins sont amovibles, évitez de les laver à la machine sans vérifier les indications du fabricant. La chaleur d’une sécheuse peut faire rétrécir le tissu et compliquer le remontage. Notre nettoyage sur place traite le tissu directement sur le meuble, ce qui limite ce type de risque.</p>
        </div>

        <!-- ZONES DESSERVIES -->
        <div class="zones-section" style="margin-top: 3rem;">
          <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Zones desservies</h3>
          <p>Nous intervenons à domicile dans le Grand Montréal, à Laval et sur la Rive-Sud avec nos unités mobiles.</p>

          <div class="city-group">
            <p class="city-lead">Montréal (Est et Ouest)</p>
            <div class="badges-container">
              <span class="badge badge-blue">Montréal (tous arrondissements)</span>
              <span class="badge badge-blue">Westmount</span>
              <span class="badge badge-blue">Mont-Royal</span>
              <span class="badge badge-blue">Outremont</span>
              <span class="badge badge-blue">LaSalle</span>
              <span class="badge badge-blue">Et plus encore...</span>
            </div>
          </div>

          <div class="city-group">
            <p class="city-lead">Laval</p>
            <div class="badges-container">
              <span class="badge badge-blue">Laval (toute la ville)</span>
              <span class="badge badge-blue">Chomedey</span>
              <span class="badge badge-blue">Sainte-Rose</span>
              <span class="badge badge-blue">Vimont</span>
            </div>
          </div>

          <div class="city-group">
            <p class="city-lead">Rive-Sud de Montréal</p>
            <div class="badges-container">
              <span class="badge badge-green">Longueuil</span>
              <span class="badge badge-green">Brossard</span>
              <span class="badge badge-green">Saint-Lambert</span>
              <span class="badge badge-green">Saint-Hubert</span>
              <span class="badge badge-green">Greenfield Park</span>
              <span class="badge badge-green">Saint-Bruno</span>
              <span class="badge badge-green">Boucherville</span>
              <span class="badge badge-green">Candiac</span>
              <span class="badge badge-green">Et plus encore...</span>
            </div>
          </div>
          
          <p class="contact-footer">Besoin d’un rendez-vous&nbsp;? Appelez-nous au <strong>(514) 893-9939</strong>.</p>
        </div>

        <nav
          class="local-upholstery-nav fade-in-section"
          aria-label="Nettoyage de meubles rembourrés par ville"
        >
          <h3 class="local-upholstery-heading">Pages locales — meubles rembourrés</h3>
          <ul class="local-upholstery-list">
            <li><a href="/services/nettoyage-meubles-rembourres-boucherville/">Boucherville</a></li>
            <li><a href="/services/nettoyage-meubles-rembourres-brossard/">Brossard</a></li>
            <li><a href="/services/nettoyage-meubles-rembourres-candiac/">Candiac</a></li>
            <li><a href="/services/nettoyage-meubles-rembourres-chambly/">Chambly</a></li>
            <li><a href="/services/nettoyage-meubles-rembourres-la-prairie/">La Prairie</a></li>
            <li><a href="/services/nettoyage-meubles-rembourres-longueuil/">Longueuil</a></li>
            <li><a href="/services/nettoyage-meubles-rembourres-saint-bruno/">Saint-Bruno</a></li>
            <li><a href="/services/nettoyage-meubles-rembourres-sainte-julie/">Sainte-Julie</a></li>
          </ul>
        </nav>
        <p
          class="fade-in-section"
          style="margin-top: 0.75rem; line-height: 1.65; color: var(--color-text-main);"
        >
          Aussi disponible à Westmount&nbsp;: <a
            href="/services/nettoyage-meubles-rembourres-westmount/"
            style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;"
            >nettoyage de divan à Westmount</a
          >.
        </p>

        <div class="local-upholstery-nav fade-in-section" style="margin-top: 1rem;">
          <h3 class="local-upholstery-heading">Nettoyage de divans, sofas et sectionnels par ville</h3>
          <p style="margin: 0 0 0.75rem; line-height: 1.65; color: var(--color-text-main);">
            Nos services de nettoyage de meubles rembourrés couvrent les divans, sofas, canapés, fauteuils et sectionnels à domicile. Des pages dédiées présentent le service dans plusieurs secteurs de la Rive-Sud, avec des précisions utiles selon le quartier et le type d’habitation.
          </p>
          <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
            Consultez nos services locaux pour le
            <a href="/services/nettoyage-meubles-rembourres-saint-bruno/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">nettoyage de divan à Saint-Bruno</a>,
            le <a href="/services/nettoyage-meubles-rembourres-boucherville/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">nettoyage de sectionnel à Boucherville</a>,
            le <a href="/services/nettoyage-meubles-rembourres-brossard/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">nettoyage de sofa à Brossard</a>
            et le <a href="/services/nettoyage-meubles-rembourres-la-prairie/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">nettoyage de divan à La Prairie</a>.
          </p>
        </div>

        <!-- PROCESSUS -->
        <div class="process-section" style="margin-top: 4rem;">
          <h2 class="text-gradient-empire">Notre processus en cinq étapes</h2>
          <div class="process-steps">
            <div class="step">
              <div class="step-num">1</div>
              <div class="step-text">
                <h3>Inspection préalable</h3>
                <p>Le technicien inspecte les fibres et la condition du mobilier, vérifie les codes d’entretien et évalue les taches ou odeurs avant de choisir la méthode.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">2</div>
              <div class="step-text">
                <h3>Préparation et détachage ciblé</h3>
                <p>Préparation du meuble et traitement manuel des taches tenaces (nourriture, boissons, gras, etc.) lorsque la situation le justifie, avec des produits adaptés au textile.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">3</div>
              <div class="step-text">
                <h3>Shampoing, vapeur et extraction</h3>
                <p>Selon la compatibilité du textile, nous procédons au shampoing et au nettoyage à la vapeur avec injection-extraction pour déloger la saleté et retirer l’eau chargée de résidus.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">4</div>
              <div class="step-text">
                <h3>Traitements spécialisés au besoin</h3>
                <p>Si l’inspection le justifie, le technicien vous explique les traitements appropriés — notamment enzymatiques ou à l’oxygène actif — en précisant ce qui est recommandé, nécessaire selon l’évaluation ou optionnel. Aucun traitement additionnel n’est effectué sans votre autorisation, et aucun résultat n’est garanti sur les taches ou les odeurs.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">5</div>
              <div class="step-text">
                <h3>Finition et conseils de séchage</h3>
                <p>Remise en place des fibres au besoin, conseils pour un séchage optimal et, si pertinent, recommandation d’un protecteur antitache compatible avec le tissu.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- CONTENU ÉDUCATIF VISIBLE -->
        <div style="margin-top: 3rem;">
          <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Prolonger la durée de vie de votre mobilier</h3>
          <p style="line-height: 1.7; color: #444; margin-bottom: 1rem;">Les résidus corporels, la poussière et les traces d’utilisation s’accumulent surtout aux accoudoirs, assises, dossiers et coussins. Un nettoyage professionnel adapté au textile aide à retirer ces saletés qui ternissent le tissu et accélèrent l’usure. Selon l’inspection des fibres et de la condition du meuble, des traitements spécialisés peuvent être recommandés pour certaines taches ou odeurs plus complexes — seulement avec votre accord, sans promesse de résultat garanti.</p>
          <p style="line-height: 1.7; color: #444;">Après le nettoyage, l’application d’<a href="/services/protecteur" style="color: var(--color-primary); font-weight: bold; text-decoration: underline;">un protecteur antitache professionnel</a> peut être conseillée si le tissu le permet, notamment un protecteur au carbone. Ce type de protection aide à ralentir l’absorption des liquides et vous laisse davantage de temps pour éponger un accident du quotidien — sans promesse de protection absolue.</p>
        </div>

        <!-- SIGNES QUE VOTRE SOFA A BESOIN D'ÊTRE NETTOYÉ -->
        <div style="margin-top: 3rem; background: #f8fbff; padding: 2rem; border-radius: 12px; border: 1px solid #dce8f5;">
          <h3 style="color: var(--color-primary); margin-bottom: 1.2rem; font-size: 1.4rem;">Cinq signes qu’un nettoyage professionnel s’impose</h3>
          <ul class="check-list">
            <li><strong>Odeurs persistantes</strong> — Une odeur de renfermé ou de transpiration qui revient malgré l’aération peut indiquer un encrassement plus profond du rembourrage.</li>
            <li><strong>Zones grises ou jaunies</strong> — Accoudoirs, assises, dossiers et coussins qui changent de teinte avec l’usage et l’accumulation de saletés.</li>
            <li><strong>Taches qui résistent</strong> — Si l’essuyage à domicile ne suffit plus, un traitement professionnel adapté au tissu est souvent nécessaire.</li>
            <li><strong>Tissu terne malgré l’entretien courant</strong> — Un aspect sale ou terne qui revient rapidement après l’aspiration peut signaler une saleté incrustée dans les fibres.</li>
            <li><strong>Usage intensif du salon</strong> — Famille nombreuse, animaux ou passages fréquents&nbsp;: le tissu s’encrasse plus vite et un entretien professionnel périodique devient utile.</li>
          </ul>
        </div>

        <!-- TARIFS -->
        <div class="pricing-section" style="margin-top: 4rem;">
          <h2 class="text-gradient-empire">Ce qui influence le prix du nettoyage</h2>
          <p>Le coût d’un nettoyage de sofa ou de divan varie selon la situation observée sur place&nbsp;:</p>
          <div class="pricing-grid">
            <div class="price-card">
              <h3>Format du meuble</h3>
              <p>Le devis tient compte de la dimension (fauteuil, sofa deux ou trois places, sectionnel).</p>
            </div>
            <div class="price-card">
              <h3>Type de tissu</h3>
              <p>Certains textiles, comme le velours ou des fibres plus délicates, demandent plus de temps et de précautions.</p>
            </div>
            <div class="price-card">
              <h3>Taches et odeurs</h3>
              <p>Un traitement spécialisé (par exemple enzymatique ou à l’oxygène actif) peut s’ajouter s’il est recommandé après inspection et autorisé par vous.</p>
            </div>
            <div class="price-card">
              <h3>Nombre de pièces</h3>
              <p>Plusieurs meubles nettoyés lors de la même visite peuvent modifier le temps d’intervention et le devis.</p>
            </div>
          </div>

          <p style="margin-top: 1.25rem; margin-bottom: 0; line-height: 1.65; color: var(--color-text-main);">
            Le prix d’un nettoyage de divan, sofa, canapé ou sectionnel dépend du format du meuble, du tissu, du niveau de saleté, des taches présentes et des traitements recommandés sur place. Pour une idée plus claire avant le rendez-vous, vous pouvez demander une estimation ou consulter nos <a href="/promotions/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">promotions en cours</a>, lorsqu’elles s’appliquent aux meubles en tissu.
          </p>

        </div>

        <!-- FAQ avec Schema structuré (rich snippets Google) -->
        <div class="faq-section" style="margin-top: 4rem;">
          <h2 class="text-gradient-empire">Questions fréquentes — nettoyage de meubles en tissu</h2>
          <FAQSchema
            faqs={[
              {
                question: "Le nettoyage de sofa à la vapeur est-il efficace ?",
                answer: "Oui, lorsqu’il est bien adapté au textile. Après une inspection préalable, nous utilisons des produits adaptés, un shampoing et un nettoyage à la vapeur avec injection-extraction lorsque le tissu le permet. Cette approche retire la saleté et les résidus plus en profondeur qu’un produit ménager ou qu’un appareil grand public, dont l’extraction est souvent insuffisante.",
              },
              {
                question: "Combien de temps faut-il pour que le sofa sèche après le nettoyage à la vapeur ?",
                answer: "Le séchage prend généralement de 2 à 6 heures, selon le type de tissu, l’humidité de la pièce et la ventilation. Ouvrir les fenêtres ou utiliser un ventilateur peut accélérer le processus. Après le nettoyage, le meuble est habituellement légèrement humide, non trempé.",
              },
              {
                question: "À quelle fréquence devrait-on faire nettoyer son sofa professionnellement ?",
                answer: "Pour un usage résidentiel courant, un nettoyage annuel est souvent un bon repère. Avec de jeunes enfants, des animaux ou un usage intensif du salon, un intervalle plus rapproché peut être utile. Après de longues périodes sans entretien, les taches et les odeurs deviennent généralement plus difficiles à traiter.",
              },
              {
