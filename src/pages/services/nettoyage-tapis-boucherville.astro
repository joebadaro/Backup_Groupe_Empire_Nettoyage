---
import Layout from "../../layouts/Layout.astro";
import FAQSchema from "../../components/FAQSchema.astro";
import LocalTapisCrossServiceLinks from "../../components/LocalTapisCrossServiceLinks.astro";
import UiIcon from "../../components/icons/UiIcon.astro";
---

<Layout
  title="Nettoyage de tapis résidentiel à Boucherville | Maisons, condos, escaliers"
  description="Service de nettoyage de tapis résidentiel à Boucherville pour maisons familiales et condos: sous-sols, escaliers, aires de vie et zones de passage. Méthode professionnelle, séchage rapide et intervention fiable à domicile."
>
  <!-- SPLIT SCREEN HERO -->
  <div class="split-hero-container mobile-hero-stack">
    <div class="container full-width-split">
      <div class="split-layout">
        <!-- LEFT COLUMN: CONTENT (Hook) -->
        <div class="split-content fade-in-section">
          <span class="service-cat-badge">NIVEAU PRESTIGE • BOUCHERVILLE</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Nettoyage de tapis résidentiel à Boucherville
          </h1>

          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
             <img
              src="/images/catalog/nettoyage-fauteuil-professionnel.webp"
              alt="Nettoyage professionnel de mobilier dans une maison de Boucherville"
              class="slide active"
              width="1200"
              height="800"
              loading="eager"
            />
            <img
              src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
              alt="Camion-usine Empire Nettoyage déployé à Boucherville"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
             <img
              src="/images/catalog/photo-40.webp"
              alt="Mobilier de salon rembourré nettoyé par extraction à la vapeur"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100" style="border-left-color: var(--color-accent);">
            <h2 class="problem-title" style="color: var(--color-primary);">Vie Familiale et Tapis Très Sollicités :</h2>
            <p class="problem-text">
              Dans les maisons et condos résidentiels de Boucherville, les tapis des aires de vie, des sous-sols et des escaliers sont sollicités chaque jour. Entre les
              enfants, les animaux et les zones de passage, les fibres accumulent rapidement poussière fine, traces d'usage et résidus du quotidien.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            À Boucherville, notre approche est pensée pour l'entretien résidentiel: protéger le confort de la maison, prolonger la durée de vie des tapis et garder des
            espaces propres sans complexifier votre routine. Nous adaptons les produits et le niveau d'agitation selon le type de fibre, l'intensité d'usage et la présence
            d'enfants ou d'animaux.
          </p>

          <div class="cta-group fade-in-up delay-300">
            <a href="tel:5148939939" class="btn btn-gradient-green pulse-btn">
              <span class="icon" aria-hidden="true"><UiIcon name="phone" size={18} /></span>
              <span class="cta-btn-stack">
                <span>Appelez pour un estimé rapide</span>
                <span class="cta-btn-phone-num">(514) 893-9939</span>
              </span>
            </a>
            <button
              onclick="window.openEstimationWidget()"
              class="btn btn-gradient-green"
            >
              <span class="icon" aria-hidden="true"><UiIcon name="bolt" size={18} /></span>
              Demander un estimé gratuit
            </button>
          </div>
        </div>

        <!-- RIGHT COLUMN: IMAGE (Visual / Slideshow) -->
        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
             <img
              src="/images/catalog/nettoyage-fauteuil-professionnel.webp"
              alt="Nettoyage professionnel de mobilier dans une maison de Boucherville"
              class="slide active"
              width="1200"
              height="800"
              fetchpriority="high"
              loading="eager"
            />
            <img
              src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
              alt="Camion-usine Empire Nettoyage déployé à Boucherville"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
             <img
              src="/images/catalog/photo-40.webp"
              alt="Mobilier de salon rembourré nettoyé par extraction à la vapeur"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="service-layout">
        <!-- MAIN CONTENT -->
        <div class="service-main">
          <!-- BENEFIT LIST & SEO CONTENT -->
          <div class="fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Pourquoi les résidences de Boucherville nous font confiance
            </h2>

            <p>
              Notre méthode combine rigueur technique et exécution soignée pour les maisons familiales et condos résidentiels de Boucherville. Nous intervenons surtout sur
              les tapis de salon, sous-sol, escaliers et couloirs afin d'améliorer la propreté quotidienne et le confort de la maison.
            </p>

            <ul class="benefit-list" style="margin-bottom: 3rem;">
              <li>
                <strong>L'Avantage du Camion-Usine :</strong> Nos unités chauffent l'eau à haute température et assurent une extraction profonde, sans laisser vos tapis
                détrempés.
              </li>
              <li>
                <strong>Soin des Tissus Délicats :</strong> Les meubles de designer et les tapis en laine véritable demandent des compétences spéciales. Nous utilisons un conditionneur à pH bas pour éviter la migration des couleurs de vos carpettes.
              </li>
              <li>
                <strong>Hygiène du Foyer :</strong> Notre traitement thermique réduit efficacement les acariens, spores de moisissure et allergènes associés aux animaux.
              </li>
              <li>
                <strong>Entretien des Zones de Passage :</strong> Nous ciblons les entrées, corridors, escaliers et aires familiales pour limiter l'usure prématurée des
                fibres.
              </li>
              <li>
                <strong>Séchage Rapide :</strong> Grâce à notre extraction soutenue, vos tapis sont généralement secs en 3 à 5 heures selon la ventilation et le textile.
              </li>
            </ul>

            <p style="margin-top: 0; margin-bottom: 0; line-height: 1.65; color: var(--color-text-main);">
              À Boucherville, notre lavage de tapis à domicile convient aux maisons familiales, condos et espaces résidentiels où les tapis accumulent poussière, traces de circulation et saleté du quotidien. Pour comprendre notre méthode complète, consultez notre <a href="/services/nettoyage-tapis-residentiel/" class="tapis-trio-links__a">service de nettoyage de tapis résidentiel</a>.
            </p>

            <div style="margin-top: 3rem; background-color: #f8f9fa; border-left: 4px solid var(--color-accent); padding: 2rem; border-radius: 8px;">
               <h3 style="color: var(--color-primary); margin-bottom: 1rem;">
                Produits adaptés à la maison
              </h3>
              <p>
                Nous utilisons des produits professionnels non toxiques, sans résidus lourds, adaptés aux foyers avec enfants et animaux. L'objectif est un nettoyage en
                profondeur qui respecte votre environnement intérieur.
              </p>
            </div>

            <div style="margin-top: 3rem;">
              <hr class="separator" />
              <h3>Taches du quotidien</h3>
              <p>
                Une tache de boisson, de nourriture ou une trace liée aux animaux? Évitez de frotter agressivement les fibres. Consultez notre <a href="/conseils/erreurs-taches-tapis" style="color: var(--color-accent); font-weight: bold;">guide pratique sur les taches</a> puis contactez-nous pour un traitement adapté.
              </p>
            </div>

            <div class="tapis-trio-links" style="margin-top: 2.25rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); padding: 1.5rem 1.75rem; border-radius: 8px;">
              <h3 style="color: var(--color-primary); margin: 0 0 0.6rem; font-size: 1.2rem">Rive-Sud : même équipe, autres pages</h3>
              <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                <a href="/services/nettoyage-tapis-rive-sud" class="tapis-trio-links__a">Vue d’ensemble Rive-Sud</a> · <a href="/services/nettoyage-tapis-longueuil" class="tapis-trio-links__a">Longueuil &amp; Saint-Hubert</a> · <a href="/services/nettoyage-tapis-brossard" class="tapis-trio-links__a">Brossard</a> · voisin immédiat : <a href="/services/nettoyage-tapis-saint-bruno" class="tapis-trio-links__a">Saint-Bruno-de-Montarville</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NEW SECTIONS: BENEFITS & FAQ -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-layout" style="display: block;">
        <div class="service-main" style="max-width: 800px; margin: 0 auto;">
           
           <!-- ZONES DESSERVIES -->
          <div class="zones-section" style="margin-top: 3rem; margin-bottom: 3rem;">
            <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Intervention Rapide Partout à Boucherville</h3>

             <div class="city-group">
              <div class="badges-container">
                <span class="badge badge-blue">Le Vieux-Boucherville (Secteur Patrimonial)</span>
                <span class="badge badge-blue">Parc Industriel (Secteur Commercial)</span>
                <span class="badge badge-blue">Secteur Harmonie</span>
                <span class="badge badge-blue">Les Boisés</span>
                <span class="badge badge-blue">Domaines sur le Fleuve</span>
                <span class="badge badge-blue">Varennes (À proximité)</span>
              </div>
            </div>
            <p class="contact-footer">Obtenez un rendez-vous rapide dès aujourd'hui : <strong>(514) 893-9939</strong>.</p>
          </div>

          <LocalTapisCrossServiceLinks locale="fr" />

          <!-- FAQ -->
          <div class="fade-in-section delay-300" style="margin-top: 3rem;">
            <h2 class="section-title text-gradient-empire">
              Foire Aux Questions — Boucherville résidentiel
            </h2>
            <FAQSchema
              faqs={[
                {
                  question: "Nettoyez-vous les tapis de sous-sol et d'escaliers dans les maisons familiales?",
                  answer:
                    "Oui. Nous intervenons régulièrement sur les sous-sols, escaliers et corridors, avec une méthode ajustée à l'usure et au type de fibre.",
                },
                {
                  question: "Le service est-il adapté aux maisons avec enfants et animaux?",
                  answer:
                    "Absolument. Nous utilisons des produits professionnels non toxiques et une extraction en profondeur pour améliorer la propreté des zones de vie les plus sollicitées.",
                },
                {
                  question: "Quel est le délai de séchage après un nettoyage résidentiel?",
                  answer:
                    "Dans la plupart des cas, les tapis résidentiels sèchent en quelques heures, souvent entre 3 et 6 heures selon la ventilation, l'humidité et l'épaisseur du tapis.",
                },
                {
                  question: "Pouvez-vous traiter des taches tenaces dans une salle familiale ou une salle à manger?",
                  answer:
                    "Oui. Nous appliquons un prétraitement ciblé puis une extraction adaptée pour améliorer nettement l'apparence des zones tachées, selon l'état réel des fibres.",
                },
                {
                  question: "Intervenez-vous aussi en condo résidentiel à Boucherville?",
                  answer:
                    "Oui. Nous adaptons la logistique et la méthode selon le bâtiment pour offrir un nettoyage efficace des aires de vie sans perturber votre quotidien.",
                }
              ]}
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".slideshow-container").forEach((container) => {
    const slides = container.querySelectorAll(".slide");
    if (slides.length <= 1) return;
    let currentSlide = 0;
    setInterval(() => {
      slides[currentSlide].classList.remove("active");
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add("active");
    }, 4000);
  });
</script>

<style>
  /* Base styles reused for consistency */
  .split-hero-container { background-color: #fff; padding-top: 0; padding-bottom: 0; overflow: hidden; width: 100vw; }
  .full-width-split { width: 100%; max-width: none; padding: 0; margin: 0; }
  .split-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: stretch; min-height: 80vh; }
  .split-content { background-color: #ffffff; padding: 100px 4rem 4rem 10%; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 2; }
  .service-cat-badge { text-transform: uppercase; color: var(--color-accent); font-weight: 700; letter-spacing: 2px; font-size: 0.85rem; display: block; margin-bottom: 1rem; }
  .split-title { font-size: clamp(2.5rem, 3.5vw, 4rem); color: var(--color-primary); margin-bottom: 2rem; line-height: 1.1; }
  .city-group { margin-bottom: 1.5rem; }
  .badges-container { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .badge { padding: 0.4rem 0.9rem; border-radius: 20px; font-size: 0.9rem; border: 1px solid transparent; }
  .badge-blue { background: #e8f4fd; border-color: #c5dff0; }
  .problem-statement { background: #ffffff; border-left: 4px solid #ff4444; padding: 1.5rem; border-radius: 0; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(174, 206, 235, 0.3); }
  .problem-title { font-size: 1rem; color: #cc0000; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 700; }
  .problem-text { font-size: 1.05rem; color: var(--color-text-main); font-style: italic; }
  .lead-text { font-size: 1.15rem; line-height: 1.7; color: var(--color-text-main); margin-bottom: 2.5rem; max-width: 650px; }
  .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; }
  .cta-btn-stack {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
    gap: 0.1rem;
    text-align: left;
  }
  .cta-btn-phone-num {
    font-size: 0.92em;
    font-weight: 800;
  }
  @media (max-width: 900px) { .cta-group { display: none !important; } }
  .split-image-wrapper { position: relative; height: 100%; min-height: 500px; width: 100%; }
  .slideshow-container { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .slideshow-container img.slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }
  .slideshow-container img.slide.active { opacity: 1; }
  @media (max-width: 1024px) {
    .split-layout { grid-template-columns: 1fr; min-height: auto; }
    .lead-text { max-width: 100%; }
  }
  .service-layout { display: grid; grid-template-columns: 1fr; gap: 5rem; }
  .section-title { font-size: 1.8rem; color: var(--color-primary); margin-bottom: 1.5rem; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; display: inline-block; }
  .separator { border: 0; height: 1px; background: rgba(0, 0, 0, 0.1); margin: 1.5rem 0; }
  .benefit-list { margin: 2rem 0; list-style: none; padding: 0; }
  .benefit-list li { margin-bottom: 1rem; padding-left: 0; position: relative; font-size: 1.05rem; }
  .contact-footer { margin-top: 1.5rem; font-style: italic; color: #666; }
  .tapis-trio-links__a { color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
</style>
