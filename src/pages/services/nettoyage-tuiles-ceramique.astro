---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";
import FAQSchema from "../../components/FAQSchema.astro";
import ServiceVideoProofDuo from "../../components/ServiceVideoProofDuo.astro";
import UiIcon from "../../components/icons/UiIcon.astro";
import ConversionCtaPriorityGroup from "../../components/ConversionCtaPriorityGroup.astro";
import CeramiqueSlideshowSlides from "../../components/CeramiqueSlideshowSlides.astro";

/** Photos techniciens (sections) : s'affichent seulement si le fichier existe (pas de cadre vide). */
function publicImageIfExists(relPath: string): string | null {
  const abs = path.join(process.cwd(), "public", relPath.replace(/^\//, ""));
  return fs.existsSync(abs) ? relPath : null;
}

const servicePhotos = {
  floor: publicImageIfExists("/images/catalog/tuile-plancher-technicien.webp"),
  shower: publicImageIfExists("/images/catalog/tuile-douche-technicien.webp"),
  backsplash: publicImageIfExists("/images/catalog/tuile-backsplash-technicien.webp"),
};
---

<Layout
  title="Nettoyage de céramique, tuiles et coulis | Montréal & Rive-Sud"
  description="Nettoyage vapeur de tuiles, carrelage et coulis à Montréal et sur la Rive-Sud. Planchers, murs de douche, dosserets de cuisine (backsplash)."
  image="/images/services/tuiles-ceramique.webp"
  preloadImage={false}
>
  <!-- SPLIT SCREEN HERO: BLOCK 1 -->
  <div class="split-hero-container mobile-hero-stack ceramique-slideshow-fit">
    <div class="container full-width-split">
      <div class="split-layout">
        <!-- LEFT COLUMN: CONTENT -->
        <div class="split-content fade-in-section">
          <div class="service-hero-intro">
          <span class="service-cat-badge">PLANCHERS & SURFACES</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Nettoyage de céramique, tuiles et joints de coulis
          </h1>

          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
              <CeramiqueSlideshowSlides locale="fr" />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100">
            <h2 class="problem-title">Le Problème :</h2>
            <p class="problem-text">
              Vos joints sont devenus noirs ou gris ? La moppe ne fait que déplacer la saleté 
              dans les pores du coulis. Sans un nettoyage à haute pression, les bactéries, 
              le calcaire et le gras s'accumulent, rendant vos planchers ternes et insalubres.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            Retrouvez l'aspect original de vos sols grâce à un
            <strong>nettoyage professionnel à la vapeur sous haute pression contrôlée</strong>,
            combiné à un <strong>puissant système d'extraction</strong>.
            L'alliance de <strong>30&nbsp;ans d'expérience</strong>, de
            <strong>technologies de nettoyage de pointe</strong> et de
            <strong>produits écologiques haut de gamme</strong> redonne tout son éclat
            à votre céramique et à vos joints de coulis — sans éclaboussures, avec un séchage quasi immédiat.
          </p>

          <ul class="empire-trust-list fade-in-up delay-200" aria-label="Nos avantages">
            <li>Plus de 30&nbsp;ans d'expérience au Québec</li>
            <li>Vapeur sous haute pression contrôlée + extraction puissante</li>
            <li>Produits écologiques haut de gamme, adaptés aux familles et aux animaux</li>
          </ul>

          </div>

          <div class="service-hero-action-band">

          <ConversionCtaPriorityGroup locale="fr" buttonStyle="primary" />
          <ServiceVideoProofDuo
            title="Voyez notre nettoyage de céramique en action"
            subtitle="Deux interventions réelles sur tuiles, carrelage et coulis"
            description="Regardez nos vidéos de réalisations et voyez notre méthode professionnelle pour le nettoyage de tuiles de céramique et le nettoyage de joints de coulis en profondeur."
            allVideosHref="/realisations-video/"
            videos={[
              {
                title: "Nettoyage commercial de tuile de céramique",
                youtubeId: "t4ZxSeA6uFA",
                youtubeTitle: "Nettoyage commercial de tuile de céramique",
                posterUrl: "/images/videos/video-thumb-nettoyage-tuile-ceramique-commercial.webp",
                videoAspectRatio: "9 / 16",
              },
              {
                title: "Nettoyage à la vapeur de tuiles et coulis",
                youtubeId: "gUCvR2RsdHQ",
                youtubeTitle: "Nettoyage à la vapeur de tuiles et coulis",
                posterUrl: "/images/videos/video-thumb-tuile-v2.webp",
                videoAspectRatio: "9 / 16",
              },
            ]}
          />

          </div>
        </div>

        <!-- RIGHT COLUMN: IMAGE -->
        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
            <CeramiqueSlideshowSlides locale="fr" priority />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="service-layout">
        <!-- MAIN CONTENT -->
        <div class="service-main">

          <nav class="ceramique-service-nav fade-in-section" aria-label="Types de nettoyage de céramique">
            <p class="ceramique-service-nav__label">Nos services de nettoyage de céramique</p>
            <ul class="ceramique-service-nav__list">
              <li><a href="#nettoyage-plancher-tuiles">Planchers de tuiles &amp; carrelage</a></li>
              <li><a href="#nettoyage-murs-douche">Murs de douche &amp; salle de bain</a></li>
              <li><a href="#nettoyage-dosseret-cuisine">Dosseret de cuisine (backsplash)</a></li>
            </ul>
          </nav>

          <!-- A. PLANCHERS -->
          <div id="nettoyage-plancher-tuiles" class="ceramique-service-block fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Nettoyage de planchers de tuiles de céramique et de carrelage
            </h2>
            {servicePhotos.floor && (
              <figure class="ceramique-service-photo">
                <img
                  src={servicePhotos.floor}
                  alt="Technicien Empire en nettoyage de plancher de tuiles de céramique à Montréal"
                  width="1200"
                  height="800"
                  loading="lazy"
                />
              </figure>
            )}
            <p>
              Sur les <strong>planchers de tuiles</strong> et le <strong>carrelage</strong>,
              gras, calcaire, résidus de moppe et <strong>joints de coulis</strong> encrassés
              s'incrustent dans les pores. Un entretien ménager classique déplace la saleté
              sans vraiment la sortir.
            </p>
            <p>
              Nous procédons par <strong>prétraitement</strong>,
              <strong>brossage spécialisé des joints</strong>, puis
              <strong>nettoyage à la vapeur sous haute pression contrôlée</strong> avec
              <strong>extraction</strong> simultanée — pour un plancher de céramique plus propre,
              des joints désincrustés et un séchage rapide, sans éclaboussures sur meubles ou plinthes.
            </p>
          </div>

          <!-- B. DOUCHE / SDB -->
          <div id="nettoyage-murs-douche" class="ceramique-service-block fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Nettoyage de murs de douche et de salle de bain
            </h2>
            {servicePhotos.shower && (
              <figure class="ceramique-service-photo">
                <img
                  src={servicePhotos.shower}
                  alt="Technicien Empire en nettoyage de murs de douche et joints de carrelage"
                  width="1200"
                  height="800"
                  loading="lazy"
                />
              </figure>
            )}
            <p>
              En salle de bain, l'humidité, le savon et le calcaire noircissent le
              <strong>carrelage mural</strong> et les <strong>joints de douche</strong>.
              Le <strong>nettoyage de murs de douche</strong> traite ces surfaces verticales
              autrement qu'un plancher&nbsp;: outils adaptés, contrôle de l'eau, finitions protégées.
            </p>
            <p>
              Nous retirons les résidus de savon et les dépôts visibles sur les tuiles de céramique,
              assainissons les joints de douche encrassés et redonnons une apparence nette
              à la cabine et aux murs carrelés — sans détremper silicone, niches ou tablettes.
            </p>
          </div>

          <!-- C. DOSSERET / BACKSPLASH -->
          <div id="nettoyage-dosseret-cuisine" class="ceramique-service-block fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Nettoyage de dosseret de cuisine (backsplash)
            </h2>
            {servicePhotos.backsplash && (
              <figure class="ceramique-service-photo">
                <img
                  src={servicePhotos.backsplash}
                  alt="Technicien Empire en nettoyage de dosseret de cuisine et backsplash"
                  width="1200"
                  height="800"
                  loading="lazy"
                />
              </figure>
            )}
            <p>
              Le <strong>nettoyage de dosseret de cuisine</strong> (backsplash) cible les
              éclaboussures de cuisson et les <strong>résidus graisseux</strong> qui
              s'accumulent derrière le comptoir et la cuisinière — un enjeu différent
              de l'humidité de la douche.
            </p>
            <p>
              Des outils à main précis nettoyent les tuiles de céramique du dosseret et
              les joints de coulis sans projeter d'eau sur les armoires. Idéal en complément
              d'un plancher de cuisine, sans reprendre toute la méthode sur les murs.
            </p>
          </div>

          <div class="ceramique-mid-cta fade-in-section delay-100">
            <p class="ceramique-mid-cta__text">
              Prêt à faire nettoyer votre céramique, votre carrelage ou vos joints de coulis&nbsp;?
            </p>
            <ConversionCtaPriorityGroup locale="fr" buttonStyle="primary" />
          </div>
          
          <div class="fade-in-section delay-100" style="margin-top: 0;">
            <h2 class="section-title text-gradient-empire">
              Notre processus professionnel (vapeur, haute pression et extraction)
            </h2>
            <p style="margin: 0 0 1.5rem; line-height: 1.65; max-width: 720px;">
              L'alliance de <strong>30&nbsp;ans d'expérience</strong>, de
              <strong>technologies de nettoyage de pointe</strong> et de
              <strong>produits écologiques haut de gamme</strong> guide chaque intervention.
              Nous restaurons tuiles de céramique, carrelage et joints de coulis — en maison,
              condo ou appartement — par un nettoyage professionnel à la vapeur sous haute
              pression contrôlée, combiné à un puissant système d'extraction.
            </p>
            <div class="process-timeline" style="margin-bottom: 3rem;">
              <div class="process-step">
                <div class="step-marker">1</div>
                <div class="step-content">
                  <h3>Inspection et prétraitement</h3>
                  <p>Identification du type de tuile (céramique, porcelaine, pierre naturelle) et application d'un agent nettoyant alcalin spécifiquement conçu pour désagréger les graisses et les résidus de savon.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="step-marker">2</div>
                <div class="step-content">
                  <h3>Brossage spécialisé des joints de coulis</h3>
                  <p>Nous utilisons des brosses spécialisées pour frotter vigoureusement chaque ligne de coulis. Cette action mécanique est essentielle pour libérer la saleté noire incrustée avant l'extraction.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="step-marker">3</div>
                <div class="step-content">
                  <h3>Vapeur sous haute pression contrôlée et extraction (200°F)</h3>
                  <p>Notre machine projette de l'eau chaude pressurisée à l'intérieur d'une tête rotative fermée. Elle nettoie et aspire simultanément, garantissant zéro éclaboussure sur vos murs ou vos armoires.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="step-marker">4</div>
                <div class="step-content">
                  <h3>Neutralisation et séchage</h3>
                  <p>Un rinçage final au pH équilibré élimine tout résidu collant. Nous utilisons ensuite des ventilateurs haute puissance pour assurer un séchage rapide, prêt pour l'étape finale.</p>
                </div>
              </div>
              <div class="process-step">
                <div class="step-marker">5</div>
                <div class="step-content">
                  <h3>Protection (scellant de coulis)</h3>
                  <p>Protection des joints offerte en option : nous pouvons appliquer un scellant protecteur professionnel qui pénètre les pores du coulis pour mieux résister à la saleté et faciliter l'entretien par la suite.</p>
                </div>
              </div>
            </div>

            <div class="info-box fade-in-section delay-100">
              <h3 style="color: var(--color-primary); margin-bottom: 10px;">
                Pourquoi vos joints redeviennent noirs si vite ?
              </h3>
              <p>
                Le coulis est comme une éponge : il est extrêmement poreux. Lorsque vous lavez votre plancher à la moppe, l'eau sale finit par s'accumuler dans les « creux » des joints. Une fois l'eau évaporée, seule la saleté reste au fond. 
                Seul un nettoyage professionnel à la vapeur sous haute pression contrôlée, combiné à l'extraction, peut « vider » ces pores. L'application d'un <strong>scellant protecteur</strong> après le nettoyage est le meilleur investissement pour garder vos joints blancs pendant des années.
              </p>
            </div>
          </div>

          <!-- BENEFITS SECTION -->
          <div class="fade-in-section delay-200" style="margin-top: 4rem;">
            <h2 class="section-title text-gradient-empire">
              Avantages de notre nettoyage professionnel
            </h2>
            <div class="benefits-grid">
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Hygiène totale :</strong> Élimine les bactéries, les moisissures, le calcaire et les allergènes logés dans les joints poreux.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Plancher comme neuf :</strong> Retrouvez la couleur d'origine de votre coulis sans le brosser vous-même pendant des heures.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Zéro éclaboussure :</strong> Notre équipement rotatif contient toute l'eau et l'aspiration à l'intérieur de la tête de nettoyage — idéal en condo et en appartement.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Produits écologiques premium :</strong> Formules professionnelles efficaces, conçues pour les familles et les animaux domestiques.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Protection durable :</strong> Nos scellants de haute qualité facilitent vos futurs nettoyages domestiques.</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span><strong>Service rapide :</strong> Une cuisine standard est généralement nettoyée en 2 à 3 heures.</span>
              </div>
            </div>
          </div>

          <!-- POUR QUI / PIÈCES -->
          <div class="fade-in-section delay-200" style="margin-top: 4rem;">
            <h2 class="section-title text-gradient-empire">
              Nettoyage de céramique pour maisons, condos et appartements
            </h2>
            <p style="line-height: 1.65; max-width: 720px; margin-bottom: 1.25rem;">
              Que vous habitiez une maison familiale, un condo en hauteur ou un appartement,
              nous adaptons l'équipement et la méthode à votre accès et à l'état de vos surfaces.
              La tête turbo fermée limite les éclaboussures — un atout dans les espaces plus étroits
              et les cuisines ouvertes.
            </p>
            <p style="line-height: 1.65; max-width: 720px; margin-bottom: 1.25rem;">
              Nous intervenons en résidentiel comme en commercial sur les zones où la céramique
              et le coulis s'encrassent le plus vite&nbsp;:
            </p>
            <ul class="ceramique-rooms-list">
              <li><a href="#nettoyage-dosseret-cuisine">Cuisines et dosserets / backsplash</a> (gras, résidus graisseux, calcaire)</li>
              <li><a href="#nettoyage-murs-douche">Salles de bain et murs de douche</a> (humidité, joints de douche noircis)</li>
              <li><a href="#nettoyage-plancher-tuiles">Planchers de tuiles et carrelage</a> (entrées, corridors, circulation intense)</li>
              <li>Sous-sols et aires de vie carrelées</li>
            </ul>
          </div>

          <!-- ZONES DESSERVIES -->
          <div class="zones-section" style="margin-top: 4rem; margin-bottom: 3rem;">
            <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Zones desservies — Tuiles et céramique</h3>
            <p>Nous desservons tout le Grand Montréal avec nos unités mobiles haute performance.</p>

            <div class="city-group">
                <p class="city-lead">Montréal (Est et Ouest)</p>
                <div class="badges-container">
                    <span class="badge badge-blue">Montréal</span>
                    <span class="badge badge-blue">Westmount</span>
                    <span class="badge badge-blue">Mont-Royal</span>
                    <span class="badge badge-blue">Outremont</span>
                    <span class="badge badge-blue">LaSalle</span>
                    <span class="badge badge-blue">Ahuntsic</span>
                </div>
            </div>

            <div class="city-group">
                <p class="city-lead">Laval</p>
                <div class="badges-container">
                    <span class="badge badge-blue">Laval (tous quartiers)</span>
                    <span class="badge badge-blue">Chomedey</span>
                    <span class="badge badge-blue">Duvernay</span>
                    <span class="badge badge-blue">Fabreville</span>
                </div>
            </div>

            <div class="city-group">
                <p class="city-lead">Rive-Sud de Montréal</p>
                <div class="badges-container">
                    <span class="badge badge-green">Longueuil</span>
                    <span class="badge badge-green">Brossard</span>
                    <span class="badge badge-green">Saint-Hubert</span>
                    <span class="badge badge-green">Boucherville</span>
                    <span class="badge badge-green">Saint-Lambert</span>
                </div>
            </div>
          </div>

                    <div
                        class="fade-in-section delay-200"
                        style="margin-top: 2rem; margin-bottom: 2rem; padding: 1.5rem 1.75rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); border-radius: 8px; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <h3 style="color: var(--color-primary); margin: 0 0 0.75rem; font-size: 1.2rem;">
                            Nettoyage de céramique à Longueuil et sur la Rive-Sud
                        </h3>
                        <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                            Nous offrons le nettoyage de céramique à Longueuil, Brossard, Saint-Hubert, Boucherville, Saint-Lambert et sur toute la Rive-Sud pour les planchers, tuiles et joints de coulis — en maison, condo ou appartement. Cuisines, salles de bain, entrées et espaces très utilisés sont traités avec nos produits écologiques premium. Le technicien inspecte la surface avant de commencer afin d'adapter le nettoyage selon l'état des tuiles, l'accumulation dans les joints et le niveau de saleté.
                        </p>
                    </div>

          <!-- FAQ SECTION -->
          <div class="fade-in-section delay-300" style="margin-top: 3rem;">
              <h2 class="section-title text-gradient-empire">
                  Questions Fréquentes — Tuiles & Coulis
              </h2>
              <FAQSchema
                  faqs={[
                      {
                          question: "Combien de temps faut-il attendre avant de marcher sur le plancher ?",
                          answer: "Grâce à notre aspiration puissante, le plancher est sec au toucher presque immédiatement. Cependant, si nous appliquons un scellant protecteur, nous recommandons d'attendre environ 2 à 4 heures avant de marcher dessus avec des chaussures, et 24 heures avant de passer la moppe avec de l'eau.",
                      },
                      {
                          question: "Est-ce que votre machine va envoyer de l'eau sur mes armoires de cuisine ?",
                          answer: "Pas du tout. Nous utilisons un outil 'Turbo' qui est une cloche fermée hermétique. L'eau à haute pression est projetée à l'intérieur de cette cloche et aspirée instantanément par le vide. Vos murs, plinthes et armoires restent parfaitement secs du début à la fin.",
                      },
                      {
                          question: "Pouvez-vous nettoyer les joints de douche moisis ?",
                          answer: "Oui, nous pouvons éliminer la moisissure de surface et les résidus de savon. Cependant, si la moisissure a pénétré *derrière* le coulis ou si le silicone est noirci en profondeur, le nettoyage ne suffira pas; un remplacement du joint de silicone (calfeutrant) pourrait être nécessaire.",
                      },
                      {
                          question: "En quoi consiste votre nettoyage à la vapeur ?",
                          answer: "Nous réalisons un nettoyage professionnel à la vapeur sous haute pression contrôlée, combiné à un puissant système d'extraction. La chaleur (200°F), la pression contrôlée (800-1200 PSI) et l'aspiration industrielle travaillent ensemble pour extraire la saleté du fond des joints de coulis — bien au-delà d'un appareil vapeur domestique.",
                      },
                      {
                          question: "Est-ce que le scellant change la couleur de mes joints ?",
                          answer: "Nous utilisons généralement un scellant pénétrant invisible qui ne change pas l'apparence naturelle de vos joints. Il protège de l'intérieur. Si vous souhaitez changer la couleur de vos joints, il existe des scellants colorés (ColorSeal), mais c'est un service spécialisé distinct.",
                      },
                      {
                          question: "Nettoyez-vous aussi les dosserets de cuisine (backsplashes) ?",
                          answer: "Oui ! Nous utilisons des outils à main plus petits, spécialement conçus pour les surfaces verticales, afin de nettoyer vos dosserets et vos murs de douche avec la même efficacité que vos planchers.",
                      },
                      {
                          question: "À quelle fréquence faut-il faire nettoyer la céramique et les joints ?",
                          answer: "Nous recommandons un nettoyage professionnel tous les 12 à 18 mois selon l'usage, la présence d'animaux et le niveau de circulation. Un entretien régulier prévient le noircissement des joints et prolonge la durée de vie du coulis.",
                      },
                      {
                          question: "Vos produits sont-ils sécuritaires pour les enfants et les animaux ?",
                          answer: "Oui. Nous utilisons des produits écologiques premium, professionnels et adaptés aux environnements familiaux. Ils nettoient en profondeur sans compromettre la finition de votre céramique.",
                      },
                      {
                          question: "Intervenez-vous en condo et en appartement à Montréal ?",
                          answer: "Oui. Nous nettoyons régulièrement les tuiles et joints de coulis en condo et en appartement à Montréal, Laval et sur la Rive-Sud. Notre tête turbo fermée limite les éclaboussures et convient bien aux espaces plus compacts.",
                      },
                  ]}
              />
          </div>

          <div class="fade-in-section delay-200" style="margin-top: 2.5rem; max-width: 720px;">
            <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
              Pendant que nous y sommes, plusieurs clients combinent aussi le
              <a href="/services/nettoyage-tapis-residentiel/">nettoyage de tapis</a>
              ou le
              <a href="/services/meubles-tissu/">nettoyage de meubles en tissu</a>
              pour un entretien complet de la résidence.
            </p>
          </div>

        </div>

        <!-- SIDEBAR -->
        <aside class="service-sidebar">
          <div class="sticky-card fade-in-section">
            <h3 class="card-title text-gradient-gold">Demander un estimé gratuit</h3>
