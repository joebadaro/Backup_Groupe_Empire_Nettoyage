---
import Layout from "../../layouts/Layout.astro";
import FAQSchema from "../../components/FAQSchema.astro";
import ServiceVideoProof from "../../components/ServiceVideoProof.astro";
import UiIcon from "../../components/icons/UiIcon.astro";
import ConversionCtaPriorityGroup from "../../components/ConversionCtaPriorityGroup.astro";
---

<Layout
  title="Nettoyage de tapis et d'escaliers résidentiels | Montréal et Rive-Sud"
  description="Nettoyage de tapis mur à mur et d'escaliers à domicile, avec vapeur, shampoing et produits verts. Service à Montréal et sur la Rive-Sud."
>
  <!-- SPLIT SCREEN HERO -->
  <div class="split-hero-container mobile-hero-stack">
    <div class="container full-width-split">
      <div class="split-layout">
        <!-- LEFT COLUMN: CONTENT (Hook) -->
        <div class="split-content fade-in-section">
          <div class="service-hero-intro">
          <span class="service-cat-badge">TAPIS & ESCALIERS</span>
          <h1 class="split-title fade-in-up text-gradient-empire">
            Nettoyage de tapis et d'escaliers résidentiels
          </h1>

          <div class="mobile-hero-slideshow fade-in-up delay-050">
            <div class="slideshow-container">
              <img
                src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
                alt="Nettoyage professionnel de tapis à la vapeur à domicile"
                class="slide active"
                width="1200"
                height="800"
                loading="eager"
              />
              <img
                src="/images/catalog/resultat-tapis-propre-longueuil.webp"
                alt="Résultat de nettoyage de tapis résidentiel - Groupe Empire"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-34.webp"
                alt="Service de nettoyage de tapis à domicile - Groupe Empire"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-67.webp"
                alt="Tapis résidentiel après nettoyage professionnel à Montréal"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-142.webp"
                alt="Avant-après nettoyage de tapis - Groupe Empire"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-143.webp"
                alt="Tapis résidentiel propre après nettoyage professionnel"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-144.webp"
                alt="Plus de 30 ans d'expertise en nettoyage de tapis - Groupe Empire"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
              <img
                src="/images/catalog/photo-133.webp"
                alt="Nettoyage de tapis à domicile sans déplacer les meubles"
                class="slide"
                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="image-overlay-gradient"></div>
          </div>

          <div class="problem-statement fade-in-up delay-100">
            <h2 class="problem-title">Nettoyage professionnel de tapis avec des produits verts et écologiques</h2>
            <p class="problem-text">
              Au quotidien, les tapis résidentiels et les escaliers accumulent poussière, sable, poils d'animaux et saletés provenant des passages fréquents. Les taches d'urine, les odeurs persistantes et les zones fortement encrassées peuvent également nécessiter des traitements spécialisés.
            </p>
            <p class="problem-text">
              Chez Groupe Nettoyage Empire, nous privilégions des produits de nettoyage professionnels verts et écologiques, sélectionnés selon les fibres et la condition de vos tapis.
            </p>
          </div>

          <p class="lead-text fade-in-up delay-200">
            Nous offrons un <strong>nettoyage de tapis résidentiels à domicile</strong> pour les tapis mur à mur, les chambres, les sous-sols, les corridors et les <strong>escaliers recouverts de tapis</strong>. Après une <strong>inspection préalable</strong>, nous adaptons la méthode : vapeur, shampoing et injection-extraction selon les fibres. Des traitements spécialisés peuvent être recommandés et appliqués seulement avec votre autorisation.
          </p>
          </div>

          <div class="service-hero-action-band">
          <ConversionCtaPriorityGroup locale="fr" buttonStyle="green" phoneIcon estimateIcon />
          <ServiceVideoProof
            title="Voyez notre nettoyage de tapis en action"
            subtitle="Nettoyage complet de tapis résidentiel à domicile"
            description="Regardez une intervention réelle chez un client et voyez notre méthode de nettoyage professionnel pour rafraîchir les tapis résidentiels en profondeur."
            youtubeId="9TKQuGP6-GA"
            youtubeTitle="Nettoyage complet de tapis résidentiel à domicile"
            allVideosHref="/realisations-video/"
            posterUrl="/images/videos/video-thumb-nettoyage-tapis-maison-complet.webp"
            videoAspectRatio="9 / 16"
          />
          </div>
        </div>

        <!-- RIGHT COLUMN: IMAGE (Visual / Slideshow) -->
        <div class="split-image-wrapper fade-in-section delay-200">
          <div class="slideshow-container">
            <img
              src="/images/catalog/nettoyage-tapis-vapeur-laval.webp"
              alt="Nettoyage professionnel de tapis à la vapeur à domicile"
              class="slide active"
              width="1200"
              height="800"
              fetchpriority="high"
              loading="eager"
            />
            <img
              src="/images/catalog/resultat-tapis-propre-longueuil.webp"
              alt="Résultat de nettoyage de tapis résidentiel - Groupe Empire"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-34.webp"
              alt="Service de nettoyage de tapis à domicile - Groupe Empire"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-67.webp"
              alt="Tapis résidentiel après nettoyage professionnel à Montréal"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-142.webp"
              alt="Avant-après nettoyage de tapis - Groupe Empire"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-143.webp"
              alt="Tapis résidentiel propre après nettoyage professionnel"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-144.webp"
              alt="Plus de 30 ans d'expertise en nettoyage de tapis - Groupe Empire"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
            <img
              src="/images/catalog/photo-133.webp"
              alt="Nettoyage de tapis à domicile sans déplacer les meubles"
              class="slide"
              width="1200"
              height="800"
              loading="lazy"
            />
          </div>
          <div class="image-overlay-gradient"></div>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="service-layout">
        <div class="service-main">
          <div class="fade-in-section delay-100">
            <h2 class="section-title text-gradient-empire">
              Notre méthode professionnelle en cinq étapes
            </h2>

            <p>
              Chaque intervention commence par l'état réel du tapis. Voici le déroulement type d'un nettoyage professionnel à domicile :
            </p>

            <ul class="benefit-list" style="margin-bottom: 2rem;">
              <li>
                <strong>1. Inspection préalable :</strong> le technicien examine les tapis, les fibres, l'usure, les taches et les odeurs, puis explique la méthode recommandée.
              </li>
              <li>
                <strong>2. Préparation et aspiration :</strong> préparation des surfaces, protection des planchers au besoin et aspiration adaptée pour retirer poussière et saletés sèches.
              </li>
              <li>
                <strong>3. Prétraitements spécialisés au besoin :</strong> lorsque l'inspection le justifie, application d'un traitement enzymatique, à l'oxygène actif ou d'un autre prétraitement adapté — toujours après explication et avec votre autorisation. Le moment d'application suit les caractéristiques du produit et les recommandations du fabricant.
              </li>
              <li>
                <strong>4. Vapeur, shampoing et injection-extraction :</strong> nettoyage professionnel coordonné selon les fibres, pour déloger la saleté et retirer l'humidité en excès. La vapeur ne constitue pas une désinfection automatique de tous les tapis.
              </li>
              <li>
                <strong>5. Rinçage, extraction finale et conseils de séchage :</strong> finition du procédé, puis conseils pour un séchage optimal. Le séchage prend généralement quelques heures, selon les fibres, l'humidité et la ventilation.
              </li>
            </ul>

            <h3 style="color: var(--color-primary); margin: 2rem 0 1rem; font-size: 1.35rem;">
              Tapis mur à mur : salons, chambres, sous-sols et corridors
            </h3>
            <p>
              Nous réalisons le <strong>nettoyage de tapis mur à mur</strong> dans les pièces de vie : salon, chambre, sous-sol et corridor. La méthode s'adapte au type de fibre et au niveau d'encrassement observé, pour un résultat propre et durable sur les zones de passage fréquent.
            </p>
            <p style="margin-top: 0.75rem;">
              Cette page porte sur les <strong>tapis résidentiels fixes</strong> et les <strong>escaliers recouverts de tapis</strong>. Pour les carpettes amovibles, consultez nos services de
              <a href="/services/tapis-synthetique/" style="color: var(--color-primary); font-weight: 600;">nettoyage de tapis synthétique</a>,
              <a href="/services/tapis-laine/" style="color: var(--color-primary); font-weight: 600;">tapis en laine</a>
              et
              <a href="/services/tapis-orientaux/" style="color: var(--color-primary); font-weight: 600;">tapis orientaux</a>.
              Pour les bureaux et commerces :
              <a href="/services/nettoyage-tapis-commercial/" style="color: var(--color-primary); font-weight: 600;">nettoyage de tapis commercial</a>.
            </p>

            <div style="margin-top: 3rem; background-color: #f8f9fa; border-left: 4px solid var(--color-accent); padding: 2rem; border-radius: 8px;">
              <h3 style="color: var(--color-primary); margin-bottom: 1rem;">
                Spécialité : nettoyage de tapis d'escalier, marches et paliers
              </h3>
              <p>
                Le <strong>nettoyage d'escaliers recouverts de tapis</strong> demande une approche distincte du salon. Les marches, nez de marche, contremarches et paliers s'encrassent vite sous les passages fréquents — ce service concerne les escaliers tapissés, et non le nettoyage des escaliers en bois ou en céramique.
              </p>
              <p style="margin-top: 1rem;">
                Après inspection, nos techniciens utilisent des <strong>outils d'extraction professionnels</strong> adaptés à chaque marche et aux coins des paliers. Nous traitons les zones fortement utilisées pour retirer saletés incrustées et traces de passage, et redonner du volume aux fibres aplaties lorsque possible.
              </p>
            </div>

            <div style="margin-top: 3rem;">
              <hr class="separator" />
              <h3 style="color: var(--color-primary);">Camion-usine et appareil portable professionnel</h3>
              <p>
                Nous privilégions le <strong>camion-usine</strong> de nettoyage à la vapeur et d'extraction lorsque l'accès le permet, pour une puissance d'extraction professionnelle adaptée aux tapis mur à mur.
              </p>
              <p style="margin-top: 1rem;">
                Pour les condos, certains étages élevés ou les accès difficiles, nous utilisons des <strong>appareils portables professionnels</strong> adaptés. Le choix de l'équipement dépend de l'accès, du type de fibres et des conditions de l'intervention — l'appareil portable offre une extraction professionnelle comparable lorsque le camion-usine n'est pas approprié.
              </p>
            </div>

            <div style="margin-top: 2.5rem;">
              <h3 style="color: var(--color-primary);">Taches, odeurs, acariens et allergènes</h3>
              <p style="margin-bottom: 1rem;">
                Selon l'inspection, notre nettoyage de tapis peut viser plusieurs situations courantes :
              </p>
              <ul class="benefit-list" style="margin-bottom: 1.25rem;">
                <li><strong>Urine humaine et animale :</strong> taches et odeurs associées, souvent abordées avec un prétraitement enzymatique ou un autre traitement spécialisé selon l'évaluation.</li>
                <li><strong>Odeurs d'animaux et odeurs persistantes :</strong> traitement ciblé lorsque la source peut être traitée sur place.</li>
                <li><strong>Taches alimentaires, saletés incrustées et passages fréquents :</strong> approche adaptée aux zones de fort trafic.</li>
                <li><strong>Poussière, acariens et allergènes :</strong> le nettoyage en profondeur aide à retirer poussières et résidus présents dans les fibres.</li>
                <li><strong>Bactéries et désinfection spécialisée :</strong> lorsqu'approprié et compatible avec le textile, un traitement désinfectant peut être recommandé en complément — il n'est pas automatique.</li>
              </ul>
              <p>
                Les traitements enzymatiques, à l'oxygène actif ou désinfectants sont présentés clairement (recommandés, nécessaires selon l'évaluation ou optionnels). Le technicien explique les recommandations et obtient votre <strong>autorisation</strong> avant toute application. Ces traitements spécialisés ne font pas automatiquement partie du nettoyage de base et ne sont pas tous présentés comme écologiques.
              </p>
            </div>

            <div class="info-box" style="margin-top: 2rem;">
              <h3 style="color: var(--color-primary); margin-bottom: 10px;">
                Protecteur antitache pour tapis
              </h3>
              <p>
                Après inspection, un <a href="/services/protecteur" style="color: var(--color-primary); font-weight: bold; text-decoration: underline;">protecteur antitache professionnel</a> compatible avec les fibres peut être proposé, notamment pour les escaliers et les zones de passage. Il aide à ralentir l'absorption des liquides au quotidien, sans constituer une protection absolue.
              </p>
            </div>

            <p style="margin-top: 2rem;">
              Sur la Rive-Sud, consultez aussi nos pages locales :
              <a href="/services/nettoyage-tapis-longueuil/" style="color: var(--color-primary); font-weight: 600;">intervention à Longueuil</a>,
              <a href="/services/nettoyage-tapis-brossard/" style="color: var(--color-primary); font-weight: 600;">nettoyage de tapis à Brossard</a>,
              <a href="/services/nettoyage-tapis-boucherville/" style="color: var(--color-primary); font-weight: 600;">service à Boucherville</a>,
              <a href="/services/nettoyage-tapis-chambly/" style="color: var(--color-primary); font-weight: 600;">nettoyage de tapis à Chambly</a>
              et
              <a href="/services/nettoyage-tapis-candiac/" style="color: var(--color-primary); font-weight: 600;">rendez-vous à Candiac</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-layout" style="display: block;">
        <div class="service-main" style="max-width: 800px; margin: 0 auto;">
          <div class="fade-in-section delay-200" style="margin-top: 3rem;">
            <h2 class="section-title text-gradient-empire">
              Pourquoi nous choisir ?
            </h2>
            <div class="benefits-grid">
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span>Plus de 30 ans d'expérience</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span>Produits professionnels verts et écologiques</span>
              </div>
              <div class="benefit-item">
                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                <span>Camion-usine ou portable selon l'accès</span>
              </div>
            </div>
            <p style="margin-top: 1.25rem; line-height: 1.65; color: var(--color-text-main);">
              Inspection préalable, méthodes adaptées aux fibres et service professionnel à domicile : notre équipe met à profit plus de 30&nbsp;ans d'expérience pour le nettoyage de tapis résidentiels et d'escaliers recouverts de tapis.
            </p>
          </div>

          <div class="zones-section" style="margin-top: 3rem; margin-bottom: 3rem;">
            <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Zones desservies — Nettoyage de tapis</h3>
            <p>Nous intervenons à domicile dans le Grand Montréal, à Laval et sur la Rive-Sud avec nos unités mobiles.</p>
            <p style="margin-top: 0.75rem;">
              Pour une présentation du service par secteur sur l'île, consultez notre page dédiée au <a href="/services/nettoyage-tapis-montreal/" style="color: var(--color-primary); font-weight: 600;">nettoyage de tapis à Montréal</a>. Pour la ville de Westmount, consultez le <a href="/services/nettoyage-tapis-westmount/" style="color: var(--color-primary); font-weight: 600;">nettoyage de tapis à Westmount</a>.
            </p>

            <div class="city-group">
              <p class="city-lead">Montréal (Est et Ouest)</p>
              <div class="badges-container">
                <span class="badge badge-blue">Montréal (tous arrondissements)</span>
                <span class="badge badge-blue">Westmount</span>
                <span class="badge badge-blue">Mont-Royal</span>
                <span class="badge badge-blue">Outremont</span>
                <span class="badge badge-blue">LaSalle</span>
                <span class="badge badge-blue">Et plus encore...</span>
              </div>
            </div>

            <div class="city-group">
              <p class="city-lead">Laval</p>
              <div class="badges-container">
                <span class="badge badge-blue">Laval (toute la ville)</span>
                <span class="badge badge-blue">Chomedey</span>
                <span class="badge badge-blue">Sainte-Rose</span>
                <span class="badge badge-blue">Vimont</span>
              </div>
            </div>

            <div class="city-group">
              <p class="city-lead">Rive-Sud de Montréal</p>
              <div class="badges-container">
                <span class="badge badge-green">Longueuil</span>
                <span class="badge badge-green">Brossard</span>
                <span class="badge badge-green">Saint-Lambert</span>
                <span class="badge badge-green">Saint-Hubert</span>
                <span class="badge badge-green">Greenfield Park</span>
                <span class="badge badge-green">Saint-Bruno</span>
                <span class="badge badge-green">Boucherville</span>
                <span class="badge badge-green">Et plus encore...</span>
              </div>
            </div>
            
            <p class="contact-footer">Besoin d'un rendez-vous rapide ? Appelez-nous au <strong>(514) 893-9939</strong>.</p>
          </div>

          <div
            class="fade-in-section delay-200"
            style="margin-top: 2rem; padding: 1.25rem 1.5rem; background: #f8fbff; border: 1px solid #c5dff0; border-radius: 8px; max-width: 800px; margin-left: auto; margin-right: auto;"
          >
            <h3 style="color: var(--color-primary); margin: 0 0 0.75rem; font-size: 1.2rem;">
              Prix du nettoyage de tapis résidentiel
            </h3>
            <p style="margin: 0; line-height: 1.65; color: var(--color-text-main); font-size: 0.98rem;">
              Le prix d'un nettoyage de tapis dépend de la surface, du type de fibre, de l'état du tapis et des traitements recommandés sur place. Pour obtenir un montant indicatif avant taxes, utilisez notre estimation instantanée en ligne. Commande minimale : 169 $ — déplacement inclus. Certaines zones peuvent être assujetties à un minimum différent. Les promotions en vigueur peuvent aussi être consultées sur notre <a href="/promotions/" style="color: var(--color-primary); font-weight: 600;">page Promotions</a>.
            </p>
          </div>

          <div class="fade-in-section delay-300" style="margin-top: 3rem;">
            <h2 class="section-title text-gradient-empire">
              Questions fréquentes — nettoyage de tapis résidentiel
            </h2>
            <FAQSchema
              faqs={[
                {
                  question: "En quoi consistent le nettoyage à la vapeur, le shampoing et l'injection-extraction ?",
                  answer: "Après inspection des fibres, nous utilisons des produits adaptés, un shampoing et un nettoyage à la vapeur avec injection-extraction lorsque le textile le permet. Cette approche retire saleté et humidité en excès plus en profondeur qu'un appareil grand public. La vapeur seule ne constitue pas une désinfection automatique.",
                },
                {
                  question: "Nettoyez-vous les escaliers, marches et paliers recouverts de tapis ?",
                  answer: "Oui. Notre service de nettoyage de tapis d'escalier couvre les marches, nez de marche, contremarches et paliers recouverts de tapis, avec des outils d'extraction professionnels. Ce service ne remplace pas le nettoyage des escaliers en bois ou en céramique. Le devis tient compte du nombre de marches et de la configuration.",
                },
                {
                  question: "Utilisez-vous un camion-usine ou un appareil portable ?",
                  answer: "Nous privilégions le camion-usine lorsque l'accès le permet. Pour les condos, certains étages élevés ou les accès difficiles, nous utilisons un appareil portable professionnel. Les deux options offrent une extraction professionnelle ; le choix dépend de l'accès, des fibres et des conditions sur place.",
                },
                {
                  question: "Traitez-vous les taches d'urine et les odeurs d'animaux ?",
                  answer: "Oui, c'est une demande fréquente. Après inspection, le technicien peut recommander un prétraitement enzymatique ou un autre traitement spécialisé, puis procéder au nettoyage avec extraction. Chaque traitement additionnel est expliqué et appliqué seulement avec votre autorisation. Le résultat dépend de l'ancienneté et de la profondeur de la tache.",
                },
                {
                  question: "Le nettoyage aide-t-il face aux acariens, allergènes et bactéries ?",
                  answer: "Un nettoyage en profondeur aide à retirer poussière, saletés et résidus associés aux allergènes présents dans les fibres. Lorsque c'est approprié, un traitement désinfectant compatible avec le textile peut être proposé en complément. La vapeur seule ne constitue pas une désinfection automatique de tous les tapis.",
                },
                {
                  question: "Les traitements enzymatiques, à l'oxygène actif ou désinfectants sont-ils inclus ?",
                  answer: "Ils ne sont pas automatiques. Selon l'inspection, ils peuvent servir de prétraitement ou d'intervention complémentaire. Le technicien explique ce qui est recommandé, nécessaire selon l'évaluation ou optionnel, puis obtient votre autorisation avant toute application.",
                },
                {
                  question: "Combien de temps faut-il pour que le tapis sèche ?",
                  answer: "Le séchage prend généralement quelques heures, selon les fibres, l'humidité de la pièce et la ventilation. Après extraction, la surface est habituellement légèrement humide, non détrempée. Une bonne circulation d'air accélère le processus.",
                },
                {
                  question: "Utilisez-vous des produits verts et écologiques ?",
                  answer: "Nous privilégions des produits de nettoyage professionnels verts et écologiques, sélectionnés selon les fibres et la condition des tapis. Les traitements spécialisés (enzymatiques, oxygène actif ou désinfectants) sont distincts du nettoyage de base et choisis selon le besoin de l'intervention.",
                },
              ]}
            />
          </div>

          <p
            class="fade-in-section"
            style="margin-top: 2rem; margin-bottom: 1rem; line-height: 1.65; color: var(--color-text-main); font-size: 0.95rem;"
          >
            Aussi utiles :
            <a href="/services/meubles-tissu/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">nettoyage de meubles en tissu</a>,
            <a href="/services/nettoyage-desinfection-matelas/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">nettoyage et désinfection de matelas</a>,
            <a href="/produits" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">produits professionnels</a>
            et
            <a href="/realisations-video/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">réalisations vidéo</a>.
          </p>

          <div
            class="fade-in-section delay-200"
