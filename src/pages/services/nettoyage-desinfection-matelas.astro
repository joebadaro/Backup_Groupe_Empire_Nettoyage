---
import Layout from "../../layouts/Layout.astro";
import FAQSchema from "../../components/FAQSchema.astro";
import ServiceVideoProof from "../../components/ServiceVideoProof.astro";
import UiIcon from "../../components/icons/UiIcon.astro";
import ConversionCtaPriorityGroup from "../../components/ConversionCtaPriorityGroup.astro";
---

<Layout
    title="Nettoyage et désinfection de matelas | Montréal et Rive-Sud"
    description="Nettoyage et désinfection de matelas à domicile avec produits verts et écologiques. Traitements pour urine, sang, odeurs et acariens. Montréal et Rive-Sud."
>
    <!-- SPLIT SCREEN HERO: BLOCK 1 -->
    <div class="split-hero-container mobile-hero-stack">
        <div class="container full-width-split">
            <div class="split-layout">
                <!-- LEFT COLUMN: CONTENT -->
                <div class="split-content fade-in-section bg-gradient-premium">
          <div class="service-hero-intro">
                    <span class="service-cat-badge">MATELAS</span>
                    <h1 class="split-title fade-in-up text-gradient-empire">
                        Nettoyage et désinfection de matelas
                    </h1>

                    <div class="mobile-hero-slideshow fade-in-up delay-050">
                        <div class="slideshow-container">
                            <img
                                src="/images/catalog/teck-empire-matress-optimized.webp"
                                alt="Expert Groupe Empire nettoyage en profondeur de matelas - Montréal"
                                class="slide active"
                                width="1200"
                                height="800"
                                loading="eager"
                            />
                            <img
                                src="/images/catalog/photo-matelas-2.webp"
                                alt="Nettoyage désinfection matelas à domicile Montréal - Élimination acariens"
                                class="slide"
                                width="1200"
                                height="800"
                                loading="lazy"
                            />
                            <img
                                src="/images/catalog/kid-dog-matress-optimized.webp"
                                alt="Désinfection de matelas sécurisée pour enfants et animaux - Montréal"
                                class="slide"
                                width="1200"
                                height="800"
                                loading="lazy"
                            />

                            <img
                                src="/images/catalog/woman-matress-optimized.webp"
                                alt="Sommeil réparateur après nettoyage professionnel de matelas - Groupe Empire"
                                class="slide"
                                width="1200"
                                height="800"
                                loading="lazy"
                            />
                        </div>
                        <div class="image-overlay-gradient"></div>
                    </div>

                    <!-- BLOCK 1: INTRO (VISIBLE) -->
                    <div class="problem-statement fade-in-up delay-100">
                        <h2 class="problem-title">Un nettoyage en profondeur avec des produits verts et écologiques</h2>
                        <p class="problem-text">
                            Au fil du temps, votre matelas accumule poussière, transpiration, résidus corporels et allergènes. Les taches d’urine, de sang, les cernes, le jaunissement et les odeurs persistantes peuvent également nécessiter des traitements spécialisés.
                        </p>
                        <p class="problem-text">
                            Chez Groupe Nettoyage Empire, nous privilégions des produits de nettoyage verts et écologiques, sélectionnés selon le type de textile et les besoins de chaque intervention.
                        </p>
                    </div>

                    <p class="lead-text fade-in-up delay-200">
                        Nous offrons un service professionnel de <strong>nettoyage et désinfection de matelas à domicile</strong>, à la vapeur, au shampoing et par injection-extraction lorsque le textile le permet. Après inspection, nos techniciens peuvent recommander des traitements spécialisés pour les taches, les odeurs, les acariens et les autres besoins particuliers, avec votre autorisation.
                    </p>

                    </div>

                    <div class="service-hero-action-band">

                    <ConversionCtaPriorityGroup locale="fr" buttonStyle="green" estimateIcon />
                    <ServiceVideoProof
                        title="Voyez notre nettoyage de matelas en action"
                        subtitle="Nettoyage de matelas à la vapeur et traitement spécialisé"
                        description="Regardez une intervention réelle : préparation du matelas, méthode professionnelle et résultat obtenu après le nettoyage à domicile."
                        youtubeId="0JmVo463OCA"
                        youtubeTitle="Nettoyage de matelas à la vapeur et traitement spécialisé"
                        allVideosHref="/realisations-video/"
                        posterUrl="/images/videos/video-thumb-nettoyage-matelas.webp"
                        videoAspectRatio="9 / 16"
                    />

                    </div>
                </div>

                <!-- RIGHT COLUMN: IMAGE -->
                <div class="split-image-wrapper fade-in-section delay-200">
                    <div class="slideshow-container">
                        <img
                            src="/images/catalog/teck-empire-matress-optimized.webp"
                            alt="Expert Groupe Empire nettoyage en profondeur de matelas - Montréal"
                            class="slide active"
                            width="1200"
                            height="800"
                            fetchpriority="high"
                            loading="eager"
                        />
                        <img
                            src="/images/catalog/photo-matelas-2.webp"
                            alt="Nettoyage désinfection matelas à domicile Montréal - Élimination acariens"
                            class="slide"
                            width="1200"
                            height="800"
                            loading="lazy"
                        />
                        <img
                            src="/images/catalog/kid-dog-matress-optimized.webp"
                            alt="Désinfection de matelas sécurisée pour enfants et animaux - Montréal"
                            class="slide"
                            width="1200"
                            height="800"
                            loading="lazy"
                        />

                        <img
                            src="/images/catalog/woman-matress-optimized.webp"
                            alt="Sommeil réparateur après nettoyage professionnel de matelas - Groupe Empire"
                            class="slide"
                            width="1200"
                            height="800"
                            loading="lazy"
                        />
                    </div>
                    <div class="image-overlay-gradient"></div>
                </div>
            </div>
        </div>
    </div>

    <section class="section">
        <div class="container">
            <div class="service-layout" style="display: block;">
                <!-- MAIN CONTENT (Centered, No Sidebar) -->
                <div
                    class="service-main"
                    style="max-width: 800px; margin: 0 auto;"
                >
                    <div class="fade-in-section delay-100" style="margin-top: 2rem;">
                        <div>
                            <hr class="separator" />

                            <h2 style="color: var(--color-primary);">
                                Pourquoi faire nettoyer un matelas professionnellement&nbsp;?
                            </h2>
                            <p>
                                Un matelas simple, double, Queen ou King retient facilement la transpiration, la poussière et les allergènes. Les taches d’urine humaine ou animale, les taches de sang, les cernes, les auréoles et le jaunissement demandent souvent plus qu’un produit ménager.
                            </p>
                            <p style="margin-top: 1rem;">
                                Chez <strong>Groupe Nettoyage Empire</strong>, le <strong>nettoyage</strong> retire saletés et résidus avec vapeur, shampoing et injection-extraction lorsque le textile le permet. La <strong>désodorisation</strong> cible les odeurs persistantes lorsque c’est pertinent. La <strong>désinfection</strong> est un traitement additionnel, compatible avec le textile et adapté à la situation — elle n’est pas automatique sur chaque matelas et ne remplace pas le nettoyage.
                            </p>

                            <div style="margin-top: 2.5rem;">
                                <h2 style="color: var(--color-primary); margin-bottom: 1rem;">
                                    Taches, odeurs, acariens et allergènes
                                </h2>
                                <p style="margin-bottom: 1rem;">
                                    Selon l’inspection, notre service de nettoyage et désinfection de matelas peut viser plusieurs situations courantes&nbsp;:
                                </p>
                                <ul class="benefit-list" style="margin-bottom: 1.5rem;">
                                    <li>
                                        <strong>Urine humaine et animale :</strong> taches et odeurs associées, souvent abordées avec un prétraitement enzymatique ou un autre traitement spécialisé selon l’évaluation.
                                    </li>
                                    <li>
                                        <strong>Taches de sang :</strong> traitement prudent adapté au textile et à l’ancienneté de la tache.
                                    </li>
                                    <li>
                                        <strong>Cernes, auréoles et jaunissement :</strong> liés à la transpiration et aux résidus corporels&nbsp;; une tache récente répond souvent mieux qu’une auréole ancienne.
                                    </li>
                                    <li>
                                        <strong>Odeurs persistantes :</strong> désodorisation ciblée lorsque la source peut être traitée sur place.
                                    </li>
                                    <li>
                                        <strong>Acariens, allergènes et bactéries :</strong> nos procédés professionnels de nettoyage à la vapeur, shampoing et extraction contribuent à retirer les poussières, les résidus d’acariens et les particules allergènes présents dans les fibres du matelas. Selon l’inspection et la compatibilité du textile, un traitement désinfectant spécialisé peut également être recommandé pour les bactéries et certains micro-organismes.
                                    </li>
                                </ul>
                                <p>
                                    Les traitements enzymatiques, à l’oxygène actif ou désinfectants sont présentés clairement (recommandés, nécessaires selon l’évaluation ou optionnels) et appliqués seulement avec votre autorisation. Selon le cas, ils servent de <strong>prétraitement</strong> ou d’intervention complémentaire au nettoyage.
                                </p>
                            </div>

                            <h2 style="color: var(--color-primary); margin-top: 2.5rem;">
                                Notre méthode en cinq étapes
                            </h2>
                            <p>
                                Chaque intervention commence par l’état réel du matelas. Voici le déroulement type d’un nettoyage professionnel à domicile&nbsp;:
                            </p>

                            <ul class="benefit-list" style="margin-top: 1.5rem; margin-bottom: 2rem;">
                                <li>
                                    <strong>1. Inspection préalable :</strong> le technicien examine le textile, les taches (urine, sang, cernes), les odeurs et le type de matelas, puis explique la méthode recommandée.
                                </li>
                                <li>
                                    <strong>2. Préparation et aspiration :</strong> préparation de la surface et aspiration pour retirer poussière, peaux mortes et saletés sèches avant le nettoyage humide.
                                </li>
                                <li>
                                    <strong>3. Prétraitements spécialisés au besoin :</strong> lorsque justifié, application d’un traitement enzymatique, à l’oxygène actif ou d’un autre prétraitement adapté — toujours après explication et avec votre accord.
                                </li>
                                <li>
                                    <strong>4. Vapeur, shampoing et injection-extraction :</strong> procédé professionnel coordonné lorsque le textile le permet, pour déloger la saleté et retirer l’humidité en excès. La vapeur ne constitue pas une désinfection automatique de tous les matelas.
                                </li>
                                <li>
                                    <strong>5. Finitions, désinfection optionnelle et séchage :</strong> rinçage/extraction selon le procédé, traitement désinfectant complémentaire si approprié et autorisé, puis conseils de séchage. Le séchage prend généralement de 2 à 6 heures, selon le matelas, l’humidité et la ventilation.
                                </li>
                            </ul>

                            <h2
                                class="section-title text-gradient-empire"
                                style="font-size: 1.5rem; margin-bottom: 1rem;"
                            >
                                Ce que vous gagnez avec un nettoyage professionnel
                            </h2>
                            <ul class="benefit-list">
                                <li>
                                    Un matelas plus propre, avec retrait des saletés, résidus corporels et contaminants accessibles.
                                </li>
                                <li>
                                    Une aide concrète face aux odeurs d’urine, de transpiration ou autres odeurs persistantes, lorsque le traitement adapté est possible.
                                </li>
                                <li>
                                    Une atténuation des taches, cernes, auréoles et jaunissements selon l’ancienneté et l’état des fibres.
                                </li>
                                <li>
                                    Une approche adaptée aux foyers avec enfants ou animaux, avec produits choisis pour un usage résidentiel.
                                </li>
                                <li>
                                    Un service à domicile, sans transporter le matelas, et un séchage habituel de 2 à 6 heures selon les conditions.
                                </li>
                            </ul>

                            <div style="margin-top: 3rem;">
                                <h2 style="color: var(--color-primary); margin-bottom: 1rem;">
                                    Expertise et équipements professionnels
                                </h2>
                                <p>
                                    Chez Groupe Nettoyage Empire, nous mettons à profit plus de 30&nbsp;ans d’expérience et des équipements professionnels de nettoyage à la vapeur et d’injection-extraction. Nos techniciens adaptent les produits, la méthode et le contrôle de l’humidité selon la composition et la condition de chaque matelas.
                                </p>
                                <h3 style="color: var(--color-primary); margin: 1.5rem 0 0.75rem; font-size: 1.15rem;">
                                    Nos produits de nettoyage verts et écologiques
                                </h3>
                                <p>
                                    Nous privilégions des solutions de nettoyage professionnelles vertes et écologiques, adaptées aux différents types de tissus. Nos techniciens choisissent les produits selon les caractéristiques du matelas et les besoins de l’intervention. Des traitements spécialisés peuvent également être proposés lorsqu’une situation nécessite une approche particulière.
                                </p>
                            </div>

                            <div style="margin-top: 2.5rem;">
                                <h2 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.35rem;">
                                    Formats et types de matelas
                                </h2>
                                <p>
                                    Nous nettoyons à domicile les formats courants — simple, double, Queen et King — ainsi que les matelas à ressorts, hybrides et en mousse lorsque la méthode est compatible. L’inspection confirme l’approche appropriée avant de commencer.
                                </p>
                            </div>

                            <p style="margin-top: 2rem;">
                                Pour un couchage plus propre et une chambre mieux entretenue, faites confiance au nettoyage de matelas professionnel de <strong>Groupe Nettoyage Empire</strong>.
                            </p>
                            <p style="margin-top: 0.5rem;">
                                Contactez-nous dès aujourd’hui pour un <strong>devis rapide</strong> et un service de confiance.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW SECTIONS: BENEFITS & FAQ -->
    <section class="section" style="padding-top: 0;">
        <div class="container">
            <div class="service-layout" style="display: block;">
                <!-- Full width for these bottom sections -->
                <div
                    class="service-main"
                    style="max-width: 800px; margin: 0 auto;"
                >
                    <!-- BENEFITS -->
                    <div
                        class="fade-in-section delay-200"
                        style="margin-top: 3rem;"
                    >
                        <h2 class="section-title text-gradient-empire">
                            Pourquoi nous choisir ?
                        </h2>
                        <div class="benefits-grid">
                            <div class="benefit-item">
                                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                                <span>Inspection professionnelle</span>
                            </div>
                            <div class="benefit-item">
                                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                                <span>Vapeur et extraction en profondeur</span>
                            </div>
                            <div class="benefit-item">
                                <div class="check-circle" aria-hidden="true"><UiIcon name="check" size={14} /></div>
                                <span>Traitements spécialisés adaptés</span>
                            </div>
                        </div>
                    </div>

                    <!-- ZONES DESSERVIES -->
                    <div class="zones-section" style="margin-top: 3rem; margin-bottom: 3rem;">
                        <h3 style="color: var(--color-primary); margin-bottom: 1rem; font-size: 1.4rem;">Zones desservies</h3>
                        <p>Nous intervenons à domicile dans le Grand Montréal, à Laval et sur la Rive-Sud avec nos unités mobiles.</p>

                        <div class="city-group">
                            <p class="city-lead">Montréal (Est et Ouest)</p>
                            <div class="badges-container">
                                <span class="badge badge-blue">Montréal (tous arrondissements)</span>
                                <span class="badge badge-blue">Westmount</span>
                                <span class="badge badge-blue">Mont-Royal</span>
                                <span class="badge badge-blue">Outremont</span>
                                <span class="badge badge-blue">LaSalle</span>
                                <span class="badge badge-blue">Et plus encore...</span>
                            </div>
                        </div>

                        <div class="city-group">
                            <p class="city-lead">Laval</p>
                            <div class="badges-container">
                                <span class="badge badge-blue">Laval (toute la ville)</span>
                                <span class="badge badge-blue">Chomedey</span>
                                <span class="badge badge-blue">Sainte-Rose</span>
                                <span class="badge badge-blue">Vimont</span>
                            </div>
                        </div>

                        <div class="city-group">
                            <p class="city-lead">Rive-Sud de Montréal</p>
                            <div class="badges-container">
                                <span class="badge badge-green">Longueuil</span>
                                <span class="badge badge-green">Brossard</span>
                                <span class="badge badge-green">Saint-Lambert</span>
                                <span class="badge badge-green">Saint-Hubert</span>
                                <span class="badge badge-green">Greenfield Park</span>
                                <span class="badge badge-green">Saint-Bruno</span>
                                <span class="badge badge-green">Boucherville</span>
                                <span class="badge badge-green">Candiac</span>
                                <span class="badge badge-green">Et plus encore...</span>
                            </div>
                        </div>
                        
                        <p class="contact-footer">Besoin d’un rendez-vous&nbsp;? Appelez-nous au <strong>(514) 893-9939</strong>.</p>
                    </div>

                    <div
                        class="fade-in-section delay-200"
                        style="margin-top: 2rem; margin-bottom: 1.5rem; padding: 1.5rem 1.75rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); border-radius: 8px; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <h3 style="color: var(--color-primary); margin: 0 0 0.75rem; font-size: 1.2rem;">
                            Nettoyage de matelas à Westmount
                        </h3>
                        <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                            Nous offrons aussi le nettoyage et la désinfection de matelas à Westmount, à domicile. Le technicien inspecte le matelas pour adapter la méthode selon les taches, les odeurs, la transpiration et l’état du textile. Les traitements spécialisés sont proposés lorsqu’ils sont pertinents et autorisés par vous.
                        </p>
                    </div>

                    <div
                        class="fade-in-section delay-200"
                        style="margin-top: 2rem; margin-bottom: 2rem; padding: 1.5rem 1.75rem; background: #f8f9fa; border-left: 4px solid var(--color-primary); border-radius: 8px; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <h3 style="color: var(--color-primary); margin: 0 0 0.75rem; font-size: 1.2rem;">
                            Nettoyage de matelas à Longueuil, Boucherville et Candiac
                        </h3>
                        <p style="margin: 0; line-height: 1.65; color: var(--color-text-main);">
                            Même service à Longueuil, Boucherville et Candiac&nbsp;: inspection d’abord, puis nettoyage adapté au matelas. Désodorisation ou désinfection lorsque la situation le justifie et avec votre accord.
                        </p>
                    </div>

                    <!-- FAQ with Schema Component -->
                    <div class="fade-in-section delay-300" style="margin-top: 3rem;">
                        <h2 class="section-title text-gradient-empire">
                            Questions fréquentes — nettoyage et désinfection de matelas
                        </h2>
                        <FAQSchema
                            faqs={[
                                {
                                    question:
                                        "Quelle est la différence entre nettoyage et désinfection d’un matelas ?",
                                    answer: "Le nettoyage retire saletés, résidus corporels et taches traitables avec vapeur, shampoing et injection-extraction lorsque le textile le permet. La désodorisation cible les odeurs persistantes lorsque c’est pertinent. La désinfection est un traitement additionnel, compatible avec le textile et adapté à la situation, pour contribuer à réduire bactéries et certains micro-organismes sur les zones traitées. Elle n’est pas automatique sur chaque matelas.",
                                },
                                {
                                    question:
                                        "Traitez-vous les taches d’urine humaine ou animale ?",
                                    answer: "Oui, c’est une demande fréquente. Après inspection, le technicien peut recommander un prétraitement enzymatique ou un autre traitement spécialisé, puis procéder au nettoyage avec extraction. Chaque traitement additionnel est expliqué et appliqué seulement avec votre autorisation. Le résultat dépend de l’ancienneté et de la profondeur de la tache.",
                                },
                                {
                                    question:
                                        "Pouvez-vous traiter les taches de sang, les cernes et le jaunissement ?",
                                    answer: "Souvent, oui, avec une approche adaptée au textile. Les taches récentes répondent généralement mieux. Les cernes, auréoles et jaunissements liés à la transpiration peuvent être atténués ; une auréole ancienne peut laisser une trace même après un bon nettoyage. Nous vous indiquons ce qui est réaliste avant de commencer.",
                                },
                                {
                                    question:
                                        "Le nettoyage aide-t-il face aux acariens, allergènes et bactéries ?",
                                    answer: "Un nettoyage en profondeur aide à retirer poussière, peaux mortes, résidus et contaminants associés aux allergènes. Lorsque c’est approprié, un traitement désinfectant compatible avec le textile peut être proposé en complément. La vapeur seule ne constitue pas une désinfection automatique de tous les matelas.",
                                },
                                {
                                    question:
                                        "Les traitements enzymatiques, à l’oxygène actif ou désinfectants sont-ils inclus ?",
                                    answer: "Ils ne sont pas automatiques. Selon l’inspection, ils peuvent servir de prétraitement ou d’intervention complémentaire. Le technicien vous explique ce qui est recommandé, nécessaire selon l’évaluation ou optionnel, puis obtient votre autorisation avant toute application.",
                                },
                                {
                                    question:
                                        "Combien de temps avant de pouvoir redormir sur mon matelas ?",
                                    answer: "Le séchage prend généralement de 2 à 6 heures, selon le type de matelas, l’humidité de la pièce et la ventilation. Après extraction, la surface est habituellement légèrement humide, non détrempée. Un nettoyage en matinée ou en début d’après-midi permet souvent de réutiliser le lit le jour même ; un ventilateur accélère le processus.",
                                },
                                {
                                    question:
                                        "Nettoyez-vous les matelas en mousse, hybrides et à ressorts ?",
                                    answer: "Oui, lorsque la méthode est compatible. Les matelas à ressorts, hybrides et en mousse ne reçoivent pas tous le même procédé : l’inspection confirme l’approche, surtout pour la mousse, qui demande un bon contrôle de l’humidité. Formats simples, doubles, Queen et King sont pris en charge à domicile.",
                                },
                                {
                                    question:
                                        "Dois-je faire nettoyer un matelas relativement neuf ?",
                                    answer: "Même un matelas récent accumule transpiration, résidus corporels et poussière. Un nettoyage professionnel périodique aide à maintenir un couchage plus propre, surtout avec enfants, animaux ou sensibilités aux allergènes. L’intervalle idéal dépend de l’usage ; le technicien peut vous conseiller selon l’état observé.",
                                },
                            ]}
                        />
                    </div>

                    <p
                        class="fade-in-section"
                        style="margin-top: 2rem; margin-bottom: 1rem; line-height: 1.65; color: var(--color-text-main); font-size: 0.95rem;"
                    >
                        Vous avez aussi un sofa ou un divan à rafraîchir&nbsp;? Consultez notre
                        <a href="/services/meubles-tissu/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">nettoyage de meubles en tissu</a>
                        ou nos
                        <a href="/realisations-video/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">réalisations vidéo</a>.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        // Force script to run immediately using is:inline
        (function () {
            document.querySelectorAll(".slideshow-container").forEach((container) => {
                const slides = container.querySelectorAll(".slide");
                if (slides.length <= 1) return;
                let currentSlide = 0;
                setInterval(() => {
                    slides[currentSlide].classList.remove("active");
                    currentSlide = (currentSlide + 1) % slides.length;
                    slides[currentSlide].classList.add("active");
                }, 4000);
            });


        })();
    </script>

    <style>
        /* HERO */
        /* SPLIT SCREEN HERO (Sky Blue Theme) */
        .split-hero-container {
            background-color: #fff; /* Reset container to white */
            padding-top: 0; /* Remove container padding so image hits top */
            padding-bottom: 0;
            overflow: hidden;
            width: 100vw;
        }
        .full-width-split {
            width: 100%;
            max-width: none;
            padding: 0;
