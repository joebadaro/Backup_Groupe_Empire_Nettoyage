---
import LandingLayout from '../../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Nettoyage de Tuiles et Coulis Montréal - Soumission Gratuite | Nettoyage Empire"
  description="Nettoyage professionnel de tuiles et coulis à Montréal. Résultats spectaculaires garantis. 30+ ans d'expérience. Soumission gratuite."
  service="tuiles"
>
  <nav class="navbar">
    <a href="/" class="navbar-brand"><img src="/favicon.svg" alt="" class="navbar-brand-icon"><span class="navbar-brand-text">Nettoyage<span class="brand-line2">Empire</span></span></a>
    <div class="navbar-right">
      <a href="tel:+14509774636" class="navbar-phone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg><span>(450) 977-4636</span></a>
      <a href="#soumission" class="navbar-cta">Soumission gratuite</a>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-bg"><img src="/images/promo/tuile-before-after-v3.webp" alt=""></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Résultats garantis</div>
        <h1>Nettoyage professionnel de <span class="accent">tuiles et coulis</span></h1>
        <p class="hero-desc">Nos experts redonnent l'éclat à vos planchers de tuiles et coulis avec un nettoyage haute pression professionnel. Résultats spectaculaires garantis.</p>
        <div class="hero-btns">
          <a href="#soumission" class="btn-hero-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Soumission gratuite</a>
          <a href="tel:+14509774636" class="btn-hero-secondary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Appelez-nous</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="number">30+</span><span class="label">Ans d'expérience</span></div>
          <div class="hero-stat"><span class="number">50 000+</span><span class="label">Pi2 de tuiles nettoyées</span></div>
          <div class="hero-stat"><span class="number">4.9/5</span><span class="label">Avis Google</span></div>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/promo/tuile-hero-principal.webp" alt="Nettoyage de tuiles et coulis professionnel - Nettoyage Empire">
        <div class="hero-image-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Résultats garantis</div>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Techniciens certifiés</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg> Produits non-toxiques</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> Équipement haute pression</div>
      <div class="trust-item"><img src="/images/google-reviews-badge.png" alt="Google Reviews 4.9 étoiles"></div>
    </div>
  </div>

  <section class="services fade-up">
    <div class="section-header"><h2>Nos tarifs de nettoyage de tuiles</h2><p>Prix dégressifs au pied carré - Minimum 150 pi2</p></div>
    <div class="service-grid">
      <div class="service-card">
        <img src="/images/service-ceramique.webp" alt="Nettoyage tuiles 0-200 pi2" class="service-card-img">
        <div class="service-card-body"><h3>0 - 200 pi2</h3><p>Idéal pour les salles de bain, entrées et petites surfaces. Nettoyage haute pression des tuiles et coulis.</p><div class="service-price">2,35 $ <small>/ pi2</small></div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/tuile-before-after-v3.webp" alt="Nettoyage tuiles 201-400 pi2" class="service-card-img">
        <div class="service-card-body"><h3>201 - 400 pi2</h3><p>Parfait pour les cuisines et salles de bain de taille moyenne. Prix avantageux au pied carré.</p><div class="service-price">2,25 $ <small>/ pi2</small></div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/photo-ceramique-detail.jpg" alt="Nettoyage tuiles 401-800 pi2" class="service-card-img">
        <div class="service-card-body"><h3>401 - 800 pi2</h3><p>Pour les grandes surfaces résidentielles. Sous-sols, aires ouvertes et planchers complets.</p><div class="service-price">2,15 $ <small>/ pi2</small></div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/camion-usine-nettoyage-empire.webp" alt="Nettoyage tuiles 801+ pi2" class="service-card-img">
        <div class="service-card-body"><h3>801+ pi2</h3><p>Tarif préférentiel pour les grandes surfaces et les espaces commerciaux. Meilleur prix garanti.</p><div class="service-price">1,85 $ <small>/ pi2</small></div></div>
      </div>
    </div>
  </section>

  <section class="why-us fade-up">
    <div class="section-header"><h2>Pourquoi choisir Nettoyage Empire?</h2><p>Le standard le plus élevé en nettoyage professionnel</p></div>
    <div class="why-grid">
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg></div><h3>Équipement spécialisé</h3><p>Machines haute pression professionnelles pour un nettoyage en profondeur des coulis</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/></svg></div><h3>Produits écologiques</h3><p>Produits certifiés sécuritaires pour votre famille et vos animaux. Non-toxiques et biodégradables.</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><h3>Résultats garantis</h3><p>Satisfaction garantie à 100%. Si vous n'êtes pas satisfait, nous revenons gratuitement.</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><h3>Résultats immédiats</h3><p>Voyez la différence dès le premier passage. Coulis comme neufs, tuiles éclatantes.</p></div>
    </div>
  </section>

  <section class="form-section" id="soumission">
    <div class="form-container">
      <div class="section-header"><h2>Soumission gratuite</h2><p>Remplissez le formulaire et recevez votre estimation en moins de 2 heures</p></div>
      <form id="leadForm">
        <div class="form-row">
          <div class="form-group"><label for="prenom">Prénom *</label><input type="text" id="prenom" name="prenom" placeholder="Votre prénom" required></div>
          <div class="form-group"><label for="nom">Nom *</label><input type="text" id="nom" name="nom" placeholder="Votre nom" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="telephone">Téléphone *</label><input type="tel" id="telephone" name="telephone" placeholder="(514) 000-0000" required></div>
          <div class="form-group"><label for="email">Courriel</label><input type="email" id="email" name="email" placeholder="votre@courriel.com"></div>
        </div>
        <div class="form-group"><label for="adresse">Adresse du service *</label><input type="text" id="adresse" name="adresse" placeholder="123 rue Exemple, Montréal, QC" required></div>
        <div class="form-group">
          <label for="service">Pièce à nettoyer *</label>
          <select id="service" name="service" required>
            <option value="">Choisir un service...</option>
            <option value="cuisine">Cuisine</option>
            <option value="salle-de-bain">Salle de bain</option>
            <option value="sous-sol">Sous-sol</option>
            <option value="entree">Entrée</option>
            <option value="commercial">Commercial</option>
            <option value="autre">Autre</option>
          </select>
        </div>
        <div class="form-group"><label for="message">Détails supplémentaires</label><textarea id="message" name="message" rows="3" placeholder="Surface approximative en pieds carrés, type de tuiles, état des coulis..."></textarea></div>
        <button type="submit" class="form-submit">Obtenir ma soumission gratuite</button>
        <p class="form-note">Réponse en moins de 2 heures. Aucun engagement.</p>
      </form>
    </div>
  </section>

  <section class="testimonials fade-up">
    <div class="section-header"><h2>Ce que nos clients disent</h2><p>50+ avis 5 étoiles sur Google</p></div>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Quel service satisfaisant! Premier contact on recoit toutes les explications concernant nos besoins. Résultats spectaculaires sur notre céramique."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">S</div><div><p class="testimonial-name">Sonia Chanuc</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Service impeccable, travail efficace et produits exceptionnels."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">S</div><div><p class="testimonial-name">Simon Gauthier</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Very professional service and extremely well equipped! The technician was knowledgeable, explained exactly what we needed. Results are stunning."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">A</div><div><p class="testimonial-name">Alex Mavrikos</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
    </div>
  </section>

  <div class="landing-footer">
    <div class="footer-inner">
      <div class="footer-brand"><img src="/favicon.svg" alt="" class="footer-brand-icon"><span class="footer-brand-text">Nettoyage Empire</span></div>
      <p>&copy; 2026 Nettoyage Empire - L'Art du Nettoyage Haut de Gamme</p>
      <p>Montréal | Laval | Rive-Sud | West Island | <a href="tel:+14509774636">Appelez-nous</a></p>
    </div>
  </div>

  <div class="mobile-cta">
    <div class="mobile-cta-inner">
      <a href="tel:+14509774636" class="mobile-cta-call"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Appeler</a>
      <a href="#soumission" class="mobile-cta-quote"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Soumission gratuite</a>
    </div>
  </div>

  <script is:inline>
    document.getElementById('leadForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = e.target;
      var data = new FormData(form);
      var payload = Object.fromEntries(data.entries());
      var btn = form.querySelector('.form-submit');
      btn.textContent = 'Envoi en cours...';
      btn.style.background = '#2E7D32';
      btn.disabled = true;

      fetch('/.netlify/functions/promo-form-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: (payload.prenom + ' ' + payload.nom).trim(),
          phone: payload.telephone,
          email: payload.email || '',
          service: payload.service || 'tuiles',
          address: payload.adresse || '',
          message: payload.message || '',
          source: 'promo-tuiles'
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(result) {
        if (typeof fbq !== 'undefined') { fbq('track', 'Lead', { content_name: 'Nettoyage Tuiles', content_category: payload.service, city: 'Montréal' }); }
        if (typeof gtag !== 'undefined') { gtag('event', 'conversion', { send_to: 'AW-18054652665', value: 50.0, currency: 'CAD' }); }
        window.location.href = '/promo/merci';
      })
      .catch(function(err) {
        console.error('Erreur soumission:', err);
        btn.textContent = 'Erreur - Réessayer';
        btn.style.background = '#c62828';
        btn.disabled = false;
      });
    });
  </script>
</LandingLayout>