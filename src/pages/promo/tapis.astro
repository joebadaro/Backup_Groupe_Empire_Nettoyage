---
import LandingLayout from '../../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Nettoyage de Tapis Montréal - Soumission Gratuite | Nettoyage Empire"
  description="Nettoyage professionnel de tapis à la vapeur à Montréal. Résultats garantis, 30+ ans d'expérience. Soumission gratuite en 2 minutes."
  service="tapis"
>
  <nav class="navbar">
    <a href="/" class="navbar-brand"><img src="/favicon.svg" alt="" class="navbar-brand-icon"><span class="navbar-brand-text">Nettoyage<span class="brand-line2">Empire</span></span></a>
    <div class="navbar-right">
      <a href="tel:+14509774636" class="navbar-phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <span>(450) 977-4636</span>
      </a>
      <a href="#soumission" class="navbar-cta">Soumission gratuite</a>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-bg">
      <img src="/images/promo/hero-salon-prestige-tapis-residentiel-quebec.webp" alt="">
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Service #1 à Montréal
        </div>
        <h1>Nettoyage professionnel de <span class="accent">tapis et moquettes</span></h1>
        <p class="hero-desc">Nos techniciens certifiés redonnent vie à vos tapis avec un nettoyage vapeur haute pression. Équipement camion-usine. Résultats visibles immédiatement.</p>
        <div class="hero-btns">
          <a href="#soumission" class="btn-hero-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Soumission gratuite
          </a>
          <a href="tel:+14509774636" class="btn-hero-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Appelez-nous
          </a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="number">30+</span><span class="label">Ans d'expérience</span></div>
          <div class="hero-stat"><span class="number">10 000+</span><span class="label">Tapis nettoyés</span></div>
          <div class="hero-stat"><span class="number">4.9/5</span><span class="label">Avis Google</span></div>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/promo/carpet-synt-optimized.webp" alt="Nettoyage de tapis professionnel - Nettoyage Empire">
        <div class="hero-image-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Satisfaction garantie
        </div>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Techniciens certifiés
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        Produits non-toxiques
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        Équipement camion-usine
      </div>
      <div class="trust-item">
        <img src="/images/google-reviews-badge.png" alt="Google Reviews 4.9 étoiles">
      </div>
    </div>
  </div>

  <section class="services fade-up">
    <div class="section-header">
      <h2>Nos services de nettoyage de tapis</h2>
      <p>Tout type de tapis et moquette, à domicile avec équipement professionnel camion-usine</p>
    </div>
    <div class="service-grid">
      <div class="service-card">
        <img src="/images/service-tapis-mur.webp" alt="Nettoyage mur-à-mur" class="service-card-img">
        <div class="service-card-body">
          <h3>Mur-à-mur (moquette)</h3>
          <p>Nettoyage vapeur professionnel de votre moquette dans toutes les pièces. Forfait 3 pièces disponible.</p>
          <div class="service-price">195 $ <small>/ forfait 3 pièces</small></div>
        </div>
      </div>
      <div class="service-card">
        <img src="/images/promo/carpet-synt-optimized.webp" alt="Tapis synthétique" class="service-card-img">
        <div class="service-card-body">
          <h3>Tapis amovibles (synthétique)</h3>
          <p>Nettoyage en profondeur de vos carpettes et tapis d'area. Prix au pied carré.</p>
          <div class="service-price">1,85 $ <small>/ pi2</small></div>
        </div>
      </div>
      <div class="service-card">
        <img src="/images/promo/wool-steam-optimized.webp" alt="Tapis laine oriental" class="service-card-img">
        <div class="service-card-body">
          <h3>Tapis en laine / oriental</h3>
          <p>Traitement délicat pour vos tapis de laine, orientaux et haut de gamme. Soin spécialisé.</p>
          <div class="service-price">2,25 $ <small>/ pi2</small></div>
        </div>
      </div>
      <div class="service-card">
        <img src="/images/promo/camion-usine-nettoyage-empire.webp" alt="Nettoyage commercial" class="service-card-img">
        <div class="service-card-body">
          <h3>Nettoyage commercial</h3>
          <p>Service de nettoyage de moquette pour bureaux, commerces et espaces commerciaux. Soumission sur mesure.</p>
          <div class="service-price">Sur devis</div>
        </div>
      </div>
    </div>
  </section>

  <section class="why-us fade-up">
    <div class="section-header">
      <h2>Pourquoi choisir Nettoyage Empire?</h2>
      <p>Le standard le plus élevé en nettoyage professionnel</p>
    </div>
    <div class="why-grid">
      <div class="why-card">
        <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg></div>
        <h3>Équipement industriel</h3>
        <p>Machines professionnelles CLEANCO et HYDRO-FORCE montées sur camion pour un nettoyage en profondeur</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M7 10.5c0-.276.345-.5.771-.5h8.458c.426 0 .771.224.771.5s-.345.5-.771.5H7.771c-.426 0-.771-.224-.771-.5z"/><path d="M12 7v10"/></svg></div>
        <h3>Produits écologiques</h3>
        <p>Produits certifiés sécuritaires pour votre famille et vos animaux. Non-toxiques et biodégradables.</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <h3>Protection Scotchgard</h3>
        <p>Application de protection anti-taches incluse pour prolonger la propreté de vos tapis</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
        <h3>Résultats immédiats</h3>
        <p>Voyez la différence dès le premier passage. Satisfaction garantie à 100%.</p>
      </div>
    </div>
  </section>

  <section class="form-section" id="soumission">
    <div class="form-container">
      <div class="section-header">
        <h2>Soumission gratuite</h2>
        <p>Remplissez le formulaire et recevez votre estimation en moins de 2 heures</p>
      </div>
      <form id="leadForm">
        <div class="form-row">
          <div class="form-group"><label for="prenom">Prénom *</label><input type="text" id="prenom" name="prenom" placeholder="Votre prénom" required></div>
          <div class="form-group"><label for="nom">Nom *</label><input type="text" id="nom" name="nom" placeholder="Votre nom" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="telephone">Téléphone *</label><input type="tel" id="telephone" name="telephone" placeholder="(514) 000-0000" required></div>
          <div class="form-group"><label for="email">Courriel</label><input type="email" id="email" name="email" placeholder="votre@courriel.com"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="adresse">Adresse du service *</label><input type="text" id="adresse" name="adresse" placeholder="123 rue Exemple" required></div>
          <div class="form-group"><label for="ville">Ville *</label><input type="text" id="ville" name="ville" placeholder="Montréal" required></div>
        </div>
        <div class="form-group">
          <label for="service">Type de service *</label>
          <select id="service" name="service" required>
            <option value="">Choisir un service...</option>
            <option value="mur-a-mur">Moquette mur-à-mur</option>
            <option value="tapis-synthetique">Tapis amovible (synthétique)</option>
            <option value="tapis-laine">Tapis en laine / oriental</option>
            <option value="commercial">Nettoyage commercial</option>
            <option value="autre">Autre / Plusieurs services</option>
          </select>
        </div>
        <div class="form-group"><label for="message">Détails supplémentaires</label><textarea id="message" name="message" rows="3" placeholder="Nombre de pièces, dimensions des tapis, taches particulières..."></textarea></div>
        <button type="submit" class="form-submit">Obtenir ma soumission gratuite</button>
        <p class="form-note">Réponse en moins de 2 heures. Aucun engagement.</p>
      </form>
    </div>
  </section>

  <section class="testimonials fade-up">
    <div class="section-header">
      <h2>Ce que nos clients disent</h2>
      <p>50+ avis 5 étoiles sur Google</p>
    </div>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Absolutely blown away by the service! Joe was amazing, professional and super thorough. Our carpets seriously look brand new."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">P</div><div><p class="testimonial-name">Pak Fatemi</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Excellent service par Joe. Il a fait un excellent travail, rapide et courtois. Notre tapis et escalier n'ont jamais été aussi propres."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">M</div><div><p class="testimonial-name">Michel Lord</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"La chose principale à dire c'est WOW pour le nettoyage des tapis. Par le passé, notre syndicat avait fait appel à d'autres compagnies - rien de comparable."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">N</div><div><p class="testimonial-name">Normand Bray</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
    </div>
  </section>

  <div class="landing-footer">
    <div class="footer-inner">
      <div class="footer-brand"><img src="/favicon.svg" alt="" class="footer-brand-icon"><span class="footer-brand-text">Nettoyage Empire</span></div>
      <p>&copy; 2026 Nettoyage Empire - L'Art du Nettoyage Haut de Gamme</p>
      <p>Montréal | Laval | Rive-Sud | West Island | <a href="tel:+14509774636">Appelez-nous</a></p>
    </div>
  </div>

  <div class="mobile-cta">
    <div class="mobile-cta-inner">
      <a href="tel:+14509774636" class="mobile-cta-call">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        Appeler
      </a>
      <a href="#soumission" class="mobile-cta-quote">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Soumission gratuite
      </a>
    </div>
  </div>

  <script is:inline>
    document.getElementById('leadForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = e.target;
      var data = new FormData(form);
      var payload = Object.fromEntries(data.entries());
      var btn = form.querySelector('.form-submit');
      btn.textContent = 'Envoi en cours...';
      btn.style.background = '#2E7D32';
      btn.disabled = true;

      fetch('https://nettoyage-empire-api.onrender.com/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: payload.prenom,
          lastName: payload.nom,
          phone: payload.telephone,
          email: payload.email || '',
          address: payload.adresse || '',
          city: payload.ville || '',
          source: 'promo-tapis',
          extraTags: ['google_ads', 'google_ads_tapis'],
          message: payload.message || '',
          service: payload.service || 'tapis',
          customData: { cf_type_service: payload.service || 'tapis' }
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(result) {
        if (typeof fbq !== 'undefined') { fbq('track', 'Lead', { content_name: 'Nettoyage Tapis', content_category: payload.service, city: 'Montréal' }); }
        if (typeof gtag !== 'undefined') { gtag('event', 'conversion', { send_to: 'AW-17960384308/vw2FCIet2ZccELTulvRC', value: 50.0, currency: 'CAD' }); }
        window.location.href = '/promo/merci';
      })
      .catch(function(err) {
        console.error('Erreur soumission:', err);
        btn.textContent = 'Erreur - Réessayer';
        btn.style.background = '#c62828';
        btn.disabled = false;
      });
    });
  </script>
</LandingLayout>