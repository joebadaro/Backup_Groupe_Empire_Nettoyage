---
import LandingLayout from '../../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Nettoyage de Matelas Montréal - Soumission Gratuite | Nettoyage Empire"
  description="Nettoyage professionnel de matelas à Montréal. Élimine 99% des acariens. 30+ ans d'expérience. Soumission gratuite."
  service="matelas"
>
  <nav class="navbar">
    <a href="/" class="navbar-brand"><img src="/favicon.svg" alt="" class="navbar-brand-icon"><span class="navbar-brand-text">Nettoyage<span class="brand-line2">Empire</span></span></a>
    <div class="navbar-right">
      <a href="tel:+14509774636" class="navbar-phone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg><span>(450) 977-4636</span></a>
      <a href="#soumission" class="navbar-cta">Soumission gratuite</a>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-bg"><img src="/images/promo/kid-dog-matress-optimized.webp" alt=""></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Élimine 99% des acariens</div>
        <h1>Nettoyage professionnel de <span class="accent">matelas</span></h1>
        <p class="hero-desc">Nos experts éliminent acariens, taches, odeurs et allergènes de votre matelas avec un nettoyage vapeur en profondeur. Dormez sur un matelas sain et propre.</p>
        <div class="hero-btns">
          <a href="#soumission" class="btn-hero-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Soumission gratuite</a>
          <a href="tel:+14509774636" class="btn-hero-secondary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Appelez-nous</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="number">30+</span><span class="label">Ans d'expérience</span></div>
          <div class="hero-stat"><span class="number">5 000+</span><span class="label">Matelas nettoyés</span></div>
          <div class="hero-stat"><span class="number">4.9/5</span><span class="label">Avis Google</span></div>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/promo/hero-matelas-professionnel-quebec.webp" alt="Nettoyage de matelas professionnel - Nettoyage Empire">
        <div class="hero-image-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Élimine 99% des acariens</div>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Techniciens certifiés</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg> Produits non-toxiques</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg> Santé et hygiène</div>
      <div class="trust-item"><img src="/images/google-reviews-badge.png" alt="Google Reviews 4.9 étoiles"></div>
    </div>
  </div>

  <section class="services fade-up">
    <div class="section-header"><h2>Nos tarifs de nettoyage de matelas</h2><p>Toutes les tailles - 30% de rabais sur matelas additionnels</p></div>
    <div class="service-grid">
      <div class="service-card">
        <img src="/images/service-matelas.webp" alt="Nettoyage matelas simple" class="service-card-img">
        <div class="service-card-body"><h3>Matelas Simple</h3><p>Nettoyage complet de votre matelas simple. Extraction vapeur, désinfection et élimination des acariens.</p><div class="service-price">99 $</div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/teck-empire-matress-optimized.webp" alt="Nettoyage matelas double" class="service-card-img">
        <div class="service-card-body"><h3>Matelas Double</h3><p>Nettoyage en profondeur de votre matelas double. Élimination des taches, odeurs et allergènes.</p><div class="service-price">129 $</div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/woman-matress-optimized.webp" alt="Nettoyage matelas queen" class="service-card-img">
        <div class="service-card-body"><h3>Matelas Queen</h3><p>Traitement professionnel de votre matelas Queen. Nettoyage vapeur et désinfection complète.</p><div class="service-price">149 $</div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/kid-dog-matress-optimized.webp" alt="Nettoyage matelas king" class="service-card-img">
        <div class="service-card-body"><h3>Matelas King</h3><p>Nettoyage complet de votre matelas King. Service premium pour votre confort et votre santé.</p><div class="service-price">179 $</div></div>
      </div>
    </div>
  </section>

  <section class="why-us fade-up">
    <div class="section-header"><h2>Pourquoi choisir Nettoyage Empire?</h2><p>Le standard le plus élevé en nettoyage professionnel</p></div>
    <div class="why-grid">
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></div><h3>Élimine les acariens</h3><p>Notre traitement vapeur haute température élimine 99% des acariens et bactéries</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><h3>Réduit les allergènes</h3><p>Idéal pour les personnes souffrant d'allergies, d'asthme ou de problèmes respiratoires</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div><h3>Hygiène et santé</h3><p>Élimination complète des odeurs de transpiration, d'urine et de moisissure. Matelas sain et frais.</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><h3>Séchage rapide</h3><p>Technique d'extraction qui permet un séchage en quelques heures seulement. Dormez le soir même.</p></div>
    </div>
  </section>

  <section class="form-section" id="soumission">
    <div class="form-container">
      <div class="section-header"><h2>Soumission gratuite</h2><p>Remplissez le formulaire et recevez votre estimation en moins de 2 heures</p></div>
      <form id="leadForm">
        <div class="form-row">
          <div class="form-group"><label for="prenom">Prénom *</label><input type="text" id="prenom" name="prenom" placeholder="Votre prénom" required></div>
          <div class="form-group"><label for="nom">Nom *</label><input type="text" id="nom" name="nom" placeholder="Votre nom" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="telephone">Téléphone *</label><input type="tel" id="telephone" name="telephone" placeholder="(514) 000-0000" required></div>
          <div class="form-group"><label for="email">Courriel</label><input type="email" id="email" name="email" placeholder="votre@courriel.com"></div>
        </div>
        <div class="form-group"><label for="adresse">Adresse du service *</label><input type="text" id="adresse" name="adresse" placeholder="123 rue Exemple, Montréal, QC" required></div>
        <div class="form-group">
          <label for="service">Taille du matelas *</label>
          <select id="service" name="service" required>
            <option value="">Choisir un service...</option>
            <option value="simple">Simple</option>
            <option value="double">Double</option>
            <option value="queen">Queen</option>
            <option value="king">King</option>
            <option value="plusieurs">Plusieurs matelas</option>
          </select>
        </div>
        <div class="form-group"><label for="message">Détails supplémentaires</label><textarea id="message" name="message" rows="3" placeholder="Nombre de matelas, type de taches, allergies particulières..."></textarea></div>
        <button type="submit" class="form-submit">Obtenir ma soumission gratuite</button>
        <p class="form-note">Réponse en moins de 2 heures. Aucun engagement.</p>
      </form>
    </div>
  </section>

  <section class="testimonials fade-up">
    <div class="section-header"><h2>Ce que nos clients disent</h2><p>50+ avis 5 étoiles sur Google</p></div>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Super travail! Je suis plus que satisfaite! Je vous le recommande fortement."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">G</div><div><p class="testimonial-name">Ginette Choquette</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Une super expérience de l'appel pour la prise d'information au service rendu. Joe est très compétent et professionnel."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">N</div><div><p class="testimonial-name">Nathalie Goudreau</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Amazing service and results! Twelve year old sofa looks like new; many stains all gone. Would recommend to anyone."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">L</div><div><p class="testimonial-name">Louiselle Rousseau</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
    </div>
  </section>

  <div class="landing-footer">
    <div class="footer-inner">
      <div class="footer-brand"><img src="/favicon.svg" alt="" class="footer-brand-icon"><span class="footer-brand-text">Nettoyage Empire</span></div>
      <p>&copy; 2026 Nettoyage Empire - L'Art du Nettoyage Haut de Gamme</p>
      <p>Montréal | Laval | Rive-Sud | West Island | <a href="tel:+14509774636">Appelez-nous</a></p>
    </div>
  </div>

  <div class="mobile-cta">
    <div class="mobile-cta-inner">
      <a href="tel:+14509774636" class="mobile-cta-call"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Appeler</a>
      <a href="#soumission" class="mobile-cta-quote"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Soumission gratuite</a>
    </div>
  </div>

  <script is:inline>
    document.getElementById('leadForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = e.target;
      var data = new FormData(form);
      var payload = Object.fromEntries(data.entries());
      var btn = form.querySelector('.form-submit');
      btn.textContent = 'Envoi en cours...';
      btn.style.background = '#2E7D32';
      btn.disabled = true;

      fetch('/.netlify/functions/promo-form-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: (payload.prenom + ' ' + payload.nom).trim(),
          phone: payload.telephone,
          email: payload.email || '',
          service: payload.service || 'matelas',
          address: payload.adresse || '',
          message: payload.message || '',
          source: 'promo-matelas'
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(result) {
        if (typeof fbq !== 'undefined') { fbq('track', 'Lead', { content_name: 'Nettoyage Matelas', content_category: payload.service, city: 'Montréal' }); }
        if (typeof gtag !== 'undefined') { gtag('event', 'conversion', { send_to: 'AW-18054652665', value: 50.0, currency: 'CAD' }); }
        window.location.href = '/promo/merci';
      })
      .catch(function(err) {
        console.error('Erreur soumission:', err);
        btn.textContent = 'Erreur - Réessayer';
        btn.style.background = '#c62828';
        btn.disabled = false;
      });
    });
  </script>
</LandingLayout>