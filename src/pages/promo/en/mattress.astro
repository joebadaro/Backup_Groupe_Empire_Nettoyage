---
import LandingLayout from '../../../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Professional Mattress Cleaning Montreal - Free Quote | Nettoyage Empire"
  description="Professional mattress cleaning in Montreal. Eliminates 99% of dust mites. 30+ years of experience. Free quote."
  service="mattress"
>
  <nav class="navbar">
    <a href="/" class="navbar-brand"><img src="/favicon.svg" alt="" class="navbar-brand-icon"><span class="navbar-brand-text">Nettoyage<span class="brand-line2">Empire</span></span></a>
    <div class="navbar-right">
      <a href="tel:+14509774636" class="navbar-phone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg><span>(450) 977-4636</span></a>
      <a href="#quote" class="navbar-cta">Free Quote</a>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-bg"><img src="/images/promo/kid-dog-matress-optimized.webp" alt=""></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Eliminates 99% of Dust Mites</div>
        <h1>Professional <span class="accent">mattress</span> cleaning</h1>
        <p class="hero-desc">Our experts eliminate dust mites, stains, odors and allergens from your mattress with deep steam cleaning. Sleep on a clean and healthy mattress.</p>
        <div class="hero-btns">
          <a href="#quote" class="btn-hero-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Free Quote</a>
          <a href="tel:+14509774636" class="btn-hero-secondary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Call Us</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="number">30+</span><span class="label">Years of Experience</span></div>
          <div class="hero-stat"><span class="number">5,000+</span><span class="label">Mattresses Cleaned</span></div>
          <div class="hero-stat"><span class="number">4.9/5</span><span class="label">Google Reviews</span></div>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/promo/hero-matelas-professionnel-quebec.webp" alt="Professional mattress cleaning - Nettoyage Empire">
        <div class="hero-image-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Eliminates 99% of Dust Mites</div>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Certified Technicians</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg> Non-Toxic Products</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg> Health & Hygiene</div>
      <div class="trust-item"><img src="/images/google-reviews-badge.png" alt="Google Reviews 4.9 stars"></div>
    </div>
  </div>

  <section class="services fade-up">
    <div class="section-header"><h2>Our Mattress Cleaning Rates</h2><p>All sizes - 30% off additional mattresses</p></div>
    <div class="service-grid">
      <div class="service-card">
        <img src="/images/service-matelas.webp" alt="Twin mattress cleaning" class="service-card-img">
        <div class="service-card-body"><h3>Twin Mattress</h3><p>Complete cleaning of your twin mattress. Steam extraction, disinfection and dust mite elimination.</p><div class="service-price">$99</div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/teck-empire-matress-optimized.webp" alt="Double mattress cleaning" class="service-card-img">
        <div class="service-card-body"><h3>Double Mattress</h3><p>Deep cleaning of your double mattress. Elimination of stains, odors and allergens.</p><div class="service-price">$129</div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/woman-matress-optimized.webp" alt="Queen mattress cleaning" class="service-card-img">
        <div class="service-card-body"><h3>Queen Mattress</h3><p>Professional treatment of your Queen mattress. Steam cleaning and complete disinfection.</p><div class="service-price">$149</div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/kid-dog-matress-optimized.webp" alt="King mattress cleaning" class="service-card-img">
        <div class="service-card-body"><h3>King Mattress</h3><p>Complete cleaning of your King mattress. Premium service for your comfort and health.</p><div class="service-price">$179</div></div>
      </div>
    </div>
  </section>

  <section class="why-us fade-up">
    <div class="section-header"><h2>Why Choose Nettoyage Empire?</h2><p>The highest standard in professional cleaning</p></div>
    <div class="why-grid">
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></div><h3>Eliminates Dust Mites</h3><p>Our high-temperature steam treatment eliminates 99% of dust mites and bacteria</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><h3>Reduces Allergens</h3><p>Ideal for people suffering from allergies, asthma or respiratory issues</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div><h3>Health & Hygiene</h3><p>Complete elimination of perspiration, urine and mold odors. Clean and fresh mattress.</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><h3>Quick Drying</h3><p>Extraction technique allows drying in just a few hours. Sleep the same night.</p></div>
    </div>
  </section>

  <section class="form-section" id="quote">
    <div class="form-container">
      <div class="section-header"><h2>Free Quote</h2><p>Fill out the form and receive your estimate in less than 2 hours</p></div>
      <form id="leadForm">
        <div class="form-row">
          <div class="form-group"><label for="prenom">First Name *</label><input type="text" id="prenom" name="prenom" placeholder="Your first name" required></div>
          <div class="form-group"><label for="nom">Last Name *</label><input type="text" id="nom" name="nom" placeholder="Your last name" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="telephone">Phone *</label><input type="tel" id="telephone" name="telephone" placeholder="(514) 000-0000" required></div>
          <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" placeholder="your@email.com"></div>
        </div>
        <div class="form-group"><label for="adresse">Service Address *</label><input type="text" id="adresse" name="adresse" placeholder="123 Example St, Montreal, QC" required></div>
        <div class="form-group">
          <label for="service">Mattress Size *</label>
          <select id="service" name="service" required>
            <option value="">Choose a service...</option>
            <option value="twin">Twin</option>
            <option value="double">Double</option>
            <option value="queen">Queen</option>
            <option value="king">King</option>
            <option value="multiple">Multiple Mattresses</option>
          </select>
        </div>
        <div class="form-group"><label for="message">Additional Details</label><textarea id="message" name="message" rows="3" placeholder="Number of mattresses, type of stains, specific allergies..."></textarea></div>
        <button type="submit" class="form-submit">Get My Free Quote</button>
        <p class="form-note">Response in less than 2 hours. No commitment.</p>
      </form>
    </div>
  </section>

  <section class="testimonials fade-up">
    <div class="section-header"><h2>What Our Clients Say</h2><p>50+ five-star reviews on Google</p></div>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Great work! I am more than satisfied! I highly recommend them."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">G</div><div><p class="testimonial-name">Ginette Choquette</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"A great experience from the information call to the service rendered. Joe is very competent and professional."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">N</div><div><p class="testimonial-name">Nathalie Goudreau</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Amazing service and results! Twelve year old sofa looks like new; many stains all gone. Would recommend to anyone."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">L</div><div><p class="testimonial-name">Louiselle Rousseau</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
    </div>
  </section>

  <div class="landing-footer">
    <div class="footer-inner">
      <div class="footer-brand"><img src="/favicon.svg" alt="" class="footer-brand-icon"><span class="footer-brand-text">Nettoyage Empire</span></div>
      <p>&copy; 2026 Nettoyage Empire - The Art of Premium Cleaning</p>
      <p>Montreal | Laval | South Shore | West Island | <a href="tel:+14509774636">Call Us</a></p>
    </div>
  </div>

  <div class="mobile-cta">
    <div class="mobile-cta-inner">
      <a href="tel:+14509774636" class="mobile-cta-call"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Call</a>
      <a href="#quote" class="mobile-cta-quote"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Free Quote</a>
    </div>
  </div>

  <script is:inline>
    document.getElementById('leadForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = e.target;
      var data = new FormData(form);
      var payload = Object.fromEntries(data.entries());
      var btn = form.querySelector('.form-submit');
      btn.textContent = 'Sending...';
      btn.style.background = '#2E7D32';
      btn.disabled = true;

      fetch('https://nettoyage-empire-api.onrender.com/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: payload.prenom,
          lastName: payload.nom,
          phone: payload.telephone,
          email: payload.email || '',
          address: payload.adresse || '',
          source: 'promo-matelas',
          message: payload.message || '',
          service: payload.service || 'matelas',
          lang: 'en'
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(result) {
        if (typeof fbq !== 'undefined') { fbq('track', 'Lead', { content_name: 'Mattress Cleaning', content_category: payload.service, city: 'Montreal' }); }
        if (typeof gtag !== 'undefined') { gtag('event', 'conversion', { send_to: 'AW-18054652665', value: 50.0, currency: 'CAD' }); }
        window.location.href = '/promo/en/thank-you';
      })
      .catch(function(err) {
        console.error('Submit error:', err);
        btn.textContent = 'Error - Retry';
        btn.style.background = '#c62828';
        btn.disabled = false;
      });
    });
  </script>
</LandingLayout>