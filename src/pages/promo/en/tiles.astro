---
import LandingLayout from '../../../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Professional Tile & Grout Cleaning Montreal - Free Quote | Nettoyage Empire"
  description="Professional tile and grout cleaning in Montreal. Spectacular results guaranteed. 30+ years of experience. Free quote."
  service="tiles"
>
  <nav class="navbar">
    <a href="/" class="navbar-brand"><img src="/favicon.svg" alt="" class="navbar-brand-icon"><span class="navbar-brand-text">Nettoyage<span class="brand-line2">Empire</span></span></a>
    <div class="navbar-right">
      <a href="tel:+14509774636" class="navbar-phone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg><span>(450) 977-4636</span></a>
      <a href="#quote" class="navbar-cta">Free Quote</a>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-bg"><img src="/images/promo/tuile-before-after-v3.webp" alt=""></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Guaranteed Results</div>
        <h1>Professional <span class="accent">tile and grout</span> cleaning</h1>
        <p class="hero-desc">Our experts restore the shine to your tile floors and grout with professional high-pressure cleaning. Spectacular results guaranteed.</p>
        <div class="hero-btns">
          <a href="#quote" class="btn-hero-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Free Quote</a>
          <a href="tel:+14509774636" class="btn-hero-secondary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Call Us</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="number">30+</span><span class="label">Years of Experience</span></div>
          <div class="hero-stat"><span class="number">50,000+</span><span class="label">Sq Ft of Tiles Cleaned</span></div>
          <div class="hero-stat"><span class="number">4.9/5</span><span class="label">Google Reviews</span></div>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/promo/tuile-hero-principal.webp" alt="Professional tile and grout cleaning - Nettoyage Empire">
        <div class="hero-image-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Guaranteed Results</div>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Certified Technicians</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg> Non-Toxic Products</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> High-Pressure Equipment</div>
      <div class="trust-item"><img src="/images/google-reviews-badge.png" alt="Google Reviews 4.9 stars"></div>
    </div>
  </div>

  <section class="services fade-up">
    <div class="section-header"><h2>Our Tile Cleaning Rates</h2><p>Degressive pricing per square foot - Minimum 150 sq ft</p></div>
    <div class="service-grid">
      <div class="service-card">
        <img src="/images/service-ceramique.webp" alt="Tile cleaning 0-200 sq ft" class="service-card-img">
        <div class="service-card-body"><h3>0 - 200 sq ft</h3><p>Ideal for bathrooms, entryways and small surfaces.</p><div class="service-price">$2.35 <small>/ sq ft</small></div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/tuile-before-after-v3.webp" alt="Tile cleaning 201-400 sq ft" class="service-card-img">
        <div class="service-card-body"><h3>201 - 400 sq ft</h3><p>Perfect for medium-sized kitchens and bathrooms.</p><div class="service-price">$2.25 <small>/ sq ft</small></div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/photo-ceramique-detail.jpg" alt="Tile cleaning 401-800 sq ft" class="service-card-img">
        <div class="service-card-body"><h3>401 - 800 sq ft</h3><p>For large residential surfaces. Basements, open areas and full floors.</p><div class="service-price">$2.15 <small>/ sq ft</small></div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/camion-usine-nettoyage-empire.webp" alt="Tile cleaning 801+ sq ft" class="service-card-img">
        <div class="service-card-body"><h3>801+ sq ft</h3><p>Preferred rate for large surfaces and commercial spaces. Best price guaranteed.</p><div class="service-price">$1.85 <small>/ sq ft</small></div></div>
      </div>
    </div>
  </section>

  <section class="why-us fade-up">
    <div class="section-header"><h2>Why Choose Nettoyage Empire?</h2><p>The highest standard in professional cleaning</p></div>
    <div class="why-grid">
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg></div><h3>Specialized Equipment</h3><p>Professional high-pressure machines for deep grout cleaning</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/></svg></div><h3>Eco-Friendly Products</h3><p>Certified products safe for your family and pets. Non-toxic and biodegradable.</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><h3>Guaranteed Results</h3><p>100% satisfaction guaranteed. If you are not satisfied, we come back for free.</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><h3>Immediate Results</h3><p>See the difference from the very first pass. Grout like new, sparkling tiles.</p></div>
    </div>
  </section>

  <section class="form-section" id="quote">
    <div class="form-container">
      <div class="section-header"><h2>Free Quote</h2><p>Fill out the form and receive your estimate in less than 2 hours</p></div>
      <form id="leadForm">
        <div class="form-row">
          <div class="form-group"><label for="prenom">First Name *</label><input type="text" id="prenom" name="prenom" placeholder="Your first name" required></div>
          <div class="form-group"><label for="nom">Last Name *</label><input type="text" id="nom" name="nom" placeholder="Your last name" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="telephone">Phone *</label><input type="tel" id="telephone" name="telephone" placeholder="(514) 000-0000" required></div>
          <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" placeholder="your@email.com"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="adresse">Service Address *</label><input type="text" id="adresse" name="adresse" placeholder="123 Example St" required></div>
          <div class="form-group"><label for="ville">City *</label><input type="text" id="ville" name="ville" placeholder="Montreal" required></div>
        </div>
        <div class="form-group">
          <label for="service">Room to Clean *</label>
          <select id="service" name="service" required>
            <option value="">Choose a service...</option>
            <option value="kitchen">Kitchen</option>
            <option value="bathroom">Bathroom</option>
            <option value="basement">Basement</option>
            <option value="entryway">Entryway</option>
            <option value="commercial">Commercial</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-group"><label for="message">Additional Details</label><textarea id="message" name="message" rows="3" placeholder="Approximate area in square feet, type of tiles, grout condition..."></textarea></div>
        <button type="submit" class="form-submit">Get My Free Quote</button>
        <p class="form-note">Response in less than 2 hours. No commitment.</p>
      </form>
    </div>
  </section>

  <section class="testimonials fade-up">
    <div class="section-header"><h2>What Our Clients Say</h2><p>50+ five-star reviews on Google</p></div>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"What a satisfying service! From the first contact we received all the explanations about our needs. Spectacular results on our ceramic."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">S</div><div><p class="testimonial-name">Sonia Chanuc</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Impeccable service, efficient work and exceptional products."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">S</div><div><p class="testimonial-name">Simon Gauthier</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Very professional service and extremely well equipped! The technician was knowledgeable, explained exactly what we needed. Results are stunning."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">A</div><div><p class="testimonial-name">Alex Mavrikos</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
    </div>
  </section>

  <div class="landing-footer">
    <div class="footer-inner">
      <div class="footer-brand"><img src="/favicon.svg" alt="" class="footer-brand-icon"><span class="footer-brand-text">Nettoyage Empire</span></div>
      <p>&copy; 2026 Nettoyage Empire - The Art of Premium Cleaning</p>
      <p>Montreal | Laval | South Shore | West Island | <a href="tel:+14509774636">Call Us</a></p>
    </div>
  </div>

  <div class="mobile-cta">
    <div class="mobile-cta-inner">
      <a href="tel:+14509774636" class="mobile-cta-call"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Call</a>
      <a href="#quote" class="mobile-cta-quote"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Free Quote</a>
    </div>
  </div>

  <script is:inline>
    document.getElementById('leadForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = e.target;
      var data = new FormData(form);
      var payload = Object.fromEntries(data.entries());
      var btn = form.querySelector('.form-submit');
      btn.textContent = 'Sending...';
      btn.style.background = '#2E7D32';
      btn.disabled = true;

      fetch('https://nettoyage-empire-api.onrender.com/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: payload.prenom,
          lastName: payload.nom,
          phone: payload.telephone,
          email: payload.email || '',
          address: payload.adresse || '',
          city: payload.ville || '',
          source: 'promo-tuiles',
          extraTags: ['google_ads', 'google_ads_tuiles'],
          message: payload.message || '',
          service: payload.service || 'tuiles',
          lang: 'en',
          customData: { cf_type_service: payload.service || 'tuiles' }
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(result) {
        if (typeof fbq !== 'undefined') { fbq('track', 'Lead', { content_name: 'Tile Cleaning', content_category: payload.service, city: 'Montreal' }); }
        if (typeof gtag !== 'undefined') { gtag('event', 'conversion', { send_to: 'AW-17960384308/vw2FCIet2ZccELTulvRC', value: 50.0, currency: 'CAD' }); }
        window.location.href = '/promo/en/thank-you';
      })
      .catch(function(err) {
        console.error('Submit error:', err);
        btn.textContent = 'Error - Retry';
        btn.style.background = '#c62828';
        btn.disabled = false;
      });
    });
  </script>
</LandingLayout>