---
import LandingLayout from '../../../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Professional Carpet Cleaning Montreal - Free Quote | Nettoyage Empire"
  description="Professional steam carpet cleaning in Montreal. Guaranteed results, 30+ years of experience. Free quote in 2 minutes."
  service="carpets"
>
  <nav class="navbar">
    <a href="/" class="navbar-brand"><img src="/favicon.svg" alt="" class="navbar-brand-icon"><span class="navbar-brand-text">Nettoyage<span class="brand-line2">Empire</span></span></a>
    <div class="navbar-right">
      <a href="tel:+14509774636" class="navbar-phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <span>(450) 977-4636</span>
      </a>
      <a href="#quote" class="navbar-cta">Free Quote</a>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-bg"><img src="/images/promo/hero-salon-prestige-tapis-residentiel-quebec.webp" alt=""></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          #1 Carpet Cleaning in Montreal
        </div>
        <h1>Professional <span class="accent">carpet and rug</span> cleaning</h1>
        <p class="hero-desc">Our certified technicians bring your carpets back to life with high-pressure steam cleaning. Truck-mounted equipment. Visible results immediately.</p>
        <div class="hero-btns">
          <a href="#quote" class="btn-hero-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Free Quote
          </a>
          <a href="tel:+14509774636" class="btn-hero-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Call Us
          </a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="number">30+</span><span class="label">Years of Experience</span></div>
          <div class="hero-stat"><span class="number">10,000+</span><span class="label">Carpets Cleaned</span></div>
          <div class="hero-stat"><span class="number">4.9/5</span><span class="label">Google Reviews</span></div>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/promo/carpet-synt-optimized.webp" alt="Professional carpet cleaning - Nettoyage Empire">
        <div class="hero-image-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Satisfaction Guaranteed
        </div>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Certified Technicians
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        Non-Toxic Products
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        Truck-Mounted Equipment
      </div>
      <div class="trust-item">
        <img src="/images/google-reviews-badge.png" alt="Google Reviews 4.9 stars">
      </div>
    </div>
  </div>

  <section class="services fade-up">
    <div class="section-header">
      <h2>Our Carpet Cleaning Services</h2>
      <p>All types of carpets and rugs, on-site with professional truck-mounted equipment</p>
    </div>
    <div class="service-grid">
      <div class="service-card">
        <img src="/images/service-tapis-mur.webp" alt="Wall-to-wall carpet cleaning" class="service-card-img">
        <div class="service-card-body">
          <h3>Wall-to-Wall Carpet</h3>
          <p>Professional steam cleaning of your wall-to-wall carpet in every room. 3-room package available.</p>
          <div class="service-price">$195 <small>/ 3-room package</small></div>
        </div>
      </div>
      <div class="service-card">
        <img src="/images/promo/carpet-synt-optimized.webp" alt="Area rug cleaning" class="service-card-img">
        <div class="service-card-body">
          <h3>Area Rugs (Synthetic)</h3>
          <p>Deep cleaning for your area rugs and runners. Priced per square foot.</p>
          <div class="service-price">$1.85 <small>/ sq ft</small></div>
        </div>
      </div>
      <div class="service-card">
        <img src="/images/promo/wool-steam-optimized.webp" alt="Wool and oriental rug cleaning" class="service-card-img">
        <div class="service-card-body">
          <h3>Wool / Oriental Rugs</h3>
          <p>Delicate treatment for your wool, oriental and high-end rugs. Specialized care.</p>
          <div class="service-price">$2.25 <small>/ sq ft</small></div>
        </div>
      </div>
      <div class="service-card">
        <img src="/images/promo/camion-usine-nettoyage-empire.webp" alt="Commercial carpet cleaning" class="service-card-img">
        <div class="service-card-body">
          <h3>Commercial Cleaning</h3>
          <p>Carpet cleaning service for offices, businesses and commercial spaces. Custom quote.</p>
          <div class="service-price">Custom Quote</div>
        </div>
      </div>
    </div>
  </section>

  <section class="why-us fade-up">
    <div class="section-header">
      <h2>Why Choose Nettoyage Empire?</h2>
      <p>The highest standard in professional cleaning</p>
    </div>
    <div class="why-grid">
      <div class="why-card">
        <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg></div>
        <h3>Industrial Equipment</h3>
        <p>Professional CLEANCO and HYDRO-FORCE truck-mounted machines for deep cleaning</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M7 10.5c0-.276.345-.5.771-.5h8.458c.426 0 .771.224.771.5s-.345.5-.771.5H7.771c-.426 0-.771-.224-.771-.5z"/><path d="M12 7v10"/></svg></div>
        <h3>Eco-Friendly Products</h3>
        <p>Certified products safe for your family and pets. Non-toxic and biodegradable.</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <h3>Scotchgard Protection</h3>
        <p>Stain protection included to keep your carpets cleaner longer</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
        <h3>Immediate Results</h3>
        <p>See the difference from the very first pass. 100% satisfaction guaranteed.</p>
      </div>
    </div>
  </section>

  <section class="form-section" id="quote">
    <div class="form-container">
      <div class="section-header">
        <h2>Free Quote</h2>
        <p>Fill out the form and receive your estimate in under 2 hours</p>
      </div>
      <form id="leadForm">
        <div class="form-row">
          <div class="form-group"><label for="prenom">First Name *</label><input type="text" id="prenom" name="prenom" placeholder="Your first name" required></div>
          <div class="form-group"><label for="nom">Last Name *</label><input type="text" id="nom" name="nom" placeholder="Your last name" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="telephone">Phone *</label><input type="tel" id="telephone" name="telephone" placeholder="(514) 000-0000" required></div>
          <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" placeholder="your@email.com"></div>
        </div>
        <div class="form-group"><label for="adresse">Service Address *</label><input type="text" id="adresse" name="adresse" placeholder="123 Example St, Montreal, QC" required></div>
        <div class="form-group">
          <label for="service">Service Type *</label>
          <select id="service" name="service" required>
            <option value="">Choose a service...</option>
            <option value="wall-to-wall">Wall-to-Wall Carpet</option>
            <option value="area-rug-synthetic">Area Rug (Synthetic)</option>
            <option value="wool-oriental">Wool / Oriental Rug</option>
            <option value="commercial">Commercial Cleaning</option>
            <option value="other">Other / Multiple Services</option>
          </select>
        </div>
        <div class="form-group"><label for="message">Additional Details</label><textarea id="message" name="message" rows="3" placeholder="Number of rooms, rug dimensions, specific stains..."></textarea></div>
        <button type="submit" class="form-submit">Get My Free Quote</button>
        <p class="form-note">Response in under 2 hours. No obligation.</p>
      </form>
    </div>
  </section>

  <section class="testimonials fade-up">
    <div class="section-header">
      <h2>What Our Clients Say</h2>
      <p>50+ five-star reviews on Google</p>
    </div>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Absolutely blown away by the service! Joe was amazing, professional and super thorough. Our carpets seriously look brand new."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">P</div><div><p class="testimonial-name">Pak Fatemi</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Excellent service by Joe. He did an outstanding job, fast and courteous. Our carpet and stairs have never been this clean."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">M</div><div><p class="testimonial-name">Michel Lord</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"The main thing to say is WOW for the carpet cleaning. In the past, our condo association had used other companies - nothing compares."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">N</div><div><p class="testimonial-name">Normand Bray</p><p class="testimonial-location">Google Review</p></div></div>
      </div>
    </div>
  </section>

  <div class="landing-footer">
    <div class="footer-inner">
      <div class="footer-brand"><img src="/favicon.svg" alt="" class="footer-brand-icon"><span class="footer-brand-text">Nettoyage Empire</span></div>
      <p>&copy; 2026 Nettoyage Empire - The Art of Premium Cleaning</p>
      <p>Montreal | Laval | South Shore | West Island | <a href="tel:+14509774636">Call Us</a></p>
    </div>
  </div>

  <div class="mobile-cta">
    <div class="mobile-cta-inner">
      <a href="tel:+14509774636" class="mobile-cta-call">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        Call
      </a>
      <a href="#quote" class="mobile-cta-quote">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Free Quote
      </a>
    </div>
  </div>

  <script is:inline>
    document.getElementById('leadForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = e.target;
      var data = new FormData(form);
      var payload = Object.fromEntries(data.entries());
      var btn = form.querySelector('.form-submit');
      btn.textContent = 'Sending...';
      btn.style.background = '#2E7D32';
      btn.disabled = true;

      fetch('https://nettoyage-empire-api.onrender.com/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: payload.prenom,
          lastName: payload.nom,
          phone: payload.telephone,
          email: payload.email || '',
          address: payload.adresse || '',
          source: 'promo-tapis',
          message: payload.message || '',
          service: payload.service || 'tapis',
          lang: 'en'
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(result) {
        if (typeof fbq !== 'undefined') { fbq('track', 'Lead', { content_name: 'Carpet Cleaning', content_category: payload.service, city: 'Montreal' }); }
        if (typeof gtag !== 'undefined') { gtag('event', 'conversion', { send_to: 'AW-18054652665', value: 50.0, currency: 'CAD' }); }
        window.location.href = '/promo/en/thank-you';
      })
      .catch(function(err) {
        console.error('Submit error:', err);
        btn.textContent = 'Error - Retry';
        btn.style.background = '#c62828';
        btn.disabled = false;
      });
    });
  </script>
</LandingLayout>
