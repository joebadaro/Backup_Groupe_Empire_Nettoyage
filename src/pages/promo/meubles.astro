---
import LandingLayout from '../../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Nettoyage de Meubles et Sofas Montréal - Soumission Gratuite | Nettoyage Empire"
  description="Nettoyage professionnel de meubles et sofas à Montréal. Protection Scotchgard incluse. 30+ ans d'expérience. Soumission gratuite."
  service="meubles"
>
  <nav class="navbar">
    <a href="/" class="navbar-brand"><img src="/favicon.svg" alt="" class="navbar-brand-icon"><span class="navbar-brand-text">Nettoyage<span class="brand-line2">Empire</span></span></a>
    <div class="navbar-right">
      <a href="tel:+15148939939" class="navbar-phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <span>(514) 893-9939</span>
      </a>
      <a href="#soumission" class="navbar-cta">Soumission gratuite</a>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-bg"><img src="/images/promo/sofa-hero-1.webp" alt=""></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Protection Scotchgard incluse</div>
        <h1>Nettoyage professionnel de <span class="accent">meubles et sofas</span></h1>
        <p class="hero-desc">Nos experts redonnent l'éclat à vos meubles rembourrés avec un nettoyage vapeur en profondeur. Protection Scotchgard incluse avec chaque service.</p>
        <div class="hero-btns">
          <a href="#soumission" class="btn-hero-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Soumission gratuite</a>
          <a href="tel:+15148939939" class="btn-hero-secondary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Appelez-nous</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="number">30+</span><span class="label">Ans d'expérience</span></div>
          <div class="hero-stat"><span class="number">3 000+</span><span class="label">Meubles nettoyés</span></div>
          <div class="hero-stat"><span class="number">4.9/5</span><span class="label">Avis Google</span></div>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/promo/nettoyage-fauteuil-professionnel.webp" alt="Nettoyage de meubles professionnel - Nettoyage Empire">
        <div class="hero-image-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Satisfaction garantie</div>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Protection Scotchgard incluse</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg> Produits non-toxiques</div>
      <div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg> Équipement professionnel</div>
      <div class="trust-item"><img src="/images/google-reviews-badge.png" alt="Google Reviews 4.9 étoiles"></div>
    </div>
  </div>

  <section class="services fade-up">
    <div class="section-header">
      <h2>Nos services de nettoyage de meubles</h2>
      <p>Tous types de meubles rembourrés - 25% de rabais sur items additionnels</p>
    </div>
    <div class="service-grid">
      <div class="service-card">
        <img src="/images/promo/nettoyage-fauteuil-professionnel.webp" alt="Nettoyage fauteuil 1 place" class="service-card-img">
        <div class="service-card-body"><h3>Fauteuil 1 place</h3><p>Nettoyage complet de votre fauteuil avec extraction vapeur et protection Scotchgard incluse.</p><div class="service-price">79 $</div></div>
      </div>
      <div class="service-card">
        <img src="/images/service-meubles-optimized.webp" alt="Nettoyage causeuse 2 places" class="service-card-img">
        <div class="service-card-body"><h3>Causeuse 2 places</h3><p>Nettoyage en profondeur de votre causeuse. Élimination des taches, odeurs et allergènes.</p><div class="service-price">99 $</div></div>
      </div>
      <div class="service-card">
        <img src="/images/promo/sofa-hero-1.webp" alt="Nettoyage sofa 3 places" class="service-card-img">
        <div class="service-card-body"><h3>Sofa 3 places</h3><p>Nettoyage vapeur professionnel de votre sofa. Résultats visibles immédiatement, garanti.</p><div class="service-price">149 $</div></div>
      </div>
      <div class="service-card">
        <img src="/images/service-cuir.webp" alt="Nettoyage cuir sofa" class="service-card-img">
        <div class="service-card-body"><h3>Cuir (sofa)</h3><p>Traitement spécialisé pour vos meubles en cuir. Nettoyage délicat, hydratation et protection.</p><div class="service-price">189 $</div></div>
      </div>
    </div>
  </section>

  <section class="why-us fade-up">
    <div class="section-header"><h2>Pourquoi choisir Nettoyage Empire?</h2><p>Le standard le plus élevé en nettoyage professionnel</p></div>
    <div class="why-grid">
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><h3>Protection Scotchgard</h3><p>Protection anti-taches Scotchgard incluse avec chaque nettoyage de meuble</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div><h3>25% sur items additionnels</h3><p>Économisez 25% sur chaque meuble additionnel lors du même rendez-vous</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M7 10.5c0-.276.345-.5.771-.5h8.458c.426 0 .771.224.771.5s-.345.5-.771.5H7.771c-.426 0-.771-.224-.771-.5z"/><path d="M12 7v10"/></svg></div><h3>Produits écologiques</h3><p>Produits certifiés sécuritaires pour votre famille et vos animaux</p></div>
      <div class="why-card"><div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><h3>Résultats immédiats</h3><p>Voyez la différence dès le premier passage. Satisfaction garantie à 100%</p></div>
    </div>
  </section>

  <section class="form-section" id="soumission">
    <div class="form-container">
      <div class="section-header"><h2>Soumission gratuite</h2><p>Remplissez le formulaire et recevez votre estimation en moins de 2 heures</p></div>
      <form id="leadForm" name="promo_meubles" data-netlify="true" netlify-honeypot="bot-field" method="POST">
        <input type="hidden" name="form-name" value="promo_meubles" />
        <p style="display:none;"><label>Laissez ce champ vide: <input name="bot-field" /></label></p>
        <div class="form-row">
          <div class="form-group"><label for="prenom">Prénom *</label><input type="text" id="prenom" name="prenom" placeholder="Votre prénom" required></div>
          <div class="form-group"><label for="nom">Nom *</label><input type="text" id="nom" name="nom" placeholder="Votre nom" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="telephone">Téléphone *</label><input type="tel" id="telephone" name="telephone" placeholder="(514) 000-0000" required></div>
          <div class="form-group"><label for="email">Courriel</label><input type="email" id="email" name="email" placeholder="votre@courriel.com"></div>
        </div>
        <div class="form-group"><label for="adresse">Adresse du service *</label><input type="text" id="adresse" name="adresse" placeholder="123 rue Exemple, Montréal, QC" required></div>
        <div class="form-group">
          <label for="service">Type de meuble *</label>
          <select id="service" name="service" required>
            <option value="">Choisir un service...</option>
            <option value="fauteuil">Fauteuil</option>
            <option value="causeuse">Causeuse</option>
            <option value="sofa">Sofa</option>
            <option value="sectionnel">Sectionnel</option>
            <option value="cuir">Cuir</option>
            <option value="autre">Autre</option>
          </select>
        </div>
        <div class="form-group"><label for="message">Détails supplémentaires</label><textarea id="message" name="message" rows="3" placeholder="Nombre de meubles, type de tissu, taches particulières..."></textarea></div>
        <button type="submit" class="form-submit">Obtenir ma soumission gratuite</button>
        <p class="form-note">Réponse en moins de 2 heures. Aucun engagement.</p>
      </form>
    </div>
  </section>

  <section class="testimonials fade-up">
    <div class="section-header"><h2>Ce que nos clients disent</h2><p>50+ avis 5 étoiles sur Google</p></div>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Seriously wow. My couch was horribly stained. Daniel made it look brand new. Seriously exceeded my expectations."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">S</div><div><p class="testimonial-name">Sahar Ali</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"Je ne pensais pas revoir mon divan pâle aussi beau qu'à la livraison initiale, mais c'est chose faite! Avec deux jeunes enfants, c'était un miracle."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">D</div><div><p class="testimonial-name">David et Andréanne Laganière</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-text">"J'ai eu un service incroyable! L'équipe était ponctuelle, professionnelle et très minutieuse. Mon sofa a retrouvé une allure impeccable, comme neuf."</p>
        <div class="testimonial-author"><div class="testimonial-avatar">E</div><div><p class="testimonial-name">Émilie Grant</p><p class="testimonial-location">Avis Google</p></div></div>
      </div>
    </div>
  </section>

  <div class="landing-footer">
    <div class="footer-inner">
      <div class="footer-brand"><img src="/favicon.svg" alt="" class="footer-brand-icon"><span class="footer-brand-text">Nettoyage Empire</span></div>
      <p>&copy; 2026 Nettoyage Empire - L'Art du Nettoyage Haut de Gamme</p>
      <p>Montréal | Laval | Rive-Sud | West Island | <a href="tel:+15148939939">Appelez-nous</a></p>
    </div>
  </div>

  <div class="mobile-cta">
    <div class="mobile-cta-inner">
      <a href="tel:+15148939939" class="mobile-cta-call"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Appeler</a>
      <a href="#soumission" class="mobile-cta-quote"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Soumission gratuite</a>
    </div>
  </div>

  <script is:inline>
    document.getElementById('leadForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = e.target;
      var data = new FormData(form);
      var btn = form.querySelector('.form-submit');
      btn.textContent = 'Envoi en cours...';
      btn.style.background = '#2E7D32';
      btn.disabled = true;

      data.append('source', 'promo_meubles');
      
      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data).toString()
      })
      .then(function() { return { success: true }; })
      .then(function(result) {
        window.location.href = '/promo/merci';
      })
      .catch(function(err) {
        console.error('Erreur soumission:', err);
        btn.textContent = 'Erreur - Réessayer';
        btn.style.background = '#c62828';
        btn.disabled = false;
      });
    });
  </script>
</LandingLayout>