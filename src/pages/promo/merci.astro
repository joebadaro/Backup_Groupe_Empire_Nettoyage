---
import LandingLayout from '../../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Merci pour votre demande! | Nettoyage Empire"
  description="Votre demande de soumission a été envoyée avec succès. Nous vous contacterons dans les 2 prochaines heures."
  service="merci"
>
  <nav class="navbar">
    <a href="/" class="navbar-brand"><img src="/favicon.svg" alt="" class="navbar-brand-icon"><span class="navbar-brand-text">Nettoyage<span class="brand-line2">Empire</span></span></a>
    <div class="navbar-right">
      <a href="tel:+15148939939" class="navbar-phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <span>(514) 893-9939</span>
      </a>
    </div>
  </nav>

  <section class="hero" style="min-height: 100vh; display: flex; align-items: center;">
    <div class="hero-bg" style="background: var(--empire-gradient);"></div>
    <div class="hero-overlay" style="background: linear-gradient(135deg, rgba(0,40,85,0.95) 0%, rgba(0,74,159,0.9) 100%);"></div>
    <div class="hero-content" style="grid-template-columns: 1fr; text-align: center; justify-items: center;">
      <div class="hero-text" style="text-align: center;">
        <div style="width: 80px; height: 80px; background: rgba(46,125,50,0.2); border: 2px solid #2E7D32; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="3" width="40" height="40"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h1 style="font-family: 'Outfit Variable', sans-serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #fff; margin-bottom: 16px;">Merci pour votre demande!</h1>
        <p class="hero-desc" style="max-width: 600px; margin: 0 auto 32px; font-size: 18px; color: rgba(255,255,255,0.85); line-height: 1.7;">
          Votre soumission a bien été reçue. Un de nos techniciens vous contactera dans les <strong style="color: var(--empire-gold);">2 prochaines heures</strong> pour confirmer les détails et planifier votre rendez-vous.
        </p>
        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px;">
          <a href="tel:+15148939939" class="btn-hero-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Appelez-nous maintenant
          </a>
          <a href="/" class="btn-hero-secondary">
            Retour au site
          </a>
        </div>
        <div class="hero-stats" style="justify-content: center;">
          <div class="hero-stat"><span class="number">30+</span><span class="label">Ans d'expérience</span></div>
          <div class="hero-stat"><span class="number">4.9/5</span><span class="label">Avis Google</span></div>
          <div class="hero-stat"><span class="number">100%</span><span class="label">Satisfaction garantie</span></div>
        </div>
      </div>
    </div>
  </section>

  <div class="landing-footer">
    <div class="footer-inner">
      <div class="footer-brand"><img src="/favicon.svg" alt="" class="footer-brand-icon"><span class="footer-brand-text">Nettoyage Empire</span></div>
      <p>&copy; 2026 Nettoyage Empire - L'Art du Nettoyage Haut de Gamme</p>
      <p>Montréal | Laval | Rive-Sud | West Island | <a href="tel:+15148939939">Appelez-nous</a></p>
    </div>
  </div>

</LandingLayout>
